# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
# Fake Stripe values: tests never call Stripe (StripeGatewayInterface is
# replaced by a fake); the webhook secret only signs test payloads.
STRIPE_SECRET_KEY=sk_test_fake_for_tests
STRIPE_WEBHOOK_SECRET=whsec_fake_for_tests
STRIPE_CONNECT_ACCOUNT_EVENTS_SECRET=whsec_fake_connect_account_events_for_tests
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_fake_connect_webhook_for_tests
STRIPE_PRICE_MONTHLY=price_test_monthly
STRIPE_PRICE_YEARLY=price_test_yearly
STRIPE_PRICE_RESELLER_MONTHLY=price_test_reseller_monthly
STRIPE_PRICE_RESELLER_YEARLY=price_test_reseller_yearly
STRIPE_PRICE_RESELLER_EXTRA_MONTHLY=price_test_reseller_extra_monthly
STRIPE_PRICE_RESELLER_EXTRA_YEARLY=price_test_reseller_extra_yearly
# Fake values for every other external key, so tests never read a real one
# from .env (loaded first in every environment). Tests that need a key set
# their own in $_ENV. The providers that are off in .env stay empty, i.e.
# not configured, as they are everywhere else.
GEMINI_API_KEY=gemini_fake_for_tests
GEMINI_IMAGE_API_KEY=gemini_image_fake_for_tests
GROQ_API_KEY=groq_fake_for_tests
OPENROUTER_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
EXCHANGE_API_KEY=exchange_fake_for_tests
RAPIDAPI_KEY=rapidapi_fake_for_tests
RAPIDAPI_HOST=rapidapi.fake-for-tests.invalid
