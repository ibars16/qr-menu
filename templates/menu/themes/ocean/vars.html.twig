<style>
:root {
    /* ── Identity: La Marina — sea water: aqua page and footer, white cards, pale-blue sheets, navy titles and cover band, deep turquoise accent, turquoise "metal".
       Colors only: shape and type come from the shared structure,
       layouts/standard/_structure.html.twig. Same token set as maison's
       vars.html.twig.
       Text tokens measured ≥4.5:1 on every background they sit on in the
       rendered page; borders/focus/state ≥3:1. ── */

    /* ── Palette ── */
    --bg: #D9EEF5;
    --bg-attach: scroll;
    --surface: #FFFFFF;
    --surface-2: #C3E3EE;
    --fg: #0B2E4A;
    --fg-2: #24506B;
    --fg-3: #315E76;
    --accent: #006178;
    --b1: rgba(11,46,74,0.14);
    --b2: rgba(11,46,74,0.24);

    /* ── Tokens of the shared structure ── */
    --accent-soft: #1F7488;
    --on-accent: #FFFFFF;
    --shadow-rgb: 11,46,74;
    --cf-hborder-rgb: 36,135,156;
    /* Over dish photos (badge chip, × shadow, photo scrim): black at the
       structure's 55% + white text, 4.69:1 even on a pure-white photo. */
    --scrim-rgb: 0,0,0;
    --on-scrim: #FFFFFF;
    --sheet-grip: rgba(255,255,255,0.7);
    --line-soft: rgba(11,46,74,0.08);
    /* The search field's underline: its only boundary, 3:1 on the page. */
    --search-line: #687D8F;
    /* Big full-width button (.filters-apply-btn): solid --fg block, --surface text, no border (as maison). */
    --btn-strong-bg: #0B2E4A;
    --btn-strong-fg: #FFFFFF;
    --btn-strong-border: none;
    /* "May contain" allergen chip text: 4.5:1 on the dish sheet. */
    --chip-may-text: #0C6175;

    /* ── Header ── */
    --hdr-bg: rgba(217,238,245,0.95);
    --hdr-border: rgba(11,46,74,0.14);
    --hdr-blur: blur(20px);

    /* ── Hero ── */
    --hero-bg: linear-gradient(180deg, #0F3858, #0B2E4A);
    --hero-border: rgba(11,46,74,0.08);

    /* ── Hero band (.hero-inner on phones, .hero from 768px): navy with near-white name, aqua tagline, an aqua CTA pill with navy text, aqua carousel controls and focus ring ── */
    --hero-band: #0B2E4A;
    --hero-fg: #F2FAFC;
    --hero-fg-2: #8FD6E6;
    --hero-cta-bg: #8FD6E6;
    --hero-cta-hover: #B1E3EE;
    --hero-cta-fg: #0B2E4A;
    --hero-cue-bg: rgba(143,214,230,0.14);
    --hero-cue-text: #8FD6E6;
    --hero-dot: rgba(143,214,230,0.55);
    --hero-dot-on: #8FD6E6;
    --hero-glow: radial-gradient(ellipse at center, rgba(143,214,230,0.14) 0%, rgba(143,214,230,0.05) 42%, transparent 72%);
    --hero-focus: #8FD6E6;

    /* ── Search input ── */
    --in-bg: #FFFFFF;
    /* The chat input's resting border (its only boundary): 3:1. */
    --in-border: #687D8F;
    --in-focus-border: #006178;
    --in-focus-shadow: 0 0 0 3px rgba(0,97,120,0.12);
    --in-text: #0B2E4A;
    --in-ph: #315E76;

    /* ── Tabs & filters ── */
    --tab-bg: #FFFFFF;
    --tab-border: rgba(11,46,74,0.14);
    --tab-text: #24506B;
    --tab-hbg: #C3E3EE;
    --tab-htext: #0B2E4A;
    --tab-act-bg: #006178;
    --tab-act-border: #006178;
    --tab-act-text: #FFFFFF;
    --tab-act-shadow: 0 4px 16px rgba(0,97,120,0.28);

    /* ── Card front ── --cf-hborder is the "metal" role (maison's brass):
       borders, focus rings, the allergen-shield glyph; --cf-hborder-text is
       its text-safe step for the small .count labels. */
    --cf-bg: #FFFFFF;
    --cf-border: rgba(11,46,74,0.08);
    --cf-hborder: #24879C;
    --cf-hborder-text: #0C6175;
    --cf-hshadow: 0 4px 8px rgba(11,46,74,0.05), 0 12px 28px rgba(11,46,74,0.08);
    --cf-img: #C3E3EE;
    --cf-accent: linear-gradient(90deg, transparent 0%, #24879C 40%, transparent 100%);
    --cf-accent-op: 0.55;
    --card-shadow: 0 1px 2px rgba(11,46,74,0.04), 0 3px 10px rgba(11,46,74,0.04);
    --card-hover-shadow: 0 4px 8px rgba(11,46,74,0.05), 0 12px 28px rgba(11,46,74,0.08);

    /* ── Card content ── */
    --cn: #0B2E4A;
    --cd: #24506B;
    --cp: #006178;
    --cbg: #C3E3EE;
    --cbc: rgba(11,46,74,0.14);
    --cbt: #24506B;
    --hint: rgba(11,46,74,0.2);
    --hint-h: rgba(0,97,120,0.55);

    /* ── Card back / modal ── */
    --cb-bg: #EAF6FA;
    --cb-border: rgba(11,46,74,0.08);
    --bn: #0B2E4A;
    --bp: #006178;
    --close-bg: #C3E3EE;
    --close-b: rgba(11,46,74,0.14);
    --close-t: #24506B;
    --close-hbg: #B6D6E3;
    --close-ht: #0B2E4A;
    --bdiv: rgba(11,46,74,0.08);
    --btt: #315E76;
    --bdesc: #24506B;
    --fade: #EAF6FA;
    --cue-bg: rgba(0,97,120,0.10);
    --cue-text: #006178;

    /* ── Compact-layout rows ── */
    --row-border: rgba(11,46,74,0.08);
    --row-hover: #EAF5F9;
    --num: rgba(11,46,74,0.14);
    --num-h: #315E76;

    /* ── Category titles ── */
    --cat-title: #0B2E4A;
    --cat-sep: rgba(11,46,74,0.08);
    --sep-bg: rgba(11,46,74,0.08);

    /* ── Logo ── */
    --logo-bg: #006178;

    /* ── Label colours ── */
    --lg: #266419; --lg-bg: rgba(38,100,25,0.09); --lg-b: rgba(38,100,25,0.16);
    --lo: #903D19; --lo-bg: rgba(144,61,25,0.09); --lo-b: rgba(144,61,25,0.16);

    /* ── Ingredient chips ── */
    --ing-bg: #C3E3EE; --ing-b: rgba(11,46,74,0.14); --ing-t: #24506B;

    /* ── Nutrition ── */
    --nut-bg: #C3E3EE; --nut-b: rgba(11,46,74,0.14); --nut-v: #0B2E4A; --nut-u: #315E76;

    /* ── Spicy ── */
    --dot-on: #006178; --dot-off: rgba(11,46,74,0.14); --spicy-t: #24506B;
}
</style>
