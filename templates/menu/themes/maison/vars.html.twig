<style>
:root {
    /* ── Identity: Maison — fine-dining editorial. Parchment, ivory and
       wine. Colors only: shape and type (serif display, sharp-ish corners,
       --font-scale) come from the shared structure,
       layouts/standard/_structure.html.twig. ── */

    /* ── Palette ── */
    --bg: #F2EBDF;
    --bg-attach: scroll;
    --surface: #FBF8F1;
    --surface-2: #E9DFCD;
    --fg: #241C17;
    /* --fg-2 (2026-09-07): darkened from #736354 — that value read 4.37:1 on
       --surface-2 (the hero's deep parchment), just under the 4.5:1 AA floor
       for normal text. #6D5D4E clears every background this token is used
       against in maison: 4.78:1 on --surface-2, 5.33:1 on --bg, 5.95:1 on
       --surface. Scoped to this file only — every theme defines its own
       --fg-2 in its own vars.html.twig, so this doesn't touch the others. */
    --fg-2: #6D5D4E;
    --fg-3: #A99B8A;
    --accent: #7A1E28;
    --b1: rgba(36,28,23,0.14);
    --b2: rgba(36,28,23,0.24);

    /* ── Tokens of the shared structure, consumed only by
       menu/layouts/standard/_structure.html.twig ── */
    /* Hover fill of the accent buttons ("Ver más", hero CTA, "Borrar todo",
       footer social links) and the hover color of the row "Ver más" link. */
    --accent-soft: #9A3742;
    /* Text/icons on an --accent or --accent-soft fill. */
    --on-accent: #ffffff;
    /* rgb triplets for shadows (--fg's) and the filters-sheet header glow
       (--cf-hborder's), used as rgba(var(--…-rgb), alpha). */
    --shadow-rgb: 36,28,23;
    --cf-hborder-rgb: 176,137,76;
    /* Over dish photos: badge chip and gradient scrim, × shadow, sheet grip. */
    --scrim-rgb: 20,14,11;
    --on-scrim: #f6eee2;
    --sheet-grip: rgba(255,255,255,0.7);
    --line-soft: rgba(36,28,23,0.08);
    /* The search field's underline (.search-wrap) — maison keeps the
       --line-soft hairline. */
    --search-line: rgba(36,28,23,0.08);
    /* Big full-width button (.filters-apply-btn): espresso block, ivory
       text, no border — --fg/--surface's values. */
    --btn-strong-bg: #241C17;
    --btn-strong-fg: #FBF8F1;
    --btn-strong-border: none;
    /* "May contain" allergen chip text: maison keeps its brass
       (--cf-hborder's value). */
    --chip-may-text: #B0894C;

    /* ── Header ── */
    --hdr-bg: rgba(242,235,223,0.95);
    --hdr-border: rgba(36,28,23,0.14);
    --hdr-blur: blur(20px);

    /* ── Hero ── */
    --hero-bg: radial-gradient(120% 90% at 85% 0%, rgba(176,137,76,0.14), transparent 60%), linear-gradient(180deg, #E9DFCD, #F2EBDF);
    --hero-border: rgba(36,28,23,0.08);

    /* ── Hero band (.hero-inner on phones, .hero from 768px): the --surface-2 / --fg / --fg-2 / --cp / --accent-soft / --on-accent / --cue-* / --accent values, the band as it always was ── */
    --hero-band: #E9DFCD;
    --hero-fg: #241C17;
    --hero-fg-2: #6D5D4E;
    --hero-cta-bg: #7A1E28;
    --hero-cta-hover: #9A3742;
    --hero-cta-fg: #ffffff;
    --hero-cue-bg: rgba(122,30,40,0.08);
    --hero-cue-text: rgba(122,30,40,0.55);
    --hero-dot: color-mix(in srgb, #7A1E28 30%, transparent);
    --hero-dot-on: #7A1E28;
    --hero-glow: radial-gradient(ellipse at center, rgba(255,255,255,0.5) 0%, rgba(255,255,255,0.16) 42%, transparent 72%);

    /* ── Search input ── */
    --in-bg: #FBF8F1;
    --in-border: rgba(36,28,23,0.14);
    --in-focus-border: #7A1E28;
    --in-focus-shadow: 0 0 0 3px rgba(122,30,40,0.08);
    --in-text: #241C17;
    --in-ph: #A99B8A;

    /* ── Tabs & filters ── */
    --tab-bg: #FBF8F1;
    --tab-border: rgba(36,28,23,0.14);
    --tab-text: #736354;
    --tab-hbg: #E9DFCD;
    --tab-htext: #241C17;
    --tab-act-bg: #7A1E28;
    --tab-act-border: #7A1E28;
    --tab-act-text: #ffffff;
    --tab-act-shadow: 0 4px 16px rgba(122,30,40,0.28);

    /* ── Card front ── */
    --cf-bg: #FBF8F1;
    --cf-border: rgba(36,28,23,0.08);
    --cf-hborder: #B0894C;
    /* --cf-hborder-text (2026-09-07): --cf-hborder itself only clears the
       3:1 non-text floor (2.71:1 on --bg as text) — fine for the card
       border and the allergen-shield glyph it's also used for, not for the
       three small ".count" labels (.cat-title/.filters-section-title/
       .bsec-title) that paint real 10-11px text with it. This darker brass
       is for those three uses only; --cf-hborder itself stays untouched so
       the border/glyph identity color doesn't shift. 4.98:1 on --bg. */
    --cf-hborder-text: #805E30;
    --cf-hshadow: 0 4px 8px rgba(36,28,23,0.05), 0 12px 28px rgba(36,28,23,0.08);
    --cf-img: #E9DFCD;
    --cf-accent: linear-gradient(90deg, transparent 0%, #B0894C 40%, transparent 100%);
    --cf-accent-op: 0.55;
    --card-shadow: 0 1px 2px rgba(36,28,23,0.04), 0 3px 10px rgba(36,28,23,0.04);
    --card-hover-shadow: 0 4px 8px rgba(36,28,23,0.05), 0 12px 28px rgba(36,28,23,0.08);

    /* ── Card content ── */
    --cn: #241C17;
    --cd: #736354;
    --cp: #7A1E28;
    --cbg: #E9DFCD;
    --cbc: rgba(36,28,23,0.14);
    --cbt: #736354;
    --hint: rgba(36,28,23,0.2);
    --hint-h: rgba(122,30,40,0.55);

    /* ── Card back / modal ── */
    --cb-bg: #F2EBDF;
    --cb-border: rgba(36,28,23,0.08);
    --bn: #241C17;
    --bp: #7A1E28;
    --close-bg: #E9DFCD;
    --close-b: rgba(36,28,23,0.14);
    --close-t: #736354;
    --close-hbg: #DDD0BA;
    --close-ht: #241C17;
    --bdiv: rgba(36,28,23,0.08);
    --btt: #A99B8A;
    --bdesc: #736354;
    --fade: #F2EBDF;
    --cue-bg: rgba(122,30,40,0.08);
    --cue-text: rgba(122,30,40,0.55);

    /* ── Compact-layout rows ── */
    --row-border: rgba(36,28,23,0.08);
    --row-hover: #F8F3EA;
    --num: rgba(36,28,23,0.14);
    --num-h: #A99B8A;

    /* ── Category titles ── */
    --cat-title: #736354;
    --cat-sep: rgba(36,28,23,0.08);
    --sep-bg: rgba(36,28,23,0.08);

    /* ── Logo ── */
    --logo-bg: #7A1E28;

    /* ── Label colours ── */
    --lg: #3E8018; --lg-bg: rgba(59,109,17,0.09); --lg-b: rgba(99,153,34,0.16);
    --lo: #7A1E28; --lo-bg: rgba(122,30,40,0.08); --lo-b: rgba(122,30,40,0.16);

    /* ── Ingredient chips ── */
    --ing-bg: #E9DFCD; --ing-b: rgba(36,28,23,0.14); --ing-t: #736354;

    /* ── Nutrition ── */
    --nut-bg: #E9DFCD; --nut-b: rgba(36,28,23,0.14); --nut-v: #241C17; --nut-u: #A99B8A;

    /* ── Spicy ── --spicy-t is --fg-2's value: #A99B8A (--fg-3) was 2.29:1
       on the dish sheet's --cb-bg; this is 5.33:1 there, 5.95:1 on --surface. */
    --dot-on: #7A1E28; --dot-off: rgba(36,28,23,0.14); --spicy-t: #6D5D4E;
}
</style>
