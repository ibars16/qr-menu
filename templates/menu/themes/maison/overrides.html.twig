{# Maison — structural overrides for the standard layout (the only public
   menu layout).

   This file is included right after standard/show.html.twig's own
   <style> block (`{% include 'menu/themes/' ~ theme ~ '/overrides.html.twig'
   ignore missing %}`), so equal-specificity selectors here win by source
   order alone — nothing below needs raised specificity or !important. #}
<style>
    html { scroll-behavior: smooth; }

    /* Category tabs — underline instead of filled pills. carta-estilo.css's
       .tabs{gap:24px;padding:18px 20px 2px} assumes .tabs is a direct child
       with no other horizontal gutter; ours sits inside .ui-wrap, which
       already supplies that left/right gutter to the search field and
       section headers above/below it. Copying the 20px side padding
       verbatim here would double that indent and misalign the tabs against
       everything else — so gap/vertical padding are copied literally (18px
       top, matching the reference exactly), side padding is left at 0 to
       keep the shared gutter single-sourced. */
    .cat-tabs { gap: 24px; padding: 18px 0 2px; }
    .cat-tab {
        background: none; border: none; border-radius: 0; padding: 0 0 9px; min-height: auto;
        color: var(--tab-text); font-weight: 400; font-size: calc(14.5px * var(--font-scale)); box-shadow: none; position: relative;
    }
    .cat-tab:hover { background: none; color: var(--fg); transform: none; }
    .cat-tab:active { transform: none; }
    .cat-tab.active { background: none; color: var(--fg); font-weight: 500; box-shadow: none; }
    .cat-tab.active::after {
        content: ''; position: absolute; left: 0; bottom: 0; width: 100%; height: 2px;
        background: var(--cp); border-radius: 2px;
    }

    /* Section header — serif, sentence case, no uppercase/left accent bar */
    .cat-title { text-transform: none; letter-spacing: 0; font-size: calc(23px * var(--font-scale)); font-weight: 500; gap: 12px; }
    .cat-title::before { display: none; }

    /* Dish count next to the section title — brass, small-caps spacing,
       body font (not the serif display font the title itself uses).
       Matches carta-estilo .sec-head .count exactly; --cf-hborder is the
       same brass hex as carta-estilo's --brass token. */
    .cat-title .count {
        font-family: var(--font-body); font-size: 11px; font-weight: 600;
        letter-spacing: 0.2em; color: var(--cf-hborder);
    }

    /* Price — fine display-serif typography, no filled pill */
    .dish-price, .dish-detail-price {
        background: none; box-shadow: none; padding: 0; color: var(--cn); font-family: var(--font-display);
        font-size: calc(18px * var(--font-scale));
    }
    .dish-price .price-item-label, .dish-detail-price .price-item-label {
        color: var(--fg-2); font-family: var(--font-body); font-size: 0.7em; letter-spacing: 0.04em;
    }
    .dish-price .price-item-value, .dish-detail-price .price-item-value { color: var(--cn); }
    /* Currency suffix — small and muted instead of matching the price's own
       serif/size, so "22.17 USD" reads as one price with a quiet unit, not
       two equal-weight numbers. See _price.html.twig's price() macro (all
       3 layouts, both card front/back) for the .price-currency span this
       targets — wrapping it there is unconditional/theme-agnostic, only
       this rule gives it any visual treatment. */
    .price-currency { font-size: calc(12px * var(--font-scale)); color: var(--fg-3); font-family: var(--font-body); margin-left: 3px; }

    /* "Ver más" — filled wine pill, white text, same pattern as
       .filters-clear-link ("Borrar todo"): solid var(--accent) fill,
       white-on-#7A1E28 clears AA (~10:1), lighter --wine-soft on hover
       (chosen there for reading slightly less "wine" at rest while still
       clearing AA — same reasoning applies here), var(--cf-hborder) brass
       on :focus-visible. The hover fill used to live on .dish-card:hover
       (whole-card affordance) since the resting state was a bare text
       link with nothing to swap; now .more-hint has its own visible fill
       at rest, so its own :hover / :focus-visible carry the swap instead. */
    .more-hint {
        background: var(--accent); border: 1px solid var(--accent); color: #fff;
        padding: 0.375rem 0.8125rem; border-radius: var(--radius); display: inline-flex; align-items: center; gap: 0.25rem;
    }
    .dish-card:hover .more-hint { background: var(--wine-soft); border-color: var(--wine-soft); color: #fff; }
    /* .more-hint itself is never focusable — the whole .dish-card is the
       one tap/keyboard target (role="button" tabindex="0"), per the shared
       comment above .dish-card in the base layout. Cueing keyboard focus
       on the pill it visually points at, rather than adding a focus ring
       to the card's own edge, keeps that "one target" model intact. */
    .dish-card:focus-visible .more-hint { outline: 2px solid var(--cf-hborder); outline-offset: 2px; }
    .more-hint i { transition: transform 0.25s ease; }
    .dish-card:hover .more-hint i { transform: translateX(3px); }

    /* Photo frame — 150px → 210px (2026-09-05) → 240px (2026-09-06, one more
       notch of presence). .dish-card has no fixed height/overflow-y of its
       own (its `overflow: hidden` above only clips the border-radius), so
       there is no internal card scrollbar to worry about at any height —
       growing the photo just pushes name/allergens/price further down the
       *page*, which is the thing actually verified at 390px each bump.
       Still shorter than the base layout's own clamp(190–200px) default
       since maison's parchment/ivory cards read intentionally compact.
       aspect-ratio stays auto (the fixed height alone already sets both
       dimensions — see the base layout's own comment on this same
       trade-off above .dish-card .front-img). Markup only renders this
       photo branch when theme == 'maison'; the no-photo case is .dish-row
       instead, see menu/layouts/standard/show.html.twig and .dish-row
       further down. */
    .dish-card .front-img { height: 240px; aspect-ratio: auto; }
    .dish-card { box-shadow: none; }
    /* Dish name, photo card only — .dish-row .front-name below sets its
       own size for the no-photo row variant; both selectors match a row's
       name equally (same specificity, two classes each), so the row rule
       staying declared after this one in source order is what makes it
       win there — see the padding-top gotcha noted near .search-wrap. */
    .dish-card .front-name { font-size: calc(19px * var(--font-scale)); }

    /* No-photo panel — only ever reached now inside the dish-detail modal's
       .dish-modal-photo (the front-card grid uses .dish-row instead, see
       below): a single flat block, no logo/icon (a delivery-style glyph
       doesn't belong on a restaurant menu). Just the restaurant name, small
       and muted, centered — never the dish's own name, never a second
       element. */
    .dish-placeholder {
        background: var(--surface-2); display: flex; align-items: center; justify-content: center; padding: 0.75rem;
    }
    .dish-placeholder span {
        font-size: 11px; font-weight: 500; letter-spacing: 0.04em; color: var(--fg-2); text-align: center; -webkit-line-clamp: 1;
    }

    /* No-photo dish, front-card grid: a plain text row instead of a card
       with an empty image frame — grid-column spans the full grid width so
       it reads as a list divider across both columns at the ≥640px
       breakpoint, not a half-width card-shaped hole. Horizontal margin is
       0 (not carta-estilo's literal 20px) for the same reason the tabs
       above drop their side padding: .cards-grid already sits inside
       .content's own 18/24px gutter, so a second one would double it. */
    .dish-row {
        grid-column: 1 / -1; background: none; border: none; border-radius: 0; box-shadow: none;
        margin: 0; padding: 17px 0; border-top: 1px solid var(--line-soft); cursor: pointer;
    }
    .dish-row:hover { box-shadow: none; border-color: var(--line-soft); transform: none; }
    .dish-row:active { transform: none; }
    .row-head { display: flex; justify-content: space-between; align-items: baseline; gap: 14px; }
    .dish-row .front-name {
        font-family: var(--font-display); font-size: calc(18px * var(--font-scale)); font-weight: 500;
        line-height: 1.25; white-space: normal; overflow: visible; text-overflow: clip;
    }
    .row-price {
        font-family: var(--font-display); font-size: calc(18px * var(--font-scale)); font-weight: 500;
        color: var(--cn); white-space: nowrap; flex-shrink: 0;
    }
    .row-price .price-item-label { color: var(--fg-2); font-family: var(--font-body); font-size: 0.7em; letter-spacing: 0.04em; }
    .row-price .price-item-value { color: var(--cn); }
    /* Description dropped from .dish-row's front (2026-09-05, see
       conversation) for the same reason as the photo card's .front-desc
       below — it stays in the detail sheet only. .dish-contains fills the
       gap it left; .more-hint keeps its own row-scale sizing. */
    .dish-row .dish-contains { margin: 5px 0 0; }
    .dish-row .more-hint { font-size: 11.5px; margin-top: 8px; }

    /* Card-front description (.front-desc) removed for maison (2026-09-05,
       see conversation) — no rule needed here any more, it never renders in
       this theme (see standard/show.html.twig: `pT.description and theme
       != 'maison'`). Kept out entirely rather than left as dead CSS. */

    /* Dish-detail sheet's own description (.dish-detail-desc, distinct from
       the now-removed card-front .front-desc) — already rendered whenever
       pT.description is non-empty (see standard/show.html.twig's <template
       class="dish-tpl">, untouched here) and already themed via --bdesc;
       only the size needed pulling down to this sheet's 13.5px body scale
       from the base layout's 15px. */
    .dish-detail-desc { font-size: calc(13.5px * var(--font-scale)); }

    /* .aicon itself is unrelated to the card-front allergen row removed
       below — it's the parchment-disc icon geometry shared by the filter
       panel's diet/type/allergen chips and the detail sheet's tag chips
       (_self.chipIcon() in standard/show.html.twig), so it stays even
       though .allergen-icons (its one card-front consumer) goes away. */
    .aicon {
        width: 22px; height: 22px; border-radius: 50%; background: var(--bg);
        display: flex; align-items: center; justify-content: center; font-size: 10px; flex-shrink: 0;
    }

    /* "[shield] Gluten, Crustáceos, Huevos" — the card-front allergen tease,
       replacing the old icon-per-allergen .allergen-icons/.aicon row
       (2026-09-05, see conversation): bare icons with only a native
       title="" tooltip were illegible on touch, so this reuses the same
       productAllergens entries (already translated to the active locale,
       minus free_from) as one discreet line instead. A single shield glyph
       anchors it — the exact same `ti-shield-check` the "¿Alergias o
       dietas?" button already uses (standard/show.html.twig, .diet-allergy-
       btn i), not a new icon. Flex row so only the allergen list
       (.dish-contains-list) truncates with an ellipsis on overflow — the
       icon never gets clipped. Not the full safety list (that stays in the
       detail sheet's .bsec with its 3-state chips) — a tease. Only
       rendered when the dish actually has allergens (see the Twig
       `cardAllergens|length > 0` guard, macro dishContains()) — never an
       empty line and nothing invented.

       No visible text label any more (2026-09-06, see conversation — the
       "CONTIENE:" kicker from the previous round was dropped): the shield
       carries that meaning instead, via `role="img"` + a translated
       `aria-label` on the `<i>` itself (see the macro in
       standard/show.html.twig) rather than a second DOM node here. Its
       *visual* color stays --cf-hborder (brass, ~3.03:1 against --cf-bg/
       --bg) — a decorative glyph only needs the 3:1 non-text-contrast bar,
       which it clears; there's no longer any label text at this size for
       the earlier 4.5:1 AA-text shortfall to apply to. Allergen names stay
       --fg-2 (~5.4:1, comfortably AA). */
    .dish-contains {
        display: flex; align-items: center; gap: 0.375rem;
        font-family: var(--font-body); font-size: calc(12.5px * var(--font-scale));
        overflow: hidden; max-width: 100%;
    }
    .dish-contains-icon {
        color: var(--cf-hborder); font-size: 0.8125rem; flex-shrink: 0;
    }
    .dish-contains-list {
        color: var(--fg-2); min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }

    /* Hero kicker/CTA — carta-estilo's .cta-explore is a small filled wine
       button (not a text link), positioned above h1 in the markup (moved
       there in the twig). Kept as an <a href="#cat-tabs"> so the
       smooth-scroll behavior is unchanged; only styling differs from the
       other 8 themes' larger .hero-kicker pill in this same slot. */
    .cta-explore {
        display: inline-flex; align-items: center; gap: 8px; padding: 8px 15px; margin: 0;
        background: var(--cp); color: #fff; border: none; border-radius: 100px;
        font-size: 12px; font-weight: 600; letter-spacing: 0.04em; text-decoration: none;
        transition: background 0.2s;
    }
    .cta-explore:hover { background: var(--wine-soft); }
    .cta-explore i { font-size: 12px; }
    .hero { padding: 22px 20px 26px; }
    /* Base 43px, not the shared 46px other sizes use — an almost
       imperceptible +1px over the original 42px, scaled down further by
       --font-scale like everything else. Kept separate deliberately: the
       restaurant name needs to actually fit in ~1-2 lines at 390px, unlike
       the other sizes here which just needed "a touch bigger". */
    .hero-name { font-size: calc(43px * var(--font-scale)); font-weight: 500; letter-spacing: -0.01em; margin: 16px 0 10px; text-shadow: none; }
    /* Tagline — only painted when restaurant.tagline has a value (see the
       twig guard); admins fill it in via Ajustes > Información del
       restaurante, it's never inferred or defaulted here. */
    .tagline { font-size: calc(14.5px * var(--font-scale)); font-weight: 400; color: var(--fg-2); line-height: 1.5; max-width: 82%; }

    /* Chef's-recommendation banner — carta-premium-completa.html's .banner,
       adapted to this app's tokens (--accent for its --wine, --surface for
       its --ivory; color-mix replaces its literal wine-tinted background/
       border since we don't have a raw wine rgb triplet to mix by hand).
       Only ever in the DOM when the twig found a tagged dish (see
       show.html.twig) — no empty/placeholder state to style. */
    .banner {
        margin: 16px 0 0; display: flex; align-items: center; gap: 12px; padding: 12px 14px;
        border-radius: var(--radius); cursor: pointer;
        background: color-mix(in srgb, var(--accent) 10%, var(--surface));
        border: 1px solid color-mix(in srgb, var(--accent) 26%, transparent);
    }
    .bicon {
        width: 34px; height: 34px; border-radius: var(--radius); flex-shrink: 0;
        display: flex; align-items: center; justify-content: center; background: var(--accent); color: #fff;
    }
    .bicon svg { width: 16px; height: 16px; }
    .btext { flex: 1; min-width: 0; }
    .blabel { font-size: 10px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--cf-hborder); margin-bottom: 2px; }
    .bhead {
        font-family: var(--font-display); font-weight: 500; font-size: calc(15px * var(--font-scale)); line-height: 1.2; color: var(--fg);
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .bsub {
        font-size: calc(12.5px * var(--font-scale)); color: var(--fg-2); margin-top: 2px;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }

    /* Chef's-recommendation carousel — same slide material as .banner above,
       used only when 2+ dishes carry 'recommended' (see show.html.twig's
       recommendedItems). .banner-viewport clips the sliding .banner-track;
       .banner-nav (prev/dots/next) sits below it, outside the clip, so it's
       never affected by the track's transform. */
    .banner-multi { margin: 16px 0 0; }
    .banner-viewport { overflow: hidden; border-radius: var(--radius); }
    .banner-track { display: flex; transition: transform 0.28s ease; }
    .banner-slide {
        flex: 0 0 100%; width: 100%; min-width: 0; box-sizing: border-box; cursor: pointer;
        display: flex; align-items: center; gap: 12px; padding: 12px 14px;
        background: color-mix(in srgb, var(--accent) 10%, var(--surface));
        border: 1px solid color-mix(in srgb, var(--accent) 26%, transparent);
    }
    .banner-nav { display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 8px; }
    .banner-nav-btn {
        width: 26px; height: 26px; border-radius: 50%; border: none; flex-shrink: 0; padding: 0;
        background: var(--cue-bg); color: var(--cue-text); display: flex; align-items: center; justify-content: center;
        font-size: 13px; cursor: pointer; transition: background 0.18s, color 0.18s;
    }
    .banner-nav-btn:hover:not(:disabled) { background: var(--accent); color: #fff; }
    .banner-nav-btn:disabled { opacity: 0.35; cursor: default; }
    .banner-dots { display: flex; align-items: center; gap: 6px; }
    .banner-dot {
        width: 6px; height: 6px; border-radius: 50%; border: none; padding: 0; cursor: pointer;
        background: color-mix(in srgb, var(--accent) 30%, transparent);
        transition: background 0.18s, width 0.18s;
    }
    .banner-dot.active { background: var(--accent); width: 16px; border-radius: 3px; }
    .sr-only {
        position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
        overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
    }

    /* Header — carta-estilo's header{padding:16px 20px 14px}, logo an
       ivory circle with a brass ring (not a solid wine fill), brand name
       at weight 500. */
    .header { padding: 16px 20px 14px; }
    .logo { border-radius: 50%; background: var(--surface); border: 1px solid var(--cf-hborder); box-shadow: none; color: var(--accent); }
    /* Default logo (no restaurant.logo uploaded) — a filled (not outline)
       cutlery mark, redrawn from carta-premium-completa.html's stroke
       version: a thin stroke anti-aliases soft at 24px, a solid fill reads
       crisp at that size regardless of display density. Sized/colored via
       .logo's own flex-centering and `color: var(--accent)` above (the
       svg's fill="currentColor" inherits it — no separate color rule
       needed). Not the letter-avatar fallback the other 8 themes use. */
    .logo svg { width: 24px; height: 24px; }
    .resto-name { font-weight: 500; }
    .nav-dd-trigger { padding: 7px 11px; border-width: 1px; border-radius: 100px; }

    /* Card badges — carta-estilo's single .badge treatment (dark
       translucent chip, cream small-caps text) applied to all 3 overlay
       badges (featured tag / spicy / popular); still 3 separate
       elements/logic, look only. The twig only ever renders one of the
       three per card (recommended > popular > spicy priority — see
       maisonBadge in show.html.twig), so all three share the same
       top-left slot (carta-estilo .badges{top:10px;left:10px}) rather
       than each keeping its own base-layout corner. */
    .dish-pill, .spicy-badge, .popular-badge {
        top: 0.625rem; right: auto; bottom: auto; left: 0.625rem;
        background: rgba(20,14,11,0.55); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);
        color: #f6eee2; font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase;
        padding: 4px 8px; border-radius: 2px; font-weight: 600; border: none; box-shadow: none;
    }

    /* Allergy/diet filter button — matches carta-estilo .allergy exactly:
       ivory fill, thin line border, ESPRESSO text (only the icon is
       wine), trailing arrow, brass hover border. Overrides the other
       themes' hardcoded red/pink fill (that base rule sets literal hex,
       not a var, so it's the same flat color on every theme — maison is
       the first to override it). */
    .diet-allergy-btn {
        background: var(--surface); border: 1px solid var(--b1); border-radius: var(--radius);
        color: var(--fg); box-shadow: none; font-weight: 400; gap: 10px; padding: 12px 15px;
    }
    .diet-allergy-btn:hover { border-color: var(--cf-hborder); box-shadow: none; }
    .diet-allergy-btn.has-active { border-color: var(--accent); }
    .diet-allergy-btn i { color: var(--accent); }
    .allergy-arrow { margin-left: auto; color: var(--fg-2); }

    /* Rhythm from the category tabs down through the allergy filter to the
       first section header (see conversation 2026-09-02: the previous
       0/2rem split left the button glued to the tabs, then a dead gap
       before "Carpaccios"). Matches carta-estilo: 16px between tabs and
       the allergy button (.allergy{margin:16px 20px 0}), then a uniform
       26px from there to every section title (.sec-head{padding:26px 20px
       10px}), including the gap between one section's cards and the
       next section's title. */
    .diet-allergy-row { padding: 16px 0 0; }
    .cat-section { padding-top: 26px; }

    /* Search — a hairline underline instead of a bordered/filled box, with
       the magnifier icon sitting inline to its left (carta-estilo
       .search-field: icon + input as flex siblings, border-bottom on the
       shared wrapper rather than on the input alone). The 20px gap above
       the strip is a margin, not padding — align-items:center centers
       flex children against the *content* box, so any padding here (the
       original 20px/4px split) pulls that content box off-center inside
       the visible band even though the children stay centered against
       each other. Zero padding on the wrap means the band's height comes
       only from .search-input's own symmetric 9px/9px padding, so there's
       nothing left to be off-center against — padding-top must be reset
       explicitly here, not just omitted: the base layout's own
       .search-wrap{padding-top:24px} (standard/show.html.twig) targets the
       same selector and isn't cleared just because this rule doesn't
       mention it, so leaving it out silently stacked a 24px padding under
       this rule's 20px margin instead of replacing it. */
    .search-wrap {
        display: flex; align-items: center; gap: 11px; margin-top: 20px; padding: 0;
        border-bottom: 1px solid var(--line-soft); transition: border-color 0.22s;
    }
    .search-wrap:focus-within { border-color: var(--in-focus-border); }
    .search-icon {
        position: static; top: auto; left: auto; display: block; flex-shrink: 0;
        font-size: 15px; color: var(--fg-3); pointer-events: none;
    }
    .search-input {
        flex: 1; min-width: 0; border: 0; border-radius: 0; background: transparent;
        padding: 9px 2px; box-shadow: none;
    }
    .search-input:focus { box-shadow: none; }
    .search-input::placeholder { color: var(--fg-3); font-style: italic; }

    /* Unified 20px side gutter (see conversation 2026-09-02) — .ui-wrap and
       .content are separate sibling wrappers that already carried identical
       padding (18px / 24px≥768px) so nothing inside them was ever actually
       misaligned against anything else in the *other* wrapper; this just
       moves both from that shared base-layout value to carta-estilo's
       literal 20px, at every width, in one place. Every element the brief
       calls out (search line, tabs, allergy button, section header, rows)
       stays at padding/margin 0 of its own and inherits this alone, so the
       single change here is what keeps all of them flush by construction. */
    .ui-wrap, .content { padding-left: 20px; padding-right: 20px; }
    @media (min-width: 768px) { .ui-wrap, .content { padding-left: 20px; padding-right: 20px; } }

    /* Smart Waiter FAB (menu/_smart_waiter.html.twig, shared markup/JS
       across every theme — not touched here, only its visibility) — hidden
       for as long as either bottom sheet below is open. The FAB is fixed
       at z-index:2000, above both sheets' own 1000, so while a sheet is
       open it was sitting on top of "Ver resultados"/"Cerrar" with only a
       few px to spare, which is what forced those buttons' padding to
       reserve real clearance for it (see .filters-panel-footer/
       .dish-modal-footer below) even though nothing was actually colliding
       — the FAB simply had no reason to still be reachable while a sheet
       has the customer's attention. :has() rather than a JS toggle: no
       logic to keep in sync, the sheets' own existing .open class (already
       toggled by openFiltersPanel()/openDishModal(), untouched) is the
       only thing driving this. display:none also correctly pulls the FAB
       (and its chat panel, if it happened to be open — same element,
       .sw-panel lives inside .sw-widget) out of the tab order while a
       sheet has it hidden; nothing about the chat's own open/closed state
       is touched, so it reappears exactly as it was once the sheet closes.
       Scoped to maison simply by virtue of living in this file — the
       other 8 themes never load this rule, so their FAB behaves exactly
       as before. */
    body:has(.filters-overlay.open) .sw-widget,
    body:has(.dish-modal-overlay.open) .sw-widget {
        display: none;
    }

    /* Filters bottom sheet ("¿Qué necesitas?") — the base layout's version
       of this panel is a plain form (sans title, grey labels, bright-red
       apply button, native checkboxes for "evitar alérgenos") which reads
       as off-brand next to the rest of this theme. Everything below only
       restyles filters-overlay/filters-panel/filters-section markup that
       already exists in standard/show.html.twig — no new DOM, no filtering
       logic touched (see _search_js.html.twig for the one additive JS
       change: the allergen chip variant this theme uses instead of
       checkboxes). */
    .filters-panel-title {
        font-family: var(--font-display); font-weight: 500; color: var(--fg);
        font-size: calc(22px * var(--font-scale));
    }
    .filters-panel-title::after {
        content: ''; display: block; width: 32px; height: 2px; margin-top: 10px;
        background: var(--cf-hborder);
    }
    /* Whisper of the hero's own radial glow (see vars.html.twig --hero-bg) at
       the top of the sheet, so it reads as the same material as the rest of
       the page instead of a plain generic dialog. Painted on the header
       only (not the whole scroll area) so it doesn't repeat/tile awkwardly
       further down — it scrolls away with the rest of the body, same as
       the dish name does in the ficha; only the × stays put (see
       .filters-panel/.filters-panel-scroll below). */
    .filters-panel-header {
        background: radial-gradient(140% 160% at 100% 0%, rgba(176,137,76,0.10), transparent 65%);
    }
    /* Unscoped — this is the same close-button element/class used by both
       the filters sheet and the dish-detail sheet (see further down this
       file), and both want the identical ivory-disc treatment. */
    .dish-modal-close {
        background: var(--surface); border: 1px solid var(--b1); box-shadow: none; color: var(--fg-2);
    }
    .dish-modal-close:hover { background: var(--surface); border-color: var(--cf-hborder); color: var(--fg); }

    /* Chrome vs. scroll split, same reasoning and mechanism as .dish-modal/
       .dish-modal-scroll further down: .filters-panel becomes the fixed
       shell (holds the × below, clips corners via overflow:hidden, never
       itself scrolls) so the × stays persistent — visible over both the
       header's ivory and whatever filter section has scrolled up behind
       it — instead of being carried away with the content like before.
       Other themes don't render .filters-panel-scroll at all and keep
       .filters-panel itself as the scroll box (its own overflow-y:auto
       from the base layout, untouched).

       --font-scale: 1.06 brings this sheet to the same type scale as the
       ficha's own .dish-modal override (root stays 0.94 — see
       vars.html.twig) — every filters-panel rule already written as
       calc(Npx * var(--font-scale)) picks this up automatically. The
       interactive chips (.diet-filter/.type-filter) are unaffected on
       purpose: their font-size is a plain 12px in the base layout, never
       wired to this variable, so they keep their tap-target size
       regardless of the sheet's reading-type scale — deliberately not
       the same 12px the read-only .chip in the ficha scales up from. */
    .filters-panel {
        display: flex; flex-direction: column; overflow: hidden;
        --font-scale: 1.06;
    }
    .filters-panel-scroll { position: relative; flex: 1; min-height: 0; overflow-y: auto; }

    /* Section label — wine uppercase + a hairline filling the rest of the
       row, matching .cat-title's own label+rule rhythm on the public menu
       (::after here plays the same role as .cat-title::after there). The
       optional count span (see standard/show.html.twig — only rendered when
       the backing tag/allergen array is non-empty, never invented) reuses
       .cat-title .count's brass/body-font treatment. */
    .filters-section-title {
        color: var(--accent); letter-spacing: 0.18em; font-weight: 600;
        display: flex; align-items: center; gap: 10px;
    }
    .filters-section-title::after { content: ''; flex: 1; height: 1px; background: var(--line-soft); }
    .filters-section-title .count {
        font-family: var(--font-body); font-size: 10px; font-weight: 600;
        letter-spacing: 0.2em; color: var(--cf-hborder);
    }
    .filters-panel-body { gap: 1.5rem; }
    .filters-panel .allergen-disclaimer i { color: var(--cf-hborder); }
    /* Clearance for the sticky footer below (see .filters-panel-footer):
       sticky pins it over whatever body content is still scrolled behind it,
       so the last section (the disclaimer) needs enough reserved space to
       clear the footer's full rendered height plus a clean margin, or the
       disclaimer's last line ends up half-hidden behind the footer band
       instead of just fading under its gradient. 11rem (176px) is generous
       now that the footer's own padding shrank (it no longer reserves room
       for the Smart Waiter FAB — see that rule near the top of this file),
       but left as-is: still correctly safe, and there's no defect to fix
       by tightening a number that isn't causing one. */
    .filters-panel-body { padding-bottom: 11rem; }

    /* Chip icons — Tag::$icon / Allergen::$icon are free-text (admin-set,
       usually an emoji), not a fixed key, so there's no reliable emoji→SVG
       map to build without inventing one. Containing the emoji in the same
       parchment disc (.aicon) the dish-card allergen row already uses (see
       further up this file) reads as a deliberate icon system instead of
       raw emoji, at zero data-model cost — see standard/show.html.twig's
       chipIcon() macro for where this disc gets added, maison-only. */
    .filters-panel .diet-filter,
    .filters-panel .type-filter {
        gap: 8px;
    }

    /* Chip geometry — sharp .aicon-style corners instead of the tab pill,
       tighter and uniform padding instead of the min-height-driven sizing
       (so a one-word and a two-word chip read as the same size of object,
       not just the same height). Colors/border already come from the
       --tab-* tokens (ivory/line) set in vars.html.twig — only shape and
       shadow change here; .active below is a separate, louder state. */
    .filters-panel .diet-filter,
    .filters-panel .type-filter {
        border-radius: var(--radius); padding: 0.75rem 0.8125rem; min-height: 2.5rem; box-shadow: none;
    }
    /* Keyboard focus ring — :focus-visible only (never on a mouse click).
       Brass, not wine: the .active chip below is already wine border +
       wine-tinted fill, so a wine ring there would sit right on top of an
       existing wine border and read as barely-there. Brass reads clearly
       against both the ivory resting chip and the wine-tinted active one,
       and against the dark .filters-apply-btn — one color, every target. */
    .filters-panel .diet-filter:focus-visible,
    .filters-panel .type-filter:focus-visible,
    .dish-modal-close:focus-visible,
    .filters-apply-btn:focus-visible,
    .filters-panel .filters-clear-link:focus-visible {
        outline: 2px solid var(--cf-hborder); outline-offset: 2px;
    }

    /* Diet/type/allergen chips already share one component (.diet-filter /
       .type-filter, themed via the --tab-* vars elsewhere in this file) —
       only the *selected* state gets a filters-panel-specific treatment
       here: a wine tint + brass mark instead of the solid wine fill those
       classes use as category tabs (heavier than this panel's chip density
       calls for). A dot, not a check — this same state also drives
       "evitar alérgenos", where a check mark would misread as "I want
       this" rather than "hide dishes with this". Scoped to .filters-panel
       so the category-tab row and other layouts keep the solid-fill look. */
    .filters-panel .diet-filter.active,
    .filters-panel .type-filter.active {
        background: color-mix(in srgb, var(--accent) 8%, var(--surface));
        border-color: var(--accent); color: var(--accent); box-shadow: none; font-weight: 600;
    }
    .filters-panel .diet-filter.active::before,
    .filters-panel .type-filter.active::before {
        content: ''; display: inline-block; width: 6px; height: 6px; border-radius: 50%;
        background: var(--cf-hborder); margin-right: 7px; flex-shrink: 0;
    }

    /* Footer — sticky espresso CTA (stays sticky here on purpose: this is a
       confirm action, not a read-then-close one like the ficha's "Cerrar",
       so a floating fixed button is the expected, not confusing, pattern —
       see the ficha's own comment on why it went the other way). Soft fade
       above it (::before) so scrolled content visually dissolves into the
       footer band instead of being cut by a hard edge; the footer's own
       background stays solid (border-top + fade both use
       --line-soft/--cb-bg, same tokens as the rest of the sheet).

       Same calibration as the ficha's .dish-modal-fade: 60px, reaching
       full --cb-bg only in the last ~10% of its own height rather than
       holding a solid band for a third of it — a wide solid band read as a
       bar cutting the content off rather than dissolving it. No visibility
       toggle here (unlike the ficha's fade/chevron, which hide once
       there's nothing left to scroll) — this footer is always sticky
       whenever there's overflow, so the fade is always meaningful right
       above it; nothing here to disappear to. The ficha's chevron isn't
       ported at all: the sticky footer + chips peeking out from under it
       are already the "more below" signal on their own, and a chevron
       this close to the button risked reading as part of it.

       Padding — overrides the base layout's own 0.25rem/1.25rem/6rem
       (standard/show.html.twig; left as-is there, since the other 8 themes
       share that rule and their own footer isn't sticky, and — unlike
       here — their FAB is never hidden, so they still need that 6rem to
       clear it once scrolled to the natural end). That 6rem was originally
       ported here too and briefly bumped to 5rem after measuring the FAB's
       real footprint (56px circle + 18px margin) — both were reserving
       space for a collision that no longer exists now that the FAB is
       hidden outright while this sheet is open (see the Smart Waiter rule
       above). With the actual conflict removed instead of padded around,
       this is just a plain comfortable pad plus env(safe-area-inset-bottom)
       for the iOS gesture bar — nothing left reserving room for anything. */
    .filters-panel-footer {
        position: sticky; bottom: 0; background: var(--cb-bg); border-top: 1px solid var(--line-soft);
        padding: 0.875rem 1.25rem calc(0.875rem + env(safe-area-inset-bottom));
    }
    .filters-panel-footer::before {
        content: ''; position: absolute; left: 0; right: 0; bottom: 100%; height: 3.75rem;
        background: linear-gradient(transparent, var(--cb-bg) 90%); pointer-events: none;
    }
    .filters-apply-btn {
        background: var(--fg); color: var(--surface); border-radius: var(--radius);
        font-weight: 500; letter-spacing: 0.05em; box-shadow: none;
    }
    .filters-apply-btn:hover { opacity: 0.92; }
    /* Filled wine, white text — visible without competing with
       .filters-apply-btn's solid espresso fill: role stays clear from
       size (small, inline pill vs. the big sticky footer button) and
       position (top of the panel vs. bottom), not from color alone.
       White-on-#7A1E28 is ~10:1 contrast, well past AA. Contrast ratio
       computed against --accent's actual hex, not eyeballed — see the
       hover swap to --wine-soft below, a lighter wine that still clears
       AA on its own (kept for the hover state only, not the resting
       fill, since it reads slightly less "wine" than --accent at rest). */
    .filters-clear-link {
        color: #fff; background: var(--accent); border: 1px solid var(--accent); border-radius: var(--radius);
        padding: 0.5rem 0.9375rem;
    }
    .filters-clear-link:hover { background: var(--wine-soft); border-color: var(--wine-soft); }
    /* Anchored snug under the title's accent hairline instead of floating
       in the wide empty flex-end row below it (the "dead space" this was
       reported as sitting in) — tightened vertical gap only, same
       right-alignment as before (near the persistent ×). Deliberately
       NOT moved onto the title's own line: several locales' filters.title
       run long enough (French "De quoi avez-vous besoin ?", ~27 chars) to
       collide with a same-line button at 390px regardless of restaurant
       content, so staying on its own row below avoids that risk for every
       language rather than only the short ones. */
    .filters-panel-header { padding-bottom: 0.5rem; }
    .filters-panel-clear-row { padding: 0.25rem 1.25rem 0; }

    /* ── Dish-detail sheet (.dish-modal) ──────────────────────────────────
       Brings the same material as the filters sheet above (chip, section
       hairline+count, sticky espresso footer) to the ficha de plato — the
       two bottom sheets in this theme should read as one system, not two
       different ones. See standard/show.html.twig's <template class=
       "dish-tpl"> (theme == 'maison' branches only) for the markup this
       targets; nothing here changes what data renders, only how. */

    /* Read-only chip — visually the same object as .filters-panel's
       .diet-filter/.type-filter (disc icon via the shared chipIcon() macro,
       .aicon-radius geometry, no shadow) but a DIFFERENT class on purpose:
       these are informational (product tags, allergens), never toggled, so
       they must never be reachable by the filters panel's own
       querySelectorAll('.diet-filter…') click-wiring — see the backlog note
       left in the filters-panel work about that exact class-as-behavior-hook
       collision. A shared class here would risk repeating it the moment
       this markup gets cloned into the live DOM by openDishModal().

       Scaled down from the filters panel's own chip on purpose — that one
       is tactile (44px+ tap target, bold label) because it's something you
       press; this one is read-only metadata (ingredients/tags/allergens)
       competing for attention with the actual sales copy (.dish-detail-desc)
       above it, so it should read as quieter supporting detail, not another
       interactive-looking control. Material stays identical (disc, radius,
       border, palette, the 3 allergen states below) — only weight/size/
       padding move, min-height is dropped entirely since there's no tap
       target to protect here. */
    .chip {
        display: inline-flex; align-items: center; gap: 6px; font-size: calc(12px * var(--font-scale)); font-weight: 400;
        color: var(--fg); background: var(--surface); border: 1px solid var(--b1);
        border-radius: var(--radius); padding: 0.5rem 0.625rem; line-height: 1;
    }
    /* Allergen presence — a real food-safety distinction (contains / may
       contain traces / free from), not decorative category color, so it's
       retoned to the palette rather than flattened to the plain .chip above
       like the tag chips are. Border/text carry the distinction; background
       stays the same neutral ivory as every other chip in this theme. */
    .chip.chip-contains { border-color: var(--accent); color: var(--accent); }
    .chip.chip-may_contain { border-style: dashed; border-color: var(--cf-hborder); color: var(--cf-hborder); }
    .chip.chip-free_from { color: var(--fg-3); }

    /* Section headers inside the sheet (.bsec-title) — same wine-uppercase
       + hairline-fill rhythm as .filters-section-title, applied globally
       since every section in this modal (tags, allergens, ingredients,
       spicy, calories) uses this one class; the optional .count (only
       rendered when a real backing array exists — see standard/show.html.twig)
       reuses .cat-title .count's brass treatment. The hairline replaces the
       old divider border between sections (.bsec + .bsec below), so two
       separators don't stack. */
    .bsec-title {
        color: var(--accent); letter-spacing: 0.18em; font-weight: 600; font-size: 11px;
        display: flex; align-items: center; gap: 10px;
    }
    .bsec-title::after { content: ''; flex: 1; height: 1px; background: var(--line-soft); }
    .bsec-title .count {
        font-family: var(--font-body); font-size: 10px; font-weight: 600;
        letter-spacing: 0.2em; color: var(--cf-hborder);
    }
    .bsec + .bsec { border-top: none; padding-top: 22px; }

    /* Chrome vs. scroll split — .dish-modal becomes the fixed shell (holds
       the × below, clips corners via overflow:hidden, never itself
       scrolls); .dish-modal-scroll is the one thing inside it that does
       (grip + photo + body + footer — see standard/show.html.twig's
       theme == 'maison' branch). This is what makes the × persistent: it's
       no longer a descendant of the element that scrolls, so content
       passes underneath it instead of carrying it away. Other layouts/
       themes don't render .dish-modal-scroll at all and keep .dish-modal
       itself as the scroll box (its own overflow-y:auto from the base
       layout, untouched). */
    .dish-modal {
        display: flex; flex-direction: column; overflow: hidden;
        /* Scoped bump: only the sheet's own reading type (name, price,
           description, chips, "kcal" — everything already wired to
           calc(Npx * var(--font-scale)) for exactly this reason) grows.
           Custom properties cascade, so this shadows vars.html.twig's root
           --font-scale: 0.94 for every descendant here without touching a
           single calc() — the listing/hero/tabs outside the sheet never
           see this value. Independent from the root number: 0.98 still
           read small, bumped again to 1.06 — safe to keep tuning this one
           number (e.g. 1.12) without risking the hero's own wrap outside
           the sheet. */
        --font-scale: 1.06;
    }
    .dish-modal-scroll { position: relative; flex: 1; min-height: 0; overflow-y: auto; }

    /* × — persistent, solid, legible over both the photo and the parchment
       body it ends up floating over once scrolled (see the chrome split
       above). The button's own box stays the base layout's 44px tap
       target; the *visible* disc is a smaller, daintier ~40px circle via
       ::before so it reads as refined rather than bulky, without shrinking
       what's actually tappable. z-index is already 3 on the base rule,
       comfortably above .dish-modal-scroll's un-indexed content. */
    .dish-modal-close {
        background: none; border: none; box-shadow: none; color: var(--fg);
    }
    .dish-modal-close::before {
        content: ''; position: absolute; inset: 2px; border-radius: 50%;
        background: var(--surface); border: 1px solid var(--cf-hborder);
        box-shadow: 0 2px 10px rgba(20,14,11,0.22);
    }
    .dish-modal-close:hover { color: var(--accent); }
    .dish-modal-close:hover::before { border-color: var(--accent); }
    .dish-modal-close i { position: relative; }

    /* Drag grip — now an overlay on the photo itself (position:absolute
       against .dish-modal-scroll, which the photo sits flush at the top
       of) instead of its own flow strip above it — that strip was exactly
       the odd border/gap the photo used to have before it could reach the
       sheet's own rounded top corners. Semi-transparent so it reads as a
       hint over the photo, not a UI chrome piece; the shadow gives it edge
       definition even over the flatter no-photo placeholder background. */
    .sheet-grip {
        position: absolute; top: 12px; left: 50%; transform: translateX(-50%); z-index: 2;
        width: 36px; height: 4px; border-radius: 2px;
        background: rgba(255,255,255,0.7); box-shadow: 0 1px 3px rgba(20,14,11,0.25);
    }

    /* Photo — bigger (was reading too small at the base layout's 230px)
       and now genuinely full-bleed to the sheet's own top edge: with
       .dish-modal-scroll's flush layout above and .dish-modal's own
       overflow:hidden clipping to its border-radius, the photo needs no
       radius of its own — the chrome's rounded corner does the clipping.
       Top scrim guarantees the grip (and, lower down the page, whatever
       the × is currently floating over) reads on any photo brightness; the
       bottom fade dissolves the photo into the parchment body instead of
       cutting in a hard line. */
    .dish-modal-photo { position: relative; height: 300px; }
    .dish-modal-photo::before {
        content: ''; position: absolute; top: 0; left: 0; right: 0; height: 5rem;
        background: linear-gradient(rgba(20,14,11,0.35), transparent); pointer-events: none;
    }
    .dish-modal-photo::after {
        content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 4.5rem;
        background: linear-gradient(transparent, var(--cb-bg)); pointer-events: none;
    }
    /* No-photo fallback (.dish-placeholder, already themed further up this
       file as a flat --surface-2 block + restaurant name, no icon — a past,
       deliberate call, see conversation, not re-opened here) is width:100%/
       height:100% of this same element (base layout rule), so it grows
       with the photo above automatically — nothing to add here. */

    /* Bottom scroll fade — "there's more below". Sibling of .dish-modal-
       scroll, not a pseudo-element inside it: a pseudo would be generated
       as the scrolling content's own last child and scroll away with
       everything else, instead of staying pinned to the sheet's bottom
       edge like the × stays pinned to its top. Toggled by
       updateDishScrollFade() in _search_js.html.twig (on open and on
       scroll) — hidden by default (opacity:0) so a short, non-overflowing
       ficha never shows it at all. z-index sits above the scrolling
       content but below the × (z-index:3 on the base .dish-modal-close
       rule), and pointer-events:none is load-bearing: this must never
       swallow a tap meant for a chip or the × underneath it.

       60px (was 88px, and 52px before that), reaching full --cb-bg opacity
       only in the last ~10% of its own height instead of holding a solid
       band for a third of it — a wide solid band read as a bar cutting the
       content off rather than dissolving it. The chevron (below) is now
       the actual "there's more" signal; this only needs to be a quiet
       texture that softens where the content ends, not carry that job on
       its own. */
    .dish-modal-fade {
        position: absolute; left: 0; right: 0; bottom: 0; height: 3.75rem; z-index: 2;
        background: linear-gradient(transparent, var(--cb-bg) 90%);
        display: flex; align-items: flex-end; justify-content: center; padding-bottom: 0.625rem;
        pointer-events: none; opacity: 0; transition: opacity 0.2s ease;
    }
    .dish-modal-fade.visible { opacity: 1; }

    /* Chevron — a child of .dish-modal-fade (sits on top of it, same
       stacking/pointer-events-none context) but toggled by its OWN
       .visible class, not just inherited from the parent's opacity:
       updateDishScrollFade() dismisses it the moment any scrolling starts
       (scrollTop > 2), stricter than the fade's own "near bottom" rule —
       see that function's comment in _search_js.html.twig for why. Same
       function, same single listener either way. Static — no bounce/pulse
       animation, that reads as a consumer-app nag rather than a quiet
       "there's more" cue, which is the whole point of doing this with a
       fade in the first place. */
    .dish-modal-scroll-hint {
        color: var(--fg-3); font-size: 1.0625rem; line-height: 1; pointer-events: none;
        opacity: 0; transition: opacity 0.2s ease;
    }
    .dish-modal-scroll-hint.visible { opacity: 1; }

    /* Name + price header — more editorial presence: bigger serif name,
       price pulled up close under it (one cohesive title cluster, not
       evenly spaced like the detail sections below), then a hairline
       before the first section — whichever of price/description actually
       ends up immediately before it (description is conditional on real
       data, see standard/show.html.twig), so the divider appears in both
       cases without duplicating it. */
    .dish-detail-name {
        font-size: calc(26px * var(--font-scale)); font-weight: 500; letter-spacing: -0.02em; line-height: 1.05;
        /* Fraunces is a variable font (opsz 9..144, see fonts.html.twig) —
           forcing a high optical size here overrides the browser's own
           size-based auto-selection (which at a modest 26px would default
           toward the text/low-opsz cut) so the name gets the finer,
           higher-contrast display carving regardless of its rendered size. */
        font-variation-settings: 'opsz' 144;
    }
    .dish-detail-price { margin-top: -6px; }
    .dish-detail-desc { line-height: 1.6; }
    /* Generous side margins (fine dining = air) and a bottom padding reset
       — the base layout's own 6rem bottom padding exists to clear the
       fixed Smart Waiter bubble from the *last* element in the scroll
       area; that job now belongs to .dish-modal-footer (the true last
       element, see below) instead, so left as inherited it'd just be a
       large dead gap between the last section and the footer's hairline. */
    .dish-modal-body { gap: 1.25rem; padding: 1.5rem 1.5rem; }
    .dish-detail-price + .bsec,
    .dish-detail-desc + .bsec {
        border-top: 1px solid var(--line-soft); margin-top: 0.5rem; padding-top: 1.75rem;
    }

    /* Spicy-level dots — already on-palette via --dot-on/--dot-off/--spicy-t
       (vars.html.twig: wine filled, line-colored empty, muted label); only
       size/gap needed refining to read as deliberate rather than a generic
       progress indicator. */
    .spicy-row { gap: 6px; }
    .dot { width: 8px; height: 8px; }
    .spicy-txt { margin-left: 2px; }

    /* Calories — was the one section still in a filled/bordered pill
       (.nut, --nut-bg/--nut-b — already palette-correct tokens, just the
       wrong *shape* for this sheet). Every other section here is label +
       hairline + loose content; unboxing this one number brings it into
       that same language instead of reading as a leftover data-chip. */
    .nut { background: none; border: none; padding: 0; border-radius: 0; gap: 6px; }
    .nut-v { font-family: var(--font-display); font-weight: 500; font-size: calc(22px * var(--font-scale)); color: var(--cn); }
    .nut-u { font-family: var(--font-body); font-size: calc(12px * var(--font-scale)); color: var(--fg-3); }

    /* Ingredient names are free-text (Product::getIngredientNames(), admin
       entered) with no capitalization guarantee — "huevo poche trufado"
       next to "Huevos de corral". Presentation-only fix, data untouched:
       ::first-letter uppercases just the leading character. Deliberately
       NOT text-transform:capitalize (would upper-case every word — "Huevo
       Poche Trufado") and NOT Twig's |capitalize filter (also lower-cases
       the rest of the string, which would mangle a name with an
       intentional internal capital). .ing's own content is plain text
       (no icon/nested markup, unlike .chip), so ::first-letter targets it
       directly with no wrapper span needed. */
    .ing::first-letter { text-transform: uppercase; }

    /* Footer — flows at the natural end of the content now (no
       position:sticky): in a dish sheet the action is read-then-close, not
       confirm-a-selection like the filters sheet above, so a floating fixed
       button here read as "scroll is broken" and covered the tags section.
       Border-top is now just a quiet separator, not a fade-cover — nothing
       scrolls underneath it any more. Bottom padding no longer needs to
       clear the Smart Waiter FAB (used to be 6rem for exactly that) — the
       FAB is hidden outright while this sheet is open (see that rule near
       the top of this file), so there's nothing left to reserve room for;
       just env(safe-area-inset-bottom) for the iOS gesture bar. */
    .dish-modal-footer {
        background: var(--cb-bg); border-top: 1px solid var(--line-soft);
        padding: 1.25rem 1.5rem calc(1.25rem + env(safe-area-inset-bottom)); margin-top: 0.5rem;
    }
    /* Sheet grows with its content up to the base layout's own
       max-height:88vh cap; past that it scrolls normally and this footer
       is simply the last thing reached — no artificial clearance needed
       on #dish-modal-body any more (that was only for the old sticky
       footer's overlap). */
</style>
