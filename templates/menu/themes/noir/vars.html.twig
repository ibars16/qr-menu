<style>
:root {
    /* ── Identity: The Grand Table — Michelin fine dining, champagne gold on black.
       Colors only: shape and type come from the shared structure,
       layouts/standard/_structure.html.twig. Same token set as maison's
       vars.html.twig.
       Text tokens measured ≥4.5:1 on every background they sit on in the
       rendered page; borders/focus/state ≥3:1. ── */

    /* ── Palette ── */
    --bg: #030302;
    --bg-attach: scroll;
    --surface: #0C0B09;
    --surface-2: #12100C;
    --fg: #EEE0C0;
    --fg-2: #A8966C;
    --fg-3: #8F7F5A;
    --accent: #C4A040;
    --b1: rgba(238,224,192,0.14);
    --b2: rgba(238,224,192,0.24);

    /* ── Tokens of the shared structure ── */
    --accent-soft: #D6B65C;
    --on-accent: #0E0B04;
    --shadow-rgb: 0,0,0;
    --cf-hborder-rgb: 154,128,80;
    /* Over dish photos (badge chip, × shadow, photo scrim): black at the
       structure's 55% + white text, 4.69:1 even on a pure-white photo. */
    --scrim-rgb: 0,0,0;
    --on-scrim: #FFFFFF;
    --sheet-grip: rgba(255,255,255,0.7);
    --line-soft: rgba(238,224,192,0.08);
    /* The search field's underline: its only boundary, 3:1 on the page. */
    --search-line: #686254;
    /* Big full-width button (.filters-apply-btn): a quiet raised surface with a 3:1 border, not a bright --fg block that dominates the dark screen. */
    --btn-strong-bg: #12100C;
    --btn-strong-fg: #EEE0C0;
    --btn-strong-border: 1px solid #686254;
    /* "May contain" allergen chip text: 4.5:1 on the dish sheet. */
    --chip-may-text: #9A8050;

    /* ── Header ── */
    --hdr-bg: rgba(3,3,2,0.95);
    --hdr-border: rgba(238,224,192,0.14);
    --hdr-blur: blur(20px);

    /* ── Hero ── */
    --hero-bg: linear-gradient(160deg, #100c04, #180e03);
    --hero-border: rgba(238,224,192,0.08);

    /* ── Hero band (.hero-inner on phones, .hero from 768px): same values as --surface-2 / --fg / --fg-2 / --cp / --accent-soft / --on-accent / --cue-* / --accent ── */
    --hero-band: #12100C;
    --hero-fg: #EEE0C0;
    --hero-fg-2: #A8966C;
    --hero-cta-bg: #C4A040;
    --hero-cta-hover: #D6B65C;
    --hero-cta-fg: #0E0B04;
    --hero-cue-bg: rgba(196,160,64,0.10);
    --hero-cue-text: #C4A040;
    --hero-dot: color-mix(in srgb, #C4A040 30%, transparent);
    --hero-dot-on: #C4A040;
    --hero-glow: radial-gradient(ellipse at center, rgba(255,255,255,0.5) 0%, rgba(255,255,255,0.16) 42%, transparent 72%);

    /* ── Search input ── */
    --in-bg: #0C0B09;
    /* The chat input's resting border (its only boundary): 3:1. */
    --in-border: #686254;
    --in-focus-border: #C4A040;
    --in-focus-shadow: 0 0 0 3px rgba(196,160,64,0.12);
    --in-text: #EEE0C0;
    --in-ph: #8F7F5A;

    /* ── Tabs & filters ── */
    --tab-bg: #0C0B09;
    --tab-border: rgba(238,224,192,0.14);
    --tab-text: #A8966C;
    --tab-hbg: #12100C;
    --tab-htext: #EEE0C0;
    --tab-act-bg: #C4A040;
    --tab-act-border: #C4A040;
    --tab-act-text: #0E0B04;
    --tab-act-shadow: 0 4px 16px rgba(196,160,64,0.28);

    /* ── Card front ── --cf-hborder is the "metal" role (maison's brass):
       borders, focus rings, the allergen-shield glyph; --cf-hborder-text is
       its text-safe step for the small .count labels. */
    --cf-bg: #0C0B09;
    --cf-border: rgba(238,224,192,0.08);
    --cf-hborder: #9A8050;
    --cf-hborder-text: #B09A68;
    --cf-hshadow: 0 4px 8px rgba(0,0,0,0.4), 0 12px 28px rgba(0,0,0,0.5);
    --cf-img: #12100C;
    --cf-accent: linear-gradient(90deg, transparent 0%, #9A8050 40%, transparent 100%);
    --cf-accent-op: 0.55;
    --card-shadow: 0 1px 2px rgba(0,0,0,0.3), 0 3px 10px rgba(0,0,0,0.3);
    --card-hover-shadow: 0 4px 8px rgba(0,0,0,0.4), 0 12px 28px rgba(0,0,0,0.5);

    /* ── Card content ── */
    --cn: #EEE0C0;
    --cd: #A8966C;
    --cp: #C4A040;
    --cbg: #12100C;
    --cbc: rgba(238,224,192,0.14);
    --cbt: #A8966C;
    --hint: rgba(238,224,192,0.2);
    --hint-h: rgba(196,160,64,0.55);

    /* ── Card back / modal ── */
    --cb-bg: #070605;
    --cb-border: rgba(238,224,192,0.08);
    --bn: #EEE0C0;
    --bp: #C4A040;
    --close-bg: #12100C;
    --close-b: rgba(238,224,192,0.14);
    --close-t: #A8966C;
    --close-hbg: #211F19;
    --close-ht: #EEE0C0;
    --bdiv: rgba(238,224,192,0.08);
    --btt: #8F7F5A;
    --bdesc: #A8966C;
    --fade: #070605;
    --cue-bg: rgba(196,160,64,0.10);
    --cue-text: #C4A040;

    /* ── Compact-layout rows ── */
    --row-border: rgba(238,224,192,0.08);
    --row-hover: #0A0A08;
    --num: rgba(238,224,192,0.14);
    --num-h: #8F7F5A;

    /* ── Category titles ── */
    --cat-title: #A8966C;
    --cat-sep: rgba(238,224,192,0.08);
    --sep-bg: rgba(238,224,192,0.08);

    /* ── Logo ── */
    --logo-bg: #C4A040;

    /* ── Label colours ── */
    --lg: #7AAD40; --lg-bg: rgba(122,173,64,0.12); --lg-b: rgba(122,173,64,0.22);
    --lo: #D06040; --lo-bg: rgba(216,90,48,0.12); --lo-b: rgba(216,90,48,0.22);

    /* ── Ingredient chips ── */
    --ing-bg: #12100C; --ing-b: rgba(238,224,192,0.14); --ing-t: #A8966C;

    /* ── Nutrition ── */
    --nut-bg: #12100C; --nut-b: rgba(238,224,192,0.14); --nut-v: #EEE0C0; --nut-u: #8F7F5A;

    /* ── Spicy ── */
    --dot-on: #C4A040; --dot-off: rgba(238,224,192,0.14); --spicy-t: #A8966C;
}
</style>
