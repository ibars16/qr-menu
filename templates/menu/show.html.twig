{% set dir = menu_dir(locale) -%}
{#- Owner data that is never translated (name, address, a set-menu dish's
    fallback name…): on RTL menus it's wrapped in <span dir="auto"> so a
    Spanish line keeps its own direction (punctuation at its end) while the
    block keeps its right-aligned layout. Empty on LTR menus. Translatable
    owner texts (tagline, price labels, set-menu description/sections) go
    through owner_text() instead — see OwnerTextExtension. -#}
{% set autoOpen = dir == 'rtl' ? '<span dir="auto">' : '' -%}
{% set autoClose = autoOpen ? '</span>' : '' -%}
{#- Themes on the shared structure (layouts/standard/_structure.html.twig):
    the structured_themes Twig global, from app.structured_themes in
    config/services.yaml. Read by the layout and the Smart Waiter. -#}
{% set structured = theme in structured_themes -%}
<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ dir }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ restaurant.name }}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🍽️</text></svg>">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.31.0/dist/tabler-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    {% if structured %}{% include 'menu/layouts/standard/_fonts.html.twig' %}{% endif %}
    {%- if dir == 'rtl' %}
        {# Arabic-script fallbacks for the theme fonts (none of Plus Jakarta
           Sans / Inter / Fraunces has Arabic glyphs). Listed AFTER the
           theme's Latin font in each stack (layout's body rule, the shared
           structure's --font-body/--font-display), so digits and prices keep the theme
           font and only Arabic glyphs fall through to these. #}
        <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700{% if structured %}&family=Noto+Naskh+Arabic:wght@400;500;600{% endif %}&display=swap" rel="stylesheet">
    {%- endif %}
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { margin: 0; padding: 0; }
    </style>
    {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
    {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
    {%- endif %}
</head>
<body data-menu-lang="{{ locale }}" data-menu-currency="{{ currency }}" data-menu-show-prefs-dialog="{{ showPrefsDialog ? '1' : '0' }}">

{% include 'menu/_prefs_dialog.html.twig' %}

{# Preview banner — only visible to the logged-in admin #}
{% if isPreview %}
    <div style="position:fixed;top:0;left:0;right:0;z-index:9999;background:#150d2e;border-bottom:2px solid #534AB7;padding:10px 16px;display:flex;align-items:center;gap:12px">
        <span style="font-size:18px">👁️</span>
        <div style="flex:1;min-width:0">
            <div style="font-size:13px;font-weight:600;color:#c4b5fd">Modo previsualización</div>
            <div style="font-size:11px;color:#7c6ca0">Solo tú ves este tema. Tus clientes siguen viendo el tema activo.</div>
        </div>
        <a href="{{ path('admin_theme') }}" style="padding:7px 14px;background:#C1440E;color:#fff;border-radius:8px;font-size:13px;font-weight:600;text-decoration:none;flex-shrink:0">
            ← Volver al admin
        </a>
    </div>
    <div style="height:60px"></div>
{% endif %}

{% include 'menu/layouts/' ~ layout ~ '/show.html.twig' %}

{% include 'menu/_smart_waiter.html.twig' %}

</body>
</html>
