<script>
// changeLanguage / changeCurrency are defined in menu/_prefs_dialog.html.twig,
// included once from menu/show.html.twig — they also persist the choice to
// the customer's preference cookie before reloading.

// Dish-view tracking (see MenuController::trackView) — fire-and-forget, one
// request per distinct dish per page load. viewedProductIds dedupes repeat
// opens/flips of the same dish client-side, on top of the server's own
// per-IP rate limit.
const TRACK_VIEW_URL = '{{ path('menu_track_view', {slug: restaurant.slug}) }}';
const viewedProductIds = new Set();
function trackDishView(productId) {
    if (!productId || viewedProductIds.has(productId)) return;
    viewedProductIds.add(productId);
    fetch(TRACK_VIEW_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ productId: Number(productId) }),
        keepalive: true,
    }).catch(() => {});
}

function flipCard(wrap) {
    const flipped = wrap.querySelector('.card').classList.toggle('flipped');
    if (flipped) trackDishView(wrap.dataset.productId);
}
function unflipCard(e, btn)    { e.stopPropagation(); btn.closest('.card').classList.remove('flipped'); }

// Dish detail bottom-sheet modal (standard layout's photo-first cards) — one
// shared overlay in the DOM, content cloned in from the clicked card's own
// <template class="dish-tpl"> so nothing needs re-rendering server-side.
// No-op (both querySelectors return null) on any page that doesn't have
// this modal.
function openDishModal(card) {
    const tpl       = card.querySelector('.dish-tpl');
    const overlay   = document.getElementById('dish-modal-overlay');
    const photoWrap = document.getElementById('dish-modal-photo');
    const body      = document.getElementById('dish-modal-body');
    if (!tpl || !overlay || !photoWrap || !body) return;
    trackDishView(card.dataset.productId);
    const content   = tpl.content.cloneNode(true);
    const photoNode = content.querySelector('img, .dish-placeholder');
    photoWrap.innerHTML = '';
    body.innerHTML = '';
    if (photoNode) photoWrap.appendChild(photoNode);
    body.appendChild(content);
    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    // .dish-modal is the scroll box on most themes; maison instead scrolls
    // an inner .dish-modal-scroll so the × can stay fixed in the chrome
    // above it (see overrides.html.twig) — reset whichever one actually
    // scrolls.
    const modalBox  = overlay.querySelector('.dish-modal');
    const scrollBox = modalBox.querySelector('.dish-modal-scroll');
    (scrollBox || modalBox).scrollTop = 0;
    // New content (a different dish, possibly a different length) just
    // replaced the old — recompute the bottom fade for it. No-op on
    // layouts/themes without .dish-modal-scroll (updateDishScrollFade
    // itself no-ops too, but this skips the call entirely there).
    if (scrollBox) updateDishScrollFade(scrollBox);
}
function closeDishModal() {
    const overlay = document.getElementById('dish-modal-overlay');
    if (!overlay) return;
    overlay.classList.remove('open');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
}
document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeDishModal(); });

// Bottom scroll fade + chevron hint on the maison dish-detail sheet
// (.dish-modal-scroll / .dish-modal-fade / .dish-modal-scroll-hint, all
// maison-only markup — see standard/show.html.twig) — a purely visual
// "there's more below" affordance, not a filtering/state concern. Both are
// hidden whenever the content doesn't actually overflow. The fade itself
// stays up until scroll is within 8px of the true bottom (so it's never
// sitting over a clean "Cerrar"); the chevron is more eager to get out of
// the way — it disappears the moment ANY scrolling happens (scrollTop > 2),
// since its job is just "here, scroll" and it shouldn't linger once that's
// been acted on, while the fade's job (softening where content ends)
// keeps being useful all the way down. One function, one listener drives
// both — see the single addEventListener below. The .dish-modal-scroll
// element is static (part of the one shared modal shell, not per-product),
// so this listener is attached once rather than re-bound on every
// openDishModal() call.
function updateDishScrollFade(scrollBox) {
    const fade = scrollBox.parentElement.querySelector('.dish-modal-fade');
    if (!fade) return;
    const hint = fade.querySelector('.dish-modal-scroll-hint');
    const overflowing = scrollBox.scrollHeight > scrollBox.clientHeight + 1;
    const nearBottom   = scrollBox.scrollHeight - scrollBox.scrollTop - scrollBox.clientHeight <= 8;
    fade.classList.toggle('visible', overflowing && !nearBottom);
    if (hint) hint.classList.toggle('visible', overflowing && !nearBottom && scrollBox.scrollTop <= 2);
}
const dishScrollBox = document.querySelector('.dish-modal-scroll');
if (dishScrollBox) {
    dishScrollBox.addEventListener('scroll', () => updateDishScrollFade(dishScrollBox));
}
document.addEventListener('keydown', function(e) {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    const card = e.target.closest ? e.target.closest('.dish-card') : null;
    if (!card) return;
    e.preventDefault();
    openDishModal(card);
});

// Secondary filters (type/diet/allergens) bottom sheet — standard layout
// only (see #filters-btn / .filters-overlay in that layout's markup);
// no-ops elsewhere since getElementById returns null. Category tabs stay
// in the always-visible row and are not part of this panel.
function openFiltersPanel() {
    const overlay = document.getElementById('filters-overlay');
    if (!overlay) return;
    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
}
function closeFiltersPanel() {
    const overlay = document.getElementById('filters-overlay');
    if (!overlay) return;
    overlay.classList.remove('open');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
}
document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeFiltersPanel(); });

// Reflects the existing activeTags/activeType/activeAllergens filter state
// (set by the handlers below) onto the filters button label (its translated
// base text lives in data-i18n-cta, set server-side in standard/show.html.twig) —
// display only, the filtering itself is untouched.
function updateFiltersButtonBadge() {
    const label = document.getElementById('filters-btn-label');
    const btn   = document.getElementById('filters-btn');
    const clearRow = document.getElementById('filters-clear-row');
    if (!label || !btn) return;
    const count = activeTags.size + (activeType !== 'all' ? 1 : 0) + activeAllergens.size;
    const baseLabel = label.dataset.i18nCta || label.textContent;
    label.textContent = count > 0 ? (baseLabel + ' (' + count + ')') : baseLabel;
    btn.classList.toggle('has-active', count > 0);
    if (clearRow) clearRow.hidden = count === 0;
}

// Resets diet/type/allergen filters together by driving each control's own
// existing "Todo" button / clear function — reuses their handlers rather
// than duplicating the reset logic.
function clearAllFilters() {
    document.querySelector('[data-filter="diet"][data-tag="all"]')?.click();
    document.querySelector('[data-filter="type"][data-type="all"]')?.click();
    clearAllergenFilters();
}

const searchInput = document.getElementById('menu-search');
const noResults   = document.getElementById('no-results');
const sections    = document.querySelectorAll('.cat-section');
const catTabs     = document.querySelectorAll('.cat-tab');
// Selected by data-filter, not by the visual .diet-filter class — that
// class (and .chip/.allergen-filter-option) is style-only now. Maison's
// allergen chip buttons reuse .diet-filter purely for its look but carry
// data-filter="allergen" instead of "diet", so they're driven by
// activeAllergens/onAllergenFilterChange() below and never double-handled
// here even though they'd otherwise match a plain .diet-filter selector.
const dietFilters = document.querySelectorAll('[data-filter="diet"]');
// Multi-select: every checked diet/allergy/other tag chip must match (AND,
// not OR) — these are restrictions (allergies/diets), not preferences, so
// combining them any looser than an intersection would be a food-safety
// problem, not just a UX one. The hidden data-tag="all" button (see
// standard/show.html.twig's "Todo" comment) is not a member of this set —
// clicking it clears the whole selection.
let activeTags = new Set();

// Food/drink category filter — a whole .cat-section is shown or hidden by
// its own data-type ("food"/"drink"/"" for unclassified); unlike the diet
// tag and allergen filters below, this never hides individual rows, only
// entire sections (a category is either all-in or all-out). A section with
// no data-type (unclassified) always matches, in either mode — see
// CategoryType's docblock for why null is never treated as "hidden".
const typeFilters = document.querySelectorAll('[data-filter="type"]');
let activeType = 'all';

// Allergens a customer wants to avoid — multi-select, unlike the single-select
// diet filter above, since someone can have more than one allergy. A dish is
// hidden if it carries ANY selected allergen (data-allergens is "code:presence
// code:presence …", already on every card — see MenuController::$menuAllergens
// for where the checklist itself comes from).
let activeAllergens = new Set();

function applyFilters() {
    const q      = searchInput.value.toLowerCase().trim();
    const active = document.querySelector('.cat-tab.active');
    const cat    = active ? active.dataset.cat : 'all';
    let anyVisible = false;

    sections.forEach(sec => {
        const catMatch  = cat === 'all' || cat === sec.dataset.section;
        const typeMatch = activeType === 'all' || !sec.dataset.type || sec.dataset.type === activeType;
        if (!catMatch || !typeMatch) { sec.style.display = 'none'; return; }
        const rows = sec.querySelectorAll('.card-wrap, .product-row, .dish-card');
        let secVisible = false;
        rows.forEach(row => {
            const name      = row.querySelector('.front-name, .product-name')?.textContent.toLowerCase() ?? '';
            const tags      = (row.dataset.tags ?? '').trim().split(/\s+/).filter(Boolean);
            const allergens = (row.dataset.allergens ?? '').trim().split(/\s+/).filter(Boolean).map(a => a.split(':')[0]);
            const search        = !q || name.includes(q);
            const tagMatch      = activeTags.size === 0 || [...activeTags].every(t => tags.includes(t));
            const allergenMatch = activeAllergens.size === 0 || ![...activeAllergens].some(a => allergens.includes(a));
            const show     = search && tagMatch && allergenMatch;
            row.style.display = show ? '' : 'none';
            if (show) secVisible = true;
        });
        sec.style.display = secVisible ? '' : 'none';
        if (secVisible) anyVisible = true;
    });
    if (noResults) noResults.style.display = anyVisible ? 'none' : 'block';
}

function onAllergenFilterChange() {
    // Two markup variants feed the same activeAllergens set: legacy layouts
    // use a native checkbox (read via :checked/value), maison uses a chip
    // button (read via .active/data-allergen — see standard/show.html.twig's
    // theme == 'maison' branch). A given render only ever has one variant in
    // the DOM, so reading both selectors is safe and never double-counts.
    const checked  = Array.from(document.querySelectorAll('[data-filter="allergen"]:checked')).map(el => el.value);
    const activeBt = Array.from(document.querySelectorAll('[data-filter="allergen"].active[data-allergen]')).map(el => el.dataset.allergen);
    activeAllergens = new Set([...checked, ...activeBt]);
    applyFilters();
    updateFiltersButtonBadge();
}

function clearAllergenFilters() {
    document.querySelectorAll('[data-filter="allergen"]:checked').forEach(el => { el.checked = false; });
    document.querySelectorAll('[data-filter="allergen"].active[data-allergen]').forEach(el => {
        el.classList.remove('active');
        el.setAttribute('aria-pressed', 'false');
    });
    onAllergenFilterChange();
}

// Chip-button variant of the allergen filter (maison theme only — see
// standard/show.html.twig). Toggles the same activeAllergens set that the
// checkbox variant drives elsewhere; filtering itself (applyFilters) never
// knows which markup produced the set.
document.querySelectorAll('[data-filter="allergen"][data-allergen]').forEach(btn => {
    btn.addEventListener('click', () => {
        const nowActive = !btn.classList.contains('active');
        btn.classList.toggle('active', nowActive);
        btn.setAttribute('aria-pressed', String(nowActive));
        onAllergenFilterChange();
    });
});

// Cross-contamination / exception notes on allergen chips — click-to-open,
// closes on outside click or Escape. Same interaction as the "?" help icons
// in the Admin Panel, kept intentionally simple: no hover-only behavior, so
// it works identically on touch and desktop.
function toggleAllergenNote(event, btnEl) {
    event.stopPropagation();
    const wasOpen = btnEl.classList.contains('note-open');
    closeAllergenNotes();
    if (wasOpen) return;

    const pop = document.createElement('div');
    pop.className = 'alg-note-popover';
    pop.textContent = btnEl.dataset.note;
    document.body.appendChild(pop);

    const rect = btnEl.getBoundingClientRect();
    const popRect = pop.getBoundingClientRect();
    let left = rect.left + rect.width / 2 - popRect.width / 2;
    left = Math.max(8, Math.min(left, window.innerWidth - popRect.width - 8));
    let top = rect.bottom + 8;
    if (top + popRect.height > window.innerHeight - 8) top = rect.top - popRect.height - 8;

    pop.style.left = left + 'px';
    pop.style.top = top + 'px';
    btnEl.classList.add('note-open');
}
function closeAllergenNotes() {
    document.querySelectorAll('.alg-note-popover').forEach(p => p.remove());
    document.querySelectorAll('.alg-note-btn.note-open').forEach(el => el.classList.remove('note-open'));
}
document.addEventListener('click', closeAllergenNotes);
document.addEventListener('keydown', e => {
    if (e.key !== 'Escape') return;
    closeAllergenNotes();
});

searchInput?.addEventListener('input', applyFilters);

catTabs.forEach(tab => tab.addEventListener('click', () => {
    catTabs.forEach(t => t.classList.remove('active'));
    tab.classList.add('active');
    applyFilters();
    const cat = tab.dataset.cat;
    if (cat !== 'all') document.getElementById(cat)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
}));

dietFilters.forEach(btn => btn.addEventListener('click', () => {
    if (btn.dataset.tag === 'all') {
        // "Todo" — the reset action, not a selectable chip: clears every
        // active diet/allergy/other tag rather than toggling itself.
        activeTags.clear();
        dietFilters.forEach(x => { x.classList.remove('active'); x.setAttribute('aria-pressed', 'false'); });
    } else {
        const nowActive = !btn.classList.contains('active');
        btn.classList.toggle('active', nowActive);
        btn.setAttribute('aria-pressed', String(nowActive));
        if (nowActive) activeTags.add(btn.dataset.tag); else activeTags.delete(btn.dataset.tag);
    }
    // Keeps the hidden data-tag="all" button's own active state in sync
    // (it's the reset target for clearAllFilters(), not a visible chip on
    // this layout) — same "no filter" indicator the old radio behavior
    // gave it, without making it part of the multi-select set itself.
    document.querySelectorAll('[data-filter="diet"][data-tag="all"]').forEach(all => {
        all.classList.toggle('active', activeTags.size === 0);
        all.setAttribute('aria-pressed', String(activeTags.size === 0));
    });
    applyFilters();
    updateFiltersButtonBadge();
}));

typeFilters.forEach(btn => btn.addEventListener('click', () => {
    typeFilters.forEach(x => { x.classList.remove('active'); x.setAttribute('aria-pressed', 'false'); });
    btn.classList.add('active');
    btn.setAttribute('aria-pressed', 'true');
    activeType = btn.dataset.type;
    applyFilters();
    updateFiltersButtonBadge();
}));

const obs = new IntersectionObserver(entries => {
    const vis = entries.find(e => e.isIntersecting);
    if (!vis) return;
    const id = vis.target.dataset.section;
    catTabs.forEach(t => t.classList.toggle('active', t.dataset.cat === id));
}, { threshold: 0.3 });
sections.forEach(s => obs.observe(s));

// Scroll indicators for card backs — bidirectional, no flash
(function() {
    document.querySelectorAll('.card-wrap').forEach(wrap => {
        let initialized = false;
        wrap.addEventListener('click', function() {
            if (initialized) return;
            setTimeout(function() {
                const body = wrap.querySelector('.back-body');
                if (!body) return;
                const scroll = body.closest('.back-scroll');
                if (!scroll) return;
                const horiz = scroll.classList.contains('horiz');

                function check() {
                    if (horiz) {
                        const canScroll = body.scrollWidth > body.clientWidth + 4;
                        const atStart = body.scrollLeft < 4;
                        const atEnd   = body.scrollLeft + body.clientWidth >= body.scrollWidth - 4;
                        scroll.classList.toggle('can-right', canScroll && !atEnd);
                        scroll.classList.toggle('can-left',  canScroll && !atStart);
                    } else {
                        const canScroll = body.scrollHeight > body.clientHeight + 4;
                        const atTop    = body.scrollTop < 4;
                        const atBottom = body.scrollTop + body.clientHeight >= body.scrollHeight - 4;
                        scroll.classList.toggle('can-dn', canScroll && !atBottom);
                        scroll.classList.toggle('can-up', canScroll && !atTop);
                    }
                }

                body.addEventListener('scroll', check, { passive: true });
                check();
                initialized = true;
            }, 560);
        });
    });

    // All scroll-cue clicks handled in capture phase to prevent card from unflipping
    document.addEventListener('click', function(e) {
        if (e.target.closest('.scroll-cue-dn')) {
            e.stopPropagation();
            e.target.closest('.back-scroll')?.querySelector('.back-body')?.scrollBy({ top: 120, behavior: 'smooth' });
            return;
        }
        if (e.target.closest('.scroll-cue-up')) {
            e.stopPropagation();
            e.target.closest('.back-scroll')?.querySelector('.back-body')?.scrollBy({ top: -120, behavior: 'smooth' });
            return;
        }
        if (e.target.closest('.scroll-cue-h')) {
            e.stopPropagation();
            e.target.closest('.back-scroll')?.querySelector('.back-body')?.scrollBy({ left: 180, behavior: 'smooth' });
            return;
        }
        if (e.target.closest('.scroll-cue-l')) {
            e.stopPropagation();
            e.target.closest('.back-scroll')?.querySelector('.back-body')?.scrollBy({ left: -180, behavior: 'smooth' });
        }
    }, true);
})();

// Lightbox — global functions called via inline onclick attributes
function lbOpen(src) {
    var overlay = document.getElementById('lb-overlay');
    var img = document.getElementById('lb-img');
    if (!overlay || !img || !src) return;
    img.src = src;
    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
}
function lbClose() {
    var overlay = document.getElementById('lb-overlay');
    if (!overlay) return;
    overlay.classList.remove('open');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
}
document.addEventListener('keydown', function(e) { if (e.key === 'Escape') lbClose(); });
</script>
