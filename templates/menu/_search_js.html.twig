<script>
// changeLanguage / changeCurrency are defined in menu/_prefs_dialog.html.twig,
// included once from menu/show.html.twig — they also persist the choice to
// the customer's preference cookie before reloading.

// Dish-view tracking (see MenuController::trackView) — fire-and-forget, one
// request per distinct dish per page load. viewedProductIds dedupes repeat
// opens/flips of the same dish client-side, on top of the server's own
// per-IP rate limit.
const TRACK_VIEW_URL = '{{ path('menu_track_view', {slug: restaurant.slug}) }}';
const viewedProductIds = new Set();
function trackDishView(productId) {
    if (!productId || viewedProductIds.has(productId)) return;
    viewedProductIds.add(productId);
    fetch(TRACK_VIEW_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ productId: Number(productId) }),
        keepalive: true,
    }).catch(() => {});
}

function flipCard(wrap) {
    const flipped = wrap.querySelector('.card').classList.toggle('flipped');
    if (flipped) trackDishView(wrap.dataset.productId);
}
function unflipCard(e, btn)    { e.stopPropagation(); btn.closest('.card').classList.remove('flipped'); }

// Short clip (Product::$videoClip) — autoplay only for whichever card(s)
// are actually on screen. preload="none" + no src attribute at all until
// then (see standard/show.html.twig's .dish-clip), so a menu with several
// clips never eagerly downloads or decodes all of them at once — real
// mobile-data cost otherwise. applyFilters() (below) only ever toggles
// display:none/'' on these same row elements, never removes them, and a
// display:none element already reports isIntersecting:false on its own —
// so one observe() per clip at load time is enough, nothing to re-wire
// when a filter changes.
(function() {
    const clips = document.querySelectorAll('.dish-clip');
    if (!clips.length || typeof IntersectionObserver === 'undefined') return;
    const clipObserver = new IntersectionObserver(entries => {
        entries.forEach(entry => {
            const video = entry.target;
            if (entry.isIntersecting) {
                if (!video.src) video.src = video.dataset.clipSrc;
                video.play().catch(() => {});
            } else {
                video.pause();
            }
        });
    }, { threshold: 0.25 });
    clips.forEach(video => clipObserver.observe(video));
})();

// Dish detail bottom-sheet modal (standard layout's photo-first cards) — one
// shared overlay in the DOM, content cloned in from the clicked card's own
// <template class="dish-tpl"> so nothing needs re-rendering server-side.
// No-op (both querySelectors return null) on any page that doesn't have
// this modal.
function openDishModal(card) {
    const tpl       = card.querySelector('.dish-tpl');
    const overlay   = document.getElementById('dish-modal-overlay');
    const photoWrap = document.getElementById('dish-modal-photo');
    const body      = document.getElementById('dish-modal-body');
    if (!tpl || !overlay || !photoWrap || !body) return;
    trackDishView(card.dataset.productId);
    const content   = tpl.content.cloneNode(true);
    const photoNode = content.querySelector('img, video');
    photoWrap.innerHTML = '';
    body.innerHTML = '';
    if (photoNode) {
        // A zoomed clip's blurred fill (see clipVideo() in
        // standard/show.html.twig) sits right before it in the template —
        // only photoNode itself is picked above, so bring it along.
        const backdrop = photoNode.previousElementSibling;
        if (backdrop?.classList.contains('clip-backdrop')) photoWrap.appendChild(backdrop);
        photoWrap.appendChild(photoNode);
        // The grid's own clips are gated by the IntersectionObserver above
        // (several could be on screen at once); the modal only ever shows
        // one dish at a time, so it can just play as soon as it's inserted.
        if (photoNode.tagName === 'VIDEO' && photoNode.dataset.clipSrc) {
            photoNode.src = photoNode.dataset.clipSrc;
            // A cloneNode()'d <video> doesn't reliably repaint its own
            // poster once (re)inserted in this browser — it fetches fine
            // (confirmed in Resource Timing) but never paints, leaving the
            // box blank until real video data arrives. Toggling the
            // attribute off a tick and back on forces it to paint. Caught
            // against a real clip, not the synthetic fixtures used
            // elsewhere — those have no decodable frame either way, so
            // this never surfaced until now.
            const poster = photoNode.poster;
            photoNode.removeAttribute('poster');
            void photoNode.offsetHeight;
            photoNode.setAttribute('poster', poster);
            photoNode.play().catch(() => {});
        }
    }
    body.appendChild(content);
    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    // The sheet scrolls an inner .dish-modal-scroll so the × can stay
    // fixed in the chrome above it (see _structure.html.twig) — reset
    // whichever one actually scrolls.
    const modalBox  = overlay.querySelector('.dish-modal');
    const scrollBox = modalBox.querySelector('.dish-modal-scroll');
    (scrollBox || modalBox).scrollTop = 0;
    // New content (a different dish, possibly a different length) just
    // replaced the old — recompute the bottom fade for it.
    if (scrollBox) updateDishScrollFade(scrollBox);
}
function closeDishModal() {
    const overlay = document.getElementById('dish-modal-overlay');
    if (!overlay) return;
    overlay.classList.remove('open');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    document.getElementById('dish-modal-photo')?.querySelector('video')?.pause();
}
document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeDishModal(); });

// Bottom scroll fade + chevron hint on the dish-detail sheet
// (.dish-modal-scroll / .dish-modal-fade / .dish-modal-scroll-hint — see
// standard/show.html.twig) — a purely visual
// "there's more below" affordance, not a filtering/state concern. Both are
// hidden whenever the content doesn't actually overflow. The fade itself
// stays up until scroll is within 8px of the true bottom (so it's never
// sitting over a clean "Cerrar"); the chevron is more eager to get out of
// the way — it disappears the moment ANY scrolling happens (scrollTop > 2),
// since its job is just "here, scroll" and it shouldn't linger once that's
// been acted on, while the fade's job (softening where content ends)
// keeps being useful all the way down. One function, one listener drives
// both — see the single addEventListener below. The .dish-modal-scroll
// element is static (part of the one shared modal shell, not per-product),
// so this listener is attached once rather than re-bound on every
// openDishModal() call.
function updateDishScrollFade(scrollBox) {
    const fade = scrollBox.parentElement.querySelector('.dish-modal-fade');
    if (!fade) return;
    const hint = fade.querySelector('.dish-modal-scroll-hint');
    const overflowing = scrollBox.scrollHeight > scrollBox.clientHeight + 1;
    const nearBottom   = scrollBox.scrollHeight - scrollBox.scrollTop - scrollBox.clientHeight <= 8;
    fade.classList.toggle('visible', overflowing && !nearBottom);
    if (hint) hint.classList.toggle('visible', overflowing && !nearBottom && scrollBox.scrollTop <= 2);
}
const dishScrollBox = document.querySelector('.dish-modal-scroll');
if (dishScrollBox) {
    dishScrollBox.addEventListener('scroll', () => updateDishScrollFade(dishScrollBox));
}
document.addEventListener('keydown', function(e) {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    if (!e.target.closest) return;
    const card = e.target.closest('.dish-card');
    if (card) {
        e.preventDefault();
        openDishModal(card);
        return;
    }
    // Chef's-recommendation banner / carousel slide: run its own
    // onclick, which opens the matching dish card's detail. Only when the
    // banner itself has focus — the carousel's prev/dots/next are real
    // <button>s outside the slides and keep their native Enter/Space.
    const banner = e.target.closest('.banner, .banner-slide');
    if (banner && banner === e.target) {
        e.preventDefault();
        banner.click();
    }
});

// Secondary filters (type/diet/allergens) bottom sheet — standard layout
// only (see #filters-btn / .filters-overlay in that layout's markup);
// no-ops elsewhere since getElementById returns null. Category tabs stay
// in the always-visible row and are not part of this panel.
function openFiltersPanel() {
    const overlay = document.getElementById('filters-overlay');
    if (!overlay) return;
    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
}
function closeFiltersPanel() {
    const overlay = document.getElementById('filters-overlay');
    if (!overlay) return;
    overlay.classList.remove('open');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
}
document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeFiltersPanel(); });

// "Ver resultados" — the 0-match state (see updateFiltersButtonBadge()
// below) makes this aria-disabled rather than removing it or disabling it
// natively, specifically so it stays reachable and announced by a screen
// reader instead of just vanishing; that means the click can still fire, so
// this is what actually turns the tap into a no-op in that state. "Borrar
// todo" (clearAllFilters(), unaffected by any of this) stays the only way
// out of a 0-match selection.
function applyFiltersPanel() {
    const btn = document.getElementById('filters-apply-btn');
    if (btn && btn.getAttribute('aria-disabled') === 'true') return;
    closeFiltersPanel();
}

// Reflects the existing activeTags/activeType/activeAllergens filter state
// (set by the handlers below) onto the filters button label (its translated
// base text lives in data-i18n-cta, set server-side in standard/show.html.twig) —
// display only, the filtering itself is untouched. Also drives the live
// "Ver resultados (N)" count and its 0-match state — see countMatchingDishes()
// just below applyFilters(), which this reuses rather than recomputing.
function updateFiltersButtonBadge() {
    const label = document.getElementById('filters-btn-label');
    const btn   = document.getElementById('filters-btn');
    const clearRow = document.getElementById('filters-clear-row');
    const applyBtn = document.getElementById('filters-apply-btn');
    if (label && btn) {
        const filterCount = activeTags.size + (activeType !== 'all' ? 1 : 0) + activeAllergens.size;
        const baseLabel = label.dataset.i18nCta || label.textContent;
        label.textContent = filterCount > 0 ? (baseLabel + ' (' + filterCount + ')') : baseLabel;
        btn.classList.toggle('has-active', filterCount > 0);
        if (clearRow) clearRow.hidden = filterCount === 0;

        if (applyBtn) {
            if (filterCount === 0) {
                // No filters active — the plain label, dish count doesn't
                // add anything (see the task's own "el total no aporta").
                applyBtn.textContent = applyBtn.dataset.i18nApply;
                applyBtn.setAttribute('aria-disabled', 'false');
            } else {
                const dishCount = countMatchingDishes();
                if (dishCount === 0) {
                    applyBtn.textContent = applyBtn.dataset.i18nEmpty;
                    applyBtn.setAttribute('aria-disabled', 'true');
                } else {
                    applyBtn.textContent = applyBtn.dataset.i18nApply + ' (' + dishCount + ')';
                    applyBtn.setAttribute('aria-disabled', 'false');
                }
            }
        }
    }
}

// Resets diet/type/allergen filters together by driving each control's own
// existing "Todo" button / clear function — reuses their handlers rather
// than duplicating the reset logic.
function clearAllFilters() {
    document.querySelector('[data-filter="diet"][data-tag="all"]')?.click();
    document.querySelector('[data-filter="type"][data-type="all"]')?.click();
    clearAllergenFilters();
}

const searchInput = document.getElementById('menu-search');
const noResults   = document.getElementById('no-results');
const sections    = document.querySelectorAll('.cat-section');
const catTabs     = document.querySelectorAll('.cat-tab');
// Selected by data-filter, not by the visual .diet-filter class — that
// class (and .chip/.allergen-filter-option) is style-only now. The
// allergen chip buttons reuse .diet-filter purely for its look but carry
// data-filter="allergen" instead of "diet", so they're driven by
// activeAllergens/onAllergenFilterChange() below and never double-handled
// here even though they'd otherwise match a plain .diet-filter selector.
const dietFilters = document.querySelectorAll('[data-filter="diet"]');
// Multi-select: every checked diet/other tag chip must match (AND,
// not OR) — these are restrictions (allergies/diets), not preferences, so
// combining them any looser than an intersection would be a food-safety
// problem, not just a UX one. The hidden data-tag="all" button (see
// standard/show.html.twig's "Todo" comment) is not a member of this set —
// clicking it clears the whole selection.
let activeTags = new Set();

// Food/drink category filter — a whole .cat-section is shown or hidden by
// its own data-type ("food"/"drink"/"" for unclassified); unlike the diet
// tag and allergen filters below, this never hides individual rows, only
// entire sections (a category is either all-in or all-out). A section with
// no data-type (unclassified) always matches, in either mode — see
// CategoryType's docblock for why null is never treated as "hidden".
const typeFilters = document.querySelectorAll('[data-filter="type"]');
let activeType = 'all';

// Allergens a customer wants to avoid — multi-select, unlike the single-select
// diet filter above, since someone can have more than one allergy. A dish is
// hidden if it carries ANY selected allergen (data-allergens is "code:presence
// code:presence …", already on every card — see MenuController::$menuAllergens
// for where the checklist itself comes from).
let activeAllergens = new Set();

// Shared predicates — applyFilters() (below) and countMatchingDishes() (for
// the live "Ver resultados (N)" count) both call these, so the number shown
// before applying can never drift from what applying actually reveals. Pure
// functions: no DOM mutation, so countMatchingDishes() can run at any time
// without disturbing whatever applyFilters() last rendered.
function sectionMatchesActiveScope(sec, cat) {
    const catMatch  = cat === 'all' || cat === sec.dataset.section;
    const typeMatch = activeType === 'all' || !sec.dataset.type || sec.dataset.type === activeType;
    return catMatch && typeMatch;
}
function rowMatchesActiveFilters(row, q) {
    const name      = row.querySelector('.front-name, .product-name')?.textContent.toLowerCase() ?? '';
    const tags      = (row.dataset.tags ?? '').trim().split(/\s+/).filter(Boolean);
    // "free_from" entries ("Sin gluten") are on the card too, but a dish
    // marked free of an allergen must not be hidden by avoiding it.
    const allergens = (row.dataset.allergens ?? '').trim().split(/\s+/).filter(a => a && !a.endsWith(':free_from')).map(a => a.split(':')[0]);
    const search        = !q || name.includes(q);
    const tagMatch       = activeTags.size === 0 || [...activeTags].every(t => tags.includes(t));
    const allergenMatch  = activeAllergens.size === 0 || ![...activeAllergens].some(a => allergens.includes(a));
    return search && tagMatch && allergenMatch;
}
// The category filter is the tab the customer PICKED (clicked), not the
// highlighted one: .active also follows the scroll (syncTabToScroll() below),
// and scrolling down to Carpaccios must not limit a later search for "pulpo"
// to Carpaccios. Picking "Todo" or typing a search clears it.
let pickedCat = 'all';
function currentCategory() {
    return pickedCat;
}

function applyFilters() {
    const q   = searchInput.value.toLowerCase().trim();
    const cat = currentCategory();
    let anyVisible = false;

    sections.forEach(sec => {
        if (!sectionMatchesActiveScope(sec, cat)) { sec.style.display = 'none'; return; }
        const rows = sec.querySelectorAll('.card-wrap, .product-row, .dish-card');
        let secVisible = false;
        rows.forEach(row => {
            const show = rowMatchesActiveFilters(row, q);
            row.style.display = show ? '' : 'none';
            if (show) secVisible = true;
        });
        sec.style.display = secVisible ? '' : 'none';
        if (secVisible) anyVisible = true;
    });
    if (noResults) noResults.style.display = anyVisible ? 'none' : 'block';
}

// How many dishes would be visible if "Ver resultados" were applied right
// now — same scope/predicate as applyFilters() above, just counting instead
// of touching style.display. Drives the filters panel's live "(N)" only;
// never called from applyFilters() itself and has no side effect on it.
function countMatchingDishes() {
    const q   = searchInput.value.toLowerCase().trim();
    const cat = currentCategory();
    let count = 0;
    sections.forEach(sec => {
        if (!sectionMatchesActiveScope(sec, cat)) return;
        sec.querySelectorAll('.card-wrap, .product-row, .dish-card').forEach(row => {
            if (rowMatchesActiveFilters(row, q)) count++;
        });
    });
    return count;
}

function onAllergenFilterChange() {
    // The allergen chip buttons (.active/data-allergen — see the filters
    // panel in standard/show.html.twig) feed the activeAllergens set.
    activeAllergens = new Set(Array.from(document.querySelectorAll('[data-filter="allergen"].active[data-allergen]')).map(el => el.dataset.allergen));
    applyFilters();
    updateFiltersButtonBadge();
}

function clearAllergenFilters() {
    document.querySelectorAll('[data-filter="allergen"].active[data-allergen]').forEach(el => {
        el.classList.remove('active');
        el.setAttribute('aria-pressed', 'false');
    });
    onAllergenFilterChange();
}

// Allergen filter chip buttons (see standard/show.html.twig): toggle the
// activeAllergens set that applyFilters() reads.
document.querySelectorAll('[data-filter="allergen"][data-allergen]').forEach(btn => {
    btn.addEventListener('click', () => {
        const nowActive = !btn.classList.contains('active');
        btn.classList.toggle('active', nowActive);
        btn.setAttribute('aria-pressed', String(nowActive));
        onAllergenFilterChange();
    });
});

// Cross-contamination / exception notes on allergen chips — click-to-open,
// closes on outside click or Escape. Same interaction as the "?" help icons
// in the Admin Panel, kept intentionally simple: no hover-only behavior, so
// it works identically on touch and desktop.
function toggleAllergenNote(event, btnEl) {
    event.stopPropagation();
    const wasOpen = btnEl.classList.contains('note-open');
    closeAllergenNotes();
    if (wasOpen) return;

    const pop = document.createElement('div');
    pop.className = 'alg-note-popover';
    pop.textContent = btnEl.dataset.note;
    document.body.appendChild(pop);

    const rect = btnEl.getBoundingClientRect();
    const popRect = pop.getBoundingClientRect();
    let left = rect.left + rect.width / 2 - popRect.width / 2;
    left = Math.max(8, Math.min(left, window.innerWidth - popRect.width - 8));
    let top = rect.bottom + 8;
    if (top + popRect.height > window.innerHeight - 8) top = rect.top - popRect.height - 8;

    pop.style.left = left + 'px';
    pop.style.top = top + 'px';
    btnEl.classList.add('note-open');
}
function closeAllergenNotes() {
    document.querySelectorAll('.alg-note-popover').forEach(p => p.remove());
    document.querySelectorAll('.alg-note-btn.note-open').forEach(el => el.classList.remove('note-open'));
}
document.addEventListener('click', closeAllergenNotes);
document.addEventListener('keydown', e => {
    if (e.key !== 'Escape') return;
    closeAllergenNotes();
});

// Also refreshes the filters panel's live count: if it's open (or gets
// reopened) while a search term is active, "Ver resultados (N)" must
// already reflect it — same reasoning as the task's own "N refleja ambos".
// Searching drops the picked category (see pickedCat) and re-syncs the
// highlight: back to "Todo", then onto whichever visible section is under the
// tab bar — never left on a category the results just hid.
searchInput?.addEventListener('input', () => {
    pickedCat = 'all';
    applyFilters();
    updateFiltersButtonBadge();
    const all = [...catTabs].find(t => t.dataset.cat === 'all');
    if (all) setActiveTab(all);
    syncTabToScroll();
});

// .cat-tab is an <a href="#cat-{id}"> (accessibility pass, 2026-09-07) so
// Tab+Enter and screen readers get a real, focusable, named control with a
// working no-JS fallback (plain anchor jump, nothing hidden) — see the
// comment on the "Todo" tab's markup in show.html.twig. With JS, this
// handler always takes over instead: it preventDefault()s unconditionally
// because JS already decides the resulting behavior either way (a smooth
// scrollIntoView for a real category, or deliberately no scroll at all for
// "Todo" — letting the native jump through for "Todo" would scroll to
// #cat-tabs itself, a jump this control never made before).
function setActiveTab(tab) {
    catTabs.forEach(t => {
        const isActive = t === tab;
        t.classList.toggle('active', isActive);
        t.setAttribute('aria-current', isActive ? 'true' : 'false');
    });
}
catTabs.forEach(tab => tab.addEventListener('click', e => {
    e.preventDefault();
    setActiveTab(tab);
    pickedCat = tab.dataset.cat;
    applyFilters();
    const cat = tab.dataset.cat;
    if (cat !== 'all') document.getElementById(cat)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
}));

dietFilters.forEach(btn => btn.addEventListener('click', () => {
    if (btn.dataset.tag === 'all') {
        // "Todo" — the reset action, not a selectable chip: clears every
        // active diet/other tag rather than toggling itself.
        activeTags.clear();
        dietFilters.forEach(x => { x.classList.remove('active'); x.setAttribute('aria-pressed', 'false'); });
    } else {
        const nowActive = !btn.classList.contains('active');
        btn.classList.toggle('active', nowActive);
        btn.setAttribute('aria-pressed', String(nowActive));
        if (nowActive) activeTags.add(btn.dataset.tag); else activeTags.delete(btn.dataset.tag);
    }
    // Keeps the hidden data-tag="all" button's own active state in sync
    // (it's the reset target for clearAllFilters(), not a visible chip on
    // this layout) — same "no filter" indicator the old radio behavior
    // gave it, without making it part of the multi-select set itself.
    document.querySelectorAll('[data-filter="diet"][data-tag="all"]').forEach(all => {
        all.classList.toggle('active', activeTags.size === 0);
        all.setAttribute('aria-pressed', String(activeTags.size === 0));
    });
    applyFilters();
    updateFiltersButtonBadge();
}));

typeFilters.forEach(btn => btn.addEventListener('click', () => {
    typeFilters.forEach(x => { x.classList.remove('active'); x.setAttribute('aria-pressed', 'false'); });
    btn.classList.add('active');
    btn.setAttribute('aria-pressed', 'true');
    activeType = btn.dataset.type;
    applyFilters();
    updateFiltersButtonBadge();
}));

// Scroll-spy: the active tab is the section being read — the last visible
// one whose top has passed under the (sticky) tab bar. It used to be an
// IntersectionObserver at threshold 0.3 that picked whichever section
// crossed 30% first, often the next one coming in from below ("Pasta"
// active with Carpaccios on screen), and never caught a section leaving.
// Same limits as before: it only ever moves between categories (never back
// to "Todo") and skips sections hidden by a filter. Visual only: the
// category filter is pickedCat (set by clicks), never this highlight.
let spyQueued = false;
function syncTabToScroll() {
    spyQueued = false;
    // Whatever sticks at the top: the tab bar, or the header above it.
    const line = Math.max(0, ...[...document.querySelectorAll('.header, .cat-tabs')]
        .map(el => el.getBoundingClientRect().bottom)) + 1;
    let current = null;
    sections.forEach(s => {
        if (s.offsetParent !== null && s.getBoundingClientRect().top <= line) current = s;
    });
    if (!current) return;
    const match = [...catTabs].find(t => t.dataset.cat === current.dataset.section);
    if (match && !match.classList.contains('active')) setActiveTab(match);
}
window.addEventListener('scroll', () => {
    if (!spyQueued) { spyQueued = true; requestAnimationFrame(syncTabToScroll); }
}, { passive: true });

// Scroll indicators for card backs — bidirectional, no flash
(function() {
    document.querySelectorAll('.card-wrap').forEach(wrap => {
        let initialized = false;
        wrap.addEventListener('click', function() {
            if (initialized) return;
            setTimeout(function() {
                const body = wrap.querySelector('.back-body');
                if (!body) return;
                const scroll = body.closest('.back-scroll');
                if (!scroll) return;
                const horiz = scroll.classList.contains('horiz');

                function check() {
                    if (horiz) {
                        // Math.abs: on a right-to-left page scrollLeft runs
                        // from 0 (start) down to negative values.
                        const canScroll = body.scrollWidth > body.clientWidth + 4;
                        const scrolled = Math.abs(body.scrollLeft);
                        const atStart = scrolled < 4;
                        const atEnd   = scrolled + body.clientWidth >= body.scrollWidth - 4;
                        scroll.classList.toggle('can-end',   canScroll && !atEnd);
                        scroll.classList.toggle('can-start', canScroll && !atStart);
                    } else {
                        const canScroll = body.scrollHeight > body.clientHeight + 4;
                        const atTop    = body.scrollTop < 4;
                        const atBottom = body.scrollTop + body.clientHeight >= body.scrollHeight - 4;
                        scroll.classList.toggle('can-dn', canScroll && !atBottom);
                        scroll.classList.toggle('can-up', canScroll && !atTop);
                    }
                }

                body.addEventListener('scroll', check, { passive: true });
                check();
                initialized = true;
            }, 560);
        });
    });

    // All scroll-cue clicks handled in capture phase to prevent card from unflipping.
    // -h scrolls toward the end, -l toward the start: negative scrollLeft
    // is "forward" on a right-to-left page.
    const fwd = getComputedStyle(document.body).direction === 'rtl' ? -1 : 1;
    document.addEventListener('click', function(e) {
        if (e.target.closest('.scroll-cue-dn')) {
            e.stopPropagation();
            e.target.closest('.back-scroll')?.querySelector('.back-body')?.scrollBy({ top: 120, behavior: 'smooth' });
            return;
        }
        if (e.target.closest('.scroll-cue-up')) {
            e.stopPropagation();
            e.target.closest('.back-scroll')?.querySelector('.back-body')?.scrollBy({ top: -120, behavior: 'smooth' });
            return;
        }
        if (e.target.closest('.scroll-cue-h')) {
            e.stopPropagation();
            e.target.closest('.back-scroll')?.querySelector('.back-body')?.scrollBy({ left: 180 * fwd, behavior: 'smooth' });
            return;
        }
        if (e.target.closest('.scroll-cue-l')) {
            e.stopPropagation();
            e.target.closest('.back-scroll')?.querySelector('.back-body')?.scrollBy({ left: -180 * fwd, behavior: 'smooth' });
        }
    }, true);
})();

// Lightbox — global functions called via inline onclick attributes
function lbOpen(src) {
    var overlay = document.getElementById('lb-overlay');
    var img = document.getElementById('lb-img');
    if (!overlay || !img || !src) return;
    img.src = src;
    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
}
function lbClose() {
    var overlay = document.getElementById('lb-overlay');
    if (!overlay) return;
    overlay.classList.remove('open');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
}
document.addEventListener('keydown', function(e) { if (e.key === 'Escape') lbClose(); });

// Chef's-recommendation carousel (2+ 'recommended'-tagged dishes —
// see show.html.twig's recommendedItems/.banner-multi). No-op everywhere
// else since getElementById returns null. No auto-play, no wraparound:
// bannerGoTo() clamps to [0, slides.length-1], same as the disabled state
// on the prev/next buttons at either end. Right-to-left menus: the flex
// track lays slides out right to left, so the track slides the other way,
// and "next" is ArrowLeft / a left-to-right swipe (fwd = -1); prev/next
// order and the dots already follow the page direction via flexbox.
(function () {
    var track = document.getElementById('banner-track');
    var carousel = document.getElementById('banner-carousel');
    if (!track || !carousel) return;
    var slides   = Array.prototype.slice.call(track.querySelectorAll('.banner-slide'));
    var dots     = Array.prototype.slice.call(document.querySelectorAll('#banner-dots .banner-dot'));
    var announce = document.getElementById('banner-announce');
    var prevBtn  = carousel.querySelector('.banner-prev');
    var nextBtn  = carousel.querySelector('.banner-next');
    var index    = 0;
    var fwd      = getComputedStyle(carousel).direction === 'rtl' ? -1 : 1;

    function render() {
        track.style.transform = 'translateX(' + (fwd === 1 ? '-' : '') + (index * 100) + '%)';
        slides.forEach(function (slide, i) {
            var active = i === index;
            slide.classList.toggle('active', active);
            slide.setAttribute('aria-hidden', active ? 'false' : 'true');
            slide.setAttribute('tabindex', active ? '0' : '-1');
        });
        dots.forEach(function (dot, i) {
            var active = i === index;
            dot.classList.toggle('active', active);
            dot.setAttribute('aria-current', active ? 'true' : 'false');
        });
        if (prevBtn) prevBtn.disabled = index === 0;
        if (nextBtn) nextBtn.disabled = index === slides.length - 1;
        if (announce) {
            var head = slides[index].querySelector('.bhead');
            announce.textContent = head ? head.textContent : '';
        }
    }

    window.bannerGoTo = function (i) {
        index = Math.max(0, Math.min(slides.length - 1, i));
        render();
    };
    window.bannerNav = function (delta) { window.bannerGoTo(index + delta); };

    carousel.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowLeft')  { e.preventDefault(); window.bannerNav(-fwd); }
        if (e.key === 'ArrowRight') { e.preventDefault(); window.bannerNav(fwd); }
    });

    // Swipe — a mostly-horizontal drag past a small threshold pages the
    // carousel; a mostly-vertical one is left alone so page scroll still works.
    var touchStartX = null, touchStartY = null;
    track.addEventListener('touchstart', function (e) {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
    }, { passive: true });
    track.addEventListener('touchend', function (e) {
        if (touchStartX === null) return;
        var dx = e.changedTouches[0].clientX - touchStartX;
        var dy = e.changedTouches[0].clientY - touchStartY;
        touchStartX = touchStartY = null;
        if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy)) return;
        window.bannerNav(dx < 0 ? fwd : -fwd);
    });

    render();
})();
</script>
