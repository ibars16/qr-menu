{# Smart Waiter — floating chat widget. Included once from menu/show.html.twig
   (not per-layout) since everything it needs — --accent, --surface, --cb-bg,
   --bdiv, --btt, --bn, --in-bg/--in-border/--in-text/--in-ph — is already a
   global :root custom property from menu/themes/{theme}/vars.html.twig,
   regardless of which of the 3 layouts is active. #}

{# Widget text lives in translations/menu_public.*.yaml under the chat.*
   keys (same domain/coverage as the rest of the public menu chrome — ~20 of
   the 60 supported locales have it, the rest fall back to English exactly
   like loading.title does), never hardcoded here or AI-generated per
   request: it's fixed UI copy, not menu content, so there's no reason to
   spend a model call on it and no room for it to drift off-message. #}
{% set swStrings = {
    bubble: 'chat.bubble'|trans({}, 'menu_public', locale),
    title: 'chat.title'|trans({}, 'menu_public', locale),
    greeting: 'chat.greeting'|trans({}, 'menu_public', locale),
    placeholder: 'chat.placeholder'|trans({}, 'menu_public', locale),
    send: 'chat.send'|trans({}, 'menu_public', locale),
    close: 'common.close'|trans({}, 'menu_public', locale),
    disclaimer: 'chat.disclaimer'|trans({}, 'menu_public', locale),
    errorFallback: 'chat.error_fallback'|trans({}, 'menu_public', locale),
    dailyLimit: 'chat.daily_limit'|trans({}, 'menu_public', locale),
} %}

<style>
    /* The chat is fixed to the viewport, so its side is set physically and
       mirrored explicitly for right-to-left menus (bubble and desktop panel
       bottom-left), rather than with inset-inline-*: the full-screen mobile
       panel below then has exactly the same left/right in every direction. */
    .sw-widget { position: fixed; right: 18px; bottom: 18px; z-index: 2000; }
    [dir="rtl"] .sw-widget { right: auto; left: 18px; }

    .sw-bubble {
        width: 56px; height: 56px; border-radius: 50%; border: none; cursor: pointer;
        background: var(--accent); color: var(--on-accent, #fff); font-size: 24px;
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 6px 20px rgba(0,0,0,0.35);
        transition: transform 0.15s ease;
    }
    .sw-bubble:hover { transform: scale(1.06); }
    .sw-bubble.has-badge::after {
        content: ''; position: absolute; top: 2px; right: 2px; width: 12px; height: 12px;
        border-radius: 50%; background: var(--accent); border: 2px solid var(--bg, #111);
        animation: sw-pulse 2s ease-in-out infinite;
    }
    @keyframes sw-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
    [dir="rtl"] .sw-bubble.has-badge::after { right: auto; left: 2px; }
    @media (prefers-reduced-motion: reduce) { .sw-bubble.has-badge::after { animation: none; } }

    .sw-panel {
        position: fixed; right: 18px; bottom: 86px; width: 360px; max-width: calc(100vw - 36px);
        height: 520px; max-height: calc(100vh - 120px);
        background: var(--cb-bg, var(--surface)); border: 1px solid var(--bdiv, var(--b1));
        border-radius: var(--card-radius, 16px); box-shadow: 0 12px 40px rgba(0,0,0,0.45);
        display: flex; flex-direction: column; overflow: hidden;
    }
    [dir="rtl"] .sw-panel { right: auto; left: 18px; }
    .sw-panel[hidden] { display: none; }

    .sw-header {
        display: flex; align-items: center; justify-content: space-between; gap: 8px;
        padding: 14px 16px; border-bottom: 1px solid var(--bdiv, var(--b1)); flex-shrink: 0;
        background: var(--hdr-bg, transparent);
    }
    .sw-header-title { font-size: 14px; font-weight: 700; color: var(--bn, var(--fg)); }
    .sw-close {
        background: none; border: none; cursor: pointer; color: var(--btt, var(--fg-2));
        font-size: 16px; line-height: 1; padding: 4px;
    }
    .sw-close:hover { color: var(--bn, var(--fg)); }

    .sw-messages { flex: 1; overflow-y: auto; padding: 14px 16px; display: flex; flex-direction: column; gap: 10px; }
    .sw-msg { max-width: 84%; padding: 9px 12px; border-radius: 14px; font-size: 13.5px; line-height: 1.5; white-space: pre-wrap; }
    .sw-msg.assistant { align-self: flex-start; background: var(--surface-2, rgba(127,127,127,0.1)); color: var(--bn, var(--fg)); border-end-start-radius: 4px; }
    .sw-msg.user { align-self: flex-end; background: var(--accent); color: var(--on-accent, #fff); border-end-end-radius: 4px; }

    /* Dish cards under a reply (SmartWaiterDishRefs → dishIds), built from
       the page's own .dish-card. Tokens measured AA on all six themes:
       --bn on --surface 11.6–17:1, --cp (the menu's price color) on
       --surface 5.5–9.7:1 (classic-dark lowest) — also the arrow's color
       (--fg-2 is under 4.5:1 on glass and noir). One under another, as wide
       as a reply bubble (.sw-msg's 84%); logical properties, so
       right-to-left menus mirror on their own (the arrow too, below). */
    .sw-cards { align-self: flex-start; display: flex; flex-direction: column; gap: 8px; width: 84%; margin-top: -2px; }
    .sw-card {
        width: 100%; min-width: 0; display: flex; flex-direction: column;
        padding: 0; border: 1px solid var(--bdiv, var(--b1)); border-radius: 12px; overflow: hidden;
        background: var(--surface); color: var(--bn, var(--fg)); font: inherit; text-align: start; cursor: pointer;
        transition: transform 0.15s ease, border-color 0.15s ease;
    }
    .sw-card:hover { transform: translateY(-1px); border-color: var(--b2, var(--b1)); }
    .sw-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    @media (prefers-reduced-motion: reduce) { .sw-card { transition: none; } .sw-card:hover { transform: none; } }
    /* Photo on top, full width, cropped (never stretched). */
    .sw-card-img { display: block; width: 100%; height: 140px; object-fit: cover; background: var(--surface-2, transparent); }
    /* Name (up to two lines) | price and arrow, at the end of the line. */
    .sw-card-text { display: flex; align-items: center; gap: 10px; padding: 9px 12px 10px; }
    .sw-card-name {
        flex: 1; min-width: 0;
        font-size: 13.5px; font-weight: 600; line-height: 1.3; color: var(--bn, var(--fg));
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: break-word;
    }
    .sw-card-end { flex-shrink: 0; display: flex; align-items: center; gap: 6px; color: var(--cp, var(--accent)); }
    .sw-card-price { font-size: 13.5px; font-weight: 700; line-height: 1.3; white-space: nowrap; color: inherit; }
    /* "›" is a bidi-mirrored character: right-to-left it already shows as "‹". */
    .sw-card-arrow { font-size: 20px; line-height: 1; font-weight: 400; }
    .sw-card-price .price-from { font-weight: 600; }
    /* The menu's .price-currency is 10px --fg-2: here it follows the price. */
    .sw-card-price .price-currency { margin-inline-start: 2px; font-size: 11px; color: inherit; font-weight: 600; }

    /* A dish sheet opened from a card sits above the chat (z-index 2000);
       closing it leaves the chat exactly as it was (_search_js.html.twig). */
    .dish-modal-overlay.over-chat { z-index: 2100; }

    .sw-typing { align-self: flex-start; display: flex; gap: 4px; padding: 9px 12px; }
    .sw-typing[hidden] { display: none; }
    .sw-typing span {
        width: 6px; height: 6px; border-radius: 50%; background: var(--btt, var(--fg-2));
        animation: sw-bounce 1.2s ease-in-out infinite;
    }
    .sw-typing span:nth-child(2) { animation-delay: 0.15s; }
    .sw-typing span:nth-child(3) { animation-delay: 0.3s; }
    @keyframes sw-bounce { 0%, 60%, 100% { transform: translateY(0); opacity: 0.5; } 30% { transform: translateY(-4px); opacity: 1; } }
    @media (prefers-reduced-motion: reduce) { .sw-typing span { animation: none; } }

    .sw-form { display: flex; gap: 8px; padding: 12px; border-top: 1px solid var(--bdiv, var(--b1)); flex-shrink: 0; }
    .sw-input {
        flex: 1; min-width: 0; background: var(--in-bg, transparent); border: 1px solid var(--in-border, var(--b1));
        color: var(--in-text, var(--fg)); border-radius: 999px; padding: 9px 14px; font-size: 13.5px; outline: none;
    }
    .sw-input::placeholder { color: var(--in-ph, var(--fg-2)); }
    .sw-input:focus { border-color: var(--in-focus-border, var(--accent)); }
    .sw-send {
        width: 38px; height: 38px; border-radius: 50%; border: none; background: var(--accent); color: var(--on-accent, #fff);
        cursor: pointer; flex-shrink: 0; font-size: 15px; display: flex; align-items: center; justify-content: center;
    }
    .sw-send:disabled { opacity: 0.5; cursor: default; }
    /* The paper plane points along the reading direction. */
    [dir="rtl"] .sw-send i { display: inline-block; transform: scaleX(-1); }

    /* --ft-muted where a theme's --fg-2 misses AA on this panel (glass,
       noir), same convention as the footer's muted text; --btt (the old
       color) measured 1.5–2.4:1 on every theme. */
    .sw-disclaimer { padding: 0 16px 12px; font-size: 10.5px; color: var(--ft-muted, var(--fg-2)); line-height: 1.4; flex-shrink: 0; overflow-wrap: anywhere; }

    @media (max-width: 480px) {
        .sw-panel, [dir="rtl"] .sw-panel {
            right: 10px; left: 10px; bottom: 10px; width: auto; max-width: none;
            height: auto; top: 10px; max-height: none;
        }
    }
</style>

<div class="sw-widget" id="sw-widget" data-slug="{{ restaurant.slug }}" data-locale="{{ locale }}">
    <button type="button" class="sw-bubble has-badge" id="sw-bubble" aria-label="{{ swStrings.bubble }}" aria-expanded="false" onclick="swToggle()">💬</button>

    <div class="sw-panel" id="sw-panel" hidden>
        <div class="sw-header">
            <span class="sw-header-title">{{ swStrings.title }}</span>
            <button type="button" class="sw-close" aria-label="{{ swStrings.close }}" onclick="swToggle()">
                <i class="ti ti-x" aria-hidden="true"></i>
            </button>
        </div>
        <div class="sw-messages" id="sw-messages"></div>
        <div class="sw-typing" id="sw-typing" hidden><span></span><span></span><span></span></div>
        <form class="sw-form" id="sw-form" onsubmit="swSend(event)">
            <input type="text" class="sw-input" id="sw-input" placeholder="{{ swStrings.placeholder }}" maxlength="800" autocomplete="off">
            <button type="submit" class="sw-send" id="sw-send-btn" aria-label="{{ swStrings.send }}">
                <i class="ti ti-send-2" aria-hidden="true"></i>
            </button>
        </form>
        <div class="sw-disclaimer">{{ swStrings.disclaimer }}</div>
    </div>
</div>

<script>
(function () {
    const SW_STRINGS = {{ swStrings|json_encode|raw }};
    const widget = document.getElementById('sw-widget');
    const slug = widget.dataset.slug;
    const locale = widget.dataset.locale;

    const bubble = document.getElementById('sw-bubble');
    const panel = document.getElementById('sw-panel');
    const messagesEl = document.getElementById('sw-messages');
    const typingEl = document.getElementById('sw-typing');
    const input = document.getElementById('sw-input');
    const sendBtn = document.getElementById('sw-send-btn');

    let opened = false;
    let sending = false;

    function getConversationId() {
        return sessionStorage.getItem('sw_conv_' + slug);
    }
    function setConversationId(id) {
        sessionStorage.setItem('sw_conv_' + slug, id);
    }

    // Down to the end: the customer's own question, the greeting. A reply
    // is placed by showReplyStart() instead.
    function appendMessage(role, text, stay) {
        const div = document.createElement('div');
        div.className = 'sw-msg ' + role;
        div.textContent = text;
        messagesEl.appendChild(div);
        if (!stay) messagesEl.scrollTop = messagesEl.scrollHeight;
        return div;
    }

    // A reply (and its cards) shows from its START, with the question just
    // above it when there is room: the customer reads down, never back up.
    // A reply that fits whole ends up at the bottom, exactly as before.
    // Card photos have a fixed height (.sw-card-img), so a late one never
    // moves this. Vertical only: the same right-to-left.
    function showReplyStart(questionEl, replyEl) {
        const pad = parseFloat(getComputedStyle(messagesEl).paddingTop) || 0;
        const boxTop = messagesEl.getBoundingClientRect().top;
        const topOf = el => el.getBoundingClientRect().top - boxTop + messagesEl.scrollTop;
        let target = (questionEl ? topOf(questionEl) : topOf(replyEl)) - pad;
        // A question so long that the reply's first lines wouldn't show: start at the reply.
        if (topOf(replyEl) + 72 > target + messagesEl.clientHeight) target = topOf(replyEl) - pad;
        const max = messagesEl.scrollHeight - messagesEl.clientHeight;
        messagesEl.scrollTop = Math.max(0, Math.min(target, max));
    }

    // Up to 3 cards (the server already checked each id: this restaurant's,
    // visible, "suitable" when the customer has needs). Each is built from
    // the page's own .dish-card — its name, its photo (a clip's poster, never
    // the clip), its one-line price — and opens that card's detail sheet.
    // An id with no card on the page (e.g. a set menu's dish) is skipped.
    function appendDishCards(ids) {
        const row = document.createElement('div');
        row.className = 'sw-cards';
        (Array.isArray(ids) ? ids : []).slice(0, 3).forEach(id => {
            if (!Number.isInteger(id)) return;
            const dishCard = document.querySelector('.dish-card[data-product-id="' + id + '"]');
            if (!dishCard || !dishCard.querySelector('.dish-tpl')) return;

            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'sw-card';
            const label = dishCard.getAttribute('aria-label');
            if (label) btn.setAttribute('aria-label', label);

            const photo = dishCard.querySelector('.front-img img');
            const clip = dishCard.querySelector('.front-img video');
            const src = photo ? photo.getAttribute('src') : (clip ? clip.getAttribute('poster') : null);
            if (src) {
                const img = document.createElement('img');
                img.className = 'sw-card-img';
                img.src = src;
                img.alt = '';
                btn.appendChild(img);
            }

            const text = document.createElement('span');
            text.className = 'sw-card-text';
            const name = document.createElement('span');
            name.className = 'sw-card-name';
            name.textContent = (dishCard.querySelector('.front-name')?.textContent || '').trim();
            text.appendChild(name);
            // Price and arrow at the end of the line (the arrow alone if no price).
            const end = document.createElement('span');
            end.className = 'sw-card-end';
            const priceTpl = dishCard.querySelector('template.dish-price-one');
            if (priceTpl) {
                const price = document.createElement('span');
                price.className = 'sw-card-price';
                price.appendChild(priceTpl.content.cloneNode(true));
                end.appendChild(price);
            }
            const arrow = document.createElement('span');
            arrow.className = 'sw-card-arrow';
            arrow.setAttribute('aria-hidden', 'true');
            arrow.textContent = '›';
            end.appendChild(arrow);
            text.appendChild(end);
            btn.appendChild(text);

            btn.addEventListener('click', () => {
                window.openDishModal?.(dishCard, { overChat: true, returnFocus: btn });
            });
            row.appendChild(btn);
        });
        if (!row.children.length) return;
        messagesEl.appendChild(row);
    }

    window.swToggle = function () {
        opened = !opened;
        panel.hidden = !opened;
        bubble.setAttribute('aria-expanded', opened ? 'true' : 'false');
        bubble.classList.remove('has-badge');
        if (opened) {
            if (!messagesEl.dataset.greeted) {
                appendMessage('assistant', SW_STRINGS.greeting);
                messagesEl.dataset.greeted = '1';
            }
            input.focus();
        }
    };

    window.swSend = function (e) {
        e.preventDefault();
        if (sending) return;
        const text = input.value.trim();
        if (!text) return;

        const questionEl = appendMessage('user', text);
        input.value = '';
        sending = true;
        sendBtn.disabled = true;
        typingEl.hidden = false;
        messagesEl.scrollTop = messagesEl.scrollHeight;

        fetch('/r/' + encodeURIComponent(slug) + '/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                message: text,
                conversationId: getConversationId(),
                locale: locale,
                // The currency this page shows (?currency= included), so the
                // reply's prices match the cards taken from the page.
                currency: document.body.dataset.menuCurrency || null,
            }),
        })
            .then(res => res.ok ? res.json() : res.json().catch(() => ({})).then(data => {
                // Today's limit reached (SmartWaiterController): its own short sentence.
                if (data.error === 'daily_limit') return data;
                return Promise.reject(new Error('http_' + res.status));
            }))
            .then(data => {
                if (data.conversationId) setConversationId(data.conversationId);
                // Hidden first: it sits under the messages, so it changes their height.
                typingEl.hidden = true;
                let replyEl;
                if (data.error === 'daily_limit') {
                    replyEl = appendMessage('assistant', SW_STRINGS.dailyLimit, true);
                } else if (data.error || !data.reply) {
                    replyEl = appendMessage('assistant', SW_STRINGS.errorFallback, true);
                } else {
                    replyEl = appendMessage('assistant', data.reply, true);
                    appendDishCards(data.dishIds);
                }
                showReplyStart(questionEl, replyEl);
            })
            .catch(() => {
                typingEl.hidden = true;
                showReplyStart(questionEl, appendMessage('assistant', SW_STRINGS.errorFallback, true));
            })
            .finally(() => {
                sending = false;
                sendBtn.disabled = false;
                typingEl.hidden = true;
            });
    };

    // Capture phase, so it runs before the dish sheet's own Escape handler:
    // with a sheet open (e.g. from a card), Escape closes only the sheet.
    document.addEventListener('keydown', e => {
        if (e.key !== 'Escape' || !opened) return;
        if (document.getElementById('dish-modal-overlay')?.classList.contains('open')) return;
        window.swToggle();
    }, true);
})();
</script>
