<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ restaurant.name }}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🍽️</text></svg>">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 20px;
            background: #150d2e;
            color: #fff;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            text-align: center;
            padding: 24px;
        }
        .logo {
            width: 64px;
            height: 64px;
            border-radius: 16px;
            object-fit: cover;
        }
        .name {
            font-size: 18px;
            font-weight: 600;
            opacity: 0.9;
        }
        .spinner {
            width: 36px;
            height: 36px;
            border: 3px solid rgba(255, 255, 255, 0.2);
            border-top-color: #C1440E;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }
        .text {
            font-size: 14px;
            color: #b8aed6;
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>
</head>
<body>
    {% if restaurant.logo %}
        <img class="logo" src="{{ asset('uploads/logos/' ~ restaurant.logo) }}" alt="">
    {% endif %}
    <div class="name">{{ restaurant.name }}</div>
    <div class="spinner"></div>
    <div class="text">{{ loading_text }}</div>

    <script>
        // Fire the real translation work in the background — the spinner
        // above is what covers that wait, not this navigation — then
        // reload into the actual menu, now cached. A hard timeout guards
        // against a network hiccup leaving the visitor stuck here forever;
        // the reload target carries mtw=1 either way so it can only ever
        // detour through this screen once.
        const nextUrl = {{ nextUrl|json_encode|raw }};
        const warmUrl = {{ warmUrl|json_encode|raw }};

        const done = () => { window.location.replace(nextUrl); };
        // Each translator now runs a translate pass plus a verify-and-fix
        // pass (see RouterProductTranslator) — roughly double the AI calls
        // of a single pass, so this needs more headroom than a bare
        // translate call would.
        const timeout = new Promise(resolve => setTimeout(resolve, 25000));

        Promise.race([
            fetch(warmUrl, { method: 'POST' }).catch(() => {}),
            timeout,
        ]).finally(done);
    </script>
</body>
</html>
