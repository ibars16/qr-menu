{% extends 'public/base.html.twig' %}

{% block title %}{{ 'title'|trans({}, 'public_site', locale) }}{% endblock %}

{% block meta %}
    <meta name="description" content="{{ 'meta.description'|trans({}, 'public_site', locale) }}">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ 'meta.og_title'|trans({}, 'public_site', locale) }}">
    <meta property="og:description" content="{{ 'meta.og_description'|trans({}, 'public_site', locale) }}">
{% endblock %}

{% block extra_stylesheets %}
    /* Hero */
    .hero { padding: 72px 24px 72px; border-top: 1px solid var(--bd-1); }
    .hero-inner { max-width: 1080px; margin: 0 auto; display: flex; align-items: center; gap: 48px; }
    .hero-copy { flex: 1; min-width: 0; }
    .hero-badge { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; color: var(--accent-text); background: rgba(193,68,14,0.12); border: 1px solid rgba(193,68,14,0.3); padding: 6px 14px; border-radius: 999px; margin-bottom: 22px; }
    .hero h1 { font-size: 42px; font-weight: 700; color: var(--tx-hi); letter-spacing: -1.1px; line-height: 1.15; margin-bottom: 18px; }
    .hero p { font-size: 16px; color: var(--tx-2); max-width: 480px; margin-bottom: 30px; line-height: 1.55; }
    .hero-ctas { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .hero-note { font-size: 12px; color: var(--tx-4); margin-top: 16px; }

    /* Hero visual — a CSS mockup of the actual public menu UI (standard
       layout), not a fabricated screenshot. Dish cards deliberately reuse
       the real app's own "no photo" treatment (icon + gradient panel, see
       templates/menu/layouts/standard/show.html.twig's .dish-placeholder /
       ti-tools-kitchen-2) rather than inventing fake dish photos. */
    .hero-visual { flex-shrink: 0; position: relative; width: 320px; max-width: 100%; }
    .menu-mockup-frame {
        background: var(--bg-elevated); border: 1px solid var(--bd-2); border-radius: 22px;
        padding: 8px; box-shadow: 0 30px 60px -20px rgba(0,0,0,0.6);
        transform: rotate(1.5deg);
    }
    .menu-mockup { background: var(--bg-card); border-radius: 16px; padding: 16px; overflow: hidden; }

    .mockup-topbar { display: flex; align-items: center; gap: 6px; margin-bottom: 8px; }
    .mockup-pill { display: inline-flex; align-items: center; gap: 3px; font-size: 9px; font-weight: 600; color: var(--tx-2); background: var(--bg-input); border: 1px solid var(--bd-2); padding: 3px 8px; border-radius: 999px; }
    .mockup-pill i { font-size: 8px; }
    .mockup-restaurant { font-size: 14px; font-weight: 700; color: var(--tx-hi); letter-spacing: -0.2px; margin-bottom: 2px; }
    .mockup-tagline { font-size: 10px; color: var(--tx-4); margin-bottom: 12px; }
    .mockup-search { display: flex; align-items: center; gap: 6px; font-size: 10px; color: var(--tx-4); background: var(--bg-input); border: 1px solid var(--bd-2); padding: 8px 12px; border-radius: 999px; margin-bottom: 14px; }
    .mockup-search i { font-size: 12px; }

    .mockup-cat { font-size: 9px; font-weight: 700; color: var(--tx-4); text-transform: uppercase; letter-spacing: 0.08em; margin: 12px 0 7px; }
    .mockup-dish-card { background: var(--bg-subtle); border: 1px solid var(--bd-1); border-radius: 12px; overflow: hidden; margin-bottom: 8px; }
    .mockup-dish-img {
        aspect-ratio: 4 / 3.2; display: flex; align-items: center; justify-content: center;
        background: linear-gradient(150deg, rgba(193,68,14,0.22), rgba(193,68,14,0.08));
    }
    .mockup-dish-img i { font-size: 34px; color: #e8875f; }
    .mockup-dish-info { padding: 8px 10px 10px; }
    .mockup-dish-name { font-size: 10.5px; font-weight: 500; color: var(--tx-1); letter-spacing: -0.1px; margin-bottom: 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .mockup-dish-bottom { display: flex; align-items: center; justify-content: space-between; gap: 6px; }
    .mockup-price { background: var(--brand); color: #fff; font-size: 9.5px; font-weight: 600; padding: 3px 9px; border-radius: 999px; white-space: nowrap; }
    .mockup-more { font-size: 9px; font-weight: 500; color: var(--accent-text); border: 1px solid rgba(232,135,95,0.35); padding: 3px 8px; border-radius: 999px; white-space: nowrap; }

    .hero-qr-badge {
        position: absolute; bottom: -14px; left: -14px;
        width: 44px; height: 44px; border-radius: 12px;
        background: var(--brand); color: #fff;
        display: flex; align-items: center; justify-content: center;
        font-size: 20px; box-shadow: 0 10px 24px -8px rgba(193,68,14,0.6);
        transform: rotate(-4deg);
    }

    /* Section shared */
    .section { padding: 64px 24px; border-top: 1px solid var(--bd-1); }
    .section-head { text-align: center; max-width: 560px; margin: 0 auto 44px; }
    .section-eyebrow { font-size: 11px; font-weight: 600; color: var(--brand); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 10px; }
    .section-head h2 { font-size: 28px; font-weight: 700; color: var(--tx-hi); letter-spacing: -0.6px; margin-bottom: 10px; }
    .section-head p { font-size: 15px; color: var(--tx-3); line-height: 1.5; }

    /* Features */
    .features-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; max-width: 1080px; margin: 0 auto; }
    .feature-card { background: var(--bg-card); border: 1px solid var(--bd-1); border-radius: 14px; padding: 22px; }
    .feature-icon { width: 38px; height: 38px; border-radius: 10px; background: rgba(193,68,14,0.12); color: var(--brand); display: flex; align-items: center; justify-content: center; font-size: 18px; margin-bottom: 14px; }
    .feature-card h3 { font-size: 15px; font-weight: 600; color: var(--tx-hi); margin-bottom: 6px; letter-spacing: -0.2px; }
    .feature-card p { font-size: 13px; color: var(--tx-3); line-height: 1.5; }

    /* Steps */
    .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; max-width: 900px; margin: 0 auto; }
    .step { text-align: center; }
    .step-num { width: 34px; height: 34px; border-radius: 50%; background: var(--bg-card); border: 1px solid var(--bd-2); color: var(--tx-hi); font-size: 14px; font-weight: 700; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; }
    .step h3 { font-size: 15px; font-weight: 600; color: var(--tx-hi); margin-bottom: 6px; }
    .step p { font-size: 13px; color: var(--tx-3); line-height: 1.5; }

    /* Final CTA */
    .cta-band { text-align: center; padding: 72px 24px; border-top: 1px solid var(--bd-1); }
    .cta-band h2 { font-size: 26px; font-weight: 700; color: var(--tx-hi); letter-spacing: -0.5px; margin-bottom: 12px; }
    .cta-band p { font-size: 14px; color: var(--tx-3); margin-bottom: 26px; }

    @media (max-width: 900px) {
        .hero-inner { flex-direction: column; text-align: center; }
        .hero p { max-width: 100%; margin-left: auto; margin-right: auto; }
        .hero-ctas { justify-content: center; }
        .hero-visual { margin-top: 8px; }
    }
    @media (max-width: 767px) {
        .hero { padding: 48px 20px; }
        .hero h1 { font-size: 30px; }
        .hero p { font-size: 15px; }
        .section { padding: 48px 20px; }
        .features-grid { grid-template-columns: 1fr; }
        .steps { grid-template-columns: 1fr; gap: 28px; }
    }
{% endblock %}

{% block content %}
    <section class="hero">
        <div class="hero-inner">
            <div class="hero-copy">
                <div class="hero-badge"><i class="ti ti-sparkles" aria-hidden="true"></i> {{ 'hero.badge'|trans({}, 'public_site', locale) }}</div>
                <h1>{{ 'hero.title'|trans({}, 'public_site', locale) }}</h1>
                <p>{{ 'hero.subtitle'|trans({}, 'public_site', locale) }}</p>
                <div class="hero-ctas">
                    <a href="{{ path('app_register') }}" class="btn-primary">{{ 'hero.cta_primary'|trans({}, 'public_site', locale) }}</a>
                    <a href="#funcionalidades" class="btn-secondary">{{ 'hero.cta_secondary'|trans({}, 'public_site', locale) }}</a>
                </div>
                <div class="hero-note">{{ 'hero.note'|trans({}, 'public_site', locale) }}</div>
            </div>
            <div class="hero-visual">
                <div class="menu-mockup-frame">
                    <div class="menu-mockup">
                        <div class="mockup-topbar">
                            <span class="mockup-pill">{{ locales[locale].flag }} {{ locale|upper }} <i class="ti ti-chevron-down" aria-hidden="true"></i></span>
                            <span class="mockup-pill">€ EUR <i class="ti ti-chevron-down" aria-hidden="true"></i></span>
                        </div>
                        <div class="mockup-restaurant">David Test</div>
                        <div class="mockup-tagline">{{ 'mockup.tagline'|trans({}, 'public_site', locale) }}</div>
                        <div class="mockup-search"><i class="ti ti-search" aria-hidden="true"></i> {{ 'mockup.search_placeholder'|trans({}, 'public_site', locale) }}</div>

                        <div class="mockup-cat">Carpaccios</div>
                        <div class="mockup-dish-card">
                            <div class="mockup-dish-img"><i class="ti ti-tools-kitchen-2" aria-hidden="true"></i></div>
                            <div class="mockup-dish-info">
                                <div class="mockup-dish-name">Carpaccio de chuleta de vaca con parmesano</div>
                                <div class="mockup-dish-bottom">
                                    <span class="mockup-price">19,25 €</span>
                                    <span class="mockup-more">{{ 'mockup.view_more'|trans({}, 'public_site', locale) }}</span>
                                </div>
                            </div>
                        </div>

                        <div class="mockup-cat">Pasta</div>
                        <div class="mockup-dish-card">
                            <div class="mockup-dish-img"><i class="ti ti-tools-kitchen-2" aria-hidden="true"></i></div>
                            <div class="mockup-dish-info">
                                <div class="mockup-dish-name">Canelones Casa Cervelló</div>
                                <div class="mockup-dish-bottom">
                                    <span class="mockup-price">14,00 €</span>
                                    <span class="mockup-more">{{ 'mockup.view_more'|trans({}, 'public_site', locale) }}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="hero-qr-badge"><i class="ti ti-qrcode" aria-hidden="true"></i></div>
            </div>
        </div>
    </section>

    <section class="section" id="funcionalidades">
        <div class="section-head">
            <div class="section-eyebrow">{{ 'features.eyebrow'|trans({}, 'public_site', locale) }}</div>
            <h2>{{ 'features.title'|trans({}, 'public_site', locale) }}</h2>
            <p>{{ 'features.subtitle'|trans({}, 'public_site', locale) }}</p>
        </div>
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon"><i class="ti ti-qrcode" aria-hidden="true"></i></div>
                <h3>{{ 'features.qr.title'|trans({}, 'public_site', locale) }}</h3>
                <p>{{ 'features.qr.desc'|trans({}, 'public_site', locale) }}</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><i class="ti ti-layout-list" aria-hidden="true"></i></div>
                <h3>{{ 'features.admin.title'|trans({}, 'public_site', locale) }}</h3>
                <p>{{ 'features.admin.desc'|trans({}, 'public_site', locale) }}</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><i class="ti ti-message-chatbot" aria-hidden="true"></i></div>
                <h3>{{ 'features.smart_waiter.title'|trans({}, 'public_site', locale) }}</h3>
                <p>{{ 'features.smart_waiter.desc'|trans({}, 'public_site', locale) }}</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><i class="ti ti-chart-bar" aria-hidden="true"></i></div>
                <h3>{{ 'features.stats.title'|trans({}, 'public_site', locale) }}</h3>
                <p>{{ 'features.stats.desc'|trans({}, 'public_site', locale) }}</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><i class="ti ti-language" aria-hidden="true"></i></div>
                <h3>{{ 'features.multilang.title'|trans({}, 'public_site', locale) }}</h3>
                <p>{{ 'features.multilang.desc'|trans({}, 'public_site', locale) }}</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><i class="ti ti-currency-dollar" aria-hidden="true"></i></div>
                <h3>{{ 'features.multicurrency.title'|trans({}, 'public_site', locale) }}</h3>
                <p>{{ 'features.multicurrency.desc'|trans({}, 'public_site', locale) }}</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><i class="ti ti-book-2" aria-hidden="true"></i></div>
                <h3>{{ 'features.fixed_menus.title'|trans({}, 'public_site', locale) }}</h3>
                <p>{{ 'features.fixed_menus.desc'|trans({}, 'public_site', locale) }}</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><i class="ti ti-palette" aria-hidden="true"></i></div>
                <h3>{{ 'features.themes.title'|trans({}, 'public_site', locale) }}</h3>
                <p>{{ 'features.themes.desc'|trans({}, 'public_site', locale) }}</p>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="section-head">
            <div class="section-eyebrow">{{ 'steps.eyebrow'|trans({}, 'public_site', locale) }}</div>
            <h2>{{ 'steps.title'|trans({}, 'public_site', locale) }}</h2>
        </div>
        <div class="steps">
            <div class="step">
                <div class="step-num">1</div>
                <h3>{{ 'steps.step1.title'|trans({}, 'public_site', locale) }}</h3>
                <p>{{ 'steps.step1.desc'|trans({}, 'public_site', locale) }}</p>
            </div>
            <div class="step">
                <div class="step-num">2</div>
                <h3>{{ 'steps.step2.title'|trans({}, 'public_site', locale) }}</h3>
                <p>{{ 'steps.step2.desc'|trans({}, 'public_site', locale) }}</p>
            </div>
            <div class="step">
                <div class="step-num">3</div>
                <h3>{{ 'steps.step3.title'|trans({}, 'public_site', locale) }}</h3>
                <p>{{ 'steps.step3.desc'|trans({}, 'public_site', locale) }}</p>
            </div>
        </div>
    </section>

    <section class="cta-band">
        <h2>{{ 'cta.title'|trans({}, 'public_site', locale) }}</h2>
        <p>{{ 'cta.subtitle'|trans({}, 'public_site', locale) }}</p>
        <a href="{{ path('app_register') }}" class="btn-primary">{{ 'cta.button'|trans({}, 'public_site', locale) }}</a>
    </section>
{% endblock %}
