{% extends 'public/base.html.twig' %}

{% block title %}{{ 'title'|trans({}, 'public_site', locale) }}{% endblock %}

{% block meta %}
    <meta name="description" content="{{ 'meta.description'|trans({}, 'public_site', locale) }}">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ 'meta.og_title'|trans({}, 'public_site', locale) }}">
    <meta property="og:description" content="{{ 'meta.og_description'|trans({}, 'public_site', locale) }}">
{% endblock %}

{% block extra_stylesheets %}
    /* Home in the "Clásico claro" (maison) language of the public menu:
       Fraunces display type, parchment surfaces, wine accent, brass
       hairlines. Colors come from public/base.html.twig's tokens. */

    /* Shared small pieces */
    .eyebrow {
        display: inline-flex; align-items: center; gap: 10px;
        font-size: 11px; font-weight: 600; color: var(--gold-text);
        text-transform: uppercase; letter-spacing: 0.16em;
    }
    .eyebrow::before, .eyebrow::after { content: ''; width: 22px; height: 1px; background: var(--gold); opacity: 0.7; }
    .rule { width: 44px; height: 1px; background: var(--gold); border: 0; }

    /* Hero */
    .hero { position: relative; padding: 96px 24px 104px; background: var(--hero-wash); border-bottom: 1px solid var(--bd-1); overflow: hidden; }
    .hero-inner { position: relative; z-index: 1; max-width: 1120px; margin: 0 auto; display: flex; align-items: center; gap: 72px; }
    .hero-copy { flex: 1; min-width: 0; }
    .hero-badge {
        display: inline-flex; align-items: center; gap: 8px;
        font-size: 12px; font-weight: 500; color: var(--gold-text);
        border: 1px solid rgba(176,137,76,0.45); background: rgba(176,137,76,0.07);
        padding: 7px 15px; border-radius: 999px; margin-bottom: 28px;
    }
    .hero-badge i { font-size: 14px; color: var(--gold); }
    .hero h1 {
        font-family: var(--font-display); font-size: 60px; font-weight: 400; color: var(--tx-hi);
        letter-spacing: -0.012em; line-height: 1.06; margin-bottom: 26px;
        font-variation-settings: 'opsz' 144;
    }
    .hero h1 .accent { font-style: italic; color: var(--accent-text); }
    .hero .rule { margin-bottom: 24px; }
    .hero p { font-size: 17px; color: var(--tx-2); max-width: 500px; margin-bottom: 34px; line-height: 1.7; }
    .hero-ctas { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .hero-note { display: flex; align-items: center; gap: 7px; font-size: 13px; color: var(--tx-3); margin-top: 20px; }
    .hero-note i { color: var(--gold); font-size: 15px; }

    /* Hero visual — a modern phone (thin frame, island, real shadow,
       tilted on desktop) showing a made-up restaurant, "La Brasa", in the
       public menu's "Clásico claro" (maison) look, with real dish photos
       (assets/images/home, from David Test's dishes). The screen follows
       the site theme: maison when light, "Clásico oscuro" when dark. Two floating cards (allergens, AI waiter) on wide screens.
       Fixed size, so it never pushes or reflows the hero text. */
    .hero-visual { flex-shrink: 0; position: relative; width: 340px; max-width: 100%; }
    .hero-visual::before {
        content: ''; position: absolute; inset: 8% -18% -6%; z-index: 0; pointer-events: none;
        background: radial-gradient(ellipse at center, rgba(176,137,76,0.28) 0%, transparent 65%);
        filter: blur(40px);
    }
    .device-stage { position: relative; z-index: 1; width: 300px; max-width: 100%; margin: 0 auto; }
    .device {
        /* Dark site theme (default): the "Clásico oscuro" menu theme
           (menu/themes/classic-dark/vars.html.twig). */
        --m-bg: #080808; --m-surface: #121212; --m-surface-2: #1A1A1A; --m-fg: #F4F4F4; --m-fg-2: #A6A6A6;
        --m-accent: #EE5B1B; --m-on-accent: #140803; --m-brass: #958474; --m-brass-text: #B59C88; --m-line: rgba(244,244,244,0.10);
        --m-hero-bg: radial-gradient(120% 90% at 85% 0%, rgba(238,91,27,0.10), transparent 60%), linear-gradient(180deg, #1A1A1A, #080808);
        --m-card-shadow: 0 1px 2px rgba(0,0,0,0.3), 0 6px 16px -6px rgba(0,0,0,0.5);
        --m-waiter-ring: rgba(18,18,18,0.9);
        --m-waiter-glow: rgba(238,91,27,0.45);
        position: relative; text-align: left;
        padding: 7px; border-radius: 48px;
        background: linear-gradient(145deg, #3A322D 0%, #17120F 45%, #2A231F 100%);
        box-shadow:
            inset 0 0 0 1px rgba(255,255,255,0.10),
            inset 0 0 0 2px rgba(0,0,0,0.55),
            0 2px 4px rgba(36,28,23,0.12),
            0 24px 38px -18px rgba(36,28,23,0.45),
            0 60px 90px -40px rgba(36,28,23,0.55);
    }
    /* Light site theme: the "Clásico claro" (maison) menu theme
       (menu/themes/maison/vars.html.twig). */
    html.light .device {
        --m-bg: #F2EBDF; --m-surface: #FBF8F1; --m-surface-2: #E9DFCD; --m-fg: #241C17; --m-fg-2: #6D5D4E;
        --m-accent: #7A1E28; --m-on-accent: #FFFFFF; --m-brass: #B0894C; --m-brass-text: #805E30; --m-line: rgba(36,28,23,0.10);
        --m-hero-bg: radial-gradient(120% 90% at 85% 0%, rgba(176,137,76,0.16), transparent 60%), linear-gradient(180deg, #E9DFCD, #F2EBDF);
        --m-card-shadow: 0 1px 2px rgba(36,28,23,0.05), 0 6px 16px -6px rgba(36,28,23,0.12);
        --m-waiter-ring: rgba(251,248,241,0.9);
        --m-waiter-glow: rgba(122,30,40,0.55);
    }
    /* Side buttons */
    .device::before, .device::after { content: ''; position: absolute; width: 3px; border-radius: 2px; background: #2A231F; }
    .device::before { left: -3px; top: 118px; height: 54px; box-shadow: 0 70px 0 #2A231F; }
    .device::after  { right: -3px; top: 150px; height: 78px; }
    .device-screen {
        position: relative; overflow: hidden; height: 612px;
        border-radius: 41px; background: var(--m-bg); color: var(--m-fg);
    }
    .device-screen::after {
        content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 80px; pointer-events: none;
        background: linear-gradient(180deg, transparent, var(--m-bg) 85%);
    }
    .device-island { position: absolute; top: 9px; left: 50%; transform: translateX(-50%); z-index: 3; width: 92px; height: 27px; border-radius: 20px; background: #0B0908; }
    .device-status {
        position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between;
        height: 44px; padding: 0 26px 0 30px; font-size: 12px; font-weight: 600; color: var(--m-fg);
    }
    .device-status span:last-child { display: inline-flex; gap: 4px; font-size: 13px; }

    .m-header { display: flex; align-items: center; justify-content: space-between; padding: 6px 16px 10px; border-bottom: 1px solid var(--m-line); }
    .m-brand { display: flex; align-items: center; gap: 8px; font-family: var(--font-display); font-size: 14px; color: var(--m-fg); }
    .m-logo { width: 24px; height: 24px; border-radius: 50%; background: var(--m-accent); color: var(--m-on-accent); font-family: var(--font-display); font-style: italic; font-size: 11px; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 0 1px var(--m-brass); }
    .m-pills { display: flex; gap: 5px; }
    .m-pill { font-size: 9px; font-weight: 500; color: var(--m-fg-2); background: var(--m-surface); border: 1px solid var(--m-line); padding: 3px 7px; border-radius: 999px; display: inline-flex; align-items: center; gap: 3px; }
    .m-pill i { font-size: 8px; }
    .m-hero { padding: 16px 16px 14px; background: var(--m-hero-bg); }
    .m-name { font-family: var(--font-display); font-size: 30px; font-weight: 400; color: var(--m-fg); letter-spacing: -0.02em; line-height: 1; }
    .m-rule { width: 26px; height: 1px; background: var(--m-brass); margin: 10px 0 8px; }
    .m-tagline { font-family: var(--font-display); font-style: italic; font-size: 12px; color: var(--m-fg-2); }
    .m-tabs { display: flex; gap: 14px; padding: 11px 16px 0; font-size: 10.5px; color: var(--m-fg-2); white-space: nowrap; overflow: hidden; border-bottom: 1px solid var(--m-line); }
    .m-tabs span { padding-bottom: 7px; }
    .m-tabs span.on { color: var(--m-accent); font-weight: 600; border-bottom: 1.5px solid var(--m-accent); }
    .m-cat { display: flex; align-items: baseline; gap: 6px; padding: 14px 16px 8px; font-family: var(--font-display); font-size: 18px; color: var(--m-fg); }
    .m-cat small { font-family: var(--font-body); font-size: 8.5px; font-weight: 600; color: var(--m-brass-text); letter-spacing: 0.08em; }
    .m-card { margin: 0 14px 4px; background: var(--m-surface); border: 1px solid var(--m-line); border-radius: 10px; overflow: hidden; box-shadow: var(--m-card-shadow); }
    .m-photo { position: relative; aspect-ratio: 16 / 10; background: #3D2C22; }
    .m-photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
    .m-badge { position: absolute; top: 8px; left: 8px; display: inline-flex; align-items: center; gap: 3px; font-size: 8.5px; font-weight: 600; letter-spacing: 0.04em; color: #FBF8F1; background: rgba(20,14,11,0.72); padding: 3px 8px; border-radius: 999px; }
    .m-card-body { padding: 10px 12px 12px; }
    .m-dish { font-family: var(--font-display); font-size: 14px; line-height: 1.25; color: var(--m-fg); }
    .m-desc { font-size: 10px; line-height: 1.4; color: var(--m-fg-2); margin-top: 3px; }
    .m-card-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 10px; }
    .m-allergens { display: inline-flex; gap: 4px; }
    .m-allergens span { width: 20px; height: 20px; border-radius: 50%; background: var(--m-surface-2); display: inline-flex; align-items: center; justify-content: center; font-size: 10.5px; }
    .m-price-wrap { display: inline-flex; align-items: center; gap: 8px; }
    .m-price { font-family: var(--font-display); font-size: 14px; color: var(--m-fg); white-space: nowrap; }
    .m-more { display: inline-flex; align-items: center; gap: 2px; background: var(--m-accent); color: var(--m-on-accent); font-size: 9px; font-weight: 500; padding: 4px 10px; border-radius: 999px; }
    .m-row { display: flex; align-items: center; gap: 12px; margin: 0 16px; padding: 10px 0; border-bottom: 1px solid var(--m-line); }
    .m-row > div { flex: 1; min-width: 0; }
    .m-row .m-dish { font-size: 13px; }
    .m-row .m-price { display: block; margin-top: 6px; font-size: 13px; }
    .m-thumb { flex-shrink: 0; width: 66px; height: 66px; border-radius: 8px; object-fit: cover; background: #3D2C22; }
    .m-waiter {
        position: absolute; right: 14px; bottom: 16px; z-index: 2;
        width: 44px; height: 44px; border-radius: 50%; background: var(--m-accent); color: var(--m-on-accent);
        display: flex; align-items: center; justify-content: center; font-size: 21px;
        box-shadow: 0 0 0 3px var(--m-waiter-ring), 0 10px 22px -6px var(--m-waiter-glow);
    }

    /* Floating cards — site tokens, so they follow the light/dark theme. */
    .float-card {
        display: block; position: absolute; z-index: 2; width: 214px;
        background: var(--bg-card); border: 1px solid var(--bd-2); border-radius: 14px;
        padding: 13px 14px; text-align: left;
        box-shadow: 0 2px 6px rgba(var(--shadow-rgb),0.06), 0 22px 40px -18px rgba(var(--shadow-rgb),0.35);
    }
    .float-label { display: flex; align-items: center; gap: 6px; font-size: 10.5px; font-weight: 600; color: var(--gold-text); text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 8px; }
    .float-label i { font-size: 14px; letter-spacing: 0; }
    .float-dish { font-family: var(--font-display); font-size: 15px; color: var(--tx-hi); line-height: 1.25; margin-bottom: 10px; }
    .float-allergens { display: flex; flex-wrap: wrap; gap: 6px; }
    .float-allergens span { display: inline-flex; align-items: center; gap: 5px; font-size: 12.5px; font-weight: 500; color: var(--tx-1); background: var(--bg-subtle); border: 1px solid var(--bd-1); padding: 4px 10px; border-radius: 999px; }
    .float-chat { display: flex; flex-direction: column; gap: 6px; }
    .float-q, .float-a { font-size: 12.5px; line-height: 1.45; padding: 7px 11px; border-radius: 12px; max-width: 92%; }
    .float-q { align-self: flex-end; background: var(--brand); color: var(--on-brand); border-bottom-right-radius: 4px; }
    .float-a { align-self: flex-start; background: var(--bg-subtle); color: var(--tx-1); border: 1px solid var(--bd-1); border-bottom-left-radius: 4px; }
    /* The cards stick out 64px left / 30px right of the phone: inside the
       hero's side padding on desktop, so nothing is clipped. */
    .float-allergen-card { left: -64px; top: 250px; }
    .float-chat-card { right: -30px; top: 400px; width: 232px; }
    .device { transform: rotate(-2.5deg); }
    .float-card { animation: float-card 7s ease-in-out infinite; }
    .float-chat-card { animation-delay: -3.5s; }

    /* Mobile: the same composition as on desktop (tilted phone + both
       cards), centred and scaled down with zoom so it fits the screen:
       about 404px wide (phone 300 + cards 64 + 30 + tilt) in 100vw - 40px. */
    @media (max-width: 900px) {
        .device-stage { left: 17px; }
    }
    @media (max-width: 444px) { .device-stage { zoom: 0.9; } }
    @media (max-width: 404px) { .device-stage { zoom: 0.8; } }
    @media (max-width: 363px) { .device-stage { zoom: 0.68; } }
    @keyframes float-card { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
    @media (prefers-reduced-motion: reduce) {
        .float-card { animation: none !important; }
    }
    .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

    .hero-demo-link { position: relative; z-index: 2; text-align: center; margin-top: 26px; }
    .hero-demo-link a {
        display: inline-flex; align-items: center; gap: 8px;
        font-family: var(--font-display); font-style: italic; font-size: 16px; color: var(--accent-text); text-decoration: none;
        border-bottom: 1px solid var(--gold); padding-bottom: 3px;
        transition: gap 0.18s, color 0.18s;
    }
    .hero-demo-link a i { font-style: normal; font-size: 15px; }
    .hero-demo-link a:hover { gap: 12px; }

    /* Section shared. 88px, not 104px: two sections in a row add their
       paddings, and a tinted .section-alt around short content (the steps
       used to be one) read as an empty band above and below it. */
    .section { padding: 88px 24px; }
    .section + .section { border-top: 1px solid var(--bd-1); }
    .section-alt { background: var(--bg-subtle); }
    .section-head { text-align: center; max-width: 620px; margin: 0 auto 52px; }
    /* The sticky nav (public/base.html.twig) mustn't cover an anchored heading. */
    #funcionalidades, #precios { scroll-margin-top: 72px; }
    .section-head .eyebrow { margin-bottom: 18px; }
    .section-head h2 { font-family: var(--font-display); font-size: 44px; font-weight: 400; color: var(--tx-hi); letter-spacing: -0.02em; line-height: 1.1; margin-bottom: 16px; }
    .section-head p { font-size: 16px; color: var(--tx-3); line-height: 1.65; }

    /* Features */
    .features-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; max-width: 1120px; margin: 0 auto; }
    .feature-card {
        position: relative; background: var(--bg-card); border: 1px solid var(--bd-1); border-radius: 8px; padding: 28px 24px 26px;
        box-shadow: 0 1px 2px rgba(var(--shadow-rgb),0.04), 0 3px 10px rgba(var(--shadow-rgb),0.04);
        transition: border-color 0.25s, transform 0.25s, box-shadow 0.25s;
    }
    .feature-card::before {
        content: ''; position: absolute; top: -1px; left: 20%; right: 20%; height: 1px;
        background: linear-gradient(90deg, transparent, var(--gold), transparent); opacity: 0; transition: opacity 0.25s;
    }
    .feature-card:hover {
        border-color: var(--gold); transform: translateY(-3px);
        box-shadow: 0 4px 8px rgba(var(--shadow-rgb),0.05), 0 16px 34px rgba(var(--shadow-rgb),0.09);
    }
    .feature-card:hover::before { opacity: 0.8; }
    .feature-icon {
        width: 46px; height: 46px; border-radius: 50%;
        border: 1px solid rgba(176,137,76,0.55); color: var(--accent-text);
        display: flex; align-items: center; justify-content: center;
        font-size: 20px; margin-bottom: 20px; background: var(--bg-subtle);
    }
    .feature-card h3 { font-family: var(--font-display); font-size: 20px; font-weight: 500; color: var(--tx-hi); margin-bottom: 8px; letter-spacing: -0.01em; line-height: 1.2; }
    .feature-card p { font-size: 14px; color: var(--tx-3); line-height: 1.6; }

    /* Steps */
    .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; max-width: 1000px; margin: 0 auto; }
    .step { text-align: center; padding: 8px 36px; }
    .step + .step { border-left: 1px solid var(--bd-1); }
    .step-num {
        font-family: var(--font-display); font-style: italic; font-size: 52px; font-weight: 400; line-height: 1;
        color: var(--gold); margin-bottom: 18px;
    }
    .step h3 { font-family: var(--font-display); font-size: 22px; font-weight: 500; color: var(--tx-hi); margin-bottom: 10px; letter-spacing: -0.01em; }
    .step p { font-size: 14px; color: var(--tx-3); line-height: 1.65; }

    /* Pricing — one plan; prices from app.billing_prices (same source as
       the admin). Without JS both periods show side by side and the
       Mensual/Anual switch stays hidden; the script below turns it on and
       shows one period at a time (.is-enhanced). */
    .pricing-card {
        position: relative; max-width: 620px; margin: 0 auto; text-align: center;
        background: var(--bg-card); border: 1px solid var(--bd-1); border-radius: 8px;
        padding: 40px 44px 36px;
        box-shadow: 0 4px 8px rgba(var(--shadow-rgb),0.05), 0 16px 34px rgba(var(--shadow-rgb),0.09);
    }
    .pricing-card::before {
        content: ''; position: absolute; top: -1px; left: 20%; right: 20%; height: 1px;
        background: linear-gradient(90deg, transparent, var(--gold), transparent);
    }
    .pricing-toggle {
        display: inline-flex; gap: 4px; padding: 4px; margin-bottom: 30px;
        background: var(--bg-subtle); border: 1px solid var(--bd-2); border-radius: 999px;
    }
    .pricing-toggle[hidden] { display: none; }
    .pricing-toggle button {
        font: inherit; font-size: 14px; font-weight: 500; color: var(--tx-2);
        background: transparent; border: 0; border-radius: 999px;
        min-height: 40px; padding: 8px 22px; cursor: pointer;
        transition: background 0.15s, color 0.15s;
    }
    .pricing-toggle button:hover { color: var(--tx-hi); }
    .pricing-toggle button[aria-pressed="true"] { background: var(--brand); color: var(--on-brand); }
    .pricing-toggle button:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
    .pricing-options { display: grid; grid-template-columns: 1fr 1fr; }
    .pricing-option { padding: 4px 12px; }
    .pricing-option + .pricing-option { border-left: 1px solid var(--bd-1); }
    .pricing-option-label {
        font-size: 11px; font-weight: 600; color: var(--gold-text);
        text-transform: uppercase; letter-spacing: 0.16em; margin-bottom: 14px;
    }
    .pricing-amount { display: flex; align-items: baseline; justify-content: center; flex-wrap: wrap; gap: 6px; }
    .pricing-price {
        font-family: var(--font-display); font-size: 44px; font-weight: 400; color: var(--tx-hi);
        letter-spacing: -0.02em; line-height: 1; font-variant-numeric: tabular-nums;
        font-variation-settings: 'opsz' 144;
    }
    .pricing-per { font-size: 15px; color: var(--tx-3); }
    .pricing-vat { font-size: 13px; color: var(--tx-3); margin-top: 10px; }
    .pricing-saving {
        display: inline-flex; align-items: center; gap: 6px; margin-top: 14px;
        font-size: 13px; font-weight: 500; color: var(--accent-text);
        background: rgba(176,137,76,0.08); border: 1px solid rgba(176,137,76,0.55);
        padding: 6px 13px; border-radius: 999px;
    }
    .pricing-saving i { font-size: 14px; }
    .is-enhanced .pricing-options { grid-template-columns: 1fr; }
    .is-enhanced .pricing-option { padding: 0; }
    .is-enhanced .pricing-option:not(.is-active) { display: none; }
    .is-enhanced .pricing-option + .pricing-option { border-left: 0; }
    .is-enhanced .pricing-option-label { display: none; }
    .is-enhanced .pricing-price { font-size: 60px; }
    .pricing-card .rule { margin: 32px auto 26px; }
    .pricing-included-title { font-family: var(--font-display); font-size: 19px; font-weight: 500; color: var(--tx-hi); margin-bottom: 16px; }
    .pricing-list {
        list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 12px 28px;
        max-width: 500px; margin: 0 auto 34px; text-align: left;
    }
    .pricing-list li { display: flex; align-items: flex-start; gap: 10px; font-size: 14px; color: var(--tx-2); line-height: 1.5; }
    .pricing-list i { flex-shrink: 0; font-size: 16px; color: var(--gold-text); margin-top: 2px; }
    .pricing-cta { width: 100%; justify-content: center; font-size: 16px; padding: 17px 28px; }
    .pricing-note { display: flex; align-items: center; justify-content: center; gap: 7px; font-size: 13px; color: var(--tx-3); margin-top: 16px; }
    .pricing-note i { color: var(--gold); font-size: 15px; }

    /* FAQ */
    .faq { max-width: 760px; margin: 0 auto; border-top: 1px solid var(--bd-2); }
    .faq-item { border-bottom: 1px solid var(--bd-2); }
    .faq-item summary {
        cursor: pointer; list-style: none;
        display: flex; align-items: center; justify-content: space-between; gap: 20px;
        font-family: var(--font-display); font-size: 20px; font-weight: 400; color: var(--tx-hi);
        padding: 24px 4px; transition: color 0.15s;
    }
    .faq-item summary:hover { color: var(--accent-text); }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary i {
        flex-shrink: 0; width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--bd-2);
        display: flex; align-items: center; justify-content: center;
        font-size: 14px; color: var(--accent-text); transition: transform 0.25s, border-color 0.15s;
    }
    .faq-item summary:hover i { border-color: var(--gold); }
    .faq-item[open] summary i { transform: rotate(45deg); }
    .faq-item p { font-size: 15px; color: var(--tx-3); line-height: 1.7; padding: 0 60px 26px 4px; margin-top: -6px; }

    /* Final CTA */
    .cta-band { padding: 0 24px 88px; }
    .cta-band-inner {
        max-width: 1120px; margin: 0 auto; text-align: center;
        background: var(--hero-wash); border: 1px solid var(--bd-1); border-radius: 8px;
        padding: 80px 40px; position: relative; overflow: hidden;
    }
    .cta-band-inner::before {
        content: ''; position: absolute; inset: 14px; border: 1px solid rgba(176,137,76,0.35); border-radius: 4px; pointer-events: none;
    }
    .cta-band-inner > * { position: relative; z-index: 1; }
    .cta-band .rule { margin: 0 auto 26px; }
    .cta-band h2 { font-family: var(--font-display); font-size: 44px; font-weight: 400; color: var(--tx-hi); letter-spacing: -0.02em; line-height: 1.1; margin-bottom: 16px; }
    .cta-band p { font-size: 16px; color: var(--tx-3); margin-bottom: 34px; }

    @media (max-width: 1000px) {
        .features-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 900px) {
        .hero-inner { flex-direction: column; text-align: center; gap: 56px; }
        .hero .rule { margin-left: auto; margin-right: auto; }
        .hero p { max-width: 100%; margin-left: auto; margin-right: auto; }
        .hero-ctas, .hero-note { justify-content: center; }
    }
    @media (max-width: 767px) {
        .hero { padding: 56px 20px 64px; }
        .hero h1 { font-size: 40px; }
        .hero p { font-size: 16px; }
        .hero-ctas a { width: 100%; justify-content: center; }
        .hero-visual { width: 100%; }
        .section { padding: 64px 20px; }
        .section-head { margin-bottom: 40px; }
        .section-head h2, .cta-band h2 { font-size: 32px; }
        .features-grid { grid-template-columns: 1fr; gap: 12px; }
        .feature-card { padding: 22px 20px; display: grid; grid-template-columns: 46px 1fr; column-gap: 16px; }
        .feature-icon { grid-row: span 2; margin-bottom: 0; }
        .steps { grid-template-columns: 1fr; gap: 36px; }
        .step { padding: 0 8px; }
        .step + .step { border-left: 0; border-top: 1px solid var(--bd-1); padding-top: 36px; }
        .pricing-card { padding: 30px 20px 26px; }
        .pricing-options { grid-template-columns: 1fr; }
        .pricing-option { padding: 0; }
        .pricing-option + .pricing-option { border-left: 0; border-top: 1px solid var(--bd-1); margin-top: 22px; padding-top: 22px; }
        .is-enhanced .pricing-option + .pricing-option { border-top: 0; margin-top: 0; padding-top: 0; }
        .is-enhanced .pricing-price { font-size: 50px; }
        .pricing-list { grid-template-columns: 1fr; }
        .faq-item summary { font-size: 17px; padding: 20px 2px; }
        .faq-item p { padding-right: 8px; }
        .cta-band { padding: 0 16px 64px; }
        .cta-band-inner { padding: 56px 24px; }
    }
{% endblock %}

{% block content %}
    {# Prices: app.billing_prices (cents, VAT included) — the same source as
       the admin's plan dialog — formatted for the home's language. #}
    {% import 'billing/_price.html.twig' as billing_price %}
    {% set prices = {
        monthly: 'pricing.amount'|trans({'%price%': billing_price.amount(billing_prices.monthly, locale)}, 'public_site', locale),
        yearly: 'pricing.amount'|trans({'%price%': billing_price.amount(billing_prices.yearly, locale)}, 'public_site', locale),
        saving: 'pricing.amount'|trans({'%price%': billing_price.amount(billing_prices.monthly * 12 - billing_prices.yearly, locale)}, 'public_site', locale),
    } %}
    <section class="hero">
        <div class="hero-inner">
            <div class="hero-copy">
                <div class="hero-badge"><i class="ti ti-sparkles" aria-hidden="true"></i> {{ 'hero.badge'|trans({}, 'public_site', locale) }}</div>
                <h1>{{ 'hero.title_main'|trans({}, 'public_site', locale) }}<span class="accent">{{ 'hero.title_accent'|trans({}, 'public_site', locale) }}</span></h1>
                <hr class="rule">
                <p>{{ 'hero.subtitle'|trans({}, 'public_site', locale) }}</p>
                <div class="hero-ctas">
                    <a href="{{ path('app_register') }}" class="btn-primary">{{ 'hero.cta_primary'|trans({}, 'public_site', locale) }}</a>
                    <a href="#precios" class="btn-secondary">{{ 'hero.cta_secondary'|trans({}, 'public_site', locale) }}</a>
                </div>
                <div class="hero-note"><i class="ti ti-shield-check" aria-hidden="true"></i> {{ 'hero.note'|trans({}, 'public_site', locale) }}</div>
            </div>
            <div class="hero-visual">
                {# Dish prices in cents, formatted like the pricing (€ placement per language). #}
                {% set dish_price = {
                    pizza: 'pricing.amount'|trans({'%price%': billing_price.amount(1350, locale)}, 'public_site', locale),
                    lamb: 'pricing.amount'|trans({'%price%': billing_price.amount(2400, locale)}, 'public_site', locale),
                    cannelloni: 'pricing.amount'|trans({'%price%': billing_price.amount(1450, locale)}, 'public_site', locale),
                } %}
                <figure class="device-stage">
                    <figcaption class="visually-hidden">{{ 'mockup.device_label'|trans({}, 'public_site', locale) }}</figcaption>
                    <div class="device">
                        <div class="device-screen">
                            <div class="device-island" aria-hidden="true"></div>
                            <div class="device-status" aria-hidden="true"><span>9:41</span><span><i class="ti ti-antenna-bars-5"></i><i class="ti ti-wifi"></i><i class="ti ti-battery-3"></i></span></div>
                            <div class="m-header" aria-hidden="true">
                                <span class="m-brand"><span class="m-logo">LB</span> La Brasa</span>
                                <span class="m-pills">
                                    <span class="m-pill">{{ locales[locale].flag }} {{ locale|upper }} <i class="ti ti-chevron-down"></i></span>
                                    <span class="m-pill">€ EUR <i class="ti ti-chevron-down"></i></span>
                                </span>
                            </div>
                            <div class="m-hero" aria-hidden="true">
                                <div class="m-name">La Brasa</div>
                                <div class="m-rule"></div>
                                <div class="m-tagline">{{ 'mockup.restaurant_tagline'|trans({}, 'public_site', locale) }}</div>
                            </div>
                            <div class="m-tabs" aria-hidden="true">
                                <span class="on">{{ 'mockup.cat_pizzas'|trans({}, 'public_site', locale) }}</span>
                                <span>{{ 'mockup.cat_meat'|trans({}, 'public_site', locale) }}</span>
                                <span>{{ 'mockup.cat_pasta'|trans({}, 'public_site', locale) }}</span>
                                <span>{{ 'mockup.cat_desserts'|trans({}, 'public_site', locale) }}</span>
                            </div>

                            <div class="m-cat">{{ 'mockup.cat_pizzas'|trans({}, 'public_site', locale) }} <small aria-hidden="true">04</small></div>
                            <div class="m-card">
                                <div class="m-photo">
                                    <img src="{{ asset('images/home/pizza.webp') }}" width="800" height="500" decoding="async" fetchpriority="low"
                                         alt="{{ 'mockup.pizza.alt'|trans({}, 'public_site', locale) }}">
                                    <span class="m-badge" aria-hidden="true">★ {{ 'mockup.badge'|trans({}, 'public_site', locale) }}</span>
                                </div>
                                <div class="m-card-body">
                                    <div class="m-dish">{{ 'mockup.pizza.name'|trans({}, 'public_site', locale) }}</div>
                                    <div class="m-desc">{{ 'mockup.pizza.desc'|trans({}, 'public_site', locale) }}</div>
                                    <div class="m-card-bottom">
                                        <span class="m-allergens" aria-hidden="true"><span>🌾</span><span>🥛</span></span>
                                        <span class="m-price-wrap">
                                            <span class="m-price">{{ dish_price.pizza }}</span>
                                            <span class="m-more" aria-hidden="true">{{ 'mockup.view_more'|trans({}, 'public_site', locale) }} <i class="ti ti-chevron-right"></i></span>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="m-cat">{{ 'mockup.cat_meat'|trans({}, 'public_site', locale) }} <small aria-hidden="true">03</small></div>
                            <div class="m-row">
                                <div>
                                    <div class="m-dish">{{ 'mockup.lamb.name'|trans({}, 'public_site', locale) }}</div>
                                    <div class="m-desc">{{ 'mockup.lamb.desc'|trans({}, 'public_site', locale) }}</div>
                                    <span class="m-price">{{ dish_price.lamb }}</span>
                                </div>
                                <img class="m-thumb" src="{{ asset('images/home/lamb.webp') }}" width="480" height="480" loading="lazy" decoding="async"
                                     alt="{{ 'mockup.lamb.alt'|trans({}, 'public_site', locale) }}">
                            </div>
                            <div class="m-row">
                                <div>
                                    <div class="m-dish">{{ 'mockup.cannelloni.name'|trans({}, 'public_site', locale) }}</div>
                                    <div class="m-desc">{{ 'mockup.cannelloni.desc'|trans({}, 'public_site', locale) }}</div>
                                    <span class="m-price">{{ dish_price.cannelloni }}</span>
                                </div>
                                <img class="m-thumb" src="{{ asset('images/home/cannelloni.webp') }}" width="480" height="480" loading="lazy" decoding="async"
                                     alt="{{ 'mockup.cannelloni.alt'|trans({}, 'public_site', locale) }}">
                            </div>
                            <span class="m-waiter" aria-hidden="true"><i class="ti ti-message-chatbot"></i></span>
                        </div>
                    </div>

                    <div class="float-card float-allergen-card">
                        <div class="float-label"><i class="ti ti-alert-circle" aria-hidden="true"></i> {{ 'mockup.allergens_label'|trans({}, 'public_site', locale) }}</div>
                        <div class="float-dish">{{ 'mockup.pizza.name'|trans({}, 'public_site', locale) }}</div>
                        <div class="float-allergens">
                            <span><span aria-hidden="true">🌾</span> {{ 'mockup.allergen_gluten'|trans({}, 'public_site', locale) }}</span>
                            <span><span aria-hidden="true">🥛</span> {{ 'mockup.allergen_milk'|trans({}, 'public_site', locale) }}</span>
                        </div>
                    </div>
                    <div class="float-card float-chat-card">
                        <div class="float-label"><i class="ti ti-message-chatbot" aria-hidden="true"></i> {{ 'features.smart_waiter.title'|trans({}, 'public_site', locale) }}</div>
                        <div class="float-chat">
                            <div class="float-q">{{ 'mockup.waiter_question'|trans({}, 'public_site', locale) }}</div>
                            <div class="float-a">{{ 'mockup.waiter_answer'|trans({}, 'public_site', locale) }}</div>
                        </div>
                    </div>
                </figure>
                <div class="hero-demo-link">
                    <a href="{{ path('menu_show', {slug: 'david-test'}) }}" target="_blank" rel="noopener">{{ 'demo.link'|trans({}, 'public_site', locale) }} <i class="ti ti-arrow-up-right" aria-hidden="true"></i></a>
                </div>
            </div>
        </div>
    </section>

    <section class="section" id="funcionalidades">
        <div class="section-head">
            <div class="eyebrow">{{ 'features.eyebrow'|trans({}, 'public_site', locale) }}</div>
            <h2>{{ 'features.title'|trans({}, 'public_site', locale) }}</h2>
            <p>{{ 'features.subtitle'|trans({}, 'public_site', locale) }}</p>
        </div>
        <div class="features-grid">
            {% for feature, icon in {
                qr: 'ti-qrcode',
                import: 'ti-photo-scan',
                smart_waiter: 'ti-message-chatbot',
                allergens: 'ti-wheat-off',
                multilang: 'ti-language',
                multicurrency: 'ti-currency-dollar',
                stats: 'ti-chart-bar',
                themes: 'ti-palette',
            } %}
                <div class="feature-card">
                    <div class="feature-icon"><i class="ti {{ icon }}" aria-hidden="true"></i></div>
                    <h3>{{ ('features.' ~ feature ~ '.title')|trans({}, 'public_site', locale) }}</h3>
                    <p>{{ ('features.' ~ feature ~ '.desc')|trans({}, 'public_site', locale) }}</p>
                </div>
            {% endfor %}
        </div>
    </section>

    <section class="section">
        <div class="section-head">
            <div class="eyebrow">{{ 'steps.eyebrow'|trans({}, 'public_site', locale) }}</div>
            <h2>{{ 'steps.title'|trans({}, 'public_site', locale) }}</h2>
        </div>
        <div class="steps">
            <div class="step">
                <div class="step-num">01</div>
                <h3>{{ 'steps.step1.title'|trans({}, 'public_site', locale) }}</h3>
                <p>{{ 'steps.step1.desc'|trans({}, 'public_site', locale) }}</p>
            </div>
            <div class="step">
                <div class="step-num">02</div>
                <h3>{{ 'steps.step2.title'|trans({}, 'public_site', locale) }}</h3>
                <p>{{ 'steps.step2.desc'|trans({}, 'public_site', locale) }}</p>
            </div>
            <div class="step">
                <div class="step-num">03</div>
                <h3>{{ 'steps.step3.title'|trans({}, 'public_site', locale) }}</h3>
                <p>{{ 'steps.step3.desc'|trans({}, 'public_site', locale) }}</p>
            </div>
        </div>
    </section>

    <section class="section section-alt" id="precios">
        <div class="section-head">
            <div class="eyebrow">{{ 'pricing.eyebrow'|trans({}, 'public_site', locale) }}</div>
            <h2>{{ 'pricing.title'|trans({}, 'public_site', locale) }}</h2>
            <p>{{ 'pricing.subtitle'|trans({}, 'public_site', locale) }}</p>
        </div>
        <div class="pricing-card" data-pricing>
            <div class="pricing-toggle" role="group" aria-label="{{ 'pricing.period_label'|trans({}, 'public_site', locale) }}" data-pricing-toggle hidden>
                {% for period in ['monthly', 'yearly'] %}
                    <button type="button" data-period="{{ period }}" aria-pressed="{{ period == 'monthly' ? 'true' : 'false' }}">{{ ('pricing.' ~ period)|trans({}, 'public_site', locale) }}</button>
                {% endfor %}
            </div>
            <div class="pricing-options" aria-live="polite">
                {% for period in ['monthly', 'yearly'] %}
                    <div class="pricing-option{{ period == 'monthly' ? ' is-active' : '' }}" data-option="{{ period }}">
                        <div class="pricing-option-label">{{ ('pricing.' ~ period)|trans({}, 'public_site', locale) }}</div>
                        <div class="pricing-amount">
                            <span class="pricing-price" data-price="{{ period }}">{{ prices[period] }}</span>
                            <span class="pricing-per">{{ (period == 'yearly' ? 'pricing.per_year' : 'pricing.per_month')|trans({}, 'public_site', locale) }}</span>
                        </div>
                        <div class="pricing-vat">{{ 'pricing.vat'|trans({}, 'public_site', locale) }}</div>
                        {% if period == 'yearly' %}
                            <div class="pricing-saving" data-saving><i class="ti ti-discount" aria-hidden="true"></i> {{ 'pricing.saving'|trans({'%saving%': prices.saving}, 'public_site', locale) }}</div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
            <hr class="rule">
            <p class="pricing-included-title">{{ 'pricing.included_title'|trans({}, 'public_site', locale) }}</p>
            <ul class="pricing-list">
                {% for i in 1..6 %}
                    <li><i class="ti ti-check" aria-hidden="true"></i> {{ ('pricing.inc' ~ i)|trans({}, 'public_site', locale) }}</li>
                {% endfor %}
            </ul>
            <a href="{{ path('app_register') }}" class="btn-primary pricing-cta">{{ 'pricing.cta'|trans({}, 'public_site', locale) }}</a>
            <p class="pricing-note"><i class="ti ti-shield-check" aria-hidden="true"></i> {{ 'pricing.no_card'|trans({}, 'public_site', locale) }}</p>
        </div>
    </section>

    <section class="section">
        <div class="section-head">
            <div class="eyebrow">{{ 'faq.eyebrow'|trans({}, 'public_site', locale) }}</div>
            <h2>{{ 'faq.title'|trans({}, 'public_site', locale) }}</h2>
        </div>
        <div class="faq">
            {% for key in ['price', 'q1', 'q2', 'q3', 'q4', 'q5'] %}
                <details class="faq-item">
                    <summary>
                        {{ ('faq.' ~ key ~ '.q')|trans({}, 'public_site', locale) }}
                        <i class="ti ti-plus" aria-hidden="true"></i>
                    </summary>
                    <p>{{ ('faq.' ~ key ~ '.a')|trans({'%monthly%': prices.monthly, '%yearly%': prices.yearly}, 'public_site', locale) }}</p>
                </details>
            {% endfor %}
        </div>
    </section>

    <section class="cta-band">
        <div class="cta-band-inner">
            <hr class="rule">
            <h2>{{ 'cta.title'|trans({}, 'public_site', locale) }}</h2>
            <p>{{ 'cta.subtitle'|trans({}, 'public_site', locale) }}</p>
            <a href="{{ path('app_register') }}" class="btn-primary">{{ 'cta.button'|trans({}, 'public_site', locale) }}</a>
        </div>
    </section>

    <script>
        // Mensual / Anual switch: only once this runs (no JS → both periods shown).
        (function () {
            var card = document.querySelector('[data-pricing]');
            if (!card) return;
            var toggle = card.querySelector('[data-pricing-toggle]');
            var buttons = toggle.querySelectorAll('button[data-period]');
            function show(period) {
                card.querySelectorAll('[data-option]').forEach(function (el) {
                    el.classList.toggle('is-active', el.getAttribute('data-option') === period);
                });
                buttons.forEach(function (b) {
                    b.setAttribute('aria-pressed', b.getAttribute('data-period') === period ? 'true' : 'false');
                });
            }
            buttons.forEach(function (b) {
                b.addEventListener('click', function () { show(b.getAttribute('data-period')); });
            });
            show('monthly');
            toggle.hidden = false;
            card.classList.add('is-enhanced');
        }());
    </script>
{% endblock %}
