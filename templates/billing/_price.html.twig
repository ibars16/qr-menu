{# A reseller's price for its restaurants (cents) in the plan labels'
   %price%: "25" or "25,50" ("25.50" in English) — the currency sign is
   in the label, as with the platform's own prices (app.billing_prices, also cents).
   `locale` for pages whose language isn't the request's (the public home). #}
{% macro amount(cents, locale = null) -%}
    {%- if cents % 100 == 0 -%}
        {{ cents // 100 }}
    {%- else -%}
        {{ (cents / 100)|number_format(2, (locale ?? app.request.locale) == 'en' ? '.' : ',', '') }}
    {%- endif -%}
{%- endmacro %}

