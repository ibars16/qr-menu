{# templates/admin/_product_modal_css.html.twig

   CSS for _product_modal.html.twig (desktop modal + mobile sheet, steps,
   cat-select, fields, price variants, supplement, image upload, spicy,
   tags, Smart Waiter recommend, allergens, help popovers, Tom Select) —
   shared by the Carta screen (menu.html.twig) and the Menús edit screen
   (menu_edit.html.twig), which both `{% include %}` this INSIDE their own
   <style> block (this file has no <style> tag of its own).

   Extracted so both screens style the same markup identically, one source —
   before this, menu_edit.html.twig only had the generic modal/sheet/field
   shell duplicated locally and none of the rest, so the product editor
   rendered unstyled there (raw step text, unstyled inputs/pills/allergens).
   Do not copy any of this back into a page-level stylesheet block. #}

/* ══════════════════════════════
   DESKTOP MODAL
══════════════════════════════ */
.modal-overlay {
    position:fixed; inset:0; background:var(--overlay);
    z-index:500; display:flex; align-items:center; justify-content:center;
    padding:20px; opacity:0; pointer-events:none; transition:opacity 0.2s;
}
.modal-overlay.open { opacity:1; pointer-events:all; }
.modal {
    background:var(--bg-card); border:1px solid var(--bd-3); border-radius:16px;
    width:100%; max-height:90vh; display:flex; flex-direction:column;
    transform:translateY(8px) scale(0.98); transition:transform 0.2s;
}
.modal-overlay.open .modal { transform:translateY(0) scale(1); }
.modal-sm { max-width:380px; }
.modal-md { max-width:560px; }

/* ══════════════════════════════
   MOBILE BOTTOM SHEET
══════════════════════════════ */
.sheet-overlay {
    position:fixed; inset:0; background:var(--overlay);
    z-index:500; display:flex; align-items:flex-end;
    opacity:0; pointer-events:none; transition:opacity 0.25s;
}
.sheet-overlay.open { opacity:1; pointer-events:all; }
.sheet {
    width:100%; background:var(--bg-card); border-radius:20px 20px 0 0;
    border-top:1px solid var(--bd-3); max-height:92vh;
    display:flex; flex-direction:column;
    transform:translateY(100%); transition:transform 0.3s cubic-bezier(0.32,0.72,0,1);
}
.sheet-overlay.open .sheet { transform:translateY(0); }
.sheet-handle {
    width:36px; height:4px; border-radius:2px; background:var(--bd-2);
    margin:10px auto 0; flex-shrink:0;
}

/* Shared modal/sheet parts */
.panel-header {
    padding:14px 16px 12px; border-bottom:1px solid var(--bd-1);
    display:flex; align-items:center; justify-content:space-between; flex-shrink:0;
}
.panel-title { font-size:16px; font-weight:600; color:var(--tx-hi); letter-spacing:-0.3px; }
.panel-close {
    width:30px; height:30px; border-radius:50%; border:1px solid var(--bd-2);
    background:var(--bg-input); display:flex; align-items:center; justify-content:center;
    cursor:pointer; color:var(--tx-5); font-size:13px;
}
.panel-close:hover { color:var(--tx-1); }
.panel-body {
    flex:1; min-height:0; overflow-y:auto; padding:18px; display:flex; flex-direction:column;
    gap:15px; scrollbar-width:thin; scrollbar-color:var(--bg-tgl) transparent;
}
.panel-footer {
    padding:12px 18px; border-top:1px solid var(--bd-1);
    display:flex; gap:8px; justify-content:flex-end; flex-shrink:0;
    padding-bottom:calc(12px + env(safe-area-inset-bottom));
}

@media (max-width: 767px) {
    .panel-title { font-size:17px; }
    .panel-body  { padding:16px; gap:16px; }
    .panel-footer { justify-content:stretch; }
    .panel-footer .btn { flex:1; justify-content:center; min-height:48px; font-size:15px; }
    .panel-footer .btn-danger { flex:0; min-width:48px; padding:0; }
}

/* "Eliminar plato" — deliberately de-emphasized: the same box/border
   weight as "Guardar" read as two competing primary actions, when
   deleting a dish is rare, destructive and irreversible. No new red
   either — --brand already means something else here ("+ Nuevo
   plato"/the save CTA); a second red would read as a conflicting kind of
   emphasis. Discretion, not color, communicates "handle with care" — the
   hover still uses #F0997B, the same danger accent .icon-btn.danger
   already uses elsewhere in this admin, not a new one.
   Scoped by id, not a .btn-danger override: that class is global
   (base.html.twig) and reused as-is by the "eliminar todos" header
   buttons and by the tags/users edit-modal footers on other screens —
   both verified out of this file's reach (this partial is only included
   by menu.html.twig/menu_edit.html.twig, and neither of those has any
   other .btn-danger in a .panel-footer), untouched either way. See
   deleteProduct() in _product_js.html.twig — logic/confirm dialog
   unchanged. */
#d-delete-btn, #m-delete-btn {
    background:none; border-color:transparent; color:var(--tx-muted);
}
#d-delete-btn:hover, #m-delete-btn:hover { background:var(--bg-hover); color:#F0997B; }
#d-delete-btn:focus-visible, #m-delete-btn:focus-visible { outline:2px solid var(--brand); outline-offset:2px; }

/* Step body wrappers — must be flex containers so the constrained height from
   .sheet/.modal (max-height: 92/90vh) reaches .panel-body and enables scroll */
#d-step1-body, #d-step2-body,
#m-step1-body, #m-step2-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
}

/* Steps */
.steps { display:flex; align-items:center; gap:8px; margin-top:4px; }
.step  { display:flex; align-items:center; gap:5px; font-size:12px; color:var(--tx-7); }
.step.active { color:var(--tx-1); }
.step-num {
    width:20px; height:20px; border-radius:50%; border:1px solid var(--bd-2);
    background:var(--bg-input); display:flex; align-items:center; justify-content:center;
    font-size:10px; font-weight:600; color:var(--tx-6);
}
.step.active .step-num { background:#C1440E; border-color:#C1440E; color:#fff; }
.step-sep { color:var(--bd-2); }

/* Product tabs — internal grouping of step 2 (General/Foto/Detalles/
   Alérgenos), not to be confused with .steps above (the 2-step
   category→info wizard). .product-tabs-wrap replaces the flat field list
   as .panel-body's only child, so .panel-body's own flex/gap/overflow-y
   rules (shared with #d-step1-body/#m-step1-body's cat-select) stay
   untouched — the tab bar sits fixed via flex-shrink:0 and only
   .product-tab-panels scrolls. */
.product-tabs-wrap { display:flex; flex-direction:column; flex:1; min-height:0; }
/* Segmented control, not an underline row — a thin text-only tab bar read
   as barely-there against the rest of the form; a filled bg + border on
   the group, and a raised card on the active tab, makes which of the 4
   sections you're on obvious at a glance. */
.product-tabs {
    display:flex; gap:2px; padding:3px; flex-shrink:0;
    background:var(--bg-input); border:1px solid var(--bd-2); border-radius:10px;
}
.product-tab {
    flex:1; appearance:none; background:none; border:none; font-family:inherit;
    font-size:13px; font-weight:500; color:var(--tx-4); cursor:pointer;
    padding:8px 6px; border-radius:7px; text-align:center;
    transition:color 0.15s, background 0.15s, box-shadow 0.15s; white-space:nowrap;
}
.product-tab:hover { color:var(--tx-2); }
.product-tab.active { color:var(--tx-hi); background:var(--bg-card); box-shadow:var(--shadow-sm); }
.product-tab:focus-visible { outline:2px solid var(--brand); outline-offset:2px; }

/* All 4 panels are always laid out, stacked in the same grid cell — the
   grid sizes its row to the tallest of the 4 regardless of which is
   .active, so the modal/sheet never grows or shrinks when switching tabs
   (a short tab like Foto used to shrink-wrap the whole modal down with
   it, via display:none on the rest). Only .active is visible/interactive
   (visibility, not display:none, so it still counts toward the grid's
   height and — same as display:none did — is removed from the tab order
   and accessibility tree while hidden). */
.product-tab-panels { flex:1; min-height:0; overflow-y:auto; padding-top:15px; display:grid; }
.product-tab-panel {
    grid-area:1/1; display:flex; flex-direction:column; gap:15px;
    visibility:hidden; pointer-events:none;
}
.product-tab-panel.active { visibility:visible; pointer-events:auto; }

@media (max-width: 767px) {
    .product-tab { padding:10px 4px; font-size:12px; }
    .product-tab-panels { padding-top:16px; }
}

/* Cat select */
.cat-select-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(130px,1fr)); gap:8px; }
.cat-select-card {
    padding:12px; border-radius:10px; border:1px solid var(--bd-2);
    background:var(--bg-input); cursor:pointer; transition:all 0.1s; text-align:left;
}
.cat-select-card:hover     { border-color:var(--bd-1); background:var(--bg-deep); }
.cat-select-card.selected  { border-color:#C1440E; background:rgba(193,68,14,0.1); }
.cat-select-card-name  { font-size:13px; font-weight:500; color:var(--tx-1); }
.cat-select-card-count { font-size:11px; color:var(--tx-6); margin-top:2px; }
.cat-select-new {
    padding:12px; border-radius:10px; border:1px dashed var(--bd-2);
    background:none; cursor:pointer; color:var(--tx-6); font-size:13px;
    display:flex; align-items:center; gap:6px;
    transition:border-color 0.1s, color 0.1s;
}
.cat-select-new:hover { border-color:var(--tx-6); color:var(--tx-3); }

@media (max-width: 767px) {
    .cat-select-grid { grid-template-columns:repeat(2,1fr); gap:10px; }
    .cat-select-card { padding:14px 12px; }
    .cat-select-card-name { font-size:14px; }
    .cat-select-new { padding:14px 12px; font-size:14px; }
}

/* Form fields — gap between a field's title (.field-label) and its control
   below (input/pills/checkbox/spicy row/…). Bumped from a tight 5px to
   give every field-label some breathing room from what's under it —
   applies uniformly since .field is the shared base for every field in
   General/Foto/Detalles/Alérgenos, both desktop and mobile copies. */
.field { display:flex; flex-direction:column; gap:var(--sp-2); }
.field-label {
    font-size:11px; font-weight:600; color:var(--tx-5);
    text-transform:uppercase; letter-spacing:0.07em;
    display:flex; align-items:center; gap:5px;
}
.req { color:#C1440E; }
.opt { color:var(--tx-8); font-weight:400; text-transform:none; letter-spacing:0; font-size:10px; }
.field input, .field textarea, .field select {
    background:var(--bg-input); border:1px solid var(--bd-2); color:var(--tx-1);
    font-size:14px; padding:10px 12px; border-radius:9px;
    outline:none; width:100%; font-family:inherit;
    transition:border-color 0.15s; min-height:42px;
}
.field input::placeholder, .field textarea::placeholder { color:var(--tx-7); }
.field input:focus, .field textarea:focus, .field select:focus { border-color:var(--tx-5); }
.field input.error { border-color:rgba(240,100,80,0.6); }
.field-error { font-size:11px; color:#F0997B; margin-top:2px; display:none; }
.field-error.show { display:block; }
/* min-height, not a fixed height — a real dish description can run
   longer than 3-4 lines, and the previous height:76px + resize:none
   combination gave no way to see more of it than an internally-scrolled
   76px box. resize:vertical lets the owner stretch it by hand instead;
   it only grows the textarea's own box within the already-scrollable
   .product-tab-panels (see that rule's own comment), so dragging it
   taller can never resize the modal/sheet itself. 88px ≈ 3 comfortable
   lines at this font-size/line-height + the field's own padding. */
.field textarea { resize:vertical; min-height:88px; line-height:1.55; }
.field-row { display:flex; gap:10px; }
.field-row .field { flex:1; }

/* "Añadir varios precios" — a thin rule + real air above it, separating
   it from the base price input right above (previously just the panel's
   generic field-to-field gap, no different from the space between any
   two ordinary fields — read as an orphaned field rather than an
   optional action attached to the price). */
.price-variants-section {
    margin-top: var(--sp-2);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--bd-1);
}

/* Suplemento — sits right under "Añadir varios precios" with no margin
   of its own (previously a hardcoded 22px, MORE than separated it from
   the price-variants toggle above than that toggle was from the price
   input — backwards: the two price actions should read as one grouped
   set, separated as a whole from the price by the border-top above, not
   from each other). Falls back to .product-tab-panel's own gap, same as
   any two related lines. See showSupplementField()/hideSupplementField().
   Same treatment on .price-variants-toggle (an additional class on the
   other section's toggle, not a separate rule) so both read as the same
   kind of secondary, optional action rather than a real field. */
.extra-price-section { margin-top: 0; }
.extra-price-toggle {
    display:inline-flex; align-items:center; gap:5px; margin-top:8px;
    font-size:var(--fs-sm); color:var(--tx-muted); cursor:pointer; user-select:none; transition:color 0.1s;
}
.extra-price-toggle:hover { color:var(--tx-3); }
.extra-price-toggle:focus-visible { outline:2px solid var(--brand); outline-offset:2px; border-radius:4px; }
.extra-price-toggle i { font-size:var(--fs-sm); }
/* Hidden until the section is opened — previously an always-visible <p>,
   which gave "un solo precio" (the common case) unwanted visual weight
   below the base price. Shown/hidden alongside the group/field itself in
   togglePriceVariants()/showSupplementField()/hideSupplementField() and
   the two "load an already-saved dish" paths, revealPriceVariants()/
   revealSupplementField() — and hidden again by resetProduct(). Shared
   by both sections (their toggles are already the same class), so this
   only needs one rule. */
.extra-price-hint { font-size:var(--fs-sm); color:var(--tx-muted); margin-top:6px; line-height:1.5; }
.extra-price-field { margin-top:12px; }
.extra-price-field .field-label { display:flex; align-items:center; gap:6px; }
.extra-price-remove {
    font-size:15px; line-height:1; font-weight:600; color:var(--tx-6); cursor:pointer; padding:0 2px;
}
.extra-price-remove:hover { color:var(--tx-1); }

/* Precios por variante — one persistent toggle (expand: re-parents
   the base price row in as the list's first row, plus one empty
   variant row; collapse: clears everything and moves the base row
   back to its original spot — see togglePriceVariants()) reveals a
   grouped box that holds the base row, extra rows, and the "add"
   link together, so the whole thing reads as one coherent price
   list rather than loose top-level fields. */
.price-variants-group {
    margin-top:10px; padding:12px; border-radius:10px;
    background:var(--bg-card); border:1px solid var(--bd-1);
}
.price-variants-group-label { margin-bottom:10px; }
/* Column headers render once, above the list — see the "field-label
   display:none" rule below for how the base row's OWN "Precio"
   label (needed when it's outside the group, in the simple state)
   gets out of the way once these headers take over. */
.price-variant-headers { display:flex; gap:8px; align-items:center; margin-bottom:6px; }
.price-variant-header-label { flex:1.3; }
.price-variant-header-price { flex:1; }
.price-variant-rows { display:flex; flex-direction:column; gap:8px; }
.price-variant-row-item { display:flex; gap:8px; align-items:center; }
.price-variant-label-field { flex:1.3; }
.price-variant-price-field { flex:1; }
/* Every row's own field-label is hidden once inside the group — the
   column headers above take over that job — so the base row's
   input matches variant rows' bare-input height/padding exactly.
   Harmless no-op for variant rows, which never have a label at all. */
.price-variants-group .price-variant-row-item .field-label { display:none; }
/* Same 44px width on the real ×, the base row's invisible stand-in
   for it, and the header's — so the Etiqueta/Precio columns line up
   in a straight edge across every row and the header. Only the real
   × needs the matching height (its 44×44 tap target); the other two
   are zero-height placeholders, purely for width. */
.price-variant-remove, .price-variant-remove-spacer, .price-variant-header-spacer {
    width:44px; flex-shrink:0;
}
.price-variant-remove {
    display:flex; align-items:center; justify-content:center; height:44px;
    font-size:18px; line-height:1; font-weight:600;
    color:var(--tx-6); cursor:pointer;
}
.price-variant-remove:hover { color:var(--tx-1); }
.price-variant-add {
    display:inline-flex; align-items:center; gap:5px; margin-top:10px;
    font-size:12px; color:var(--tx-6); cursor:pointer; user-select:none; transition:color 0.1s;
}
.price-variant-add:hover { color:var(--tx-3); }

/* Detalles tab groups into 4 blocks — Recomendado (destacar) / Etiquetas /
   Picante / Nutrición (datos numéricos) — that used to read as one
   apelotonado list, separated only by the panel's generic 15px gap (same
   as any two unrelated fields). Same thin-rule + air treatment as
   .price-variants-section in General (identical tokens), so both tabs
   read as the same family rather than two different conventions. Hooked
   onto existing classes only — .sw-recommend-box (the Recomendado
   checkbox), .spicy-row (Picante) and .nutrition-section — no markup/JS
   changes. */
.field:has(.sw-recommend-box) + *,
.field:has(.spicy-row) {
    margin-top: var(--sp-2);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--bd-1);
}
.nutrition-section {
    margin-top: var(--sp-2);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--bd-1);
}

/* Nutrición toggle — deliberately heavier than .extra-price-toggle's other
   two users ("Añadir varios precios"/"Añadir suplemento" stay as discreet
   as they already were; this overrides ONLY the .nutrition-toggle hook, so
   nothing else sharing the .extra-price-toggle base is affected). The base
   rule reads as a footnote link; this one needs to read as an available
   action — a subtle framed chip (border + very faint fill, same radius as
   the form inputs) at body-text size/weight instead of the small muted
   link. ":focus-visible" still comes from the shared .extra-price-toggle
   rule. */
.nutrition-toggle {
    font-size: var(--fs-md); font-weight:500; color: var(--tx-1);
    padding: var(--sp-2) var(--sp-3);
    border: 1px solid var(--bd-1); border-radius: var(--r-md);
    background: var(--bg-hover);
}
.nutrition-toggle:hover { color: var(--tx-hi); border-color: var(--bd-2); }
/* .extra-price-toggle:focus-visible sets border-radius:4px (line ~259) —
   fine for the plain-link price toggles, but would visibly snap this
   chip's own 9px radius down on focus. Same specificity (two classes) as
   that rule but declared later, so this wins without touching the shared
   rule the price toggles still rely on. */
.nutrition-toggle:focus-visible { border-radius: var(--r-md); }
.nutrition-toggle i { font-size: var(--fs-md); }
/* "(opcional)" — same span/class the rest of Detalles' optional fields use
   (NIVEL DE PICANTE/ETIQUETAS), but a notch bigger than .opt's default
   10px since it sits next to fs-md text here rather than an 11px
   field-label; stays visible in both toggle states (a sibling of
   .nutrition-toggle-text, not touched by toggleNutrition()'s textContent=). */
.nutrition-toggle-opt { font-size: var(--fs-xs); }

/* Nutrición — collapsed by default (see toggleNutrition() in
   _product_js.html.twig). .nutrition-fields replicates the flex/gap a
   .field would normally give its children automatically, since this
   wrapper is deliberately not itself a .field (its own label + 5
   sub-fields need more room to breathe than .field's 5px gap gives a
   label+input pair). */
.nutrition-fields { display:flex; flex-direction:column; gap:12px; margin-top:10px; }
.nutrition-group-label { margin-bottom:-2px; }

@media (max-width: 767px) {
    /* font-size:16px on all three prevents iOS Safari's auto-zoom on
       focus; min-height:48px (a tap-target size) is split out to skip
       textarea — it would otherwise override the 88px above with a
       smaller mobile value, undoing it. */
    .field input, .field textarea, .field select { font-size:16px; }
    .field input, .field select { min-height:48px; }
    .field-row { flex-direction:column; }
    /* .nutrition-toggle stays inline-flex (shrink-to-fit chip) on desktop,
       where the modal is wide enough — but "Añadir información nutricional
       (opcional)" at fs-md plus the icon can get close to a 390px viewport's
       width, and inline-flex never wraps unless something constrains its
       box first. Full-width flex row here lets it wrap onto a second line
       instead of forcing horizontal scroll — also a bigger, easier tap
       target on mobile. */
    .nutrition-toggle { display:flex; width:100%; flex-wrap:wrap; }
}

/* Image upload — its own tab now (Foto), with the room a 76px line-item
   box never had: 76px on object-fit:cover cropped most food photos down
   to an unrecognizable sliver. Sized as a real photo preview instead. */
.img-upload {
    width:100%; aspect-ratio:16/9; max-height:260px; border:1px dashed var(--bd-2); border-radius:var(--r-lg);
    display:flex; align-items:center; justify-content:center; gap:8px;
    font-size:13px; color:var(--tx-6); cursor:pointer; background:var(--bg-card);
    transition:border-color 0.15s, color 0.15s; position:relative; overflow:hidden;
}
.img-upload:hover, .img-upload.drag-over { border-color:var(--tx-6); color:var(--tx-3); }
.img-upload img {
    position:absolute; inset:0; width:100%; height:100%; object-fit:cover;
    opacity:0; transition:opacity 0.2s;
}
.img-upload img.loaded { opacity:1; }
.img-upload-hint { position:relative; z-index:1; display:flex; flex-direction:column; align-items:center; gap:8px; text-align:center; padding:0 var(--sp-4); }
.img-upload-hint i { font-size:26px; color:var(--tx-7); }

/* Shown once the <img> starts loading (a saved photo is a real network
   fetch of the original upload — there's no server-side thumbnail yet, so
   it can take a moment) — a spinner reads as "loading", an empty box
   reads as broken. Removed the instant the image's load event fires. */
.img-upload-spinner {
    position:absolute; z-index:1; width:22px; height:22px; border-radius:50%;
    border:2px solid var(--bd-2); border-top-color:var(--tx-4);
    animation:img-upload-spin 0.7s linear infinite; display:none;
}
.img-upload.loading .img-upload-spinner { display:block; }
.img-upload.loading .img-upload-hint { display:none; }
@keyframes img-upload-spin { to { transform:rotate(360deg); } }

/* "Cambiar foto" — a real button below the photo, not an overlay on top
   of it (tried that first, blocked the photo itself). Only shown once
   there's an image (previewImage()/renderProductImage() reveal it,
   opposite to .img-upload-hint) — the dropzone's own hint is the call to
   action until then. Sized up from the base .btn (bigger padding/font,
   full width) so it reads as a real action, not an afterthought. */
.img-upload-change-btn {
    width:100%; margin-top:10px; justify-content:center;
    padding:11px; min-height:44px; font-size:14px;
}

@media (max-width: 767px) {
    .img-upload-change-btn { min-height:48px; }
}

/* Spicy */
.chili {
    display: inline-block; line-height: 1;
    /* Convert emoji silhouette to solid red */
    filter: brightness(0) invert(30%) sepia(100%) saturate(800%) hue-rotate(320deg) brightness(1.1);
}
.spicy-row { display:flex; gap:6px; align-items:center; flex-wrap:wrap; }
.spicy-pip {
    width:32px; height:32px; border-radius:7px; border:1px solid transparent;
    background:transparent; display:flex; align-items:center; justify-content:center;
    cursor:pointer; font-size:17px; transition:all 0.1s; user-select:none;
    opacity: 0.3;
}
.spicy-pip.on   { opacity:1; background:rgba(220,38,38,0.08); border-color:rgba(220,38,38,0.22); }
.spicy-pip:hover { opacity:0.65; }
.spicy-text { font-size:12px; color:var(--tx-6); }

@media (max-width: 767px) {
    .spicy-pip { width:38px; height:38px; font-size:20px; }
}

/* Tags */
.tag-pills { display:flex; flex-wrap:wrap; gap:6px; }
.tag-pill  {
    font-size:12px; padding:5px 11px; border-radius:20px; border:1px solid var(--bd-2);
    background:var(--bg-input); color:var(--tx-5); cursor:pointer; transition:all 0.1s; user-select:none;
    min-height:32px; display:flex; align-items:center;
}
.tag-pill.on { background:rgba(99,153,34,0.15); color:#7aad40; border-color:rgba(99,153,34,0.35); }
.tag-pill:hover:not(.on) { border-color:var(--bd-2); color:var(--tx-3); }

@media (max-width: 767px) {
    .tag-pill { font-size:13px; min-height:38px; padding:6px 14px; }
}

/* Recommended-dish toggle */
.sw-recommend-box {
    display:flex; align-items:flex-start; gap:10px;
    padding:12px 14px; background:var(--bg-card);
    border:1px solid var(--bd-2); border-radius:10px; cursor:pointer;
}
.sw-recommend-box input[type="checkbox"] {
    width:18px; height:18px; margin-top:1px; flex-shrink:0;
    accent-color:#D4AF37; cursor:pointer;
}
.sw-recommend-text { display:flex; flex-direction:column; gap:2px; }
.sw-recommend-label { font-size:13px; font-weight:600; color:var(--tx-1); }
.sw-recommend-hint { font-size:11.5px; color:var(--tx-6); line-height:1.5; }
.sw-recommend-box input:checked ~ .sw-recommend-text .sw-recommend-label { color:#D4AF37; }

/* Allergens */
.allergen-block { margin-top:14px; }
.allergen-block:first-child { margin-top:0; }
.allergen-subtitle { font-size:11px; font-weight:600; color:var(--tx-4); margin-bottom:4px; }
.allergen-hint { font-size:11px; color:var(--tx-7); line-height:1.5; margin-top:5px; }
/* Deliberately --tx-muted (AA-safe), not --tx-7 like .allergen-hint above —
   this is a real "we couldn't verify this" state, not decorative copy. No
   red/alarm color per this tab's convention; the icon + wording carry the
   distinction instead. */
.allergen-computed-error { display:flex; align-items:center; gap:5px; font-size:11px; color:var(--tx-muted); line-height:1.5; margin-top:5px; }
.allergen-computed-error i { font-size:12px; flex-shrink:0; }
.allergen-chip-row { display:flex; flex-wrap:wrap; gap:6px; min-height:0; }
.allergen-empty { font-size:12px; color:var(--tx-7); }

.achip {
    font-size:12px; padding:5px 10px; border-radius:20px; border:1px solid var(--bd-2);
    display:inline-flex; align-items:center; gap:5px; min-height:30px; background:var(--bg-input); color:var(--tx-5);
}
/* Deliberately identical across all three presence states — a chip is
   informational, not a warning, and the previous red/amber coding read as
   alarm even for "confirmed free from". The AA-safe pairing (~4.5:1 in
   both themes, verified the same way as .allergen-scope-pill) rather than
   the plain .achip base (--tx-5 on --bg-input, ~2.3:1 — fails AA). Presence
   is still legible via the " · <label>" text suffix wherever it's kept
   (see allergenChipHtml()'s showPresence param) — never drop both at once. */
.achip-contains, .achip-may_contain, .achip-free_from {
    background:var(--bg-card); color:var(--tx-muted); border-color:var(--bd-2);
}
.achip-remove { cursor:pointer; opacity:0.55; display:flex; align-items:center; }
.achip-remove:hover { opacity:1; }

.allergen-ing-card { background:var(--bg-card); border:1px solid var(--bd-1); border-radius:9px; padding:10px 12px; margin-bottom:8px; }
.allergen-ing-card:last-child { margin-bottom:0; }
.allergen-ing-name { font-size:12px; font-weight:600; color:var(--tx-3); margin-bottom:7px; }
.allergen-pill-grid { display:flex; flex-wrap:wrap; gap:5px; }
.allergen-pill {
    font-size:11px; padding:4px 9px; border-radius:16px; border:1px solid var(--bd-2);
    background:var(--bg-input); color:var(--tx-6); cursor:pointer; user-select:none; transition:all 0.1s;
}
.allergen-pill[data-state="contains"]    { background:rgba(220,38,38,0.12); color:#e0684a; border-color:rgba(220,38,38,0.28); }
.allergen-pill[data-state="may_contain"] { background:transparent; color:#c78a3d; border:1px dashed rgba(199,138,61,0.55); }
.allergen-pill:hover { border-color:var(--bd-3); }

.allergen-override-adder { display:flex; flex-wrap:wrap; gap:6px; margin-top:8px; }
.allergen-override-adder select, .allergen-override-adder input {
    background:var(--bg-input); border:1px solid var(--bd-2); color:var(--tx-1);
    font-size:12px; padding:7px 9px; border-radius:8px; outline:none; font-family:inherit; min-height:0;
}
.allergen-override-adder input { flex:1; min-width:130px; }
.allergen-add-btn {
    display:flex; align-items:center; gap:5px; padding:7px 13px; border-radius:8px;
    background:var(--bg-card); border:1px solid var(--bd-2); color:var(--tx-3); font-size:12px;
    cursor:pointer; transition:all 0.1s; user-select:none; white-space:nowrap;
}
.allergen-add-btn:hover { border-color:var(--bd-3); color:var(--tx-1); }

.allergen-block-label { font-size:11px; font-weight:600; color:var(--tx-4); display:flex; align-items:center; gap:5px; }

.allergen-presence-legend {
    display:flex; flex-wrap:wrap; gap:12px; margin-top:12px; padding-top:10px;
    border-top:1px solid var(--bd-1);
}
.allergen-presence-legend span {
    display:inline-flex; align-items:center; gap:5px; font-size:11px; color:var(--tx-6);
}

/* Advanced allergen accordion — collapsed by default; see
   toggleAllergenAdvanced() and resetProduct(). */
.allergen-accordion { border:1px solid var(--bd-1); border-radius:10px; margin-top:14px; overflow:hidden; }
.allergen-accordion-toggle {
    display:flex; align-items:flex-start; gap:9px; padding:11px 13px; cursor:pointer;
    user-select:none; background:var(--bg-card); transition:background 0.15s;
}
.allergen-accordion-toggle:hover { background:var(--bg-hover); }
.allergen-accordion-toggle:focus-visible { outline:2px solid var(--brand); outline-offset:-2px; }
.allergen-accordion-chevron { font-size:14px; color:var(--tx-6); margin-top:2px; flex-shrink:0; transition:transform 0.18s; }
.allergen-accordion-toggle[aria-expanded="true"] .allergen-accordion-chevron { transform:rotate(90deg); }
.allergen-accordion-toggle-text { display:flex; flex-direction:column; gap:3px; min-width:0; }
.allergen-accordion-title { font-size:12px; font-weight:600; color:var(--tx-3); }
.allergen-accordion-badge {
    display:inline-flex; align-items:center; justify-content:center; min-width:16px; height:16px;
    padding:0 4px; border-radius:999px; background:var(--tx-6); color:var(--bg-card);
    font-size:10px; font-weight:700; margin-left:3px; vertical-align:middle;
}
/* Scope pills — informational only (no focus target of their own, no
   --brand/alarm color): tell "affects every dish" apart from "this dish
   only" while the accordion is collapsed. Inline with the title text, so
   it wraps together with it exactly like .allergen-accordion-badge above
   already does at narrow widths. */
.allergen-scope-pill {
    display:inline-flex; align-items:center; white-space:nowrap;
    font-size:var(--fs-xs); font-weight:500; color:var(--tx-muted);
    border:1px solid var(--bd-1); border-radius:var(--r-pill);
    padding:1px var(--sp-2); margin-left:var(--sp-1); vertical-align:middle;
}
/* "Affects every dish" carries the wider consequence — one notch more
   marked via a firmer border + weight, never via color/alarm. */
.allergen-scope-pill-shared { border-color:var(--bd-2); font-weight:600; }
.allergen-accordion-subtitle { font-size:11px; font-weight:400; color:var(--tx-7); line-height:1.5; }
.allergen-accordion-body { display:none; padding:13px; border-top:1px solid var(--bd-1); }
.allergen-accordion-body.open { display:block; }

/* Contextual help icons — click/tap to open a small popover; see toggleHelp(). */
.help-icon {
    display:inline-flex; align-items:center; justify-content:center; flex-shrink:0;
    width:15px; height:15px; border-radius:50%; background:var(--bg-input); border:1px solid var(--bd-2);
    color:var(--tx-6); font-size:10px; font-weight:700; line-height:1; cursor:pointer;
    user-select:none; transition:border-color 0.15s, color 0.15s;
}
.help-icon:hover, .help-icon.help-open { border-color:var(--tx-6); color:var(--tx-2); }
.help-popover {
    position:fixed; max-width:240px; background:var(--bg-card); border:1px solid var(--bd-2);
    border-radius:9px; padding:10px 12px; font-size:12px; font-weight:400; line-height:1.55;
    color:var(--tx-2); box-shadow:0 10px 28px rgba(0,0,0,0.32); z-index:600;
}

@media (max-width: 767px) {
    .allergen-override-adder select, .allergen-override-adder input { font-size:14px; padding:9px 10px; }
    .allergen-pill { font-size:12px; padding:6px 11px; }
    .help-icon { width:18px; height:18px; font-size:11px; }
}

/* Ingredients — Tom Select (base structure from tom-select.default.min.css, reskinned here).
   min-height matches .field input's 42px so the empty/typing state reads at
   the same size as every other field in this modal, not smaller. max-height
   + overflow-y:auto (same thin-scrollbar treatment as .panel-body) caps how
   tall this can grow with a long ingredient list — past ~3 rows of chips it
   scrolls internally instead of pushing "Según tus ingredientes"/Casos
   especiales further down the panel.

   .ts-dropdown (the suggestion list) is a SIBLING of .ts-control, not a
   child of it (see tom-select.index.js's setup: dropdownParent defaults to
   the wrapper, never the control) — this overflow can never clip it. */
.ts-wrapper.multi .ts-control {
    background:var(--bg-input); border:1px solid var(--bd-2); border-radius:10px;
    padding:8px 10px; gap:6px; min-height:42px; max-height:180px; overflow-y:auto;
    scrollbar-width:thin; scrollbar-color:var(--bg-tgl) transparent;
}
.ts-wrapper.multi.focus .ts-control { border-color:var(--tx-6); box-shadow:none; }
/* order:-1 + sticky are visual only — TomSelect's insertAtCaret()/caretPos
   insert new chips by real DOM position (last child stays the input),
   completely unaffected by CSS order. This just paints the same input node
   pinned at the top of the scroll area instead of wherever the DOM would
   otherwise place it, so it never travels down as chips accumulate.
   flex-basis:100% forces it onto its own full-width row, and padding gives
   that row real height — both verified in the browser: without them, a
   sticky input narrower/shorter than a chip row lets whatever's scrolled up
   behind it peek out at the edges instead of being fully covered.
   background/padding need !important AND the fuller .ts-wrapper.multi
   .ts-control selector below, not just .ts-control input: tom-select's own
   CSS (background:none!important, padding:0!important on .ts-control>input)
   loads dynamically at runtime — see ensureTomSelect()'s import() — so it
   lands AFTER this stylesheet in source order. Same specificity + both
   !important ties on source order, and theirs would win; three classes
   here beats their one, confirmed by computed style in the browser
   (was rgba(0,0,0,0)/0px despite !important until this selector was
   specific enough). */
.ts-wrapper.multi .ts-control input {
    color:var(--tx-2); font-size:14px; flex:1 1 100%; min-width:100%;
    padding:4px 0 !important; order:-1; position:sticky; top:0;
    background:var(--bg-input) !important;
    /* Explicit (border-box, see base.html.twig's global box-sizing reset)
       instead of letting it fall out of line-height — .ts-dropdown's `top`
       below is computed FROM this exact number, so it can't be left to
       whatever the browser's default input line-height happens to render. */
    height:26px;
}
.ts-control input::placeholder { color:var(--tx-6); }
.ts-wrapper.multi .ts-control > .item {
    display:flex; align-items:center; gap:5px; font-size:12px;
    padding:3px 8px; border-radius:20px; background:var(--bg-deep);
    border:1px solid var(--bd-2); color:var(--tx-3);
}
.ts-wrapper.multi .ts-control > .item.active { background:var(--bg-hover); border-color:var(--bd-2); }
/* The global-ingredient globe icon (render.item() in _product_js.html.twig)
   sets its own inline style="font-size:11px" — not touched here, this is
   CSS-only — so font-size needs !important to win over that inline style;
   color has no inline value to fight and needs none. --tx-muted, not
   --tx-6/7 (~1.6-2.7:1, fails AA — same reasoning as the allergen scope
   pills and neutral chips): a decorative icon still has to be visible. */
.ts-wrapper.multi .ts-control > .item i.ti-world {
    font-size:10px !important;
    color:var(--tx-muted);
}
.plugin-remove_button .item .remove {
    border-left:none; color:var(--tx-6); padding:2px 4px; font-size:13px;
}
.plugin-remove_button .item .remove:hover { background:none; color:#F0997B; }
/* Default tom-select.default.min.css anchors this at top:100% of
   .ts-wrapper — since .ts-wrapper's own height tracks .ts-control's
   rendered height (up to the 180px scroll cap above), that puts the
   dropdown below the ENTIRE chip stack, not below the sticky input row
   sitting at its top. Overriding `top` to a literal pixel value anchored
   to the input row (not the wrapper's full, variable height) fixes that:
   8px (.ts-control's padding-top) + 26px (the sticky input's own
   explicit height, set above) + 6px (.ts-control's row gap) = 40px —
   lands right under the input regardless of how many chip rows sit
   below it or how tall the (still a SIBLING, still un-clipped by
   .ts-control's overflow — see comment above) dropdown grows.
   The dropdown still overlaps the first visible chip row while open —
   expected combobox overlay behavior, not a bug; it was already
   overlapping content below .ts-wrapper before this change, just lower
   down. */
.ts-dropdown {
    background:var(--bg-deep); border:1px solid var(--bd-2); border-radius:9px;
    top:40px; margin-top:4px; overflow:hidden; box-shadow:none;
}
.ts-dropdown .option, .ts-dropdown .create {
    padding:10px 13px; font-size:13px; color:var(--tx-2);
}
.ts-dropdown .option.active { background:var(--bg-hover); color:var(--tx-2); }
.ts-dropdown .option > div { display:flex; align-items:center; justify-content:space-between; gap:10px; }
.ts-dropdown .create { color:var(--tx-5); cursor:pointer; }
.ts-dropdown .create strong { color:var(--tx-2); font-weight:600; }
.ts-dropdown .no-results { padding:10px 13px; font-size:13px; color:var(--tx-6); }
.ing-source {
    font-size:10px; font-weight:600; text-transform:uppercase; letter-spacing:0.04em;
    padding:2px 8px; border-radius:20px; white-space:nowrap; flex-shrink:0;
}
.ing-source-restaurant { background:rgba(99,153,34,0.15); color:#7aad40; }
.ing-source-global { background:rgba(84,144,187,0.15); color:#5ba3d0; }

@media (max-width: 767px) {
    .ts-dropdown .option, .ts-dropdown .create { padding:13px; font-size:14px; }
    .ts-wrapper.multi .ts-control > .item { font-size:13px; padding:5px 12px; }
}

/* Never show the desktop modal on mobile, nor the bottom sheet on desktop */
@media (max-width: 767px) {
    .modal-overlay { display:none !important; }
}
@media (min-width: 768px) {
    .sheet-overlay { display:none !important; }
}
