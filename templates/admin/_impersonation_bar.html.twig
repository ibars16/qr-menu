{# The super-admin viewing /admin "as" a restaurant's owner (switch_user,
   see BillingController::pay()). Spanish only: the platform owner's tool. #}
{% if is_granted('IS_IMPERSONATOR') %}
    <style>
        .impersonation-bar {
            display: flex; align-items: center; justify-content: center; gap: var(--sp-3);
            padding: 4px var(--sp-4); background: var(--brand); color: #fff;
            font-size: var(--fs-sm); line-height: 1.4;
        }
        .impersonation-bar a { color: #fff; font-weight: 600; text-decoration: underline; white-space: nowrap; }
    </style>
    <div class="impersonation-bar">
        <span>Viendo como {{ app.user.restaurant ? app.user.restaurant.name : app.user.userIdentifier }}</span>
        <a href="{{ impersonation_exit_path(path('platform_index')) }}">Volver a Plataforma</a>
    </div>
{% endif %}
