{# "Elegir plan" dialog (owner without a live Stripe subscription): admin's
   modal on desktop, bottom sheet on mobile, each with its own copy of the
   form. Posts to BillingController::checkout(), which redirects to Stripe.
   Styles: .billing-dialog in admin/base.html.twig. Prices come from
   app.billing_prices (config/services.yaml).

   The reseller's panel passes its own checkout_route, checkout_token_id,
   plan_option_template (each option's content, given `plan`) and
   plan_note (a line under the options). A reseller's restaurant passes
   `plans` (only those its reseller offers) and their plan_labels. #}
{% set plans = plans|default(['monthly', 'yearly']) %}
{% set checkout_route = checkout_route|default('admin_billing_checkout') %}
{% set checkout_token_id = checkout_token_id|default('billing-checkout') %}
{% set plan_labels = plan_labels|default({
    monthly: 'billing.plan_monthly'|trans({'%price%': billing_prices.monthly}, 'admin_base'),
    yearly: 'billing.plan_yearly'|trans({'%price%': billing_prices.yearly}, 'admin_base'),
}) %}
<div class="billing-dialog">
    {% for panel in [{id: 'billing-modal', overlay: 'modal-overlay', box: 'modal'}, {id: 'billing-sheet', overlay: 'sheet-overlay', box: 'sheet'}] %}
        <div class="{{ panel.overlay }}" id="{{ panel.id }}" onclick="if(event.target===this)BillingUI.close()">
            <div class="{{ panel.box }}" role="dialog" aria-modal="true" aria-labelledby="{{ panel.id }}-title">
                {% if panel.box == 'sheet' %}<div class="sheet-handle"></div>{% endif %}
                <div class="panel-header">
                    <div class="panel-title" id="{{ panel.id }}-title">{{ 'billing.dialog_title'|trans({}, 'admin_base') }}</div>
                    <button type="button" class="panel-close" onclick="BillingUI.close()" aria-label="{{ 'billing.close_aria'|trans({}, 'admin_base') }}">
                        <i class="ti ti-x" aria-hidden="true"></i>
                    </button>
                </div>
                <form method="post" action="{{ path(checkout_route) }}" style="display: contents">
                    <input type="hidden" name="_token" value="{{ csrf_token(checkout_token_id) }}">
                    <div class="panel-body">
                        <div class="plan-options">
                            {% for plan in plans %}
                                <label class="plan-option">
                                    <input type="radio" name="plan" value="{{ plan }}" {{ loop.first ? 'checked' }}>
                                    {% if plan_option_template is defined %}
                                        {% include plan_option_template %}
                                    {% else %}
                                        <span>{{ plan_labels[plan] }}</span>
                                    {% endif %}
                                </label>
                            {% endfor %}
                        </div>
                        {% if plan_note is defined %}<p class="plan-note">{{ plan_note }}</p>{% endif %}
                    </div>
                    <div class="panel-footer">
                        <button type="button" class="btn" onclick="BillingUI.close()">{{ 'billing.cancel'|trans({}, 'admin_base') }}</button>
                        <button type="submit" class="btn btn-primary"><i class="ti ti-credit-card" aria-hidden="true"></i> {{ 'billing.go_to_payment'|trans({}, 'admin_base') }}</button>
                    </div>
                </form>
            </div>
        </div>
    {% endfor %}
</div>
<script>
    const BillingUI = {
        open() {
            document.getElementById(window.innerWidth < 768 ? 'billing-sheet' : 'billing-modal').classList.add('open');
        },
        close() {
            document.getElementById('billing-modal').classList.remove('open');
            document.getElementById('billing-sheet').classList.remove('open');
        },
    };
    document.addEventListener('keydown', e => { if (e.key === 'Escape') BillingUI.close(); });
    // Arriving from the payment link (BillingController::pay()).
    (function () {
        const url = new URL(location.href);
        if (url.searchParams.get('billing') === 'choose') {
            BillingUI.open();
            url.searchParams.delete('billing');
            history.replaceState(history.state, '', url);
        }
    }());
</script>
