{#/home/david/gitProjects/qr-menu/templates/admin/menu.html.twig#}
{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'title'|trans({}, 'admin_menu') }}{% endblock %}
{% block page_title %}{{ 'title'|trans({}, 'admin_menu') }}{% endblock %}

{% block header_actions %}
    {% if totalProducts > 0 and app.environment == 'dev' %}
        <button class="btn btn-danger" onclick="deleteAllProducts()" title="{{ 'action.delete_all_products'|trans({}, 'admin_menu') }}">
            <i class="ti ti-trash" aria-hidden="true"></i>
            <span class="hide-mobile">{{ 'action.delete_all_products'|trans({}, 'admin_menu') }}</span>
        </button>
    {% endif %}
    <button class="btn" onclick="UI.openAiImport()">
        <i class="ti ti-sparkles" aria-hidden="true"></i>
        {{ 'action.import_ai'|trans({}, 'admin_menu') }}
    </button>
    <button class="btn btn-primary" onclick="ProductUI.openNewProduct(null)">
        <i class="ti ti-plus" aria-hidden="true"></i>
        {{ 'modal.product.new_title'|trans({}, 'admin_menu') }}
    </button>
{% endblock %}

{% block stylesheets %}
    <style>
        /* ── Hide labels on mobile ── */
        @media (max-width: 767px) { .hide-mobile { display: none; } }

        /* ══════════════════════════════
           CARTA
        ══════════════════════════════ */
        .menu-wrap { max-width: 860px; }

        /* Summary notices above the list (missing photo, not on the public
           menu) — same visual language as the static .info-banner in
           tags.html.twig/users.html.twig, but these are real <button>s (not
           <div>s) since they're actionable: clicking one highlights every
           dish it counts and scrolls to the first one, it doesn't just
           inform. Each is only rendered when its own count > 0
           (missingPhotoCount / notOnMenuCount, see body block below). */
        .info-banner {
            width:100%; text-align:left; font-family:inherit; appearance:none;
            background:var(--bg-nav); border:1px solid var(--bd-1); border-radius:var(--r-md);
            box-shadow:var(--shadow-sm);
            padding:var(--sp-3) var(--sp-4); font-size:var(--fs-base); color:var(--tx-muted); line-height:var(--lh-body);
            margin-bottom:var(--sp-5); display:flex; align-items:center; gap:var(--sp-3);
            cursor:pointer; transition:border-color 0.15s, background 0.15s;
        }
        .info-banner:hover { border-color:var(--bd-2); background:var(--bg-hover); }
        .info-banner:focus-visible { outline:2px solid var(--brand); outline-offset:2px; }
        .info-banner i.ti-photo-off,
        .info-banner i.ti-eye-off {
            font-size:15px; flex-shrink:0; color:var(--brand);
            width:28px; height:28px; border-radius:var(--r-pill); background:rgba(193,68,14,0.12);
            display:flex; align-items:center; justify-content:center;
        }
        .info-banner span.info-banner-text { flex:1; }
        .info-banner i.ti-chevron-right { font-size:14px; flex-shrink:0; color:var(--tx-6); }

        /* Highlight applied on click of either summary banner (see
           highlightRows() below) to the rows it counts — missing a photo,
           or not on the public menu. One shared look, one class.
           Outline instead of a background-only change so it stays visible
           on both the active and .inactive (opacity:0.4) row states. */
        .product-row.highlight-missing-photo {
            outline:2px solid var(--brand); outline-offset:2px; background:var(--bg-hover);
        }

        .empty-state  { text-align:center; padding:80px var(--sp-6); }
        .empty-icon   { font-size:52px; display:block; margin-bottom:var(--sp-4); opacity:0.2; }
        .empty-title  { font-size:var(--fs-xl); font-weight:600; color:var(--tx-hi); margin-bottom:var(--sp-2); letter-spacing:-0.3px; }
        .empty-sub    { font-size:var(--fs-md); color:var(--tx-muted); line-height:var(--lh-body); margin-bottom:var(--sp-7); max-width:340px; margin-left:auto; margin-right:auto; }
        .empty-btns   { display:flex; gap:var(--sp-3); justify-content:center; flex-wrap:wrap; }

        .cat-block    { border:1px solid var(--bd-1); border-radius:var(--r-lg); box-shadow:var(--shadow-sm); margin-bottom:var(--sp-3); overflow:hidden; }
        .cat-header   { display:flex; align-items:center; gap:var(--sp-2); padding:var(--sp-3) var(--sp-4); background:var(--bg-card); border-bottom:1px solid var(--bd-1); }
        .cat-drag     { color:var(--tx-8); cursor:grab; font-size:var(--fs-lg); flex-shrink:0; }
        .cat-drag:active { cursor:grabbing; }
        .cat-name-text { font-size:var(--fs-md); font-weight:500; color:var(--tx-1); flex:1; }
        .cat-count    {
            font-size:var(--fs-xs); font-weight:600; color:var(--tx-muted); background:var(--bg-tgl);
            padding:1px var(--sp-2); border-radius:var(--r-pill); flex-shrink:0;
        }
        .cat-actions  { display:flex; gap:var(--sp-1); }

        .toggle {
            width:32px; height:18px; border-radius:var(--r-md); background:var(--bg-tgl);
            position:relative; cursor:pointer; transition:background 0.15s;
            border:none; padding:0; flex-shrink:0;
        }
        .toggle::after {
            content:''; position:absolute; width:12px; height:12px;
            border-radius:50%; background:var(--tx-6); top:3px; left:3px;
            transition:left 0.15s, background 0.15s;
        }
        /* "On" state — same green for category and product-row toggles.
           Both mean the same thing (visible/activo) so they get the same
           color; --brand (orange) stays reserved for the primary "+ Nuevo
           plato" action and destructive actions, not for state. Reuses the
           green already established for .flash-success/.toast.success. */
        .toggle.on { background:rgba(99,153,34,0.25); }
        .toggle.on::after { left:17px; background:#7aad40; }
        .toggle:focus-visible { outline:2px solid var(--brand); outline-offset:2px; }

        .icon-btn {
            width:28px; height:28px; border-radius:var(--r-sm); border:1px solid var(--bd-3);
            background:var(--bg-input); display:flex; align-items:center; justify-content:center;
            cursor:pointer; color:var(--tx-4); font-size:var(--fs-base);
            transition:color 0.1s, border-color 0.1s;
        }
        .icon-btn:hover        { color:var(--tx-1); border-color:var(--bd-2); }
        .icon-btn:focus-visible { outline:2px solid var(--brand); outline-offset:2px; }
        .icon-btn.danger:hover { color:#F0997B; border-color:rgba(240,153,123,0.3); }

        @media (max-width: 767px) {
            .icon-btn { width:36px; height:36px; font-size:16px; }
            .toggle   { width:38px; height:22px; }
            .toggle::after { width:14px; height:14px; top:4px; left:4px; }
            .toggle.on::after { left:20px; }
        }

        .products-list { padding:var(--sp-1); }
        /* align-items:flex-start (not center) so a 2-line .product-name
           doesn't push price/toggle to float at half-height — they anchor
           to the first line instead. .product-drag/.product-thumb opt back
           into vertical centering via align-self since they read better
           centered against a variable-height row than pinned to the top. */
        .product-row {
            display:flex; align-items:flex-start; gap:var(--sp-2); padding:9px var(--sp-2);
            border-radius:var(--r-sm); border:1px solid transparent; cursor:pointer;
            transition:background 0.1s, border-color 0.1s; min-height:52px;
        }
        .product-row:hover { background:var(--bg-hover); border-color:var(--bd-1); }
        .product-drag { color:var(--tx-8); cursor:grab; font-size:var(--fs-md); flex-shrink:0; align-self:center; }
        .product-drag:active { cursor:grabbing; }
        .product-thumb {
            width:38px; height:38px; border-radius:var(--r-sm); background:var(--bd-1);
            border:1px solid var(--bd-3); display:flex; align-items:center;
            justify-content:center; font-size:18px; flex-shrink:0; overflow:hidden;
            align-self:center;
        }
        .product-thumb img { width:100%; height:100%; object-fit:cover; }
        .product-info { flex:1; min-width:0; }
        .product-name {
            font-size:var(--fs-base); font-weight:500; color:var(--tx-1); line-height:1.3;
            display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden;
        }
        .product-price {
            display:flex; align-items:baseline; justify-content:flex-end; gap:3px;
            flex-shrink:0; min-width:58px;
        }
        .price-amount { font-size:var(--fs-base); font-weight:600; color:var(--tx-1); }
        .price-currency { font-size:var(--fs-xs); font-weight:500; color:var(--tx-5); }
        .product-row.inactive { opacity:0.4; }

        @media (max-width: 767px) {
            .product-row  { min-height:64px; padding:var(--sp-3) var(--sp-2); }
            .product-thumb { width:44px; height:44px; font-size:20px; }
            .product-name { font-size:var(--fs-md); }
            .price-amount { font-size:var(--fs-md); }
            .price-currency { font-size:var(--fs-sm); }
        }

        .add-row { padding:var(--sp-1) var(--sp-2) var(--sp-2); }
        .add-product-btn {
            width:100%; padding:var(--sp-2); border:1px dashed var(--bd-2); border-radius:var(--r-sm);
            background:none; color:var(--tx-muted); font-weight:500; font-size:var(--fs-sm); cursor:pointer;
            display:flex; align-items:center; justify-content:center; gap:5px;
            min-height:40px; transition:border-color 0.15s, color 0.15s, background 0.15s;
        }
        .add-product-btn:hover { border-color:var(--brand); color:var(--brand); background:rgba(193,68,14,0.06); }
        .add-product-btn:focus-visible { outline:2px solid var(--brand); outline-offset:2px; }

        @media (max-width: 767px) {
            .cat-block { margin-bottom:var(--sp-4); }
            .add-product-btn { min-height:48px; font-size:var(--fs-base); }
        }

        {% include 'admin/_product_modal_css.html.twig' %}
    </style>
{% endblock %}

{% block body %}
    <div class="menu-wrap">

        {# Above the photo banner: dishes customers can't see at all matter more than dishes without a picture. #}
        {% if notOnMenuCount > 0 %}
            <button type="button" class="info-banner" id="not-on-menu-banner" onclick="highlightNotOnMenu()">
                <i class="ti ti-eye-off" aria-hidden="true"></i>
                <span class="info-banner-text">
                    {{ (notOnMenuCount == 1 ? 'notice.not_on_menu_singular' : 'notice.not_on_menu_plural')|trans({'%count%': notOnMenuCount}, 'admin_menu') }}
                </span>
                <i class="ti ti-chevron-right" aria-hidden="true"></i>
            </button>
        {% endif %}

        {% if missingPhotoCount > 0 %}
            <button type="button" class="info-banner" id="missing-photo-banner" onclick="highlightMissingPhotos()">
                <i class="ti ti-photo-off" aria-hidden="true"></i>
                <span class="info-banner-text">
                    {{ (missingPhotoCount == 1 ? 'notice.missing_photos_singular' : 'notice.missing_photos_plural')|trans({'%count%': missingPhotoCount}, 'admin_menu') }}
                </span>
                <i class="ti ti-chevron-right" aria-hidden="true"></i>
            </button>
        {% endif %}

        {% if categories|length == 0 %}
            <div class="empty-state">
                <span class="empty-icon">🍽️</span>
                <div class="empty-title">{{ 'empty.title'|trans({}, 'admin_menu') }}</div>
                <div class="empty-sub">
                    {{ 'empty.subtitle'|trans({}, 'admin_menu') }}
                </div>
                <div class="empty-btns">
                    <button class="btn btn-ai" onclick="UI.openAiImport()">
                        <i class="ti ti-sparkles" aria-hidden="true"></i> {{ 'empty.import_ai'|trans({}, 'admin_menu') }}
                    </button>
                    <button class="btn btn-primary" onclick="UI.openNewCategory()">
                        <i class="ti ti-folder-plus" aria-hidden="true"></i> {{ 'empty.create_first_category'|trans({}, 'admin_menu') }}
                    </button>
                </div>
            </div>

        {% else %}

            <div id="cats-list">
                {% for category in categories %}
                    {% set catT = category.getDisplayTranslation(locale) %}
                    {% set catName = catT ? catT.name : 'common.unnamed'|trans({}, 'admin_menu') %}

                    <div class="cat-block" data-id="{{ category.id }}">
                        <div class="cat-header">
                            <i class="ti ti-grip-vertical cat-drag" aria-hidden="true"></i>
                            <span class="cat-name-text">{{ catName }}</span>
                            <span class="cat-count">{{ category.products|length }}</span>
                            <div class="cat-actions">
                                <button class="toggle {{ category.isActive ? 'on' : '' }}"
                                        onclick="toggleCategory({{ category.id }}, this)"
                                        title="{{ category.isActive ? 'category.toggle_hide_title'|trans({}, 'admin_menu') : 'category.toggle_show_title'|trans({}, 'admin_menu') }}"
                                        aria-label="{{ 'category.toggle_aria'|trans({}, 'admin_menu') }}"></button>
                                <button class="icon-btn"
                                        onclick="UI.openEditCategory({{ category.id }}, '{{ catName|e('js') }}', '{{ category.type ? category.type.value : '' }}')"
                                        title="{{ 'category.edit_title'|trans({}, 'admin_menu') }}">
                                    <i class="ti ti-edit" aria-hidden="true"></i>
                                </button>
                                <button class="icon-btn danger"
                                        onclick="deleteCategory({{ category.id }}, '{{ catName|e('js') }}', {{ category.products|length }}, this)"
                                        title="{{ 'category.delete_title'|trans({}, 'admin_menu') }}">
                                    <i class="ti ti-trash" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>

                        <div class="products-list" id="prods-{{ category.id }}">
                            {% for product in category.products %}
                                {% set pT = product.getDisplayTranslation(locale) %}
                                {% set pName = pT ? pT.name : 'common.unnamed'|trans({}, 'admin_menu') %}
                                <div class="product-row {{ not product.isActive ? 'inactive' : '' }}"
                                     data-id="{{ product.id }}"
                                     onclick="ProductUI.openEditProduct({{ product.id }})">
                                    <i class="ti ti-grip-vertical product-drag" aria-hidden="true"></i>
                                    <div class="product-thumb">
                                        {% if product.image %}
                                            <img src="{{ asset('uploads/products/' ~ product.image) }}" alt="{{ pName }}">
                                        {% else %}🍽️{% endif %}
                                    </div>
                                    <div class="product-info">
                                        <div class="product-name">{{ pName }}</div>
                                        {% include 'admin/_product_menu_notice.html.twig' %}
                                    </div>
                                    <div class="product-price">
                                        <span class="price-amount">{{ (product.basePrice / 100)|number_format(2) }}</span>
                                        <span class="price-currency">{{ restaurant.currency }}</span>
                                    </div>
                                    <button class="toggle {{ product.isActive ? 'on' : '' }}"
                                            onclick="event.stopPropagation(); toggleProduct({{ product.id }}, this)"
                                            title="{{ product.isActive ? 'product.visible'|trans({}, 'admin_menu') : 'product.hidden'|trans({}, 'admin_menu') }}"
                                            aria-label="{{ 'product.toggle_aria'|trans({}, 'admin_menu') }}"></button>
                                </div>
                            {% endfor %}
                        </div>

                        <div class="add-row">
                            <button class="add-product-btn" onclick="ProductUI.openNewProduct({{ category.id }})">
                                <i class="ti ti-plus" aria-hidden="true"></i>
                                {{ 'product.add_to_category'|trans({'%category%': catName}, 'admin_menu') }}
                            </button>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

    </div>

    {# ════════════════════════════
   DESKTOP: modal categoría
════════════════════════════ #}
    <div class="modal-overlay" id="desktop-cat-modal"
         onclick="if(event.target===this)UI.closeCat()">
        <div class="modal modal-sm">
            <div class="panel-header">
                <div class="panel-title" id="cat-modal-title">{{ 'modal.category.new_title'|trans({}, 'admin_menu') }}</div>
                <button class="panel-close" onclick="UI.closeCat()" aria-label="{{ 'modal.close_aria'|trans({}, 'admin_menu') }}">
                    <i class="ti ti-x" aria-hidden="true"></i>
                </button>
            </div>
            <div class="panel-body">
                {% include 'admin/_cat_fields.html.twig' %}
            </div>
            <div class="panel-footer">
                <button class="btn" onclick="UI.closeCat()">{{ 'action.cancel'|trans({}, 'admin_menu') }}</button>
                <button class="btn btn-primary" onclick="saveCategory()">
                    <i class="ti ti-check" aria-hidden="true"></i> {{ 'action.save'|trans({}, 'admin_menu') }}
                </button>
            </div>
        </div>
    </div>

    {# ════════════════════════════
   MOBILE: bottom sheet categoría
════════════════════════════ #}
    <div class="sheet-overlay" id="mobile-cat-sheet"
         onclick="if(event.target===this)UI.closeCat()">
        <div class="sheet">
            <div class="sheet-handle"></div>
            <div class="panel-header">
                <div class="panel-title" id="cat-sheet-title">{{ 'modal.category.new_title'|trans({}, 'admin_menu') }}</div>
                <button class="panel-close" onclick="UI.closeCat()" aria-label="{{ 'modal.close_aria'|trans({}, 'admin_menu') }}">
                    <i class="ti ti-x" aria-hidden="true"></i>
                </button>
            </div>
            <div class="panel-body">
                {% include 'admin/_cat_fields.html.twig' %}
            </div>
            <div class="panel-footer">
                <button class="btn" onclick="UI.closeCat()">{{ 'action.cancel'|trans({}, 'admin_menu') }}</button>
                <button class="btn btn-primary" onclick="saveCategory()">
                    <i class="ti ti-check" aria-hidden="true"></i> {{ 'action.save'|trans({}, 'admin_menu') }}
                </button>
            </div>
        </div>
    </div>

    {% include 'admin/_product_modal.html.twig' with {'show_category_step': true} %}

{% endblock %}

{% block javascripts %}
    <script>
        const MENU_IMPORT_URL        = "{{ path('admin_menu_import_new') }}";
        const MSG_NEW_CATEGORY       = "{{ 'modal.category.new_title'|trans({}, 'admin_menu')|e('js') }}";
        const MSG_EDIT_CATEGORY      = "{{ 'modal.category.edit_title'|trans({}, 'admin_menu')|e('js') }}";
        const MSG_CATEGORY_UPDATED   = "{{ 'js.category_updated'|trans({}, 'admin_menu')|e('js') }}";
        const MSG_CATEGORY_CREATED   = "{{ 'js.category_created'|trans({}, 'admin_menu')|e('js') }}";
        const MSG_CATEGORY_VISIBLE   = "{{ 'category.toggle_visible'|trans({}, 'admin_menu')|e('js') }}";
        const MSG_CATEGORY_HIDDEN    = "{{ 'category.toggle_hidden'|trans({}, 'admin_menu')|e('js') }}";
        const MSG_CATEGORY_HIDE_TITLE = "{{ 'category.toggle_hide_title'|trans({}, 'admin_menu')|e('js') }}";
        const MSG_CATEGORY_SHOW_TITLE = "{{ 'category.toggle_show_title'|trans({}, 'admin_menu')|e('js') }}";
        const MSG_CONFIRM_DELETE_CATEGORY_WITH_PRODUCTS = "{{ 'js.confirm_delete_category_with_products'|trans({}, 'admin_menu')|e('js') }}";
        const MSG_CONFIRM_DELETE_CATEGORY = "{{ 'js.confirm_delete_category'|trans({}, 'admin_menu')|e('js') }}";
        const MSG_CATEGORY_DELETED   = "{{ 'js.category_deleted'|trans({}, 'admin_menu')|e('js') }}";
        const MSG_CONFIRM_DELETE_ALL_PRODUCTS_STEP1 = "{{ 'js.confirm_delete_all_products_step1'|trans({}, 'admin_menu')|e('js') }}";
        const MSG_CONFIRM_DELETE_ALL_PRODUCTS_STEP2 = "{{ 'js.confirm_delete_all_products_step2'|trans({}, 'admin_menu')|e('js') }}";
        const MSG_ALL_PRODUCTS_DELETED = "{{ 'js.all_products_deleted'|trans({}, 'admin_menu')|e('js') }}";
        const TOTAL_PRODUCTS_COUNT = {{ totalProducts }};

        // S, isMobile, apiFetch, panelEl/getVal/setVal come from
        // _admin_js_utils.html.twig — declare S first since the product JS
        // (and this page's own category JS) both read/write its fields.
        const S = {
            productId:   null,
            categoryId:  null,
            menuSectionId: null,
            editingCatId: null,
            spicy:       0,
            allergenOverrides: [],
            ingredientAllergenCache: {},
            // Canvas-captured poster for a freshly-picked clip, staged here
            // (not in an <input>) since #p-img-input holds the clip file
            // itself — see capturePosterFromClip() in _product_js.html.twig.
            stagedPosterFile: null,
        };
    </script>
    {% include 'admin/_admin_js_utils.html.twig' %}
    {% include 'admin/_product_js.html.twig' %}
    <script>
        // ── UI controller (category only — dish editing is ProductUI, see
        // _product_js.html.twig) ─────────────────────────────────────────────
        const UI = {
            openNewCategory() {
                S.editingCatId = null;
                document.getElementById('cat-modal-title').textContent  = MSG_NEW_CATEGORY;
                document.getElementById('cat-sheet-title').textContent  = MSG_NEW_CATEGORY;
                document.getElementById('cat-name-input').value = '';
                document.getElementById('cat-type-select').value = '';
                document.getElementById('cat-name-error').classList.remove('show');
                this._openCat();
                setTimeout(() => document.getElementById('cat-name-input').focus(), 80);
            },
            openEditCategory(id, name, type) {
                S.editingCatId = id;
                document.getElementById('cat-modal-title').textContent = MSG_EDIT_CATEGORY;
                document.getElementById('cat-sheet-title').textContent = MSG_EDIT_CATEGORY;
                document.getElementById('cat-name-input').value = name;
                document.getElementById('cat-type-select').value = type || '';
                document.getElementById('cat-name-error').classList.remove('show');
                this._openCat();
                setTimeout(() => document.getElementById('cat-name-input').focus(), 80);
            },
            _openCat() {
                if (isMobile()) document.getElementById('mobile-cat-sheet').classList.add('open');
                else            document.getElementById('desktop-cat-modal').classList.add('open');
            },
            closeCat() {
                document.getElementById('mobile-cat-sheet').classList.remove('open');
                document.getElementById('desktop-cat-modal').classList.remove('open');
            },

            openAiImport() { window.location.href = MENU_IMPORT_URL; },
        };

        // ── Category CRUD ──────────────────────────────────────────────────────────
        async function saveCategory() {
            const name = document.getElementById('cat-name-input').value.trim();
            if (!name) { document.getElementById('cat-name-error').classList.add('show'); return; }
            document.getElementById('cat-name-error').classList.remove('show');
            const type = document.getElementById('cat-type-select').value || null;

            const url = S.editingCatId
                ? `/admin/categories/${S.editingCatId}/edit`
                : '/admin/categories/create';

            const data = await apiFetch(url, { name, type });
            if (data.error) { showToast(data.error, 'error'); return; }

            showToast(S.editingCatId ? MSG_CATEGORY_UPDATED : MSG_CATEGORY_CREATED, 'success');
            UI.closeCat();
            setTimeout(() => location.reload(), 700);
        }

        async function toggleCategory(id, btn) {
            const data = await apiFetch(`/admin/categories/${id}/toggle`);
            btn.classList.toggle('on', data.active);
            btn.title = data.active ? MSG_CATEGORY_HIDE_TITLE : MSG_CATEGORY_SHOW_TITLE;
            showToast(data.active ? MSG_CATEGORY_VISIBLE : MSG_CATEGORY_HIDDEN);
        }

        async function deleteCategory(id, name, count, btn) {
            const msg = count > 0
                ? MSG_CONFIRM_DELETE_CATEGORY_WITH_PRODUCTS.replace('%name%', name).replace('%count%', count)
                : MSG_CONFIRM_DELETE_CATEGORY.replace('%name%', name);
            if (!confirm(msg)) return;
            const data = await apiFetch(`/admin/categories/${id}/delete`);
            if (data.ok) {
                btn.closest('.cat-block').remove();
                showToast(MSG_CATEGORY_DELETED, 'success');
                if (!document.querySelector('.cat-block')) location.reload();
            }
        }

        // ── Delete all dishes (categories stay) ──
        // Two sequential confirm() dialogs — this wipes every dish in the
        // whole carta in one shot and can't be undone.
        async function deleteAllProducts() {
            const step1 = MSG_CONFIRM_DELETE_ALL_PRODUCTS_STEP1.replace('%count%', TOTAL_PRODUCTS_COUNT);
            if (!confirm(step1)) return;
            if (!confirm(MSG_CONFIRM_DELETE_ALL_PRODUCTS_STEP2)) return;

            const data = await apiFetch('/admin/products/delete-all');
            if (data.ok) {
                showToast(MSG_ALL_PRODUCTS_DELETED, 'success');
                location.reload();
            }
        }

        // Dish-row highlighting shared by the two summary banners above the
        // list (#not-on-menu-banner, #missing-photo-banner). Each banner
        // only decides WHICH rows (its own filter, below); marking them,
        // scrolling to the first and the no-timer/no-toggle behavior are
        // this one function. It clears any existing highlight first, so
        // pressing one banner after the other never leaves two marks with
        // different meanings on screen; pressing the same one twice just
        // re-marks (and re-scrolls). No un-highlight timer on purpose —
        // leaving it visible is more useful than fading it, and a page
        // reload naturally clears it. (The class keeps its original
        // "missing-photo" name: it is the one shared look, see its CSS.)
        function highlightRows(rows) {
            document.querySelectorAll('.product-row.highlight-missing-photo')
                .forEach(row => row.classList.remove('highlight-missing-photo'));
            rows.forEach(row => row.classList.add('highlight-missing-photo'));
            if (rows.length > 0) {
                rows[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }

        // Missing-photo banner (see #missing-photo-banner above) — a dish
        // row is "missing a photo" client-side exactly the same way the
        // server decided it for the banner's own count: no <img> inside its
        // .product-thumb (the template only renders one when product.image
        // is set, see the fallback plate emoji a few lines up).
        function highlightMissingPhotos() {
            highlightRows(Array.from(document.querySelectorAll('.product-row'))
                .filter(row => !row.querySelector('.product-thumb img')));
        }

        // Not-on-the-menu banner (see #not-on-menu-banner above) — a row
        // is one of these exactly when the server rendered its per-row
        // .menu-notice (active dish that Product::menuHiddenReason() says
        // the public menu won't show), the same condition that produced the
        // banner's count. A row the owner has since toggled off (.inactive,
        // no reload) keeps its now-hidden notice in the DOM but reads
        // "Oculto" honestly, so it is skipped, matching the notice's own CSS.
        function highlightNotOnMenu() {
            highlightRows(Array.from(document.querySelectorAll('.product-row'))
                .filter(row => !row.classList.contains('inactive') && row.querySelector('.menu-notice')));
        }
    </script>
{% endblock %}
