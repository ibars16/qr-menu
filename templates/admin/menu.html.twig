{#/home/david/gitProjects/qr-menu/templates/admin/menu.html.twig#}
{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'title'|trans({}, 'admin_menu') }}{% endblock %}
{% block page_title %}{{ 'title'|trans({}, 'admin_menu') }}{% endblock %}

{% block header_actions %}
    {% if totalProducts > 0 and app.environment == 'dev' %}
        <button class="btn btn-danger" onclick="deleteAllProducts()" title="{{ 'action.delete_all_products'|trans({}, 'admin_menu') }}">
            <i class="ti ti-trash" aria-hidden="true"></i>
            <span class="hide-mobile">{{ 'action.delete_all_products'|trans({}, 'admin_menu') }}</span>
        </button>
    {% endif %}
    {% if categories|length > 0 %}
        <button class="btn" id="sort-btn" onclick="SortMode.open()">
            <i class="ti ti-arrows-sort" aria-hidden="true"></i>
            {{ 'sort.open'|trans({}, 'admin_menu') }}
        </button>
    {% endif %}
    {# Same AI purple as the empty state's import button (.btn-ai, _styles_controls): #a09aee on #2a2060 5.67:1, hover #c0baff on #342870 6.96:1. #}
    <button class="btn btn-ai" onclick="UI.openAiImport()">
        <i class="ti ti-sparkles" aria-hidden="true"></i>
        {{ 'action.import_ai'|trans({}, 'admin_menu') }}
    </button>
    <button class="btn btn-primary" onclick="ProductUI.openNewProduct(null)">
        <i class="ti ti-plus" aria-hidden="true"></i>
        {{ 'modal.product.new_title'|trans({}, 'admin_menu') }}
    </button>
{% endblock %}

{% block stylesheets %}
    <style>
        /* ── Hide labels on mobile ── */
        @media (max-width: 767px) { .hide-mobile { display: none; } }

        /* ══════════════════════════════
           CARTA
        ══════════════════════════════ */
        .menu-wrap { max-width: 860px; }

        /* "Esta carta parece estar en {idioma}…" — one per import
           (MenuImportLanguageNotice). Amber heads-up on the opaque amber
           fill: --warn-fg on --warn-bg-solid 8.70:1 dark / 5.55:1 light;
           its buttons are the standard .btn (10.8:1 / 11.0:1) and
           .btn-primary (white on --brand 5.12:1). */
        .import-lang-notice {
            background:var(--warn-bg-solid); border:1px solid rgba(193,150,14,0.3); border-radius:var(--r-md);
            padding:var(--sp-3) var(--sp-4); margin-bottom:var(--sp-5);
            font-size:var(--fs-base); line-height:var(--lh-body); color:var(--warn-fg);
        }
        .import-lang-notice-text { display:flex; align-items:flex-start; gap:var(--sp-2); }
        .import-lang-notice-text i { font-size:16px; flex-shrink:0; margin-top:2px; }
        .import-lang-notice-message { flex:1; }
        .import-lang-notice-actions { display:flex; flex-wrap:wrap; gap:var(--sp-2); margin-top:var(--sp-3); }
        .import-lang-notice-actions form { margin:0; }
        .import-lang-notice[data-state="working"] .import-lang-notice-actions { display:none; }
        .import-lang-notice-progress { display:none; margin-top:var(--sp-2); }
        .import-lang-notice[data-state="working"] .import-lang-notice-progress { display:block; }
        /* Mobile: folded by default to its first two lines, no buttons;
           tapping the text (or the chevron, the accessible control) opens
           it. Desktop: always open, no chevron. A failed translation opens
           it (see fail() below) so the error is read in full. Chevron is
           --warn-fg on --warn-bg-solid, same 8.70:1 / 5.55:1 as the text. */
        .import-lang-notice-toggle { display:none; }
        @media (max-width: 767px) {
            .import-lang-notice { padding:var(--sp-2) var(--sp-3); margin-bottom:var(--sp-3); }
            .import-lang-notice-text { cursor:pointer; }
            .import-lang-notice-toggle {
                display:flex; align-items:center; justify-content:center; flex-shrink:0;
                width:36px; height:36px; margin:-6px -8px -6px 0; padding:0;
                background:none; border:none; border-radius:var(--r-sm); color:inherit; font-size:18px; cursor:pointer;
            }
            .import-lang-notice-toggle:focus-visible { outline:2px solid var(--warn-fg); outline-offset:-2px; }
            .import-lang-notice-toggle i { transition:transform 0.15s; margin:0; }
            .import-lang-notice.is-open .import-lang-notice-toggle i { transform:rotate(180deg); }
            .import-lang-notice:not(.is-open) .import-lang-notice-actions { display:none; }
            .import-lang-notice:not(.is-open) .import-lang-notice-message {
                display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden;
            }
        }

        /* Summary notices above the list (missing photo, not on the public
           menu) — same visual language as the static .info-banner in
           tags.html.twig/users.html.twig, but these are real <button>s (not
           <div>s) since they're actionable: clicking one highlights every
           dish it counts and scrolls to the first one, it doesn't just
           inform. Each is only rendered when its own count > 0
           (missingPhotoCount / notOnMenuCount, see body block below). */
        .info-banner {
            width:100%; text-align:left; font-family:inherit; appearance:none;
            background:var(--bg-nav); border:1px solid var(--bd-1); border-radius:var(--r-md);
            box-shadow:var(--shadow-sm);
            padding:var(--sp-3) var(--sp-4); font-size:var(--fs-base); color:var(--tx-muted); line-height:var(--lh-body);
            margin-bottom:var(--sp-5); display:flex; align-items:center; gap:var(--sp-3);
            cursor:pointer; transition:border-color 0.15s, background 0.15s;
        }
        .info-banner:hover { border-color:var(--bd-2); background:var(--bg-hover); }
        .info-banner:focus-visible { outline:2px solid var(--brand); outline-offset:2px; }
        .info-banner i.ti-photo-off,
        .info-banner i.ti-eye-off {
            font-size:15px; flex-shrink:0; color:var(--brand);
            width:28px; height:28px; border-radius:var(--r-pill); background:rgba(193,68,14,0.12);
            display:flex; align-items:center; justify-content:center;
        }
        .info-banner span.info-banner-text { flex:1; }
        .info-banner i.ti-chevron-right { font-size:14px; flex-shrink:0; color:var(--tx-6); }

        /* Highlight applied on click of either summary banner (see
           highlightRows() below) to the rows it counts — missing a photo,
           or not on the public menu. One shared look, one class.
           Outline instead of a background-only change so it stays visible
           on both the active and .inactive (opacity:0.4) row states. */
        /* Ring drawn INSIDE the row (its own 1px border + a 1px inset
           shadow), never outside it: rows sit flush against each other, so
           the old outward outline-offset ring overlapped the next row's.
           Two highlighted rows in a row also get a small gap so their
           rings read as separate boxes rather than one double line. */
        .product-row.highlight-missing-photo,
        .product-row.highlight-missing-photo:hover {
            border-color:var(--brand); box-shadow:inset 0 0 0 1px var(--brand); background:var(--bg-hover);
        }
        .product-row.highlight-missing-photo + .product-row.highlight-missing-photo { margin-top:var(--sp-1); }

        /* ── Dish/category search (MenuSearch below) ──────────────────────
           Filters the rendered list in the browser, no request. Field on
           --bg-nav: typed text --tx-1 11.76:1 dark / 12.63:1 light,
           placeholder and icons --tx-muted 4.65:1 / 4.95:1. At rest it
           looks like the .info-banner cards next to it (--bd-1 border,
           --r-md, --shadow-sm); lupa + placeholder say it's a field. On
           focus the border goes --tx-muted (on --bg-page 4.88:1 / 4.43:1)
           plus the --brand ring (3.87:1 / 4.58:1), both ≥3:1. :focus, not
           :focus-visible, so a tap/click shows it too. "No hay platos…" --tx-2 on
           --bg-page. 16px text on mobile so iOS doesn't zoom on focus. */
        .menu-search { position:relative; margin-bottom:var(--sp-5); }
        .menu-search-icon {
            position:absolute; left:var(--sp-3); top:50%; transform:translateY(-50%);
            font-size:16px; color:var(--tx-muted); pointer-events:none;
        }
        .menu-search-input {
            width:100%; height:40px; padding:0 44px 0 38px; box-sizing:border-box;
            background:var(--bg-nav); border:1px solid var(--bd-1); border-radius:var(--r-md);
            box-shadow:var(--shadow-sm);
            color:var(--tx-1); font-family:inherit; font-size:var(--fs-md);
            appearance:none; -webkit-appearance:none; transition:border-color 0.15s;
        }
        .menu-search-input::placeholder { color:var(--tx-muted); opacity:1; }
        .menu-search-input::-webkit-search-cancel-button,
        .menu-search-input::-webkit-search-decoration { -webkit-appearance:none; appearance:none; }
        .menu-search-input:focus { border-color:var(--tx-muted); outline:2px solid var(--brand); outline-offset:1px; }
        .menu-search-clear {
            position:absolute; right:2px; top:50%; transform:translateY(-50%);
            width:36px; height:36px; display:flex; align-items:center; justify-content:center;
            background:none; border:none; border-radius:var(--r-sm); padding:0;
            color:var(--tx-muted); font-size:16px; cursor:pointer;
        }
        .menu-search-clear[hidden] { display:none; }
        .menu-search-clear:hover { color:var(--tx-1); }
        .menu-search-clear:focus-visible { outline:2px solid var(--brand); outline-offset:-2px; }
        .menu-search-empty {
            text-align:center; padding:var(--sp-8) var(--sp-4);
            font-size:var(--fs-md); color:var(--tx-2); line-height:var(--lh-body);
        }
        .menu-search-empty[hidden] { display:none; }
        /* While there is text: notices and "Añadir plato a …" step aside,
           and whatever doesn't match is taken out of the list. */
        .menu-wrap.is-searching .import-lang-notice,
        .menu-wrap.is-searching .info-banner,
        .menu-wrap.is-searching .add-row,
        .menu-wrap.is-searching .search-miss { display:none !important; }
        @media (max-width: 767px) {
            .menu-search { margin-bottom:var(--sp-3); }
            .menu-search-input { height:48px; font-size:16px; }
            .menu-search-clear { width:44px; height:44px; }
        }

        .empty-state  { text-align:center; padding:80px var(--sp-6); }
        .empty-icon   { font-size:52px; display:block; margin-bottom:var(--sp-4); opacity:0.2; }
        .empty-title  { font-size:var(--fs-xl); font-weight:600; color:var(--tx-hi); margin-bottom:var(--sp-2); letter-spacing:-0.3px; }
        .empty-sub    { font-size:var(--fs-md); color:var(--tx-muted); line-height:var(--lh-body); margin-bottom:var(--sp-7); max-width:340px; margin-left:auto; margin-right:auto; }
        .empty-btns   { display:flex; gap:var(--sp-3); justify-content:center; flex-wrap:wrap; }

        .cat-block    { border:1px solid var(--bd-1); border-radius:var(--r-lg); box-shadow:var(--shadow-sm); margin-bottom:var(--sp-3); overflow:hidden; }
        .cat-header   { display:flex; align-items:center; gap:var(--sp-2); padding:var(--sp-3) var(--sp-4); background:var(--bg-card); border-bottom:1px solid var(--bd-1); }
        .cat-drag     { color:var(--tx-8); cursor:grab; font-size:var(--fs-lg); flex-shrink:0; }
        .cat-drag:active { cursor:grabbing; }
        .cat-name-text { font-size:var(--fs-md); font-weight:500; color:var(--tx-1); flex:1; }
        .cat-count    {
            font-size:var(--fs-xs); font-weight:600; color:var(--tx-muted); background:var(--bg-tgl);
            padding:1px var(--sp-2); border-radius:var(--r-pill); flex-shrink:0;
        }
        .cat-actions  { display:flex; gap:var(--sp-1); }

        .toggle {
            width:32px; height:18px; border-radius:var(--r-md); background:var(--bg-tgl);
            position:relative; cursor:pointer; transition:background 0.15s;
            border:none; padding:0; flex-shrink:0;
        }
        .toggle::after {
            content:''; position:absolute; width:12px; height:12px;
            border-radius:50%; background:var(--tx-6); top:3px; left:3px;
            transition:left 0.15s, background 0.15s;
        }
        /* "On" state — same green for category and product-row toggles.
           Both mean the same thing (visible/activo) so they get the same
           color; --brand (orange) stays reserved for the primary "+ Nuevo
           plato" action and destructive actions, not for state. Reuses the
           green already established for .flash-success/.toast.success. */
        .toggle.on { background:rgba(99,153,34,0.25); }
        .toggle.on::after { left:17px; background:#7aad40; }
        .toggle:focus-visible { outline:2px solid var(--brand); outline-offset:2px; }

        .icon-btn {
            width:28px; height:28px; border-radius:var(--r-sm); border:1px solid var(--bd-3);
            background:var(--bg-input); display:flex; align-items:center; justify-content:center;
            cursor:pointer; color:var(--tx-4); font-size:var(--fs-base);
            transition:color 0.1s, border-color 0.1s;
        }
        .icon-btn:hover        { color:var(--tx-1); border-color:var(--bd-2); }
        .icon-btn:focus-visible { outline:2px solid var(--brand); outline-offset:2px; }
        .icon-btn.danger:hover { color:#F0997B; border-color:rgba(240,153,123,0.3); }

        @media (max-width: 767px) {
            .icon-btn { width:36px; height:36px; font-size:16px; }
            .toggle   { width:38px; height:22px; }
            .toggle::after { width:14px; height:14px; top:4px; left:4px; }
            .toggle.on::after { left:20px; }
        }

        .products-list { padding:var(--sp-1); }
        /* align-items:flex-start (not center) so a 2-line .product-name
           doesn't push price/toggle to float at half-height — they anchor
           to the first line instead. .product-drag/.product-thumb opt back
           into vertical centering via align-self since they read better
           centered against a variable-height row than pinned to the top. */
        .product-row {
            display:flex; align-items:flex-start; gap:var(--sp-2); padding:9px var(--sp-2);
            border-radius:var(--r-sm); border:1px solid transparent; cursor:pointer;
            transition:background 0.1s, border-color 0.1s; min-height:52px;
        }
        .product-row:hover { background:var(--bg-hover); border-color:var(--bd-1); }
        .product-drag { color:var(--tx-8); cursor:grab; font-size:var(--fs-md); flex-shrink:0; align-self:center; }
        .product-drag:active { cursor:grabbing; }
        .product-thumb {
            width:38px; height:38px; border-radius:var(--r-sm); background:var(--bd-1);
            border:1px solid var(--bd-3); display:flex; align-items:center;
            justify-content:center; font-size:18px; flex-shrink:0; overflow:hidden;
            align-self:center;
        }
        .product-thumb img { width:100%; height:100%; object-fit:cover; }
        .product-info { flex:1; min-width:0; }
        .product-name {
            font-size:var(--fs-base); font-weight:500; color:var(--tx-1); line-height:1.3;
            display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden;
        }
        .product-price {
            display:flex; align-items:baseline; justify-content:flex-end; gap:3px;
            flex-shrink:0; min-width:58px;
        }
        .price-amount { font-size:var(--fs-base); font-weight:600; color:var(--tx-1); }
        .price-currency { font-size:var(--fs-xs); font-weight:500; color:var(--tx-5); }
        .product-row.inactive { opacity:0.4; }

        @media (max-width: 767px) {
            .product-row  { min-height:64px; padding:var(--sp-3) var(--sp-2); }
            .product-thumb { width:44px; height:44px; font-size:20px; }
            .product-name { font-size:var(--fs-md); }
            .price-amount { font-size:var(--fs-md); }
            .price-currency { font-size:var(--fs-sm); }
        }

        .add-row { padding:var(--sp-2) var(--sp-2) var(--sp-1); }
        .add-product-btn {
            width:100%; padding:var(--sp-2); border:1px dashed var(--bd-2); border-radius:var(--r-sm);
            background:none; color:var(--tx-muted); font-weight:500; font-size:var(--fs-sm); cursor:pointer;
            display:flex; align-items:center; justify-content:center; gap:5px;
            min-height:40px; transition:border-color 0.15s, color 0.15s, background 0.15s;
        }
        .add-product-btn:hover { border-color:var(--brand); color:var(--brand); background:rgba(193,68,14,0.06); }
        .add-product-btn:focus-visible { outline:2px solid var(--brand); outline-offset:2px; }

        @media (max-width: 767px) {
            .cat-block { margin-bottom:var(--sp-4); }
            .add-product-btn { min-height:48px; font-size:var(--fs-base); }
        }

        /* ── "Ordenar" mode (SortMode below) ─────────────────────────────
           Replaces the whole Carta body (and the header buttons) with
           #sort-view until "Listo" reloads the page. Contrast, from the
           tokens: names --tx-1 on --bg-card/--bg-nav ≥11.5:1; counts, hint
           and the handles (≡ categories, ⋮⋮ dishes) --tx-muted on
           --bg-card/--bg-nav 4.54:1 dark / 4.74:1 light (a control: ≥3:1).
           No hover background on rows (it would drop --tx-muted to 4.04:1
           in light), and hidden rows keep full opacity. */
        body.is-sorting .main-header-actions { display:none; }
        .menu-wrap.is-sorting > :not(#sort-view) { display:none !important; }
        .sort-bar {
            display:flex; align-items:center; gap:var(--sp-3); margin-bottom:var(--sp-4);
            position:sticky; top:0; z-index:5; background:var(--bg-page); padding:var(--sp-2) 0;
        }
        .sort-bar-text { flex:1; min-width:0; }
        .sort-title { font-size:var(--fs-lg); font-weight:600; color:var(--tx-hi); }
        .sort-hint  { font-size:var(--fs-sm); color:var(--tx-muted); line-height:var(--lh-body); }
        .sort-cat {
            border:1px solid var(--bd-1); border-radius:var(--r-lg); box-shadow:var(--shadow-sm);
            margin-bottom:var(--sp-2); overflow:hidden; background:var(--bg-card);
        }
        .sort-cat-head { display:flex; align-items:center; }
        .sort-handle {
            display:flex; align-items:center; justify-content:center; flex-shrink:0;
            width:40px; height:44px; color:var(--tx-muted); font-size:20px;
        }
        /* The whole row drags, not only its handle (the handle is just the
           visual cue). No touch-action:none: on touch a drag starts after a
           short press (delayOnTouchOnly below), so a swipe still scrolls. */
        .sort-cat-head, .sort-prod { cursor:grab; user-select:none; -webkit-user-select:none; -webkit-touch-callout:none; }
        .sort-cat-head:active, .sort-prod:active { cursor:grabbing; }
        .sort-cat-toggle {
            flex:1; min-width:0; display:flex; align-items:center; gap:var(--sp-2);
            min-height:44px; padding:var(--sp-2) var(--sp-3) var(--sp-2) 0;
            background:none; border:none; text-align:left; font-family:inherit; cursor:pointer;
            color:var(--tx-1);
        }
        .sort-cat-toggle:focus-visible { outline:2px solid var(--brand); outline-offset:-2px; }
        .sort-cat-name { font-size:var(--fs-md); font-weight:500; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
        .sort-count { font-size:var(--fs-xs); font-weight:600; color:var(--tx-muted); flex-shrink:0; }
        .sort-chevron { margin-left:auto; color:var(--tx-muted); font-size:16px; flex-shrink:0; transition:transform 0.15s; }
        .sort-cat-toggle[aria-expanded="true"] .sort-chevron { transform:rotate(90deg); }
        .sort-prods { border-top:1px solid var(--bd-1); background:var(--bg-nav); padding:var(--sp-1) 0; }
        .sort-prod  { display:flex; align-items:center; gap:var(--sp-1); padding-right:var(--sp-3); background:var(--bg-nav); }
        .sort-prod + .sort-prod { border-top:1px solid var(--bd-1); }
        .sort-prod .sort-handle { width:44px; }
        .sort-prod-name { font-size:var(--fs-base); color:var(--tx-1); flex:1; min-width:0; line-height:1.3; padding:var(--sp-2) 0; }
        .sort-empty { font-size:var(--fs-sm); color:var(--tx-muted); padding:var(--sp-3) var(--sp-4); }
        .sort-ghost { opacity:0.35; }
        .sort-cat.sort-chosen, .sort-prod.sort-chosen { box-shadow:inset 0 0 0 2px var(--brand); }

        @media (max-width: 767px) {
            .sort-handle, .sort-prod .sort-handle { width:48px; height:48px; }
            .sort-cat-toggle { min-height:48px; }
            .sort-prod-name { font-size:var(--fs-md); }
        }

        {% include 'admin/_product_modal_css.html.twig' %}
    </style>
{% endblock %}

{% block body %}
    <div class="menu-wrap">

        {# Dish/category search (MenuSearch below): under the header buttons,
           above the notices. A direct child of .menu-wrap, so "Ordenar"
           mode hides it with the rest of the Carta. #}
        {% if categories|length > 0 %}
            <div class="menu-search" role="search">
                <i class="ti ti-search menu-search-icon" aria-hidden="true"></i>
                <input type="search" id="menu-search-input" class="menu-search-input"
                       placeholder="{{ 'search.placeholder'|trans({}, 'admin_menu') }}"
                       aria-label="{{ 'search.aria'|trans({}, 'admin_menu') }}"
                       autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" enterkeyhint="search">
                <button type="button" class="menu-search-clear" id="menu-search-clear" hidden
                        aria-label="{{ 'search.clear'|trans({}, 'admin_menu') }}">
                    <i class="ti ti-x" aria-hidden="true"></i>
                </button>
            </div>
        {% endif %}

        {# Above everything: an import in another language than the menu's (see MenuImportLanguageNotice). #}
        {% for notice in importLanguageNotices %}
            {% set batchId = notice.batch.id %}
            <div class="import-lang-notice" role="status"
                 data-step-url="{{ path('admin_menu_import_language_translate', {id: batchId}) }}"
                 data-token="{{ csrf_token('import_language_' ~ batchId) }}"
                 data-main="{{ notice.main }}"
                 data-state="{{ notice.batch.languageNotice == 'translating' ? 'stopped' : 'idle' }}">
                {# Says how many dishes; "Ver los N platos" marks them (highlightRows(), like the other notices) —
                   exactly the dishes "Traducir" would translate. Only the categories left: nothing to mark. #}
                {% set dishCount = notice.productIds|length %}
                <div class="import-lang-notice-text">
                    <i class="ti ti-alert-triangle" aria-hidden="true"></i>
                    <span class="import-lang-notice-message">
                        {% if dishCount > 0 %}
                            {{ (dishCount == 1 ? 'language_notice.text_singular' : 'language_notice.text_plural')|trans({'%language%': notice.language, '%main%': notice.main, '%count%': dishCount}, 'admin_menu') }}
                        {% else %}
                            {{ 'language_notice.text'|trans({'%language%': notice.language, '%main%': notice.main}, 'admin_menu') }}
                        {% endif %}
                        {% if notice.batch.languageNotice == 'translating' %}
                            <span class="import-lang-notice-half">{{ 'language_notice.half_done'|trans({'%count%': notice.remaining}, 'admin_menu') }}</span>
                        {% endif %}
                        <span class="import-lang-notice-error" hidden>{{ 'language_notice.error'|trans({}, 'admin_menu') }}</span>
                    </span>
                    <button type="button" class="import-lang-notice-toggle" aria-expanded="false"
