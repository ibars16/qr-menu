{% block javascripts %}
    <script>
        const MENU_IMPORT_URL        = "{{ path('admin_menu_import_new') }}";
        const MSG_NEW_CATEGORY       = "{{ 'modal.category.new_title'|trans({}, 'admin_menu')|e('js') }}";
        const MSG_EDIT_CATEGORY      = "{{ 'modal.category.edit_title'|trans({}, 'admin_menu')|e('js') }}";
        const MSG_CATEGORY_UPDATED   = "{{ 'js.category_updated'|trans({}, 'admin_menu')|e('js') }}";
        const MSG_CATEGORY_CREATED   = "{{ 'js.category_created'|trans({}, 'admin_menu')|e('js') }}";
        const MSG_CATEGORY_VISIBLE   = "{{ 'category.toggle_visible'|trans({}, 'admin_menu')|e('js') }}";
        const MSG_CATEGORY_HIDDEN    = "{{ 'category.toggle_hidden'|trans({}, 'admin_menu')|e('js') }}";
        const MSG_CATEGORY_HIDE_TITLE = "{{ 'category.toggle_hide_title'|trans({}, 'admin_menu')|e('js') }}";
        const MSG_CATEGORY_SHOW_TITLE = "{{ 'category.toggle_show_title'|trans({}, 'admin_menu')|e('js') }}";
        const MSG_CONFIRM_DELETE_CATEGORY_WITH_PRODUCTS = "{{ 'js.confirm_delete_category_with_products'|trans({}, 'admin_menu')|e('js') }}";
        const MSG_CONFIRM_DELETE_CATEGORY = "{{ 'js.confirm_delete_category'|trans({}, 'admin_menu')|e('js') }}";
        const MSG_CATEGORY_DELETED   = "{{ 'js.category_deleted'|trans({}, 'admin_menu')|e('js') }}";
        const MSG_CONFIRM_DELETE_ALL_PRODUCTS_STEP1 = "{{ 'js.confirm_delete_all_products_step1'|trans({}, 'admin_menu')|e('js') }}";
        const MSG_CONFIRM_DELETE_ALL_PRODUCTS_STEP2 = "{{ 'js.confirm_delete_all_products_step2'|trans({}, 'admin_menu')|e('js') }}";
        const MSG_ALL_PRODUCTS_DELETED = "{{ 'js.all_products_deleted'|trans({}, 'admin_menu')|e('js') }}";
        const TOTAL_PRODUCTS_COUNT = {{ totalProducts }};

        // S, isMobile, apiFetch, panelEl/getVal/setVal come from
        // _admin_js_utils.html.twig — declare S first since the product JS
        // (and this page's own category JS) both read/write its fields.
        const S = {
            productId:   null,
            categoryId:  null,
            menuSectionId: null,
            editingCatId: null,
            spicy:       0,
            allergenOverrides: [],
            ingredientAllergenCache: {},
            // Clip framing (object-position %) — see initClipFraming() in
            // _product_js.html.twig and Product::$videoFocusX/Y.
            clipFocus: { x: 50, y: 50, zoom: 50 },
        };
    </script>
    {% include 'admin/_admin_js_utils.html.twig' %}
    {% include 'admin/_product_js.html.twig' %}
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
    <script>
        // ── "Ordenar" mode ────────────────────────────────────────────────
        // Drag from anywhere on the row (see _sortable).
        // Categories among themselves, dishes within their own category
        // (one Sortable per list, no shared group: a dish can never land in
        // another category). Saved on drop with the WHOLE list; on any
        // error the item goes back where it was (apiFetch() toasts it).
        // "Listo" reloads so the normal Carta shows the new order.
        const MSG_SORT_SAVED = "{{ 'sort.saved'|trans({}, 'admin_menu')|e('js') }}";
        const SortMode = {
            _ready: false,
            open() {
                document.querySelector('.menu-wrap').classList.add('is-sorting');
                document.body.classList.add('is-sorting');
                document.getElementById('sort-view').hidden = false;
                window.scrollTo(0, 0);
                if (!this._ready) { this._init(); this._ready = true; }
            },
            close() { location.reload(); },
            toggle(button) {
                const open = button.getAttribute('aria-expanded') !== 'true';
                button.setAttribute('aria-expanded', open ? 'true' : 'false');
                document.getElementById(button.getAttribute('aria-controls')).hidden = !open;
            },
            _init() {
                const cats = document.getElementById('sort-cats');
                this._sortable(cats, '.sort-cat-head', () => ({
                    url: '/admin/reorder/categories',
                    body: { ids: [...cats.children].map(el => parseInt(el.dataset.id, 10)) },
                }));
                document.querySelectorAll('.sort-prod-list').forEach(list => {
                    this._sortable(list, null, () => ({
                        url: '/admin/reorder/products',
                        body: {
                            categoryId: parseInt(list.dataset.categoryId, 10),
                            ids: [...list.children].map(el => parseInt(el.dataset.id, 10)),
                        },
                    }));
                });
            },
            _sortable(list, handle, request) {
                // handle: a category drags from its whole header (its dish list
                // has its own Sortable); a dish from its whole row (null).
                // forceFallback: Sortable's own drag, not the browser's native
                // HTML5 one — native drag won't start from the header's
                // <button> in some browsers. supportPointer:false: touch events,
                // so once a row is picked up its touchmove can stop the page
                // from scrolling (with pointer events the browser's pan cancels
                // the drag). Touch: hold ~0.2 s to pick up, so a plain swipe
                // still scrolls; mouse: 4px of movement before it's a drag, so
                // a click on a category header still opens/closes it.
                const sortable = Sortable.create(list, {
                    ...(handle ? { handle } : {}),
                    forceFallback: true,
                    fallbackOnBody: true,
                    fallbackTolerance: 4,
                    supportPointer: false,
                    delay: 200,
                    delayOnTouchOnly: true,
                    touchStartThreshold: 5,
                    animation: 150,
                    ghostClass: 'sort-ghost',
                    chosenClass: 'sort-chosen',
                    onEnd: async (evt) => {
                        if (evt.oldIndex === evt.newIndex) return;
                        sortable.option('disabled', true);
                        const { url, body } = request();
                        const data = await apiFetch(url, body);
                        if (data.ok) {
                            showToast(MSG_SORT_SAVED, 'success');
                        } else {
                            // Put it back: before the item that now sits at its old index.
                            list.removeChild(evt.item);
                            list.insertBefore(evt.item, list.children[evt.oldIndex] ?? null);
                        }
                        sortable.option('disabled', false);
                    },
                });
            },
        };
    </script>
    <script>
        // ── UI controller (category only — dish editing is ProductUI, see
        // _product_js.html.twig) ─────────────────────────────────────────────
        const UI = {
            openNewCategory() {
                S.editingCatId = null;
                document.getElementById('cat-modal-title').textContent  = MSG_NEW_CATEGORY;
                document.getElementById('cat-sheet-title').textContent  = MSG_NEW_CATEGORY;
                document.getElementById('cat-name-input').value = '';
                document.getElementById('cat-type-select').value = '';
                document.getElementById('cat-name-error').classList.remove('show');
                this._openCat();
                setTimeout(() => document.getElementById('cat-name-input').focus(), 80);
            },
            openEditCategory(id, name, type) {
                S.editingCatId = id;
                document.getElementById('cat-modal-title').textContent = MSG_EDIT_CATEGORY;
                document.getElementById('cat-sheet-title').textContent = MSG_EDIT_CATEGORY;
                document.getElementById('cat-name-input').value = name;
                document.getElementById('cat-type-select').value = type || '';
                document.getElementById('cat-name-error').classList.remove('show');
                this._openCat();
                setTimeout(() => document.getElementById('cat-name-input').focus(), 80);
            },
            _openCat() {
                if (isMobile()) document.getElementById('mobile-cat-sheet').classList.add('open');
                else            document.getElementById('desktop-cat-modal').classList.add('open');
            },
            closeCat() {
                document.getElementById('mobile-cat-sheet').classList.remove('open');
                document.getElementById('desktop-cat-modal').classList.remove('open');
            },

            openAiImport() { window.location.href = MENU_IMPORT_URL; },
        };

        // ── Category CRUD ──────────────────────────────────────────────────────────
        async function saveCategory() {
            const name = document.getElementById('cat-name-input').value.trim();
            if (!name) { document.getElementById('cat-name-error').classList.add('show'); return; }
            document.getElementById('cat-name-error').classList.remove('show');
            const type = document.getElementById('cat-type-select').value || null;

            const url = S.editingCatId
                ? `/admin/categories/${S.editingCatId}/edit`
                : '/admin/categories/create';

            const data = await apiFetch(url, { name, type });
            if (data.error) return; // apiFetch() has already toasted it (a 4xx)

            showToast(S.editingCatId ? MSG_CATEGORY_UPDATED : MSG_CATEGORY_CREATED, 'success');
            UI.closeCat();
            setTimeout(() => location.reload(), 700);
        }

        async function toggleCategory(id, btn) {
            const data = await apiFetch(`/admin/categories/${id}/toggle`);
            btn.classList.toggle('on', data.active);
            btn.title = data.active ? MSG_CATEGORY_HIDE_TITLE : MSG_CATEGORY_SHOW_TITLE;
            showToast(data.active ? MSG_CATEGORY_VISIBLE : MSG_CATEGORY_HIDDEN);
        }

        async function deleteCategory(id, name, count, btn) {
            const msg = count > 0
                ? MSG_CONFIRM_DELETE_CATEGORY_WITH_PRODUCTS.replace('%name%', name).replace('%count%', count)
                : MSG_CONFIRM_DELETE_CATEGORY.replace('%name%', name);
            if (!confirm(msg)) return;
            const data = await apiFetch(`/admin/categories/${id}/delete`);
            if (data.ok) {
                btn.closest('.cat-block').remove();
                showToast(MSG_CATEGORY_DELETED, 'success');
                if (!document.querySelector('.cat-block')) location.reload();
            }
        }

        // ── Delete all dishes (categories stay) ──
        // Two sequential confirm() dialogs — this wipes every dish in the
        // whole carta in one shot and can't be undone.
        async function deleteAllProducts() {
            const step1 = MSG_CONFIRM_DELETE_ALL_PRODUCTS_STEP1.replace('%count%', TOTAL_PRODUCTS_COUNT);
            if (!confirm(step1)) return;
            if (!confirm(MSG_CONFIRM_DELETE_ALL_PRODUCTS_STEP2)) return;

            const data = await apiFetch('/admin/products/delete-all');
            if (data.ok) {
                showToast(MSG_ALL_PRODUCTS_DELETED, 'success');
                location.reload();
            }
        }

        // Dish-row highlighting shared by the two summary banners above the
        // list (#not-on-menu-banner, #missing-photo-banner). Each banner
        // only decides WHICH rows (its own filter, below); marking them,
        // scrolling to the first and the no-timer/no-toggle behavior are
        // this one function. It clears any existing highlight first, so
        // pressing one banner after the other never leaves two marks with
        // different meanings on screen; pressing the same one twice just
        // re-marks (and re-scrolls). No un-highlight timer on purpose —
        // leaving it visible is more useful than fading it, and a page
        // reload naturally clears it. (The class keeps its original
        // "missing-photo" name: it is the one shared look, see its CSS.)
        function highlightRows(rows) {
            document.querySelectorAll('.product-row.highlight-missing-photo')
                .forEach(row => row.classList.remove('highlight-missing-photo'));
            rows.forEach(row => row.classList.add('highlight-missing-photo'));
            if (rows.length > 0) {
                rows[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }

        // Missing-photo banner (see #missing-photo-banner above) — a dish
        // row is "missing a photo" client-side exactly the same way the
        // server decided it for the banner's own count: no <img> inside its
        // .product-thumb (the template only renders one when product.image
        // is set, see the fallback plate emoji a few lines up).
        function highlightMissingPhotos() {
            highlightRows(Array.from(document.querySelectorAll('.product-row'))
                .filter(row => !row.querySelector('.product-thumb img')));
        }

        // Not-on-the-menu banner (see #not-on-menu-banner above) — a row
        // is one of these exactly when the server rendered its per-row
        // .menu-notice (active dish that Product::menuHiddenReason() says
        // the public menu won't show), the same condition that produced the
        // banner's count. A row the owner has since toggled off (.inactive,
        // no reload) keeps its now-hidden notice in the DOM but reads
        // "Oculto" honestly, so it is skipped, matching the notice's own CSS.
        // Import-language notice (see .import-lang-notice above) — the rows
        // are exactly the dishes the server listed for it (the ones
        // "Traducir" would translate), by id.
        function highlightImportLanguage(button) {
            const ids = button.dataset.productIds.split(',');
            highlightRows(Array.from(document.querySelectorAll('.product-row'))
                .filter(row => ids.includes(row.dataset.id)));
        }

        function highlightNotOnMenu() {
            highlightRows(Array.from(document.querySelectorAll('.product-row'))
                .filter(row => !row.classList.contains('inactive') && row.querySelector('.menu-notice')));
        }

        // ── Dish/category search ──────────────────────────────────────────
        // Purely in the browser, on every keystroke: the whole Carta is
        // already in the page (main language, as the list shows it), so
        // nothing is requested. Case- and accent-insensitive ("jamon" =
        // "jamón"). A matching category shows with all its dishes; otherwise
        // a category shows with only its matching dishes. Hidden (.inactive)
        // and pending-review dishes are rows like any other, so they're
        // searched too and keep their own label. Names are read from the
        // DOM on each run, so a rename/delete without reload is honoured.
        // Clearing removes every class it added: the list is back exactly
        // as it was.
        (() => {
            const input = document.getElementById('menu-search-input');
            if (!input) return;
            const clear = document.getElementById('menu-search-clear');
            const empty = document.getElementById('menu-search-empty');
            const wrap  = document.querySelector('.menu-wrap');
            const norm  = s => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/\s+/g, ' ').trim();

            const run = () => {
                const q = norm(input.value);
                clear.hidden = input.value === '';
                document.querySelectorAll('.search-miss').forEach(el => el.classList.remove('search-miss'));
                if (q === '') {
                    wrap.classList.remove('is-searching');
                    empty.hidden = true;
                    return;
                }
                wrap.classList.add('is-searching');
                let shown = 0;
                document.querySelectorAll('#cats-list .cat-block').forEach(block => {
                    const nameEl = block.querySelector('.cat-name-text');
                    if (nameEl && norm(nameEl.textContent).includes(q)) { shown++; return; }
                    let hits = 0;
                    block.querySelectorAll('.product-row').forEach(row => {
                        const n = row.querySelector('.product-name');
                        if (n && norm(n.textContent).includes(q)) hits++;
                        else row.classList.add('search-miss');
                    });
                    if (hits === 0) block.classList.add('search-miss');
                    else shown++;
                });
                empty.hidden = shown > 0;
            };

            input.addEventListener('input', run);
            input.addEventListener('keydown', e => {
                if (e.key === 'Escape' && input.value !== '') { e.preventDefault(); input.value = ''; run(); }
                if (e.key === 'Enter') { e.preventDefault(); input.blur(); } // mobile: close the keyboard
            });
            clear.addEventListener('click', () => { input.value = ''; run(); input.focus(); });
            // Back/forward cache or autofill can restore a value without an input event.
            window.addEventListener('pageshow', run);
            run();
        })();
    </script>
    <script>
        // "Traducir al {idioma}" on an import's language notice: one batch
        // per request until done (MenuImportController::translateLanguage),
        // like the main-language change. A failed batch is retried once,
        // then the notice offers "Continuar"; what's done is kept server side.
        (() => {
            const working = {{ 'language_notice.working'|trans({'%language%': '__LANG__', '%count%': '__COUNT__'}, 'admin_menu')|json_encode|raw }};
            document.querySelectorAll('.import-lang-notice').forEach(box => {
                const button   = box.querySelector('.import-lang-notice-translate');
                const progress = box.querySelector('.import-lang-notice-progress');
                const error    = box.querySelector('.import-lang-notice-error');
                const half     = box.querySelector('.import-lang-notice-half');
                const textRow  = box.querySelector('.import-lang-notice-text');
                const toggle   = box.querySelector('.import-lang-notice-toggle');
                let retried = false;

                // Mobile fold (see .import-lang-notice-toggle CSS): the whole
                // text row toggles; on desktop the box is always open.
                const setOpen = (open) => {
                    box.classList.toggle('is-open', open);
                    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
                };
                textRow.addEventListener('click', () => {
                    if (isMobile()) setOpen(!box.classList.contains('is-open'));
                });

                const fail = () => {
                    setOpen(true);
                    box.dataset.state = 'stopped';
                    if (half) half.hidden = true;
                    error.hidden = false;
                };

                const step = async () => {
                    box.dataset.state = 'working';
                    error.hidden = true;
                    let result;
                    try {
                        const response = await fetch(box.dataset.stepUrl, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: new URLSearchParams({ _token: box.dataset.token }),
                        });
                        result = await response.json();
                    } catch (e) {
                        result = { error: true };
                    }
                    if (result.done) {
                        window.location.reload();
                        return;
                    }
                    if (result.error) {
                        if (retried) {
                            retried = false;
                            return fail();
                        }
                        retried = true;
                        setTimeout(step, 3000);
                        return;
                    }
                    retried = false;
                    progress.textContent = working.replace('__LANG__', box.dataset.main).replace('__COUNT__', result.remaining);
                    step();
                };

                button.addEventListener('click', step);
            });
        })();
    </script>
{% endblock %}
