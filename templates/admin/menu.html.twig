                </div>
                <div class="import-lang-notice-actions">
                    {% if dishCount > 0 %}
                        <button type="button" class="btn" data-product-ids="{{ notice.productIds|join(',') }}" onclick="highlightImportLanguage(this)">
                            <i class="ti ti-eye" aria-hidden="true"></i>
                            {{ (dishCount == 1 ? 'language_notice.show_dishes_singular' : 'language_notice.show_dishes_plural')|trans({'%count%': dishCount}, 'admin_menu') }}
                        </button>
                    {% endif %}
                    <button type="button" class="btn btn-primary import-lang-notice-translate">
                        <i class="ti ti-language" aria-hidden="true"></i>
                        {{ (notice.batch.languageNotice == 'translating' ? 'language_notice.continue' : 'language_notice.translate')|trans({'%main%': notice.main}, 'admin_menu') }}
                    </button>
                    <form method="post" action="{{ path('admin_menu_import_language_dismiss', {id: batchId}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('import_language_' ~ batchId) }}">
                        <button type="submit" class="btn">{{ 'language_notice.dismiss'|trans({}, 'admin_menu') }}</button>
                    </form>
                </div>
            </div>
        {% endfor %}

        {# Above the photo banner: dishes customers can't see at all matter more than dishes without a picture. #}
        {% if notOnMenuCount > 0 %}
            <button type="button" class="info-banner" id="not-on-menu-banner" onclick="highlightNotOnMenu()">
                <i class="ti ti-eye-off" aria-hidden="true"></i>
                <span class="info-banner-text">
                    {{ (notOnMenuCount == 1 ? 'notice.not_on_menu_singular' : 'notice.not_on_menu_plural')|trans({'%count%': notOnMenuCount}, 'admin_menu') }}
