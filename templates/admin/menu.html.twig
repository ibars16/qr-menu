                    <button type="button" class="btn btn-primary" onclick="SortMode.close()">
                        <i class="ti ti-check" aria-hidden="true"></i> {{ 'sort.done'|trans({}, 'admin_menu') }}
                    </button>
                </div>
                <div id="sort-cats">
                    {% for category in categories %}
                        {% set catT = category.getDisplayTranslation(locale) %}
                        {% set catName = catT ? catT.name : 'common.unnamed'|trans({}, 'admin_menu') %}
                        <div class="sort-cat" data-id="{{ category.id }}">
                            <div class="sort-cat-head">
                                <span class="sort-handle sort-cat-handle" title="{{ 'sort.drag_category'|trans({'%name%': catName}, 'admin_menu') }}">
                                    <i class="ti ti-menu-2" aria-hidden="true"></i>
