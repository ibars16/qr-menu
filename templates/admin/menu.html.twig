                    </div>
                {% endfor %}
            </div>
            <div class="menu-search-empty" id="menu-search-empty" role="status" hidden>{{ 'search.no_results'|trans({}, 'admin_menu') }}</div>
        {% endif %}

        {# "Ordenar" mode (SortMode below). Every category and dish is here,
           hidden and pending-review ones too (no badge, by owner decision):
           the server only accepts the whole list (CartaReorder), so a hidden
           dish keeps its place and reappears there once published. #}
        {% if categories|length > 0 %}
            <section id="sort-view" hidden aria-labelledby="sort-title">
                <div class="sort-bar">
                    <div class="sort-bar-text">
                        <div class="sort-title" id="sort-title">{{ 'sort.title'|trans({}, 'admin_menu') }}</div>
                        <div class="sort-hint">{{ 'sort.hint'|trans({}, 'admin_menu') }}</div>
