{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'title'|trans({}, 'admin_settings') }}{% endblock %}
{% block page_title %}{{ 'title'|trans({}, 'admin_settings') }}{% endblock %}

{% block stylesheets %}
    <style>
        .settings-wrap { max-width: 600px; }

        .settings-section {
            background: var(--bg-card);
            border: 1px solid var(--bd-1);
            border-radius: var(--r-lg);
            box-shadow: var(--shadow-sm);
            overflow: hidden;
            margin-bottom: var(--sp-4);
        }
        .settings-section-title {
            font-size: var(--fs-sm); font-weight: 600; color: var(--tx-muted);
            text-transform: uppercase; letter-spacing: 0.08em;
            padding: var(--sp-4) var(--sp-5) var(--sp-3);
            border-bottom: 1px solid var(--bd-1);
            background: var(--bg-nav);
        }
        .settings-body { padding: var(--sp-5); display: flex; flex-direction: column; gap: var(--sp-4); }

        .field { display: flex; flex-direction: column; gap: var(--sp-2); }
        .field label {
            font-size: var(--fs-base); font-weight: 500; color: var(--tx-3);
            display: flex; align-items: center; gap: var(--sp-2);
        }
        .req { color: #C1440E; }
        .field input,
        .field select {
            background: var(--bg-input); border: 1px solid var(--bd-2);
            color: var(--tx-hi); font-size: var(--fs-lg); padding: var(--sp-3) var(--sp-4);
            border-radius: var(--r-md); outline: none; width: 100%;
            transition: border-color 0.15s; -webkit-appearance: none;
        }
        .field input:focus, .field select:focus { border-color: var(--tx-5); }
        .field input:focus-visible, .field select:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
        .field-hint { font-size: var(--fs-sm); color: var(--tx-3); line-height: var(--lh-body); }
        /* Per-field errors — same tokens as the dish editor's .field-error /
           input.error (--err-text / --err-border, AA in both modes, see
           base.html.twig). */
        .field input.error { border-color: var(--err-border); }
        .field-error { font-size: var(--fs-sm); color: var(--err-text); line-height: var(--lh-body); }

        /* Contacto y redes */
        .field label i { font-size: 16px; color: var(--tx-3); }
        /* Horario — one bordered list, a row per day: name · switch · shifts */
        .hours-toolbar { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--sp-3); }
        .hours-copy { flex-shrink: 0; display: inline-flex; align-items: center; gap: var(--sp-2); min-height: 36px; white-space: nowrap; }
        .hours { border: 1px solid var(--bd-1); border-radius: var(--r-md); overflow: hidden; background: var(--bg-input); }
        .hours-day {
            display: grid; grid-template-columns: 6rem 7rem minmax(0, 1fr); align-items: center;
            column-gap: var(--sp-3); row-gap: var(--sp-2); padding: var(--sp-3) var(--sp-4);
            transition: background 0.15s;
        }
        .hours-day + .hours-day { border-top: 1px solid var(--bd-1); }
        .hours-day { min-height: 61px; }
        .hours-day.has-error { box-shadow: inset 3px 0 0 var(--err-border); }
        .hours-day .field-error { grid-column: 1 / -1; }
        .hours-name { font-size: var(--fs-base); font-weight: 600; color: var(--tx-hi); }
        .hours-day.is-closed .hours-name { color: var(--tx-3); }

        /* Switch: the "closed" checkbox drawn inverted — track on = open. */
        .hours-toggle { position: relative; display: inline-flex; align-items: center; gap: var(--sp-2); cursor: pointer; min-height: 36px; user-select: none; }
        .hours-closed-input { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; }
        .hours-switch {
            position: relative; flex-shrink: 0; width: 36px; height: 20px; border-radius: var(--r-pill);
            background: var(--brand); transition: background 0.15s;
        }
        .hours-switch::after {
            content: ''; position: absolute; top: 2px; left: 18px; width: 16px; height: 16px; border-radius: 50%;
            background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,0.3); transition: left 0.15s;
        }
        .hours-closed-input:checked + .hours-switch { background: var(--bd-2); }
        .hours-closed-input:checked + .hours-switch::after { left: 2px; }
        .hours-closed-input:focus-visible + .hours-switch { outline: 2px solid var(--brand); outline-offset: 2px; }
        .hours-state { font-size: var(--fs-sm); color: var(--tx-3); }
        .hours-state-open { color: var(--tx-hi); font-weight: 500; }
        .hours-state-closed,
        .hours-closed-input:checked ~ .hours-state-open { display: none; }
        .hours-closed-input:checked ~ .hours-state-closed { display: inline; }

        .hours-shifts { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-2) var(--sp-3); min-width: 0; }
        .hours-day.is-closed .hours-shifts { display: none; }
        .hours-shift { display: inline-flex; align-items: center; gap: var(--sp-1); }
        .hours-shift[hidden], .hours-add[hidden] { display: none; }
        .hours-sep { color: var(--tx-3); padding: 0 2px; }
        .hours-shift input {
            background: var(--bg-card); border: 1px solid var(--bd-2); color: var(--tx-hi);
            font-size: var(--fs-base); font-variant-numeric: tabular-nums;
            padding: 0 var(--sp-2); border-radius: var(--r-sm);
            width: 6.25rem; min-height: 36px; color-scheme: light dark;
        }
        .hours-shift input:hover { border-color: var(--tx-6); }
        .hours-shift input:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
        .hours-shift input[aria-invalid="true"] { border-color: var(--err-border); }
        .hours-icon-btn, .hours-add {
            display: inline-flex; align-items: center; justify-content: center; gap: var(--sp-1);
            background: transparent; border: 0; color: var(--tx-3); font: inherit; font-size: var(--fs-sm);
            cursor: pointer; border-radius: var(--r-sm); min-height: 36px;
        }
        .hours-icon-btn { width: 32px; }
        .hours-add { width: 32px; border: 1px dashed var(--bd-2); }
        .hours-add-text { display: none; }
        .hours-icon-btn:hover, .hours-add:hover { color: var(--tx-hi); background: var(--bg-hover); }
        .hours-icon-btn:focus-visible, .hours-add:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }

        @media (max-width: 600px) {
            .hours-toolbar { flex-direction: column; }
            .hours-day { grid-template-columns: minmax(0, 1fr) auto; padding: var(--sp-3); }
            .hours-shifts { grid-column: 1 / -1; }
            .hours-shift { flex: 1 1 100%; }
            .hours-shift input { flex: 1; width: auto; min-width: 0; min-height: 40px; }
            .hours-add { width: auto; padding: 0 var(--sp-3); }
            .hours-add-text { display: inline; }
        }

        /* Color picker */

        /* Logo upload */
        .logo-area {
            display: flex; align-items: center; gap: var(--sp-4); flex-wrap: wrap;
        }
        .logo-preview {
            width: 72px; height: 72px; border-radius: var(--r-lg);
            background: var(--bg-input); border: 1px solid var(--bd-2);
            display: flex; align-items: center; justify-content: center;
            font-size: var(--fs-2xl); font-weight: 700; color: var(--tx-5);
            overflow: hidden; flex-shrink: 0;
            position: relative;
        }
        .logo-preview img { width: 100%; height: 100%; object-fit: cover; }
        .logo-actions { display: flex; flex-direction: column; gap: var(--sp-2); }
        .upload-btn {
            display: inline-flex; align-items: center; gap: var(--sp-2);
            padding: var(--sp-2) var(--sp-4); border-radius: var(--r-md); font-size: var(--fs-base);
            font-weight: 500; cursor: pointer;
            border: 1px solid var(--bd-2); background: var(--bg-input); color: var(--tx-1);
            transition: border-color 0.15s, color 0.15s;
        }
        .upload-btn:hover { border-color: var(--tx-6); color: var(--tx-hi); }
        /* Only fires once the associated file input is reachable by keyboard:
           today it's `display:none` (see the <input type="file"> in the body
           block below), so it's outside the tab order and this label is
           never actually focused yet. Left in place so the ring is already
           correct the moment that reachability gap is fixed — fixing it
           needs a JS change (tabindex + keydown), out of scope for this
           visual-only pass. */
        .upload-btn:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
        .remove-logo-btn {
            font-size: var(--fs-sm); color: var(--tx-muted); background: none;
            border: none; cursor: pointer; padding: 0; text-align: left;
            transition: color 0.15s;
        }
        .remove-logo-btn:hover { color: #F0997B; }
        .remove-logo-btn:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }

        /* Hero-image quality warning — amber, matches .flash-warning's
           palette (base.html.twig) so a returning-visitor's eye already
           reads this color as "heads up, not broken". The confirm control
           is a real checkbox (native focus/keyboard/screen-reader support)
           visually styled as a button — see .quality-warning-confirm below
           — rather than a div with an onclick and only a color to signal
           state, which is neither focusable nor announced as interactive. */
        .quality-warning {
            margin-top: var(--sp-3); padding: var(--sp-3) var(--sp-4); border-radius: var(--r-md);
            background: rgba(193,150,14,0.12); border: 1px solid rgba(193,150,14,0.3);
            display: flex; flex-direction: column; gap: var(--sp-3);
        }
        /* [hidden] and .quality-warning both carry (0,1,0) specificity, so
           without this the class's own `display: flex` — declared after the
           UA stylesheet's `[hidden]{display:none}` — would win by source
           order and defeat `el.hidden = true`, showing the box empty on
           every page load regardless of whether a warning actually fired. */
        .quality-warning[hidden] { display: none; }
        .quality-note {
            margin-top: var(--sp-3); padding: var(--sp-3) var(--sp-4); border-radius: var(--r-md);
            background: rgba(193,150,14,0.12); border: 1px solid rgba(193,150,14,0.3);
            font-size: var(--fs-base); color: var(--warn-fg); line-height: var(--lh-body);
        }
        .quality-note[hidden] { display: none; }
        .upload-discarded { margin: 0 0 var(--sp-4); }
        .quality-warning-messages { display: flex; flex-direction: column; gap: var(--sp-1); }
        .quality-warning-messages p { margin: 0; font-size: var(--fs-base); color: var(--warn-fg); line-height: var(--lh-body); }
        .quality-warning-confirm {
            display: inline-flex; align-items: center; gap: var(--sp-2); align-self: flex-start;
            padding: var(--sp-2) var(--sp-4); border-radius: var(--r-md); font-size: var(--fs-base); font-weight: 600;
            border: 1px solid rgba(193,150,14,0.45); background: rgba(193,150,14,0.18); color: var(--warn-fg);
            cursor: pointer; transition: background 0.15s;
        }
        .quality-warning-confirm:hover { background: rgba(193,150,14,0.28); }
        .quality-warning-confirm input[type="checkbox"] {
            width: 16px; height: 16px; margin: 0; accent-color: var(--warn-fg);
        }
        /* :focus-visible on the checkbox itself (not the label) so the ring
           tracks real keyboard focus, matching this app's other
           :focus-visible-only conventions (never on a mouse click). */
        .quality-warning-confirm:has(input:focus-visible) {
            outline: 2px solid var(--warn-fg); outline-offset: 2px;
        }

        /* Save button */
        .settings-footer {
            display: flex; justify-content: flex-end; gap: var(--sp-3);
            padding-top: var(--sp-2);
        }
        .save-btn {
            padding: var(--sp-3) var(--sp-6); background: #C1440E; color: #fff;
            border: none; border-radius: var(--r-md); font-size: var(--fs-md);
            font-weight: 600; cursor: pointer; transition: opacity 0.15s;
        }
        .save-btn:hover { opacity: 0.9; }
        .save-btn:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }

        /* Danger zone */
        .danger-zone { border-color: rgba(240,100,80,0.2) !important; }
        .danger-zone .settings-section-title { color: #F0997B; background: rgba(240,100,80,0.06); }
        .danger-text { font-size: 13px; color: var(--tx-4); line-height: 1.5; }
        .danger-btn {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 8px 16px; border-radius: 8px; font-size: 13px;
            font-weight: 500; cursor: pointer;
            border: 1px solid rgba(240,100,80,0.3);
            background: rgba(240,100,80,0.08); color: #F0997B;
            transition: background 0.15s;
        }
        .danger-btn:hover { background: rgba(240,100,80,0.15); }

        /* QR preview */
        .qr-info {
            background: var(--bg-nav); border: 1px solid var(--bd-1); border-radius: var(--r-md);
            padding: var(--sp-4); display: flex; align-items: center;
            gap: var(--sp-3);
        }
        .qr-url { font-size: var(--fs-base); color: var(--tx-muted); font-family: monospace; word-break: break-all; flex: 1; }
        .copy-btn {
            padding: var(--sp-2) var(--sp-3); border-radius: var(--r-sm); font-size: var(--fs-sm);
            border: 1px solid var(--bd-2); background: var(--bg-input); color: var(--tx-3);
            cursor: pointer; flex-shrink: 0; transition: color 0.15s;
        }
        .copy-btn:hover { color: var(--tx-hi); border-color: var(--tx-6); }
        .copy-btn:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }

        .implicit-submit { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

        /* Per-section save — secondary next to the footer's "save all" */
        .section-save {
            display: flex; justify-content: flex-end;
            padding: var(--sp-3) var(--sp-5);
            border-top: 1px solid var(--bd-1);
        }
        .section-save-btn {
            display: inline-flex; align-items: center; gap: var(--sp-2);
            padding: var(--sp-2) var(--sp-4); border-radius: var(--r-md);
            font-size: var(--fs-base); font-weight: 600; cursor: pointer;
            border: 1px solid rgba(193,68,14,0.45); background: transparent; color: #E0703F;
            transition: background 0.15s;
        }
        .section-save-btn:hover { background: rgba(193,68,14,0.10); }
        .section-save-btn:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }

        @media (max-width: 767px) {
            .settings-body { padding: var(--sp-4); gap: var(--sp-4); }
            .section-save { padding: var(--sp-3) var(--sp-4); }
            .settings-footer { justify-content: stretch; }
            .save-btn { flex: 1; padding: var(--sp-3); font-size: var(--fs-lg); }
        }
    </style>
{% endblock %}

{# Per-field error helpers: the input gets aria-invalid + aria-describedby
   and the .error border; the message sits right under it (same look as the
   dish editor's .field-error). #}
{% macro attrs(errors, key) %}{% if errors[key] is defined %}aria-invalid="true" aria-describedby="err-{{ key }}" class="error"{% endif %}{% endmacro %}
{% macro message(errors, key) %}{% if errors[key] is defined %}<span class="field-error" id="err-{{ key }}">{{ errors[key]|trans({}, 'admin_settings') }}</span>{% endif %}{% endmacro %}

{% block body %}
{% import _self as fieldErr %}
    <div class="settings-wrap">

        <form method="post" enctype="multipart/form-data">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_settings') }}">
            {# Enter in a field submits via the form's FIRST submit button; this
               keeps that a full save instead of the first section's button. #}
            <button type="submit" class="implicit-submit" tabindex="-1" aria-hidden="true"></button>

            {# ── Información del restaurante ── #}
            <div class="settings-section" id="section-info">
                <div class="settings-section-title">{{ 'section.restaurant_info'|trans({}, 'admin_settings') }}</div>
                <div class="settings-body">

                    <div class="field">
                        <label for="name">{{ 'field.name'|trans({}, 'admin_settings') }} <span class="req">*</span></label>
                        <input type="text"
                               id="name" name="name"
                               value="{{ old ? old.name : restaurant.name }}"
                               placeholder="{{ 'field.name_placeholder'|trans({}, 'admin_settings') }}"
                               {{ fieldErr.attrs(errors, 'name') }}
                               required>
                        {{ fieldErr.message(errors, 'name') }}
                    </div>

                    <div class="field">
                        <label for="tagline">{{ 'field.tagline'|trans({}, 'admin_settings') }}</label>
                        <input type="text"
                               id="tagline" name="tagline"
                               value="{{ old ? old.tagline : restaurant.tagline }}"
                               placeholder="{{ 'field.tagline_placeholder'|trans({}, 'admin_settings') }}"
                               {{ fieldErr.attrs(errors, 'tagline') }}
                               maxlength="160">
                        {{ fieldErr.message(errors, 'tagline') }}
                        <span class="field-hint">{{ 'hint.tagline'|trans({}, 'admin_settings') }}</span>
                    </div>

                    {# URL pública de la carta #}
                    <div class="field">
                        <label>{{ 'field.menu_url'|trans({}, 'admin_settings') }}</label>
                        <div class="qr-info">
                            <span class="qr-url" id="menu-url">{{ app.request.schemeAndHttpHost ~ path('menu_show', {slug: restaurant.slug}) }}</span>
                            <button type="button" class="copy-btn" onclick="copyUrl()">
                                <i class="ti ti-copy" aria-hidden="true"></i> {{ 'action.copy'|trans({}, 'admin_settings') }}
                            </button>
                        </div>
                    </div>

                </div>
                <div class="section-save">
                    <button type="submit" name="section" value="info" class="section-save-btn">
                        <i class="ti ti-device-floppy" aria-hidden="true"></i> {{ 'action.save_section'|trans({}, 'admin_settings') }}
                    </button>
                </div>
            </div>

            {# ── Contacto ── #}
            {% set socialValues = old ? old.social : (restaurant.socialLinks ?? {}) %}
            {% set hoursValues = old ? old.hours : null %}
            {% set storedHours = restaurant.openingHours ?? {} %}
            <div class="settings-section" id="section-contact">
                <div class="settings-section-title">{{ 'section.contact'|trans({}, 'admin_settings') }}</div>
                <div class="settings-body">

                    <div class="field">
                        <label for="address">{{ 'field.address'|trans({}, 'admin_settings') }}</label>
                        <input type="text" id="address" name="address" maxlength="255" autocomplete="street-address"
                               value="{{ old ? old.address : restaurant.address }}"
                               placeholder="{{ 'field.address_placeholder'|trans({}, 'admin_settings') }}"
                               {{ fieldErr.attrs(errors, 'address') }}>
                        {{ fieldErr.message(errors, 'address') }}
                    </div>

                    <div class="field">
                        <label for="phone">{{ 'field.phone'|trans({}, 'admin_settings') }}</label>
                        <input type="tel" id="phone" name="phone" maxlength="32" autocomplete="tel" inputmode="tel"
                               value="{{ old ? old.phone : restaurant.phone }}"
                               placeholder="{{ 'field.phone_placeholder'|trans({}, 'admin_settings') }}"
                               {{ fieldErr.attrs(errors, 'phone') }}>
                        {{ fieldErr.message(errors, 'phone') }}
                        <span class="field-hint">{{ 'hint.phone'|trans({}, 'admin_settings') }}</span>
                    </div>

                </div>
                <div class="section-save">
                    <button type="submit" name="section" value="contact" class="section-save-btn">
                        <i class="ti ti-device-floppy" aria-hidden="true"></i> {{ 'action.save_section'|trans({}, 'admin_settings') }}
                    </button>
                </div>
            </div>

            {# ── Apariencia ── #}
            <div class="settings-section" id="section-appearance">
                <div class="settings-section-title">{{ 'section.appearance'|trans({}, 'admin_settings') }}</div>
                <div class="settings-body">
                    {# A logo / hero image picked in the last submission wasn't
                       stored — the form came back with errors (a file input
                       can't be refilled) or another section's button was used
                       (then via a flash, after the redirect). See
                       SettingsController::discardedUploads(). #}
                    {# Read once: app.flashes() empties the bag, and Twig's ?: evaluates its left side twice. #}
                    {% set discardedFlash = app.flashes('settings_upload_discarded') %}
                    {% set discarded = discardedUploads ?? (discardedFlash is empty ? null : discardedFlash|first) %}
                    {% if discarded %}
                        <p class="quality-note upload-discarded" role="alert">
                            {{ discarded.key|trans({}, 'admin_settings') }}
                            {% if discarded.viaAppearanceButton %}{{ 'hint.upload_discarded_use_appearance'|trans({'%button%': 'action.save_section'|trans({}, 'admin_settings'), '%section%': 'section.appearance'|trans({}, 'admin_settings')}, 'admin_settings') }}{% endif %}
                        </p>
                    {% endif %}

                    {# Logo #}
                    <div class="field">
                        <label>{{ 'field.logo'|trans({}, 'admin_settings') }}</label>
                        <div class="logo-area">
                            <div class="logo-preview" id="logo-preview">
                                {% if restaurant.logo %}
                                    <img src="{{ asset('uploads/logos/' ~ restaurant.logo) }}"
                                         alt="{{ restaurant.name }}" id="logo-img">
                                {% else %}
                                    <span id="logo-letter">{{ restaurant.name|slice(0,1)|upper }}</span>
                                {% endif %}
                            </div>
                            <div class="logo-actions">
                                <label class="upload-btn" for="logo-input">
                                    <i class="ti ti-upload" aria-hidden="true"></i>
                                    {{ restaurant.logo ? 'action.change_logo'|trans({}, 'admin_settings') : 'action.upload_logo'|trans({}, 'admin_settings') }}
                                </label>
                                <input type="file" id="logo-input" name="logo"
                                       accept="image/*" style="display:none"
                                       onchange="previewLogo(this)">
                                {% if restaurant.logo %}
                                    <button type="button" class="remove-logo-btn" onclick="removeLogo()">
                                        <i class="ti ti-trash" aria-hidden="true"></i> {{ 'action.remove_logo'|trans({}, 'admin_settings') }}
                                    </button>
                                    {# Must not be named "removeLogo" — a form field with that
                                       name becomes accessible as the bare identifier
                                       "removeLogo" inside this form's inline onclick handlers
                                       (via the legacy with(form){...} scope browsers use for
                                       intrinsic event attributes), shadowing the removeLogo()
                                       function below and breaking the button with "removeLogo
                                       is not a function". #}
                                    <input type="hidden" name="removeLogoFlag" id="remove-logo-input" value="0">
                                {% endif %}
                                <span class="field-hint">{{ 'hint.logo_format'|trans({}, 'admin_settings') }}</span>
                            </div>
                        </div>
                    </div>

                    {# Foto de cabecera (hero) — same upload/preview/remove pattern as
                       the logo above, its own field/directory (Restaurant::$heroImage,
                       public/uploads/heroes/), shown by every theme as the hero's
                       .hero-photo-band (menu/layouts/standard/show.html.twig). #}
                    <div class="field">
                        <label>{{ 'field.hero_image'|trans({}, 'admin_settings') }}</label>
                        <div class="logo-area">
                            <div class="logo-preview hero-image-preview" id="hero-image-preview">
                                {% if restaurant.heroImage %}
                                    <img src="{{ asset('uploads/heroes/' ~ restaurant.heroImage) }}"
                                         alt="{{ restaurant.name }}" id="hero-image-img">
                                {% else %}
                                    <i class="ti ti-photo" aria-hidden="true"></i>
                                {% endif %}
                            </div>
                            <div class="logo-actions">
                                <label class="upload-btn" for="hero-image-input">
                                    <i class="ti ti-upload" aria-hidden="true"></i>
                                    {{ restaurant.heroImage ? 'action.change_hero_image'|trans({}, 'admin_settings') : 'action.upload_hero_image'|trans({}, 'admin_settings') }}
                                </label>
                                <input type="file" id="hero-image-input" name="heroImage"
                                       accept="image/*" style="display:none"
                                       data-min-dimension="{{ heroImageMinDimension }}"
                                       data-recommended-width="{{ heroImageRecommendedWidth }}"
                                       onchange="previewHeroImage(this); checkHeroImageQuality(this)">
                                {% if restaurant.heroImage %}
                                    <button type="button" class="remove-logo-btn" onclick="removeHeroImage()">
                                        <i class="ti ti-trash" aria-hidden="true"></i> {{ 'action.remove_hero_image'|trans({}, 'admin_settings') }}
                                    </button>
                                    {# Same naming trap as removeLogoFlag above — must not be
                                       named "removeHeroImage", see the comment there. #}
                                    <input type="hidden" name="removeHeroImageFlag" id="remove-hero-image-input" value="0">
                                {% endif %}
                                <span class="field-hint">{{ 'hint.hero_image_format'|trans({'%max_mb%': heroImageMaxMegabytes, '%min%': heroImageMinDimension, '%max%': heroImageMaxDimension, '%recommended%': heroImageRecommendedWidth}, 'admin_settings') }}</span>
                                <span class="field-hint">{{ 'hint.hero_image'|trans({}, 'admin_settings') }}</span>
                            </div>
                        </div>

                        {# Quality-only warning (small/portrait, see UploadQualityWarning)
                           — hidden until JS finds a reason to show it (checkHeroImageQuality()).
                           The checkbox is the real, always-functional accessible control:
                           native, keyboard/focus-operable, works with zero JS (SettingsController
                           itself renders the same warning as a server-side flash + leaves this
                           box available if the file is resubmitted unconfirmed). JS only makes it
                           nicer: styled as a button (see CSS) and auto-submits on check. #}
                        <div class="quality-warning" id="hero-quality-warning" hidden role="alert">
                            <div class="quality-warning-messages" id="hero-quality-warning-messages"></div>
                            <label class="quality-warning-confirm">
                                <input type="checkbox" name="heroImageQualityConfirmed"
                                       id="hero-quality-confirmed" value="1"
                                       onchange="confirmHeroQualityAndSubmit(this)">
                                {{ 'action.upload_anyway'|trans({}, 'admin_settings') }}
                            </label>
                        </div>
                        {# Informative only (UploadQualityWarning::WidthBelowRecommended):
                           never blocks the save — the server repeats it as a flash
                           once the photo is stored. #}
                        <p class="quality-note" id="hero-quality-note" hidden role="status"></p>
                    </div>

                </div>
                <div class="section-save">
                    <button type="submit" name="section" value="appearance" class="section-save-btn">
                        <i class="ti ti-device-floppy" aria-hidden="true"></i> {{ 'action.save_section'|trans({}, 'admin_settings') }}
                    </button>
                </div>
            </div>

            {# ── Idioma y moneda ── #}
            <div class="settings-section" id="section-language">
                <div class="settings-section-title">{{ 'section.language_currency'|trans({}, 'admin_settings') }}</div>
                <div class="settings-body">

                    <div class="field">
                        <label for="defaultLanguage">{{ 'field.menu_language'|trans({}, 'admin_settings') }}</label>
                        <select id="defaultLanguage" name="defaultLanguage">
                            {% for code, lang in languages %}
                                <option value="{{ code }}"
                                    {{ (old ? old.defaultLanguage : restaurant.defaultLanguage) == code ? 'selected' : '' }}>
                                    {{ lang.flag }} {{ lang.name }}
                                </option>
                            {% endfor %}
                        </select>
                        <span class="field-hint">
                    {{ 'hint.menu_language'|trans({}, 'admin_settings') }}
                </span>
                    </div>

                    <div class="field">
                        <label for="adminLocale">{{ 'field.admin_language'|trans({}, 'admin_settings') }}</label>
                        <select id="adminLocale" name="adminLocale">
                            {% for code, lang in adminLocales %}
                                <option value="{{ code }}"
                                    {{ (old ? old.adminLocale : restaurant.adminLocale) == code ? 'selected' : '' }}>
                                    {{ lang.flag }} {{ lang.name }}
                                </option>
                            {% endfor %}
                        </select>
                        <span class="field-hint">
                    {{ 'hint.admin_language'|trans({}, 'admin_settings') }}
                </span>
                    </div>

                    <div class="field">
                        <label for="currency">{{ 'field.currency'|trans({}, 'admin_settings') }}</label>
                        <select id="currency" name="currency">
                            {% for code, curr in currencies %}
                                <option value="{{ code }}"
                                    {{ (old ? old.currency : restaurant.currency) == code ? 'selected' : '' }}>
                                    {{ curr.symbol }} {{ code }} — {{ curr.name }}
                                </option>
                            {% endfor %}
                        </select>
                        <span class="field-hint">
                    {{ 'hint.currency'|trans({}, 'admin_settings') }}
                </span>
                    </div>

                </div>
                <div class="section-save">
                    <button type="submit" name="section" value="language" class="section-save-btn">
                        <i class="ti ti-device-floppy" aria-hidden="true"></i> {{ 'action.save_section'|trans({}, 'admin_settings') }}
                    </button>
                </div>
            </div>

            {# ── Redes y reseñas ── #}
            <div class="settings-section" id="section-social">
                <div class="settings-section-title">{{ 'section.social'|trans({}, 'admin_settings') }}</div>
                <div class="settings-body">

                    <span class="field-hint">{{ 'hint.social'|trans({}, 'admin_settings') }}</span>
                    {% for network, icon in {instagram: 'ti-brand-instagram', facebook: 'ti-brand-facebook', tiktok: 'ti-brand-tiktok', google: 'ti-brand-google', tripadvisor: 'ti-brand-tripadvisor', website: 'ti-world'} %}
                        <div class="field">
                            <label for="social-{{ network }}"><i class="ti {{ icon }}" aria-hidden="true"></i> {{ ('field.social_' ~ network)|trans({}, 'admin_settings') }}</label>
                            <input type="text" id="social-{{ network }}" name="social[{{ network }}]" maxlength="255"
                                   autocomplete="off" autocapitalize="off" spellcheck="false"
                                   value="{{ socialValues[network] ?? '' }}"
                                   placeholder="{{ ('field.social_' ~ network ~ '_placeholder')|trans({}, 'admin_settings') }}"
                                   {{ fieldErr.attrs(errors, 'social_' ~ network) }}>
                            {{ fieldErr.message(errors, 'social_' ~ network) }}
                        </div>
                    {% endfor %}

                </div>
                <div class="section-save">
                    <button type="submit" name="section" value="social" class="section-save-btn">
                        <i class="ti ti-device-floppy" aria-hidden="true"></i> {{ 'action.save_section'|trans({}, 'admin_settings') }}
                    </button>
                </div>
            </div>

            {# ── Horario ── #}
            <div class="settings-section" id="section-hours">
                <div class="settings-section-title" id="hours-title">{{ 'section.hours'|trans({}, 'admin_settings') }}</div>
                <div class="settings-body">

                    <div class="hours-toolbar">
                        <span class="field-hint">{{ 'hint.hours'|trans({}, 'admin_settings') }}</span>
                        <button type="button" class="copy-btn hours-copy" id="hours-copy-mon">
                            <i class="ti ti-copy" aria-hidden="true"></i> {{ 'hours.copy_monday'|trans({}, 'admin_settings') }}
                        </button>
                    </div>
                    {# One row per day: name · switch · shifts. The switch IS the
                       hours[day][closed] checkbox, drawn inverted (track "on" =
                       open, i.e. unchecked) so the form contract is unchanged.
                       Shift 2 stays hidden behind "+ Añadir turno" until it has
                       a value (or an error); hidden inputs still post empty. #}
                    <div class="hours" role="group" aria-labelledby="hours-title">
                        {% for day in ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'] %}
                            {% set dayName = ('day.' ~ day)|trans({}, 'admin_settings') %}
                            {% set dayErr = errors['hours_' ~ day] is defined %}
                            {% if hoursValues is not null %}
                                {% set dayIn = hoursValues[day] ?? {} %}
                                {% set closed = dayIn.closed is defined and dayIn.closed %}
                                {% set shifts = [[dayIn[0].open ?? '', dayIn[0].close ?? ''], [dayIn[1].open ?? '', dayIn[1].close ?? '']] %}
                            {% else %}
                                {% set closed = storedHours[day] is defined and storedHours[day] is empty %}
                                {% set stored = storedHours[day] ?? [] %}
                                {% set shifts = [stored[0] ?? ['', ''], stored[1] ?? ['', '']] %}
                            {% endif %}
                            {% set showShift2 = shifts[1][0] != '' or shifts[1][1] != '' %}
                            <div class="hours-day{{ closed ? ' is-closed' : '' }}{{ dayErr ? ' has-error' : '' }}" data-day="{{ day }}">
                                <span class="hours-name" id="hours-{{ day }}-name">{{ dayName }}</span>
                                <label class="hours-toggle">
                                    <input type="checkbox" class="hours-closed-input" name="hours[{{ day }}][closed]" value="1" {{ closed ? 'checked' : '' }}
                                           aria-label="{{ 'hours.closed_aria'|trans({'%day%': dayName}, 'admin_settings') }}">
                                    <span class="hours-switch" aria-hidden="true"></span>
                                    <span class="hours-state hours-state-open" aria-hidden="true">{{ 'hours.open'|trans({}, 'admin_settings') }}</span>
                                    <span class="hours-state hours-state-closed" aria-hidden="true">{{ 'hours.closed'|trans({}, 'admin_settings') }}</span>
                                </label>
                                <div class="hours-shifts">
                                    {% for i in 0..1 %}
                                        {% set n = i + 1 %}
                                        <div class="hours-shift"{% if i == 1 and not showShift2 %} hidden{% endif %}>
                                            <input type="time" step="60" name="hours[{{ day }}][{{ i }}][open]" value="{{ shifts[i][0] }}"
                                                   aria-label="{{ 'hours.open_aria'|trans({'%day%': dayName, '%n%': n}, 'admin_settings') }}"
                                                   {% if dayErr %}aria-invalid="true" aria-describedby="err-hours_{{ day }}"{% endif %}
                                                   {{ closed ? 'disabled' : '' }}>
                                            <span class="hours-sep" aria-hidden="true">–</span>
                                            <input type="time" step="60" name="hours[{{ day }}][{{ i }}][close]" value="{{ shifts[i][1] }}"
                                                   aria-label="{{ 'hours.close_aria'|trans({'%day%': dayName, '%n%': n}, 'admin_settings') }}"
                                                   {% if dayErr %}aria-invalid="true" aria-describedby="err-hours_{{ day }}"{% endif %}
                                                   {{ closed ? 'disabled' : '' }}>
                                            {% if i == 1 %}
                                                <button type="button" class="hours-icon-btn hours-remove"
                                                        title="{{ 'hours.remove_shift'|trans({}, 'admin_settings') }}"
                                                        aria-label="{{ 'hours.remove_shift'|trans({}, 'admin_settings') }} · {{ dayName }}">
                                                    <i class="ti ti-x" aria-hidden="true"></i>
                                                </button>
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                    <button type="button" class="hours-add"{% if showShift2 %} hidden{% endif %}
                                            title="{{ 'hours.add_shift'|trans({}, 'admin_settings') }}"
                                            aria-label="{{ 'hours.add_shift'|trans({}, 'admin_settings') }} · {{ dayName }}">
                                        <i class="ti ti-plus" aria-hidden="true"></i><span class="hours-add-text">{{ 'hours.add_shift'|trans({}, 'admin_settings') }}</span>
                                    </button>
                                </div>
                                {{ fieldErr.message(errors, 'hours_' ~ day) }}
                            </div>
                        {% endfor %}
                    </div>

                </div>
                <div class="section-save">
                    <button type="submit" name="section" value="hours" class="section-save-btn">
                        <i class="ti ti-device-floppy" aria-hidden="true"></i> {{ 'action.save_section'|trans({}, 'admin_settings') }}
                    </button>
                </div>
            </div>

            <div class="settings-footer">
                <button type="submit" class="save-btn">
                    <i class="ti ti-check" aria-hidden="true"></i> {{ 'action.save'|trans({}, 'admin_settings') }}
                </button>
            </div>

        </form>

    </div>
{% endblock %}

{% block javascripts %}
    <script>
        // ── Horario: the switch is the "closed" checkbox — closing a day hides
        // and disables its shifts (disabled inputs aren't submitted, so a closed
        // day posts only its flag). "+ Añadir turno" reveals shift 2, ✕ clears
        // and hides it again. "Copiar lunes" copies Monday's flag, times and
        // shift-2 visibility to every other day. ──
        (function () {
            const days = Array.from(document.querySelectorAll('.hours-day'));
            if (!days.length) return;
            const parts = dayEl => {
                const shifts = dayEl.querySelectorAll('.hours-shift');
                return { box: dayEl.querySelector('.hours-closed-input'), shift2: shifts[1], add: dayEl.querySelector('.hours-add') };
            };
            const setClosed = (dayEl, closed) => {
                dayEl.classList.toggle('is-closed', closed);
                dayEl.querySelectorAll('input[type="time"]').forEach(i => { i.disabled = closed; });
            };
            const setShift2 = (dayEl, show) => {
                const { shift2, add } = parts(dayEl);
                shift2.hidden = !show;
                add.hidden = show;
                if (!show) shift2.querySelectorAll('input').forEach(i => { i.value = ''; });
            };
            days.forEach(dayEl => {
                const { box, shift2, add } = parts(dayEl);
                box.addEventListener('change', () => setClosed(dayEl, box.checked));
                add.addEventListener('click', () => { setShift2(dayEl, true); shift2.querySelector('input').focus(); });
                shift2.querySelector('.hours-remove').addEventListener('click', () => { setShift2(dayEl, false); add.focus(); });
            });
            document.getElementById('hours-copy-mon')?.addEventListener('click', () => {
                const mon = days[0];
                const monClosed = parts(mon).box.checked;
                const monShift2 = !parts(mon).shift2.hidden;
                const monTimes = Array.from(mon.querySelectorAll('input[type="time"]')).map(i => i.value);
                days.slice(1).forEach(dayEl => {
                    parts(dayEl).box.checked = monClosed;
                    setShift2(dayEl, monShift2);
                    dayEl.querySelectorAll('input[type="time"]').forEach((i, idx) => { i.value = monTimes[idx] ?? ''; });
                    setClosed(dayEl, monClosed);
                });
            });
        })();

        const MSG_LOGO_REMOVED       = "{{ 'toast.logo_removed'|trans({}, 'admin_settings')|e('js') }}";
        const MSG_HERO_IMAGE_REMOVED = "{{ 'toast.hero_image_removed'|trans({}, 'admin_settings')|e('js') }}";
        const MSG_URL_COPIED         = "{{ 'toast.url_copied'|trans({}, 'admin_settings')|e('js') }}";
        // Same wording SettingsController flashes server-side for the exact
        // same UploadQualityWarning cases (its own no-JS fallback path) —
        // kept in sync by both sourcing the 'flash.hero_image_warning_*'
        // keys, never a JS-only string that could drift from that copy.
        const MSG_HERO_WARNING_DIMENSIONS = "{{ 'flash.hero_image_warning_dimensions'|trans({}, 'admin_settings')|e('js') }}";
        const MSG_HERO_WARNING_PORTRAIT   = "{{ 'flash.hero_image_warning_portrait'|trans({}, 'admin_settings')|e('js') }}";
        // Before saving, so its own "will still be saved" wording rather
        // than the post-save flash.hero_image_warning_width.
        const MSG_HERO_NOTICE_WIDTH       = "{{ 'hint.hero_image_width_notice'|trans({}, 'admin_settings')|e('js') }}";

        // ── Logo preview ──
        function previewLogo(input) {
            if (!input.files?.length) return;
            const url     = URL.createObjectURL(input.files[0]);
            const preview = document.getElementById('logo-preview');
            let img       = document.getElementById('logo-img');
            const letter  = document.getElementById('logo-letter');
            if (!img) {
                img = document.createElement('img');
                img.id = 'logo-img';
                preview.appendChild(img);
            }
            img.src = url;
            if (letter) letter.style.display = 'none';
        }

        function removeLogo() {
            const input  = document.getElementById('remove-logo-input');
            const img    = document.getElementById('logo-img');
            const letter = document.getElementById('logo-letter');
            if (input) input.value = '1';
            if (img)   img.remove();
            if (letter) letter.style.display = '';
            showToast(MSG_LOGO_REMOVED, 'info');
        }

        // ── Hero image preview — same pattern as the logo above, but its
        // empty-state fallback is a plain icon (no restaurant-initial letter
        // makes sense for a header photo), so the fallback element toggled
        // here is that <i>, not a <span>. ──
        function previewHeroImage(input) {
            if (!input.files?.length) return;
            const url     = URL.createObjectURL(input.files[0]);
            const preview = document.getElementById('hero-image-preview');
            let img       = document.getElementById('hero-image-img');
            const icon    = preview.querySelector('i');
            if (!img) {
                img = document.createElement('img');
                img.id = 'hero-image-img';
                preview.appendChild(img);
            }
            img.src = url;
            if (icon) icon.style.display = 'none';
        }

        function removeHeroImage() {
            const input = document.getElementById('remove-hero-image-input');
            const img   = document.getElementById('hero-image-img');
            if (input) input.value = '1';
            if (img) {
                img.remove();
                const preview = document.getElementById('hero-image-preview');
                const icon = document.createElement('i');
                icon.className = 'ti ti-photo';
                icon.setAttribute('aria-hidden', 'true');
                preview.appendChild(icon);
            }
            showToast(MSG_HERO_IMAGE_REMOVED, 'info');
        }

        // ── Hero image quality warning — client-side mirror of
        // UploadQualityWarning (UploadValidator.php). Purely advisory: the
        // server re-decodes and re-checks the real uploaded file from
        // scratch regardless of what runs here, so this can only ever make
        // the UX nicer (catch it before a round-trip), never weaker — a
        // disabled/broken/bypassed script just falls through to the
        // server's own "needs confirmation" flash + the same checkbox. ──
        function checkHeroImageQuality(input) {
            const warningBox = document.getElementById('hero-quality-warning');
            const messagesEl = document.getElementById('hero-quality-warning-messages');
            const confirmBox = document.getElementById('hero-quality-confirmed');
            const noteEl = document.getElementById('hero-quality-note');
            const minDimension = parseInt(input.dataset.minDimension, 10);
            const recommendedWidth = parseInt(input.dataset.recommendedWidth, 10);

            const reset = () => { warningBox.hidden = true; messagesEl.innerHTML = ''; confirmBox.checked = false; noteEl.hidden = true; noteEl.textContent = ''; };

            if (!input.files?.length) { reset(); return; }

            const url = URL.createObjectURL(input.files[0]);
            const img = new Image();
            img.onload = function () {
                const w = img.naturalWidth, h = img.naturalHeight;
                // Same %placeholders% SettingsController::heroImageWarningParams() fills.
                const fill = (text) => text.replaceAll('%width%', w).replaceAll('%height%', h)
                    .replaceAll('%min%', minDimension).replaceAll('%recommended%', recommendedWidth);
                const messages = [];
                const tooSmall = w < minDimension || h < minDimension;
                if (tooSmall) messages.push(fill(MSG_HERO_WARNING_DIMENSIONS));
                if (w < h) messages.push(fill(MSG_HERO_WARNING_PORTRAIT));
                // Not on top of the "too small" one, as on the server.
                const narrow = !tooSmall && w < recommendedWidth;
                noteEl.textContent = narrow ? fill(MSG_HERO_NOTICE_WIDTH) : '';
                noteEl.hidden = !narrow;

                if (messages.length) {
                    messagesEl.innerHTML = '';
                    messages.forEach(function (text) {
                        const p = document.createElement('p');
                        p.textContent = text;
                        messagesEl.appendChild(p);
                    });
                    warningBox.hidden = false;
                    confirmBox.checked = false;
                } else {
                    warningBox.hidden = true; messagesEl.innerHTML = ''; confirmBox.checked = false;
                }
                URL.revokeObjectURL(url);
            };
            img.onerror = function () { URL.revokeObjectURL(url); };
            img.src = url;
        }

        // Checking the box IS "Subir de todas formas" — a real checkbox so
        // it's focusable/keyboard-operable/announced by a screen reader on
        // its own (see .quality-warning-confirm in the CSS above), styled
        // to look like a button. Ticking it immediately resubmits the form;
        // the server trusts heroImageQualityConfirmed=1 for the quality
        // warnings ONLY — see UploadValidator::validate()'s own guard.
        function confirmHeroQualityAndSubmit(checkbox) {
            if (checkbox.checked) {
                checkbox.closest('form').requestSubmit();
            }
        }

        // No-op unless a pending, unconfirmed hero-image warning is showing:
        // moves focus to the confirm checkbox instead of letting a plain
        // "Guardar cambios" click silently round-trip to the server just to
        // get the same warning back as a flash.
        document.querySelector('form[method="post"]').addEventListener('submit', function (e) {
            // A per-section save outside Apariencia never sends the photo.
            const section = e.submitter?.name === 'section' ? e.submitter.value : null;
            if (section && section !== 'appearance') return;
            const warningBox = document.getElementById('hero-quality-warning');
            const confirmBox = document.getElementById('hero-quality-confirmed');
            if (warningBox && !warningBox.hidden && confirmBox && !confirmBox.checked) {
                e.preventDefault();
                confirmBox.focus();
            }
        });

        // ── Copy URL ──
        function copyUrl() {
            const url = document.getElementById('menu-url')?.textContent?.trim();
            if (!url) return;
            navigator.clipboard.writeText(url).then(() => showToast(MSG_URL_COPIED, 'success'));
        }
    </script>
{% endblock %}
