{% extends 'admin/base.html.twig' %}

{# Owner's subscription screen (BillingController::index()): the shared
   billing/_subscription.html.twig with the owner's routes, plan change
   included. #}

{% block title %}{{ 'title'|trans({}, 'admin_billing') }}{% endblock %}
{% block page_title %}{{ 'title'|trans({}, 'admin_billing') }}{% endblock %}

{% block stylesheets %}
    {% include 'billing/_subscription_styles.html.twig' %}
{% endblock %}

{% block body %}
    {% include 'billing/_subscription.html.twig' with {
        customer: restaurant,
        token_id: 'billing-manage',
        routes: {
            resume: 'admin_billing_resume', cancel: 'admin_billing_cancel', card: 'admin_billing_card',
            change_plan: 'admin_billing_change_plan', undo_plan_change: 'admin_billing_undo_plan_change',
        },
    } %}
{% endblock %}
