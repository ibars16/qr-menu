{# Shared user form fields — used in both desktop modal and mobile sheet #}

<div class="field">
    <div class="field-label">{{ 'field.email'|trans({}, 'admin_users') }} <span class="req">*</span></div>
    <input type="email" id="user-email" placeholder="nombre@restaurante.com" autocomplete="off"
           oninput="this.classList.remove('error'); document.getElementById('user-email-error').classList.remove('show')">
    <div class="field-error" id="user-email-error">{{ 'error.email_invalid'|trans({}, 'admin_users') }}</div>
</div>

<div class="field">
    <div class="field-label">{{ 'field.first_name'|trans({}, 'admin_users') }}</div>
    <input type="text" id="user-first-name" autocomplete="off">
</div>

<div class="field">
    <div class="field-label">{{ 'field.last_name'|trans({}, 'admin_users') }}</div>
    <input type="text" id="user-last-name" autocomplete="off">
</div>

<div class="field">
    <div class="field-label">
        {{ 'field.password'|trans({}, 'admin_users') }} <span class="req" id="user-password-req">*</span>
    </div>
    <input type="password" id="user-password" autocomplete="new-password"
           oninput="this.classList.remove('error'); document.getElementById('user-password-error').classList.remove('show')">
    <div class="field-hint" id="user-password-hint" style="display:none">{{ 'hint.password_edit'|trans({}, 'admin_users') }}</div>
    <div class="field-error" id="user-password-error">{{ 'error.password_too_short'|trans({}, 'admin_users') }}</div>
</div>

<div class="field">
    <div class="field-label">{{ 'field.role'|trans({}, 'admin_users') }}</div>
    <select id="user-role">
        <option value="staff">{{ 'role.staff'|trans({}, 'admin_users') }}</option>
        <option value="owner">{{ 'role.owner'|trans({}, 'admin_users') }}</option>
    </select>
    <div class="field-hint">{{ 'hint.role'|trans({}, 'admin_users') }}</div>
</div>
