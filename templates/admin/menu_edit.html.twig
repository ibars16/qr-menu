                </button>
            </div>
        </div>
    </div>
    <div class="sheet-overlay" id="mobile-section-sheet" onclick="if(event.target===this)SectionUI.close()">
        <div class="sheet">
            <div class="sheet-handle"></div>
            <div class="panel-header">
                <div class="panel-title" id="section-sheet-title">{{ 'modal.section_new_title'|trans({}, 'admin_menus') }}</div>
                <button class="panel-close" onclick="SectionUI.close()" aria-label="{{ 'action.close'|trans({}, 'admin_menus') }}">
                    <i class="ti ti-x" aria-hidden="true"></i>
                </button>
            </div>
            <div class="panel-body">
                <div class="field">
                    <label class="field-label">{{ 'field.name'|trans({}, 'admin_menus') }} <span class="req">*</span></label>
                    <input type="text"
                           id="section-name-input"
                           placeholder="{{ 'field.section_name_placeholder'|trans({}, 'admin_menus') }}"
