                </div>
            </div>
            <div class="panel-footer">
                <button class="btn" onclick="SectionUI.close()">{{ 'action.cancel'|trans({}, 'admin_menus') }}</button>
                <button class="btn btn-primary" onclick="SectionUI.save()">
                    <i class="ti ti-check" aria-hidden="true"></i> {{ 'action.save'|trans({}, 'admin_menus') }}
