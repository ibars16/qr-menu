    {% include 'admin/_product_modal.html.twig' with {'show_category_step': false} %}
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
    <script>
        const MENU_ID = {{ menu.id }};

        const MSG_HEADER_UPDATED = "{{ 'toast.menu_updated'|trans({}, 'admin_menus')|e('js') }}";
        const MSG_MENU_NAME_CURRENT = "{{ menuName|e('js') }}";
        const MSG_MENU_TYPE_CURRENT = "{{ menu.type ? menu.type.value : '' }}";
        const MSG_MENU_PRICE_CURRENT = {{ (menu.menuPrice / 100) }};
        const MSG_MENU_DESCRIPTION_CURRENT = "{{ menu.menuDescription ? menu.menuDescription|e('js') : '' }}";
        const MSG_SECTION_NEW_TITLE = "{{ 'modal.section_new_title'|trans({}, 'admin_menus')|e('js') }}";
        const MSG_SECTION_EDIT_TITLE = "{{ 'modal.section_edit_title'|trans({}, 'admin_menus')|e('js') }}";
        const MSG_SECTION_CREATED = "{{ 'toast.section_created'|trans({}, 'admin_menus')|e('js') }}";
        const MSG_SECTION_UPDATED = "{{ 'toast.section_updated'|trans({}, 'admin_menus')|e('js') }}";
        const MSG_SECTION_DELETED = "{{ 'toast.section_deleted'|trans({}, 'admin_menus')|e('js') }}";
        const MSG_CONFIRM_DELETE_SECTION_WITH_DISHES = "{{ 'confirm.delete_section_with_dishes'|trans({}, 'admin_menus')|e('js') }}";
        const MSG_CONFIRM_DELETE_SECTION_SIMPLE = "{{ 'confirm.delete_section_simple'|trans({}, 'admin_menus')|e('js') }}";

        // S must exist before _admin_js_utils/_product_js — see their
        // shared-JS contract notes in menu.html.twig.
        const S = {
            productId: null,
            categoryId: null,
            menuSectionId: null,
            editingCatId: null,
            spicy: 0,
            allergenOverrides: [],
            ingredientAllergenCache: {},
            productTranslations: {},
        };
    </script>
    {% include 'admin/_admin_js_utils.html.twig' %}
    {% include 'admin/_product_js.html.twig' %}
    <script>
        // ── Header edit ──────────────────────────────────────────────────────────
        const UI = {
            openEditHeader() {
                ['d-menu-name-input','m-menu-name-input'].forEach(id => { const el = document.getElementById(id); if (el) el.value = MSG_MENU_NAME_CURRENT; });
                ['d-menu-type-select','m-menu-type-select'].forEach(id => { const el = document.getElementById(id); if (el) el.value = MSG_MENU_TYPE_CURRENT; });
                ['d-menu-price-input','m-menu-price-input'].forEach(id => { const el = document.getElementById(id); if (el) el.value = MSG_MENU_PRICE_CURRENT.toFixed(2); });
                ['d-menu-description-input','m-menu-description-input'].forEach(id => { const el = document.getElementById(id); if (el) el.value = MSG_MENU_DESCRIPTION_CURRENT; });
                ['d-menu-name-error','m-menu-name-error','d-menu-price-error','m-menu-price-error'].forEach(id => document.getElementById(id)?.classList.remove('show'));
                if (isMobile()) document.getElementById('mobile-header-sheet').classList.add('open');
                else            document.getElementById('desktop-header-modal').classList.add('open');
            },
            closeHeader() {
                document.getElementById('mobile-header-sheet').classList.remove('open');
                document.getElementById('desktop-header-modal').classList.remove('open');
            },
            async saveHeader() {
                const s = isMobile() ? 'm' : 'd';
                const name  = document.getElementById(`${s}-menu-name-input`).value.trim();
                const type  = document.getElementById(`${s}-menu-type-select`).value;
                const price = document.getElementById(`${s}-menu-price-input`).value;
                const description = document.getElementById(`${s}-menu-description-input`).value.trim();

                let ok = true;
                if (!name) { document.getElementById(`${s}-menu-name-error`).classList.add('show'); ok = false; }
                else document.getElementById(`${s}-menu-name-error`).classList.remove('show');
                if (!price || parseFloat(price) <= 0) { document.getElementById(`${s}-menu-price-error`).classList.add('show'); ok = false; }
                else document.getElementById(`${s}-menu-price-error`).classList.remove('show');
                if (!ok) return;

                const data = await apiFetch(`/admin/menus/${MENU_ID}/edit`, { name, type, menuPrice: price, menuDescription: description || null });
                if (data.error) { showToast(data.error, 'error'); return; }

                showToast(MSG_HEADER_UPDATED, 'success');
                this.closeHeader();
                setTimeout(() => location.reload(), 700);
            },
        };

        // ── Sections ─────────────────────────────────────────────────────────────
        // Same styled modal/sheet pattern as the Carta screen's category
        // modal (single "Nombre" field, prefilled + retitled for rename) —
        // replaces the native prompt() this used to be. Deletion stays a
        // native confirm(), matching category/product deletion elsewhere in
        // this admin — that IS the established pattern for delete confirms,
        // not an oversight.
        const SectionUI = {
            editingId: null,
            open(id, currentLabel) {
                this.editingId = id;
                const title = id ? MSG_SECTION_EDIT_TITLE : MSG_SECTION_NEW_TITLE;
                document.getElementById('section-modal-title').textContent = title;
                document.getElementById('section-sheet-title').textContent = title;
                setVal('section-name-input', currentLabel ?? '');
                document.querySelectorAll('[id="section-name-error"]').forEach(el => el.classList.remove('show'));
                if (isMobile()) document.getElementById('mobile-section-sheet').classList.add('open');
                else            document.getElementById('desktop-section-modal').classList.add('open');
                setTimeout(() => panelEl('section-name-input')?.focus(), 80);
            },
            close() {
                document.getElementById('mobile-section-sheet').classList.remove('open');
                document.getElementById('desktop-section-modal').classList.remove('open');
            },
            async save() {
                const label = getVal('section-name-input');
                if (!label) { panelEl('section-name-error')?.classList.add('show'); return; }
                panelEl('section-name-error')?.classList.remove('show');

                const url = this.editingId
                    ? `/admin/menu-sections/${this.editingId}/rename`
                    : `/admin/menus/${MENU_ID}/sections/create`;
                const data = await apiFetch(url, { label });
                if (data.error) { showToast(data.error, 'error'); return; }

                showToast(this.editingId ? MSG_SECTION_UPDATED : MSG_SECTION_CREATED, 'success');
                this.close();
                setTimeout(() => location.reload(), 400);
            },
        };

        async function deleteSection(id, label, dishCount, btn) {
            const msg = dishCount > 0
                ? MSG_CONFIRM_DELETE_SECTION_WITH_DISHES.replace('%name%', label).replace('%count%', dishCount)
                : MSG_CONFIRM_DELETE_SECTION_SIMPLE.replace('%name%', label);
            if (!confirm(msg)) return;

            const data = await apiFetch(`/admin/menu-sections/${id}/delete`);
            if (data.ok) {
                showToast(MSG_SECTION_DELETED, 'success');
                setTimeout(() => location.reload(), 400);
            }
        }

        // ── Drag-reorder: sections among themselves, dishes within/between
        // sections (shared Sortable "group" so a dish can be dropped into any
        // section's list, not just reordered within its own). ──────────────────
        function saveDishOrder() {
            const sections = [...document.querySelectorAll('.section-dishes')].map(list => ({
                id: parseInt(list.dataset.sectionId),
                productIds: [...list.querySelectorAll('.dish-row')].map(r => parseInt(r.dataset.id)),
            }));
            apiFetch(`/admin/menus/${MENU_ID}/dishes/reorder`, { sections });
        }

        const sectionsSortableEl = document.getElementById('sections-sortable');
        if (sectionsSortableEl) {
            Sortable.create(sectionsSortableEl, {
                handle: '.section-drag',
                animation: 150,
                onEnd: async () => {
                    const ids = [...sectionsSortableEl.querySelectorAll('.section-card')].map(c => parseInt(c.dataset.id));
                    await apiFetch(`/admin/menus/${MENU_ID}/sections/reorder`, { ids });
                },
            });
        }

        document.querySelectorAll('.section-dishes').forEach(list => {
            Sortable.create(list, {
                group: 'menu-dishes',
                handle: '.dish-drag',
                animation: 150,
                onEnd: saveDishOrder,
            });
        });
    </script>
{% endblock %}
