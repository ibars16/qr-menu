{# CSS + JS for _ai_photo_batch.html.twig — include once per page that shows one or more boxes. #}
<style>
    /* All text from the AA tokens, on --bg-input: --tx-1 (dark 10.84:1,
       light 10.99:1), --tx-2 (7.49:1 / 6.48:1), --err-text (7.91:1 /
       5.76:1, see _styles_tokens). Buttons are the standard .btn /
       .btn-primary. The bar is decorative: the count next to it says it. */
    .ai-batch {
        background:var(--bg-input); border:1px solid var(--bd-2); border-radius:var(--r-md);
        padding:var(--sp-3) var(--sp-4); margin-bottom:var(--sp-5);
        font-size:var(--fs-base); line-height:var(--lh-body); color:var(--tx-1); text-align:left;
    }
    .ai-batch-text { display:flex; align-items:flex-start; gap:var(--sp-2); }
    .ai-batch-text i { font-size:16px; flex-shrink:0; margin-top:2px; }
    .ai-batch-trial, .ai-batch-hint, .ai-batch-skipped { margin:6px 0 0; font-size:var(--fs-sm); color:var(--tx-2); }
    .ai-batch:not([data-state="idle"]) .ai-batch-trial-box { display:none; }
    /* Trial: framed in the brand colour so "gratis / elige un plan" is read.
       Same background as the box, so text keeps the --tx-1/--tx-2 ratios. */
    .ai-batch-trial-box { margin-top:var(--sp-3); padding:var(--sp-2) var(--sp-3); border:1px solid var(--brand); border-radius:var(--r-md); }
    .ai-batch-trial-title { margin:0; font-weight:600; color:var(--tx-1); display:flex; align-items:center; gap:6px; }
    .ai-batch-trial-title i { color:var(--brand); font-size:18px; flex-shrink:0; }
    .ai-batch-trial-explain { margin:4px 0 0; color:var(--tx-1); }
    .ai-batch-trial-box .ai-batch-trial { margin-top:4px; }
    /* --tx-1 underlined, not --brand: brand text on --bg-input isn't AA. */
    .ai-batch-trial-plan { display:inline-flex; align-items:center; gap:4px; margin-top:var(--sp-2); font-weight:600; color:var(--tx-1); text-decoration:underline; text-underline-offset:3px; min-height:32px; }
    .ai-batch-trial-plan:hover { text-decoration-thickness:2px; }
    @media (max-width: 767px) { .ai-batch-trial-plan { min-height:44px; } }
    /* Import complete page: the card is centred, so is the box. */
    .ai-batch[data-variant="offer"] { text-align:center; }
    .ai-batch[data-variant="offer"] .ai-batch-text,
    .ai-batch[data-variant="offer"] .ai-batch-trial-title,
    .ai-batch[data-variant="offer"] .ai-batch-error,
    .ai-batch[data-variant="offer"] .ai-batch-actions { justify-content:center; }
    .ai-batch-plan-text { margin:var(--sp-2) 0 0; color:var(--tx-1); }
    .ai-batch-error { margin:var(--sp-2) 0 0; font-size:var(--fs-sm); color:var(--err-text); display:flex; gap:6px; align-items:flex-start; }
    .ai-batch-done { margin:var(--sp-2) 0 0; color:var(--tx-1); }
    .ai-batch-done i { color:#7aad40; }
    .ai-batch-created { margin:var(--sp-3) 0 0; font-weight:600; color:var(--tx-1); display:flex; align-items:center; gap:6px; }
    .ai-batch-created i { color:#7aad40; font-size:18px; flex-shrink:0; }
    .ai-batch[data-variant="offer"] .ai-batch-created { justify-content:center; }
    .ai-batch [hidden] { display:none !important; }
    .ai-batch-actions { display:flex; flex-wrap:wrap; gap:var(--sp-2); margin-top:var(--sp-3); }
    .ai-batch-actions form { margin:0; }
    .ai-batch-progress { display:none; margin-top:var(--sp-3); }
    .ai-batch[data-state="working"] .ai-batch-progress { display:block; }
    .ai-batch[data-state="working"] .ai-batch-actions,
    .ai-batch[data-state="done"] .ai-batch-actions { display:none; }
    .ai-batch-progress-label { display:flex; justify-content:space-between; gap:var(--sp-2); font-size:var(--fs-sm); }
    .ai-batch-count { font-variant-numeric:tabular-nums; color:var(--tx-2); }
    .ai-batch-bar { height:6px; margin-top:6px; border-radius:3px; background:var(--bd-2); overflow:hidden; }
    .ai-batch-bar span { display:block; height:100%; background:var(--brand); transition:width 0.3s; }
    @media (prefers-reduced-motion: reduce) { .ai-batch-bar span { transition:none; } }
    @media (max-width: 767px) {
        .ai-batch { padding:var(--sp-2) var(--sp-3); margin-bottom:var(--sp-3); }
        .ai-batch-actions .btn { min-height:44px; }
    }
</style>
<script>
    // One dish per request (DishPhotoController::importStep) until done. A
    // network/CSRF hiccup is retried once after 3 s; a stop the server
    // reports (Gemini down, the brake) shows its message. On the trial the
    // server ends the run when its photos are used up (trialEnded): then
    // "¿Te gustan? Elige un plan…" and, if the plan dialog is on the page,
    // "Elegir plan".
    (() => {
        const T = {{ {
            count: 'ai_photo.batch.count'|trans({'%done%': '__DONE__', '%total%': '__TOTAL__'}, 'admin_menu'),
            skippedOne: 'ai_photo.batch.skipped_singular'|trans({'%count%': '__COUNT__'}, 'admin_menu'),
            skippedMany: 'ai_photo.batch.skipped_plural'|trans({'%count%': '__COUNT__'}, 'admin_menu'),
            unavailable: 'ai_photo.error.unavailable'|trans({}, 'admin_menu'),
            trialEndOne: 'ai_photo.batch.trial_end_singular'|trans({'%count%': '__COUNT__'}, 'admin_menu'),
            trialEndMany: 'ai_photo.batch.trial_end_plural'|trans({'%count%': '__COUNT__'}, 'admin_menu'),
            trialEndCard: 'ai_photo.trial_used_card'|trans({'%limit%': ai_photo_trial_limit()}, 'admin_menu'),
            createdOne: 'ai_photo.batch.created_singular'|trans({'%count%': '__COUNT__'}, 'admin_menu'),
            createdMany: 'ai_photo.batch.created_plural'|trans({'%count%': '__COUNT__'}, 'admin_menu'),
            leftOne: 'ai_photo.batch.offer_singular'|trans({'%count%': '__COUNT__'}, 'admin_menu'),
            leftMany: 'ai_photo.batch.offer_plural'|trans({'%count%': '__COUNT__'}, 'admin_menu'),
        }|json_encode|raw }};
        const canChoosePlan = typeof BillingUI !== 'undefined';

        document.querySelectorAll('.ai-batch').forEach(box => {
            const $ = sel => box.querySelector(sel);
            const total = parseInt(box.dataset.total, 10) || 0;
            const trial = box.dataset.trial === '1';
            // A card set but not charged yet: no "Elegir plan", "cuando empiece tu plan" instead.
            const cardPending = box.dataset.cardPending === '1';
            const errorBox = $('.ai-batch-error'), errorText = $('.ai-batch-error-text');
            const plan = $('.ai-batch-plan');
            if (!canChoosePlan || cardPending) plan.hidden = true;
            let retried = false;
            let created = 0;

            // The run is over: say how many photos it made, and — complete page —
            // bring "N platos no tienen foto" up to date.
            const showCreated = remaining => {
                if (created > 0) {
                    $('.ai-batch-created-text').textContent = (created === 1 ? T.createdOne : T.createdMany).replace('__COUNT__', created);
                    $('.ai-batch-created').hidden = false;
                    $('.ai-batch-done').hidden = true;
                }
                const message = $('.ai-batch-message');
                if (message && box.dataset.variant === 'offer' && remaining > 0) {
                    message.textContent = (remaining === 1 ? T.leftOne : T.leftMany).replace('__COUNT__', remaining);
                }
            };

            const showSkipped = n => {
                const el = $('.ai-batch-skipped');
                el.hidden = !n;
                if (n) el.textContent = (n === 1 ? T.skippedOne : T.skippedMany).replace('__COUNT__', n);
            };
            // Trial: the run is the photos the trial has left, not every dish.
            const progress = (remaining, trialRemaining) => {
                const left = trial && trialRemaining != null ? Math.min(trialRemaining, remaining) : remaining;
                const done = Math.max(0, total - left);
                $('.ai-batch-count').textContent = T.count.replace('__DONE__', done).replace('__TOTAL__', total);
                $('.ai-batch-bar span').style.width = (total ? Math.round(done / total * 100) : 100) + '%';
            };
            const stop = message => {
                box.dataset.state = 'stopped';
                errorText.textContent = message;
                errorBox.hidden = false;
                $('.ai-batch-start').hidden = true;
                $('.ai-batch-retry').hidden = false;
                plan.hidden = true;
            };
            const trialEnded = remaining => {
                box.dataset.state = 'stopped';
                const text = $('.ai-batch-plan-text');
                text.textContent = cardPending ? T.trialEndCard : (remaining === 1 ? T.trialEndOne : T.trialEndMany).replace('__COUNT__', remaining);
                text.hidden = false;
                $('.ai-batch-start').hidden = true;
                $('.ai-batch-retry').hidden = true;
                plan.hidden = !canChoosePlan || cardPending;
            };

            const step = async () => {
                box.dataset.state = 'working';
                errorBox.hidden = true;
                let result;
                try {
                    const response = await fetch(box.dataset.stepUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: new URLSearchParams({ _token: box.dataset.token }),
                    });
                    result = await response.json();
                } catch (e) {
                    result = { error: true };
                }

                if (result.error) {
                    if (!retried) { retried = true; setTimeout(step, 3000); return; }
                    retried = false;
                    return stop(T.unavailable);
                }
                retried = false;
                if (result.generated) created++;
                progress(result.remaining, result.trialRemaining);
                showSkipped(result.skipped);

                if (result.stopped) { showCreated(result.remaining); return stop(result.message); }
                if (result.trialEnded) { trialEnded(result.remaining); return showCreated(result.remaining); }
                if (result.done) {
                    // Carta: reload to show the new photos. Complete page: say it's done.
                    if (box.dataset.variant === 'notice') { window.location.reload(); return; }
                    box.dataset.state = 'done';
                    $('.ai-batch-done').hidden = false;
                    return showCreated(result.remaining);
                }
                step();
            };

            $('.ai-batch-start').addEventListener('click', step);
            $('.ai-batch-retry').addEventListener('click', step);
        });
    })();
</script>
