<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ restaurant.name }}</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 16px;
            background: #f5f5f4;
            color: #1c1917;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            text-align: center;
            padding: 24px;
        }
        .message { font-size: 18px; font-weight: 600; }
        .logout { font-size: 14px; color: #57534e; }
    </style>
</head>
<body>
    <p class="message">{{ 'subscription_expired'|trans({'%date%': restaurant.paidUntil|date('d/m/Y')}, 'admin_base') }}</p>
    <a class="logout" href="{{ path('admin_logout') }}">{{ 'nav.item.logout'|trans({}, 'admin_base') }}</a>
</body>
</html>
