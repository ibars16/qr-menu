<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ restaurant.name }}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.31.0/dist/tabler-icons.min.css">
    <script>(function(){try{if(localStorage.getItem('admin-theme')==='light')document.documentElement.classList.add('light');}catch(e){}}());</script>
    <style>
        {% include 'admin/_styles_tokens.html.twig' %}
        {% include 'admin/_styles_controls.html.twig' %}

        body {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 16px;
            text-align: center;
            padding: 24px;
        }
        .message { font-size: 18px; font-weight: 600; color: var(--tx-hi); }
        .hint { font-size: 14px; color: var(--tx-muted); }
        .plans { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
        .plans form { display: contents; }
        .logout { font-size: 14px; color: var(--tx-muted); }
    </style>
</head>
<body>
    {% for message in app.flashes('error') %}
        <div class="flash flash-error"><i class="ti ti-alert-circle" aria-hidden="true"></i> {{ message }}</div>
    {% endfor %}

    {% if restaurant.billedByReseller or restaurant.archived %}
        {# The reseller pays (its own date, its restaurant's, or archived): nothing to pay here. #}
        <p class="message">{{ 'reseller_inactive'|trans({}, 'admin_base') }}</p>
        <p class="hint">{{ 'reseller_inactive_hint'|trans({'%name%': restaurant.reseller.name ?? ''}, 'admin_base') }}</p>
    {% else %}
        <p class="message">{{ 'subscription_expired'|trans({'%date%': restaurant.paidUntil|date('d/m/Y')}, 'admin_base') }}</p>

        {% if is_granted('ROLE_OWNER') %}
            <div class="plans">
                {% if not restaurant.hasLiveSubscription %}
                    {% for plan in ['monthly', 'yearly'] %}
                        <form method="post" action="{{ path('admin_billing_checkout') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('billing-checkout') }}">
                            <input type="hidden" name="plan" value="{{ plan }}">
                            <button type="submit" class="btn btn-primary">{{ ('billing.plan_' ~ plan)|trans({'%price%': billing_prices[plan]}, 'admin_base') }}</button>
                        </form>
                    {% endfor %}
                {% endif %}
                {% if restaurant.stripeCustomerId %}
                    <form method="post" action="{{ path('admin_billing_portal') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('billing-portal') }}">
                        <button type="submit" class="btn"><i class="ti ti-credit-card" aria-hidden="true"></i> {{ 'billing.nav'|trans({}, 'admin_base') }}</button>
                    </form>
                {% endif %}
            </div>
        {% else %}
            <p class="hint">{{ 'billing.staff_expired'|trans({}, 'admin_base') }}</p>
        {% endif %}
    {% endif %}

    {# Leaving "como" the owner (switch_user): back to /platform for the
       super-admin (Spanish only, its own tool), to /partners for a reseller. #}
    {% set impersonating = is_granted('IS_IMPERSONATOR') %}
    {% set exitToPartners = impersonating and 'ROLE_RESELLER' in app.token.originalToken.roleNames %}
    {% set exitUrl = impersonating ? impersonation_exit_path(path(exitToPartners ? 'partners_index' : 'platform_index')) : null %}
    {% set exitLabel = exitToPartners ? 'nav.item.back_to_partners'|trans({}, 'admin_base') : 'Volver a Plataforma' %}
    {% if impersonating %}
        <a class="logout" href="{{ exitUrl }}">{{ exitLabel }}</a>
    {% else %}
        <a class="logout" href="{{ path('admin_logout') }}">{{ 'nav.item.logout'|trans({}, 'admin_base') }}</a>
    {% endif %}
</body>
</html>
