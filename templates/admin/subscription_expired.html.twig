<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ restaurant.name }}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.31.0/dist/tabler-icons.min.css">
    <script>(function(){try{if(localStorage.getItem('admin-theme')==='light')document.documentElement.classList.add('light');}catch(e){}}());</script>
    <style>
        {% include 'admin/_styles_tokens.html.twig' %}
        {% include 'admin/_styles_controls.html.twig' %}

        body {
            display: flex; align-items: center; justify-content: center;
            padding: 24px 16px;
            background:
                radial-gradient(ellipse 80% 50% at 50% -10%, rgba(193,68,14,0.16), transparent 70%),
                var(--bg-page);
        }
        .expired {
            width: 100%; max-width: 420px;
            display: flex; flex-direction: column; align-items: center; gap: 14px;
            text-align: center;
        }
        .expired-card {
            width: 100%;
            display: flex; flex-direction: column; align-items: center; gap: 14px;
            padding: 32px 24px 24px;
            background: var(--bg-card); border: 1px solid var(--bd-2); border-radius: 18px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.35);
        }
        html.light .expired-card { box-shadow: 0 16px 40px rgba(0,0,0,0.08); }
        .expired-brand { display: flex; align-items: center; gap: 10px; color: var(--tx-2); font-size: 14px; font-weight: 500; }
        .expired-brand img, .expired-initial {
            width: 32px; height: 32px; border-radius: 9px; object-fit: cover; flex-shrink: 0;
        }
        .expired-initial {
            display: inline-flex; align-items: center; justify-content: center;
            background: var(--bg-input); border: 1px solid var(--bd-2); color: var(--tx-hi); font-weight: 600;
        }
        .expired-icon {
            width: 64px; height: 64px; margin-top: 6px; border-radius: 50%;
            display: inline-flex; align-items: center; justify-content: center;
            background: rgba(193,68,14,0.14); color: var(--brand); font-size: 30px;
            box-shadow: 0 0 0 8px rgba(193,68,14,0.06);
        }
        .message { font-size: 20px; line-height: 1.3; font-weight: 650; color: var(--tx-hi); text-wrap: balance; }
        .hint { font-size: 14px; line-height: 1.5; color: var(--tx-muted); max-width: 320px; text-wrap: pretty; }
        .plans { width: 100%; display: flex; flex-direction: column; gap: 10px; margin-top: 8px; }
        .plans form { display: contents; }
        .plans .btn { width: 100%; justify-content: center; min-height: 44px; font-size: 14px; border-radius: 10px; }
        .flash { width: 100%; text-align: left; }
        .logout {
            display: inline-flex; align-items: center; gap: 6px;
            font-size: 13px; color: var(--tx-muted); text-decoration: none; padding: 6px 10px; border-radius: 8px;
        }
        .logout:hover { color: var(--tx-hi); background: var(--bg-hover); }
        .logout:focus-visible, .plans .btn:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
    </style>
</head>
<body>
<main class="expired">
    {% for message in app.flashes('error') %}
        <div class="flash flash-error"><i class="ti ti-alert-circle" aria-hidden="true"></i> {{ message }}</div>
    {% endfor %}

    <div class="expired-card">
        <div class="expired-brand">
            {% if restaurant.logo %}
                <img src="{{ asset('uploads/logos/' ~ restaurant.logo) }}" alt="">
            {% else %}
                <span class="expired-initial" aria-hidden="true">{{ restaurant.name|first|upper }}</span>
            {% endif %}
            <span>{{ restaurant.name }}</span>
        </div>

    {# A reseller's restaurant pays here only once its reseller can charge
       it by card, and never while archived or while the reseller itself is
       expired (then nothing can turn it back on from here). #}
    {# Never paid (a reseller's restaurant has no free trial): "Elige un
       plan para activar tu carta" instead of "venció", with the reseller's
       plans — or, if it can't charge by card, who to contact. #}
    {% set resellerPlans = restaurant.reseller ? restaurant.reseller.restaurantPlans : null %}
    {% set firstPayment = restaurant.awaitingFirstPayment and not restaurant.archived and not restaurant.reseller.expired %}
    <span class="expired-icon" aria-hidden="true"><i class="ti {{ firstPayment ? 'ti-sparkles' : 'ti-lock' }}"></i></span>
    {% if firstPayment and not restaurant.ownerPaysByCard %}
        <p class="message" id="choose-plan">{{ 'choose_plan'|trans({}, 'admin_base') }}</p>
        <p class="hint">{{ 'reseller_inactive_hint'|trans({'%name%': restaurant.reseller.name}, 'admin_base') }}</p>
    {% elseif restaurant.archived or (restaurant.reseller and (not restaurant.ownerPaysByCard or restaurant.reseller.expired)) %}
        {# Nothing to pay here: contact the reseller. #}
        <p class="message">{{ 'reseller_inactive'|trans({}, 'admin_base') }}</p>
        <p class="hint">{{ 'reseller_inactive_hint'|trans({'%name%': restaurant.reseller.name ?? ''}, 'admin_base') }}</p>
    {% else %}
        {% if firstPayment %}
            <p class="message" id="choose-plan">{{ 'choose_plan'|trans({}, 'admin_base') }}</p>
        {% else %}
            <p class="message">{{ 'subscription_expired'|trans({'%date%': restaurant.paidUntil|date('d/m/Y')}, 'admin_base') }}</p>
        {% endif %}
        {# Staff can't pay: only theirs ("ask the owner"), below. #}
        {% if is_granted('ROLE_OWNER') %}
            <p class="hint">{{ (firstPayment ? 'first_payment_menu_hint' : 'expired_menu_hidden')|trans({}, 'admin_base') }}</p>
        {% endif %}

        {% if is_granted('ROLE_OWNER') %}
            <div class="plans">
                {% if not restaurant.hasLiveSubscription %}
                    {% import 'billing/_price.html.twig' as price %}
                    {% for plan in resellerPlans is not null ? resellerPlans|keys : ['monthly', 'yearly'] %}
                        <form method="post" action="{{ path('admin_billing_checkout') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('billing-checkout') }}">
                            <input type="hidden" name="plan" value="{{ plan }}">
                            <button type="submit" class="btn btn-primary">{{ ('billing.plan_' ~ plan)|trans({'%price%': resellerPlans is not null ? price.amount(resellerPlans[plan]) : price.amount(billing_prices[plan])}, 'admin_base') }}</button>
                        </form>
                    {% endfor %}
                {% endif %}
                {% if restaurant.stripeCustomerId %}
                    <form method="post" action="{{ path('admin_billing_portal') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('billing-portal') }}">
                        <button type="submit" class="btn"><i class="ti ti-credit-card" aria-hidden="true"></i> {{ 'billing.nav'|trans({}, 'admin_base') }}</button>
                    </form>
                {% endif %}
            </div>
        {% else %}
            <p class="hint">{{ 'billing.staff_expired'|trans({}, 'admin_base') }}</p>
        {% endif %}
    {% endif %}
    </div>

    {# Leaving "como" the owner (switch_user): back to /platform for the
       super-admin (Spanish only, its own tool), to /partners for a reseller. #}
    {% set impersonating = is_granted('IS_IMPERSONATOR') %}
    {% set exitToPartners = impersonating and 'ROLE_RESELLER' in app.token.originalToken.roleNames %}
    {% set exitUrl = impersonating ? impersonation_exit_path(path(exitToPartners ? 'partners_index' : 'platform_index')) : null %}
    {% set exitLabel = exitToPartners ? 'nav.item.back_to_partners'|trans({}, 'admin_base') : 'Volver a Plataforma' %}
    {% if impersonating %}
        <a class="logout" href="{{ exitUrl }}"><i class="ti ti-arrow-left" aria-hidden="true"></i>{{ exitLabel }}</a>
    {% else %}
        <a class="logout" href="{{ path('admin_logout') }}"><i class="ti ti-logout" aria-hidden="true"></i>{{ 'nav.item.logout'|trans({}, 'admin_base') }}</a>
    {% endif %}
</main>
</body>
</html>
