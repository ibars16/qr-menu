{% extends 'base.html.twig' %}
{% trans_default_domain 'login' %}

{% block title %}{{ 'title'|trans }} — QR Menu{% endblock %}

{# See public/base.html.twig's turbo_meta block for why: this page's own
   inline <style> block isn't Turbo-trackable, so a Turbo visit landing here
   (including via the back button) can leave the wrong styles applied. #}
{% block turbo_meta %}
    <meta name="turbo-visit-control" content="reload">
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.31.0/dist/tabler-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script>(function(){try{if(localStorage.getItem('admin-theme')==='light'||localStorage.getItem('site-theme')==='light')document.documentElement.classList.add('light');}catch(e){}}());</script>
    {# Grey text tokens at WCAG AA, the same values as the "forgot password"
       screens (_reset_layout): #a1a1aa on #141414 (7:1) dark, #52525b on
       #fafafa (7:1) light; #888 on #141414 is 5.3:1. Button text #fff on
       solid #C1440E (5:1) instead of the gradient (light end only 3.4:1). #}
    {% include 'security/_top_actions_styles.html.twig' %}
    <style>
        :root {
            --brand:          #C1440E;
            --brand-2:        #E8622A;
            --brand-grad:     linear-gradient(135deg, var(--brand), var(--brand-2));
            --bg-page:        #0a0a0a;
            --bg-card:        #141414;
            --bg-input:       #1a1a1a;
            --bd-card:        #242424;
            --bd-input:       #2a2a2a;
            --tx-hi:          #fff;
            --tx-label:       #888;
            --tx-sub:         #a1a1aa;
            --tx-muted:       #a1a1aa;
            --tx-placeholder: #444;
            --accent-text:    #F0997B;
        }
        html.light {
            --bg-page:        #f2f2f3;
            --bg-card:        #fafafa;
            --bg-input:       #efefef;
            --bd-card:        #d4d4d8;
            --bd-input:       #d4d4d8;
            --tx-hi:          #111;
            --tx-label:       #52525b;
            --tx-sub:         #52525b;
            --tx-muted:       #52525b;
            --tx-placeholder: #999;
            --accent-text:    #C1440E;
        }
        .theme-icon-light { display: none; }
        html.light .theme-icon-dark  { display: none; }
        html.light .theme-icon-light { display: inline-flex; }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            position: relative;
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: var(--bg-page);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            overflow-x: hidden;
        }
        body::before {
            content: ''; position: fixed; top: -260px; left: 50%; transform: translateX(-50%);
            width: 900px; height: 560px; pointer-events: none; z-index: 0;
            background: radial-gradient(ellipse at center, rgba(193,68,14,0.18) 0%, rgba(193,68,14,0.05) 40%, transparent 68%);
            filter: blur(60px);
        }

        .theme-toggle-btn {
            width: 34px; height: 34px; border-radius: 8px;
            border: 1px solid var(--bd-card); background: var(--bg-card);
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; color: var(--tx-label); font-size: 16px;
            transition: color 0.15s, border-color 0.15s;
        }
        .theme-toggle-btn:hover { color: var(--tx-hi); border-color: var(--tx-muted); }

        .login-wrap {
            position: relative; z-index: 1;
            width: 100%;
            max-width: 380px;
        }

        .login-logo {
            text-align: center;
            margin-bottom: 32px;
        }
        .login-logo-link { text-decoration: none; display: inline-block; }
        .login-logo-mark {
            width: 52px; height: 52px;
            border-radius: 14px;
            background: var(--brand-grad);
            display: inline-flex;
            align-items: center; justify-content: center;
            font-size: 22px; font-weight: 700; color: #fff;
            margin-bottom: 12px;
            box-shadow: 0 10px 24px -10px rgba(193,68,14,0.6);
        }
        .login-logo-name {
            font-size: 20px; font-weight: 600;
            color: var(--tx-hi); letter-spacing: -0.4px;
        }
        .login-logo-sub {
            font-size: 13px; color: var(--tx-sub); margin-top: 4px;
        }

        .login-card {
            background: var(--bg-card);
            border: 1px solid var(--bd-card);
            border-radius: 20px;
            padding: 30px 26px;
            box-shadow: 0 30px 60px -30px rgba(0,0,0,0.5);
        }

        .login-title {
            font-size: 17px; font-weight: 600;
            color: var(--tx-hi); letter-spacing: -0.3px;
            margin-bottom: 6px;
        }
        .login-sub {
            font-size: 13px; color: var(--tx-sub);
            margin-bottom: 24px;
        }

        .field { margin-bottom: 16px; }
        .field label {
            display: block;
            font-size: 12px; font-weight: 500;
            color: var(--tx-label); text-transform: uppercase;
            letter-spacing: 0.06em; margin-bottom: 6px;
        }
        .field input {
            width: 100%;
            background: var(--bg-input);
            border: 1px solid var(--bd-input);
            color: var(--tx-hi); font-size: 15px;
            padding: 11px 14px;
            border-radius: 10px; outline: none;
            transition: border-color 0.15s;
        }
        .field input::placeholder { color: var(--tx-placeholder); }
        .field input:focus { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(193,68,14,0.15); }

        .remember-row {
            display: flex; align-items: center;
            gap: 8px; margin-bottom: 20px;
        }
        .remember-row input[type="checkbox"] {
            width: 16px; height: 16px;
            accent-color: var(--brand); cursor: pointer;
        }
        .remember-row label {
            font-size: 13px; color: var(--tx-muted); cursor: pointer;
        }

        .login-btn {
            width: 100%; padding: 13px;
            background: var(--brand); color: #fff;
            border: none; border-radius: 10px;
            font-size: 15px; font-weight: 600;
            cursor: pointer; letter-spacing: -0.2px;
            box-shadow: 0 12px 26px -10px rgba(193,68,14,0.55);
            transition: opacity 0.15s, transform 0.15s, box-shadow 0.15s;
        }
        .login-btn:hover { opacity: 0.94; transform: translateY(-1px); box-shadow: 0 16px 32px -10px rgba(193,68,14,0.65); }

        /* "Contraseña cambiada" after a password reset (ResetPasswordController). */
        .success-msg {
            background: var(--bg-input);
            border: 1px solid var(--bd-input);
            border-radius: 10px;
            padding: 10px 14px;
            font-size: 13px; color: var(--tx-hi);
            margin-bottom: 20px;
            display: flex; align-items: center; gap: 8px;
        }
        /* --accent-text: #F0997B on #141414 and #C1440E on #fafafa, both AA. */
        .forgot-link {
            display: block; text-align: center; margin-top: 16px;
            font-size: 13px; color: var(--accent-text); text-decoration: none;
        }
        .forgot-link:hover { text-decoration: underline; }

        .error-msg {
            background: rgba(193, 68, 14, 0.12);
            border: 1px solid rgba(193, 68, 14, 0.3);
            border-radius: 10px;
            padding: 10px 14px;
            font-size: 13px; color: var(--accent-text);
            margin-bottom: 20px;
            display: flex; align-items: center; gap: 8px;
        }
    </style>
{% endblock %}

{% block body %}
    {% include 'security/_top_actions.html.twig' %}

    <div class="login-wrap">

        <div class="login-logo">
            <a href="{{ path('app_home') }}" class="login-logo-link">
                <div class="login-logo-mark">Q</div>
                <div class="login-logo-name">QR Menu</div>
            </a>
            <div class="login-logo-sub">{{ 'logo_sub'|trans }}</div>
        </div>

        <div class="login-card">
            <div class="login-title">{{ 'heading'|trans }}</div>
            <div class="login-sub">{{ 'sub'|trans }}</div>

            {% for message in app.flashes('login_success') %}
                <div class="success-msg" role="status">
                    <i class="ti ti-circle-check" style="font-size:16px;flex-shrink:0" aria-hidden="true"></i>
                    {{ message }}
                </div>
            {% endfor %}

            {% if error %}
                <div class="error-msg">
                    <i class="ti ti-alert-circle" style="font-size:16px;flex-shrink:0" aria-hidden="true"></i>
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" class="login-form">

                <div class="field">
                    <label for="email">{{ 'email'|trans }}</label>
                    <input type="email"
                           id="email"
                           name="email"
                           value="{{ last_username }}"
                           placeholder="{{ 'email_placeholder'|trans }}"
                           autocomplete="email"
                           autofocus
                           required>
                </div>

                <div class="field">
                    <label for="password">{{ 'password'|trans }}</label>
                    <input type="password"
                           id="password"
                           name="password"
                           placeholder="••••••••"
                           autocomplete="current-password"
                           required>
                </div>

                <div class="remember-row">
                    <input type="checkbox" id="remember" name="_remember_me">
                    <label for="remember">{{ 'remember'|trans }}</label>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="login-btn">{{ 'submit'|trans }}</button>

            </form>
            <a href="{{ path('admin_forgot_password') }}" class="forgot-link">{{ 'forgot'|trans }}</a>
            <div style="text-align:center;margin-top:16px;font-size:13px;color:var(--tx-sub)">
                {{ 'no_account'|trans }}
                <a href="{{ path('app_register') }}" style="color:var(--tx-label);text-decoration:none">
                    {{ 'register'|trans }}
                </a>
            </div>
        </div>

    </div>

    <script>
        window.toggleSiteTheme = function () {
            var isLight = document.documentElement.classList.toggle('light');
            var value = isLight ? 'light' : 'dark';
            try {
                localStorage.setItem('admin-theme', value);
                localStorage.setItem('site-theme', value);
            } catch (e) {}
        };
    </script>
{% endblock %}
