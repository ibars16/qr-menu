{% extends 'base.html.twig' %}

{% block title %}Acceder — QR Menu{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.31.0/dist/tabler-icons.min.css">
    <script>(function(){try{if(localStorage.getItem('admin-theme')==='light'||localStorage.getItem('site-theme')==='light')document.documentElement.classList.add('light');}catch(e){}}());</script>
    <style>
        :root {
            --brand:          #C1440E;
            --bg-page:        #0a0a0a;
            --bg-card:        #141414;
            --bg-input:       #1a1a1a;
            --bd-card:        #242424;
            --bd-input:       #2a2a2a;
            --tx-hi:          #fff;
            --tx-label:       #888;
            --tx-sub:         #555;
            --tx-muted:       #666;
            --tx-placeholder: #444;
            --accent-text:    #F0997B;
        }
        html.light {
            --bg-page:        #f2f2f3;
            --bg-card:        #fafafa;
            --bg-input:       #efefef;
            --bd-card:        #d4d4d8;
            --bd-input:       #d4d4d8;
            --tx-hi:          #111;
            --tx-label:       #777;
            --tx-sub:         #777;
            --tx-muted:       #666;
            --tx-placeholder: #999;
            --accent-text:    #C1440E;
        }
        .theme-icon-light { display: none; }
        html.light .theme-icon-dark  { display: none; }
        html.light .theme-icon-light { display: inline-flex; }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: var(--bg-page);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .theme-toggle-btn {
            position: fixed; top: 20px; right: 20px;
            width: 34px; height: 34px; border-radius: 8px;
            border: 1px solid var(--bd-card); background: var(--bg-card);
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; color: var(--tx-label); font-size: 16px;
            transition: color 0.15s, border-color 0.15s;
        }
        .theme-toggle-btn:hover { color: var(--tx-hi); border-color: var(--tx-muted); }

        .login-wrap {
            width: 100%;
            max-width: 380px;
        }

        .login-logo {
            text-align: center;
            margin-bottom: 32px;
        }
        .login-logo-mark {
            width: 52px; height: 52px;
            border-radius: 14px;
            background: var(--brand);
            display: inline-flex;
            align-items: center; justify-content: center;
            font-size: 22px; font-weight: 700; color: #fff;
            margin-bottom: 12px;
        }
        .login-logo-name {
            font-size: 20px; font-weight: 600;
            color: var(--tx-hi); letter-spacing: -0.4px;
        }
        .login-logo-sub {
            font-size: 13px; color: var(--tx-sub); margin-top: 4px;
        }

        .login-card {
            background: var(--bg-card);
            border: 1px solid var(--bd-card);
            border-radius: 16px;
            padding: 28px 24px;
        }

        .login-title {
            font-size: 17px; font-weight: 600;
            color: var(--tx-hi); letter-spacing: -0.3px;
            margin-bottom: 6px;
        }
        .login-sub {
            font-size: 13px; color: var(--tx-sub);
            margin-bottom: 24px;
        }

        .field { margin-bottom: 16px; }
        .field label {
            display: block;
            font-size: 12px; font-weight: 500;
            color: var(--tx-label); text-transform: uppercase;
            letter-spacing: 0.06em; margin-bottom: 6px;
        }
        .field input {
            width: 100%;
            background: var(--bg-input);
            border: 1px solid var(--bd-input);
            color: var(--tx-hi); font-size: 15px;
            padding: 11px 14px;
            border-radius: 10px; outline: none;
            transition: border-color 0.15s;
        }
        .field input::placeholder { color: var(--tx-placeholder); }
        .field input:focus { border-color: var(--tx-sub); }

        .remember-row {
            display: flex; align-items: center;
            gap: 8px; margin-bottom: 20px;
        }
        .remember-row input[type="checkbox"] {
            width: 16px; height: 16px;
            accent-color: var(--brand); cursor: pointer;
        }
        .remember-row label {
            font-size: 13px; color: var(--tx-muted); cursor: pointer;
        }

        .login-btn {
            width: 100%; padding: 12px;
            background: var(--brand); color: #fff;
            border: none; border-radius: 10px;
            font-size: 15px; font-weight: 600;
            cursor: pointer; letter-spacing: -0.2px;
            transition: opacity 0.15s;
        }
        .login-btn:hover { opacity: 0.9; }

        .error-msg {
            background: rgba(193, 68, 14, 0.12);
            border: 1px solid rgba(193, 68, 14, 0.3);
            border-radius: 10px;
            padding: 10px 14px;
            font-size: 13px; color: var(--accent-text);
            margin-bottom: 20px;
            display: flex; align-items: center; gap: 8px;
        }
    </style>
{% endblock %}

{% block body %}
    <button type="button" class="theme-toggle-btn" onclick="toggleSiteTheme()" title="Cambiar tema" aria-label="Cambiar entre modo oscuro y claro">
        <i class="ti ti-sun theme-icon-dark" aria-hidden="true"></i>
        <i class="ti ti-moon theme-icon-light" aria-hidden="true"></i>
    </button>

    <div class="login-wrap">

        <div class="login-logo">
            <div class="login-logo-mark">Q</div>
            <div class="login-logo-name">QR Menu</div>
            <div class="login-logo-sub">Panel de administración</div>
        </div>

        <div class="login-card">
            <div class="login-title">Bienvenido</div>
            <div class="login-sub">Accede con tu cuenta de restaurante</div>

            {% if error %}
                <div class="error-msg">
                    <i class="ti ti-alert-circle" style="font-size:16px;flex-shrink:0" aria-hidden="true"></i>
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post">

                <div class="field">
                    <label for="email">Email</label>
                    <input type="email"
                           id="email"
                           name="email"
                           value="{{ last_username }}"
                           placeholder="tu@restaurante.com"
                           autocomplete="email"
                           autofocus
                           required>
                </div>

                <div class="field">
                    <label for="password">Contraseña</label>
                    <input type="password"
                           id="password"
                           name="password"
                           placeholder="••••••••"
                           autocomplete="current-password"
                           required>
                </div>

                <div class="remember-row">
                    <input type="checkbox" id="remember" name="_remember_me">
                    <label for="remember">Mantener sesión iniciada</label>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="login-btn">Entrar</button>

            </form>
            <div style="text-align:center;margin-top:16px;font-size:13px;color:var(--tx-sub)">
                ¿No tienes cuenta?
                <a href="{{ path('app_register') }}" style="color:var(--tx-label);text-decoration:none">
                    Regístrate gratis
                </a>
            </div>
        </div>

    </div>

    <script>
        window.toggleSiteTheme = function () {
            var isLight = document.documentElement.classList.toggle('light');
            var value = isLight ? 'light' : 'dark';
            try {
                localStorage.setItem('admin-theme', value);
                localStorage.setItem('site-theme', value);
            } catch (e) {}
        };
    </script>
{% endblock %}
