{% extends 'security/_reset_layout.html.twig' %}
{% trans_default_domain 'reset_password' %}

{% block heading %}{{ 'reset.title'|trans }}{% endblock %}
{% block sub %}{{ 'reset.sub'|trans }}{% endblock %}

{% block form %}
    {% import 'security/_reset_layout.html.twig' as m %}
    {{ form_start(form, { attr: { novalidate: 'novalidate', 'data-turbo': 'false' } }) }}
        <div class="field">
            {{ form_label(form.password.first) }}
            {{ form_widget(form.password.first, { attr: { autocomplete: 'new-password', autofocus: true, 'aria-describedby': 'password-help' } }) }}
            <div class="field-help" id="password-help">{{ 'reset.password_help'|trans }}</div>
            {{ m.errors(form.password.first) }}
            {{ m.errors(form.password) }}
        </div>
        <div class="field">
            {{ form_label(form.password.second) }}
            {{ form_widget(form.password.second, { attr: { autocomplete: 'new-password' } }) }}
        </div>
        <button type="submit" class="submit-btn">{{ 'reset.submit'|trans }}</button>
    {{ form_end(form) }}
{% endblock %}
