{# Styles of _top_actions.html.twig (language picker + theme button, top
   right) on the logged-out screens: login, "forgot password" (both) and
   the sign-up. Included inside {% block stylesheets %}.

   The picker is the home's (public/base.html.twig .nav-lang-*). Its grey
   text has its own token, because the sign-up's --tx-sub (#555 dark) is
   below AA: #a1a1aa on #141414 (7:1) dark, #52525b on #fafafa (7:1)
   light; --tx-hi when hovered or active. #}
    <style>
        :root      { --lang-tx: #a1a1aa; }
        html.light { --lang-tx: #52525b; }

        .top-actions {
            position: fixed; top: 20px; right: 20px; z-index: 2;
            display: flex; align-items: center; gap: 8px;
        }
        .top-actions .theme-toggle-btn { position: static; }

        .lang-dropdown { position: relative; }
        .lang-current {
            display: flex; align-items: center; gap: 5px; list-style: none; cursor: pointer;
            height: 34px; font-size: 13px; font-weight: 600; color: var(--lang-tx);
            background: var(--bg-card); border: 1px solid var(--bd-card);
            padding: 0 10px; border-radius: 999px; user-select: none;
            transition: color 0.15s, border-color 0.15s;
        }
        .lang-current::-webkit-details-marker { display: none; }
        .lang-current:hover { color: var(--tx-hi); border-color: var(--lang-tx); }
        .lang-current:focus-visible { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px rgba(193,68,14,0.25); }
        .lang-current i { font-size: 11px; transition: transform 0.15s; }
        .lang-dropdown[open] .lang-current i { transform: rotate(180deg); }
        .lang-menu {
            position: absolute; top: calc(100% + 8px); right: 0; z-index: 60;
            min-width: 168px; background: var(--bg-card); border: 1px solid var(--bd-card);
            border-radius: 12px; padding: 6px; box-shadow: 0 16px 32px -12px rgba(0,0,0,0.6);
        }
        .lang-item {
            display: flex; align-items: center; gap: 9px; width: 100%; padding: 8px 10px;
            border: none; background: none; cursor: pointer; text-align: left;
            border-radius: 8px; font: 500 13px 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            color: var(--lang-tx); white-space: nowrap; transition: background 0.12s, color 0.12s;
        }
        .lang-item span { font-size: 15px; }
        .lang-item:hover, .lang-item:focus-visible { background: var(--bg-input); color: var(--tx-hi); outline: none; }
        .lang-item.active { color: var(--tx-hi); }
        .lang-item i { margin-left: auto; font-size: 13px; color: var(--accent-text); }

        /* Phones: the controls are fixed, so keep the logo clear of them;
           bigger tap targets in the language menu. */
        @media (max-width: 480px) {
            body { padding-top: 74px; }
            .top-actions { top: 16px; right: 16px; }
            .lang-item { padding: 11px 12px; font-size: 15px; }
        }
    </style>
