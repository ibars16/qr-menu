{% extends 'base.html.twig' %}

{% block title %}Crear cuenta — QR Menu{% endblock %}

{# See public/base.html.twig's turbo_meta block for why: this page's own
   inline <style> block isn't Turbo-trackable, so a Turbo visit landing here
   (including via the back button) can leave the wrong styles applied. #}
{% block turbo_meta %}
    <meta name="turbo-visit-control" content="reload">
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.31.0/dist/tabler-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script>(function(){try{if(localStorage.getItem('admin-theme')==='light'||localStorage.getItem('site-theme')==='light')document.documentElement.classList.add('light');}catch(e){}}());</script>
    {% include 'security/_auth_styles.html.twig' %}
{% endblock %}

{% block body %}
    <button type="button" class="theme-toggle-btn" onclick="toggleSiteTheme()" title="Cambiar tema" aria-label="Cambiar entre modo oscuro y claro">
        <i class="ti ti-sun theme-icon-dark" aria-hidden="true"></i>
        <i class="ti ti-moon theme-icon-light" aria-hidden="true"></i>
    </button>

    <div class="wrap">

        <div class="logo">
            <a href="{{ path('app_home') }}" class="logo-link">
                <div class="logo-mark">Q</div>
                <div class="logo-name">QR Menu</div>
            </a>
            <div class="logo-sub">Menús digitales inteligentes para restaurantes</div>
        </div>

        <div class="card">
            <div class="card-title">Crea tu cuenta</div>
            <div class="card-sub">Empieza tu prueba gratuita de 1 mes. Sin tarjeta de crédito.</div>

            {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}

            {# ── Restaurante ── #}
            <div class="section-divider">Tu restaurante</div>

            <div class="field">
                {{ form_label(form.restaurantName) }}
                {{ form_widget(form.restaurantName, { attr: { placeholder: 'Ej: Trattoria Roma' } }) }}
                <ul class="errors">
                    {% for error in form.restaurantName.vars.errors %}
                        <li>{{ error.message }}</li>
                    {% endfor %}
                </ul>
            </div>

            <div class="field-row">
                <div class="field">
                    {{ form_label(form.currency) }}
                    {{ form_widget(form.currency) }}
                </div>
                <div class="field">
                    {{ form_label(form.language) }}
                    {{ form_widget(form.language) }}
                </div>
            </div>

            <div class="field">
                {{ form_label(form.adminLocale) }}
                {{ form_widget(form.adminLocale) }}
                <div class="field-help">{{ form.adminLocale.vars.help }}</div>
            </div>

            {# ── Cuenta ── #}
            <div class="section-divider">Tu cuenta</div>

            <div class="field">
                {{ form_label(form.email) }}
                {{ form_widget(form.email, { attr: { placeholder: 'tu@restaurante.com' } }) }}
                <ul class="errors">
                    {% for error in form.email.vars.errors %}
                        <li>{{ error.message }}</li>
                    {% endfor %}
                </ul>
            </div>

            <div class="field">
                {{ form_label(form.password.first) }}
                {{ form_widget(form.password.first, { attr: { placeholder: 'Mínimo 8 caracteres' } }) }}
                <ul class="errors">
                    {% for error in form.password.vars.errors %}
                        <li>{{ error.message }}</li>
                    {% endfor %}
                </ul>
            </div>

            <div class="field">
                {{ form_label(form.password.second) }}
                {{ form_widget(form.password.second, { attr: { placeholder: 'Repite la contraseña' } }) }}
            </div>

            <button type="submit" class="submit-btn">Crear cuenta y entrar →</button>

            {{ form_end(form) }}
        </div>

        <div class="login-link">
            ¿Ya tienes cuenta? <a href="{{ path('admin_login') }}">Inicia sesión</a>
        </div>

    </div>

    <script>
        window.toggleSiteTheme = function () {
            var isLight = document.documentElement.classList.toggle('light');
            var value = isLight ? 'light' : 'dark';
            try {
                localStorage.setItem('admin-theme', value);
                localStorage.setItem('site-theme', value);
            } catch (e) {}
        };
    </script>
{% endblock %}
