{% extends 'security/_reset_layout.html.twig' %}
{% trans_default_domain 'reset_password' %}

{% block heading %}{{ 'request.title'|trans }}{% endblock %}
{% block sub %}{{ 'request.sub'|trans }}{% endblock %}

{% block form %}
    {% import 'security/_reset_layout.html.twig' as m %}
    {{ form_start(form, { attr: { novalidate: 'novalidate', 'data-turbo': 'false' } }) }}
        <div class="field">
            {{ form_label(form.email) }}
            {{ form_widget(form.email, { attr: { autocomplete: 'email', autofocus: true } }) }}
            {{ m.errors(form.email) }}
        </div>
        <button type="submit" class="submit-btn">{{ 'request.submit'|trans }}</button>
    {{ form_end(form) }}
{% endblock %}
