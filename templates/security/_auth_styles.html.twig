{# Styles of the sign-up pages: /register and the reseller sign-up
   (/partners/registro). Included inside {% block stylesheets %}. #}
    <style>
        :root {
            --brand:          #C1440E;
            --brand-2:        #E8622A;
            --brand-grad:     linear-gradient(135deg, var(--brand), var(--brand-2));
            --bg-page:        #0a0a0a;
            --bg-card:        #141414;
            --bg-input:       #1a1a1a;
            --bd-card:        #242424;
            /* AA: the greys below are the old ones a tone lighter.
               --bd-input 3.41:1 on --bg-card / 3.22:1 on --bg-input (was
               1.2:1); #8a8a8a 5.34:1 on --bg-card, 5.04:1 on --bg-input
               (--tx-sub #555 was 2.47:1, --tx-muted #666 3.21:1, the
               divider's #333 1.46:1, the placeholder's #444 1.79:1). */
            --bd-input:       #6a6a6a;
            --tx-hi:          #fff;
            --tx-label:       #888;
            --tx-sub:         #8a8a8a;
            --tx-muted:       #8a8a8a;
            --tx-faint:       #8a8a8a;
            --tx-placeholder: #8a8a8a;
            --accent-text:    #F0997B;
        }
        html.light {
            --bg-page:        #f2f2f3;
            --bg-card:        #fafafa;
            --bg-input:       #efefef;
            --bd-card:        #d4d4d8;
            /* --bd-input 3.01:1 on --bg-input (was 1.29:1); #666 4.99:1
               on --bg-input, 5.5:1 on --bg-card (#777 was 4.29:1, #999
               2.48–2.73:1). */
            --bd-input:       #898994;
            --tx-hi:          #111;
            --tx-label:       #666;
            --tx-sub:         #666;
            --tx-muted:       #666;
            --tx-faint:       #666;
            --tx-placeholder: #666;
            --accent-text:    #C1440E;
        }
        .theme-icon-light { display: none; }
        html.light .theme-icon-dark  { display: none; }
        html.light .theme-icon-light { display: inline-flex; }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            position: relative;
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: var(--bg-page);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px 20px;
            overflow-x: hidden;
        }
        body::before {
            content: ''; position: fixed; top: -260px; left: 50%; transform: translateX(-50%);
            width: 900px; height: 560px; pointer-events: none; z-index: 0;
            background: radial-gradient(ellipse at center, rgba(193,68,14,0.18) 0%, rgba(193,68,14,0.05) 40%, transparent 68%);
            filter: blur(60px);
        }

        .theme-toggle-btn {
            position: fixed; top: 20px; right: 20px; z-index: 2;
            width: 34px; height: 34px; border-radius: 8px;
            border: 1px solid var(--bd-card); background: var(--bg-card);
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; color: var(--tx-label); font-size: 16px;
            transition: color 0.15s, border-color 0.15s;
        }
        .theme-toggle-btn:hover { color: var(--tx-hi); border-color: var(--tx-muted); }

        .wrap { position: relative; z-index: 1; width: 100%; max-width: 420px; }

        .logo {
            text-align: center;
            margin-bottom: 28px;
        }
        .logo-link { text-decoration: none; display: inline-block; }
        .logo-mark {
            width: 52px; height: 52px;
            border-radius: 14px;
            background: var(--brand-grad);
            display: inline-flex;
            align-items: center; justify-content: center;
            font-size: 22px; font-weight: 700; color: #fff;
            margin-bottom: 12px;
            box-shadow: 0 10px 24px -10px rgba(193,68,14,0.6);
        }
        .logo-name { font-size: 20px; font-weight: 600; color: var(--tx-hi); letter-spacing: -0.4px; }
        .logo-sub  { font-size: 13px; color: var(--tx-sub); margin-top: 4px; }

        .card {
            background: var(--bg-card);
            border: 1px solid var(--bd-card);
            border-radius: 20px;
            padding: 30px 26px;
            box-shadow: 0 30px 60px -30px rgba(0,0,0,0.5);
        }
        .card-title { font-size: 17px; font-weight: 600; color: var(--tx-hi); letter-spacing: -0.3px; margin-bottom: 4px; }
        .card-sub   { font-size: 13px; color: var(--tx-sub); margin-bottom: 24px; }

        .section-divider {
            font-size: 10px; font-weight: 600; color: var(--tx-faint);
            text-transform: uppercase; letter-spacing: 0.1em;
            margin: 20px 0 14px;
            display: flex; align-items: center; gap: 10px;
        }
        .section-divider::before,
        .section-divider::after {
            content: ''; flex: 1;
            height: 1px; background: var(--bd-card);
        }

        .field { margin-bottom: 14px; }
        .field-help { font-size: 11px; color: var(--tx-sub); margin-top: 5px; }
        .field label {
            display: block;
            font-size: 12px; font-weight: 500; color: var(--tx-muted);
            text-transform: uppercase; letter-spacing: 0.06em;
            margin-bottom: 6px;
        }
        .field input,
        .field select {
            width: 100%;
            background: var(--bg-input);
            border: 1px solid var(--bd-input);
            color: var(--tx-hi); font-size: 14px;
            padding: 11px 14px;
            border-radius: 10px; outline: none;
            transition: border-color 0.15s;
            appearance: none; -webkit-appearance: none;
        }
        .field input::placeholder { color: var(--tx-placeholder); }
        .field input:focus,
        .field select:focus { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(193,68,14,0.15); }

        .field-row { display: flex; gap: 10px; }
        .field-row .field { flex: 1; }

        .errors {
            margin-top: 4px;
        }
        .errors li {
            font-size: 12px; color: var(--accent-text);
            list-style: none; margin-top: 3px;
        }
        /* Errors of the whole form, above the first field. */
        .form-errors { margin: 0 0 14px; }
        .form-errors li { font-size: 13px; }
        .field input.is-invalid,
        .field select.is-invalid { border-color: var(--brand); }
        .error-actions { margin-top: 6px; font-size: 12px; color: var(--tx-sub); display: flex; flex-wrap: wrap; gap: 6px; }
        .error-actions a { color: var(--accent-text); font-weight: 600; text-decoration: none; }
        .error-actions a:hover { text-decoration: underline; }

        .submit-btn {
            width: 100%; padding: 13px;
            background: var(--brand-grad); color: #fff;
            border: none; border-radius: 10px;
            font-size: 15px; font-weight: 600;
            cursor: pointer; letter-spacing: -0.2px;
            box-shadow: 0 12px 26px -10px rgba(193,68,14,0.55);
            transition: opacity 0.15s, transform 0.15s, box-shadow 0.15s;
            margin-top: 8px;
        }
        .submit-btn:hover { opacity: 0.94; transform: translateY(-1px); box-shadow: 0 16px 32px -10px rgba(193,68,14,0.65); }

        /* "¿Ya tienes cuenta? Inicia sesión": the link is an outlined button
           in the brand colour so whoever already has an account finds it.
           --accent-text on --bg-page 9.0:1 (dark) / 4.58:1 (light);
           hover: white on --brand 5.2:1. */
        .login-link {
            display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 8px 10px;
            margin-top: 18px;
            font-size: 14px; color: var(--tx-sub);
        }
        .login-link a {
            display: inline-flex; align-items: center; min-height: 40px; padding: 8px 18px;
            border: 1.5px solid var(--accent-text); border-radius: 10px;
            color: var(--accent-text); font-weight: 600; text-decoration: none;
            transition: background .15s, color .15s, border-color .15s;
        }
        .login-link a:hover { background: var(--brand); border-color: var(--brand); color: #fff; }
        .login-link a:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }

        /* "He leído y acepto…" (security/_accept_terms.html.twig): a real
           checkbox, not the text-field look of .field input above. Text
           --tx-hi, links --accent-text (#F0997B / #C1440E: 8.38:1 / 4.91:1
           on --bg-card). */
        .accept-terms { margin-top: 4px; }
        .field .accept-terms-label {
            display: flex; align-items: flex-start; gap: 10px; margin: 0;
            font-size: 13px; font-weight: 400; line-height: 1.45; color: var(--tx-hi);
            text-transform: none; letter-spacing: 0; cursor: pointer;
        }
        .field .accept-terms-label input[type="checkbox"] {
            width: 18px; height: 18px; min-height: 0; padding: 0; margin: 1px 0 0; flex-shrink: 0;
            appearance: auto; -webkit-appearance: checkbox; accent-color: var(--brand); cursor: pointer;
        }
        .field .accept-terms-label input[type="checkbox"]:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; box-shadow: none; }
        /* Not ticked on submit: the message is at the top of the form; the box is ringed like an invalid field. */
        .field .accept-terms-label input[type="checkbox"][aria-invalid="true"] { outline: 2px solid var(--brand); outline-offset: 2px; }
        .accept-terms-label a { color: var(--accent-text); text-decoration: underline; text-underline-offset: 2px; }

        /* Small legal line under the card (_legal_links.html.twig): --tx-sub
           (5.73:1 dark / 5.13:1 light on --bg-page). */
        .wrap { --legal-links-fg: var(--tx-sub); --legal-links-hover: var(--tx-hi); }
    </style>
