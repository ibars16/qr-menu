{# Styles of the sign-up pages: /register and the reseller sign-up
   (/partners/registro). Included inside {% block stylesheets %}. #}
    <style>
        :root {
            --brand:          #C1440E;
            --brand-2:        #E8622A;
            --brand-grad:     linear-gradient(135deg, var(--brand), var(--brand-2));
            --bg-page:        #0a0a0a;
            --bg-card:        #141414;
            --bg-input:       #1a1a1a;
            --bd-card:        #242424;
            --bd-input:       #2a2a2a;
            --tx-hi:          #fff;
            --tx-label:       #888;
            --tx-sub:         #555;
            --tx-muted:       #666;
            --tx-faint:       #333;
            --tx-placeholder: #444;
            --accent-text:    #F0997B;
        }
        html.light {
            --bg-page:        #f2f2f3;
            --bg-card:        #fafafa;
            --bg-input:       #efefef;
            --bd-card:        #d4d4d8;
            --bd-input:       #d4d4d8;
            --tx-hi:          #111;
            --tx-label:       #777;
            --tx-sub:         #777;
            --tx-muted:       #666;
            --tx-faint:       #999;
            --tx-placeholder: #999;
            --accent-text:    #C1440E;
        }
        .theme-icon-light { display: none; }
        html.light .theme-icon-dark  { display: none; }
        html.light .theme-icon-light { display: inline-flex; }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            position: relative;
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: var(--bg-page);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px 20px;
            overflow-x: hidden;
        }
        body::before {
            content: ''; position: fixed; top: -260px; left: 50%; transform: translateX(-50%);
            width: 900px; height: 560px; pointer-events: none; z-index: 0;
            background: radial-gradient(ellipse at center, rgba(193,68,14,0.18) 0%, rgba(193,68,14,0.05) 40%, transparent 68%);
            filter: blur(60px);
        }

        .theme-toggle-btn {
            position: fixed; top: 20px; right: 20px; z-index: 2;
            width: 34px; height: 34px; border-radius: 8px;
            border: 1px solid var(--bd-card); background: var(--bg-card);
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; color: var(--tx-label); font-size: 16px;
            transition: color 0.15s, border-color 0.15s;
        }
        .theme-toggle-btn:hover { color: var(--tx-hi); border-color: var(--tx-muted); }

        .wrap { position: relative; z-index: 1; width: 100%; max-width: 420px; }

        .logo {
            text-align: center;
            margin-bottom: 28px;
        }
        .logo-link { text-decoration: none; display: inline-block; }
        .logo-mark {
            width: 52px; height: 52px;
            border-radius: 14px;
            background: var(--brand-grad);
            display: inline-flex;
            align-items: center; justify-content: center;
            font-size: 22px; font-weight: 700; color: #fff;
            margin-bottom: 12px;
            box-shadow: 0 10px 24px -10px rgba(193,68,14,0.6);
        }
        .logo-name { font-size: 20px; font-weight: 600; color: var(--tx-hi); letter-spacing: -0.4px; }
        .logo-sub  { font-size: 13px; color: var(--tx-sub); margin-top: 4px; }

        .card {
            background: var(--bg-card);
            border: 1px solid var(--bd-card);
            border-radius: 20px;
            padding: 30px 26px;
            box-shadow: 0 30px 60px -30px rgba(0,0,0,0.5);
        }
        .card-title { font-size: 17px; font-weight: 600; color: var(--tx-hi); letter-spacing: -0.3px; margin-bottom: 4px; }
        .card-sub   { font-size: 13px; color: var(--tx-sub); margin-bottom: 24px; }

        .section-divider {
            font-size: 10px; font-weight: 600; color: var(--tx-faint);
            text-transform: uppercase; letter-spacing: 0.1em;
            margin: 20px 0 14px;
            display: flex; align-items: center; gap: 10px;
        }
        .section-divider::before,
        .section-divider::after {
            content: ''; flex: 1;
            height: 1px; background: var(--bd-card);
        }

        .field { margin-bottom: 14px; }
        .field-help { font-size: 11px; color: var(--tx-sub); margin-top: 5px; }
        .field label {
            display: block;
            font-size: 12px; font-weight: 500; color: var(--tx-muted);
            text-transform: uppercase; letter-spacing: 0.06em;
            margin-bottom: 6px;
        }
        .field input,
        .field select {
            width: 100%;
            background: var(--bg-input);
            border: 1px solid var(--bd-input);
            color: var(--tx-hi); font-size: 14px;
            padding: 11px 14px;
            border-radius: 10px; outline: none;
            transition: border-color 0.15s;
            appearance: none; -webkit-appearance: none;
        }
        .field input::placeholder { color: var(--tx-placeholder); }
        .field input:focus,
        .field select:focus { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(193,68,14,0.15); }

        .field-row { display: flex; gap: 10px; }
        .field-row .field { flex: 1; }

        .errors {
            margin-top: 4px;
        }
        .errors li {
            font-size: 12px; color: var(--accent-text);
            list-style: none; margin-top: 3px;
        }
        /* Errors of the whole form, above the first field. */
        .form-errors { margin: 0 0 14px; }
        .form-errors li { font-size: 13px; }

        .submit-btn {
            width: 100%; padding: 13px;
            background: var(--brand-grad); color: #fff;
            border: none; border-radius: 10px;
            font-size: 15px; font-weight: 600;
            cursor: pointer; letter-spacing: -0.2px;
            box-shadow: 0 12px 26px -10px rgba(193,68,14,0.55);
            transition: opacity 0.15s, transform 0.15s, box-shadow 0.15s;
            margin-top: 8px;
        }
        .submit-btn:hover { opacity: 0.94; transform: translateY(-1px); box-shadow: 0 16px 32px -10px rgba(193,68,14,0.65); }

        .login-link {
            text-align: center;
            margin-top: 16px;
            font-size: 13px; color: var(--tx-sub);
        }
        .login-link a { color: var(--tx-label); text-decoration: none; }
        .login-link a:hover { color: var(--tx-hi); }
    </style>
