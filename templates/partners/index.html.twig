{% extends 'partners/_base.html.twig' %}

{# The reseller's panel (PartnersController), a /platform for its own
   restaurants: summary cards, the list by paid_until with status and date,
   "Registrar pago", "Entrar", "Desactivar", archive / restore; "+ Nuevo
   restaurante"; while expired, "Elegir plan" and everything else disabled. #}

{% block main %}
        {% if expired %}
            <div class="flash flash-warning inactive-notice" id="account-inactive">
                <i class="ti ti-alert-triangle" aria-hidden="true"></i>
                <span>{{ 'inactive'|trans({}, 'partners') }}</span>
                {% if reseller.hasLiveSubscription %}
                    <a class="btn btn-primary" href="{{ path('partners_billing_index') }}">{{ 'billing.nav'|trans({}, 'partners') }}</a>
                {% else %}
                    <button type="button" class="btn btn-primary" id="choose-plan" onclick="BillingUI.open()">{{ 'billing.choose_plan'|trans({}, 'partners') }}</button>
                {% endif %}
            </div>
        {% endif %}

        {{ _self.connect_card(reseller, expired, currency) }}

        {# Its customers' own signup (/alta/{code}, ResellerSignupController):
           the restaurant lands in this list. Unavailable while expired. #}
        <section class="connect-card signup-link" id="signup-link">
            <div class="connect-title"><i class="ti ti-link" aria-hidden="true"></i> {{ 'signup_link.title'|trans({}, 'partners') }}</div>
            <p class="connect-text">{{ 'signup_link.text'|trans({}, 'partners') }}</p>
            <div class="signup-link-row">
                <code class="signup-link-url">{{ url('reseller_signup', {code: reseller.signupCode}) }}</code>
                <button type="button" class="btn btn-primary" id="signup-link-copy" onclick="copyPaymentLink(this)" {{ expired ? 'disabled' }}
                        data-url="{{ url('reseller_signup', {code: reseller.signupCode}) }}">{{ 'signup_link.copy'|trans({}, 'partners') }}</button>
            </div>
        </section>

        <div class="toolbar">
            <div class="count" id="restaurant-count">
                {%- if extra > 0 -%}
                    {{ 'count.extra'|trans({'%total%': active|length, '%extra%': extra}, 'partners')|raw }}
                {%- else -%}
                    {{ 'count.included'|trans({'%total%': active|length, '%included%': included}, 'partners')|raw }}
                {%- endif -%}
            </div>
            <button type="button" class="btn btn-primary" id="new-restaurant" onclick="NewRestaurantUI.open()" {{ expired ? 'disabled' }}>
                <i class="ti ti-plus" aria-hidden="true"></i> {{ 'new.button'|trans({}, 'partners') }}
            </button>
        </div>

        <div class="summary">
            <div class="summary-card"><div class="summary-value">{{ summary.active }}</div><div class="summary-label">{{ 'summary.active'|trans({}, 'partners') }}</div></div>
            <div class="summary-card"><div class="summary-value">{{ summary.pending }}</div><div class="summary-label">{{ 'summary.pending'|trans({}, 'partners') }}</div></div>
            <div class="summary-card"><div class="summary-value">{{ summary.expiringSoon }}</div><div class="summary-label">{{ 'summary.expiring_soon'|trans({}, 'partners') }}</div></div>
            <div class="summary-card"><div class="summary-value">{{ summary.expired }}</div><div class="summary-label">{{ 'summary.expired'|trans({}, 'partners') }}</div></div>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>{{ 'list.restaurant'|trans({}, 'partners') }}</th>
                        <th>{{ 'list.status'|trans({}, 'partners') }}</th>
                        <th>{{ 'list.until'|trans({}, 'partners') }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody class="active-list">
                    {% for restaurant in active %}
                        {% set owner = owners[restaurant.id] ?? null %}
                        <tr>
                            <td>
                                <div class="r-name">{{ restaurant.name }}</div>
                                <div class="sub">
                                    {{ owner ? owner.email : 'list.no_owner'|trans({}, 'partners') }}
                                    · <a href="{{ path('menu_show', {slug: restaurant.slug}) }}" target="_blank" rel="noopener">{{ 'list.view_menu'|trans({}, 'partners') }}</a>
                                </div>
                            </td>
                            {{ _self.status_cell(restaurant) }}
                            {{ _self.until_cell(restaurant) }}
                            <td>
                                <div class="actions">
                                    {% if restaurant.hasLiveSubscription %}
                                        {# Stripe adds its days: never twice. #}
                                        <button type="button" class="btn btn-primary register-payment" disabled>{{ 'payment.by_card'|trans({}, 'partners') }}</button>
                                    {% else %}
                                    <button type="button" class="btn btn-primary register-payment" onclick="PaymentUI.open(this)" {{ expired ? 'disabled' }}
                                            data-name="{{ restaurant.name }}"
                                            data-action="{{ path('partners_restaurant_register_payment', {id: restaurant.id}) }}"
                                            data-token="{{ csrf_token('partners-restaurant-register-payment-' ~ restaurant.id) }}"
                                            data-until-monthly="{{ restaurant.paidUntilAfter('monthly')|date('d/m/Y') }}"
                                            data-until-yearly="{{ restaurant.paidUntilAfter('yearly')|date('d/m/Y') }}">
                                        {{ 'payment.button'|trans({}, 'partners') }}
                                    </button>
                                    {% endif %}
                                    {% if reseller.canChargeRestaurants and not restaurant.hasLiveSubscription %}
                                        {% if owner %}
                                            <button type="button" class="btn copy-link" onclick="copyPaymentLink(this)"
                                                    data-url="{{ url('admin_billing_pay', {id: restaurant.id}) }}">{{ 'list.copy_link'|trans({}, 'partners') }}</button>
                                        {% else %}
                                            <button type="button" class="btn copy-link" disabled>{{ 'list.no_owner'|trans({}, 'partners') }}</button>
                                        {% endif %}
                                    {% endif %}
                                    {% if owner and not expired %}
                                        <a class="btn btn-primary enter" href="{{ path('admin_menu', {_switch_user: owner.email}) }}">{{ 'list.enter'|trans({}, 'partners') }}</a>
                                    {% else %}
                                        <button type="button" class="btn btn-primary enter" disabled>{{ 'list.enter'|trans({}, 'partners') }}</button>
                                    {% endif %}
                                    <form method="post" action="{{ path('partners_restaurant_deactivate', {id: restaurant.id}) }}"
                                          onsubmit="return confirm({{ (restaurant.hasLiveSubscription ? 'list.deactivate_confirm_card' : 'list.deactivate_confirm')|trans({'%name%': restaurant.name}, 'partners')|json_encode }})">
                                        <input type="hidden" name="_token" value="{{ csrf_token('partners-restaurant-deactivate-' ~ restaurant.id) }}">
                                        <button type="submit" class="btn btn-danger deactivate" {{ expired ? 'disabled' }}>{{ 'list.deactivate'|trans({}, 'partners') }}</button>
                                    </form>
                                    <form method="post" action="{{ path('partners_restaurant_archive', {id: restaurant.id}) }}"
                                          onsubmit="return confirm({{ (restaurant.hasLiveSubscription ? 'list.archive_confirm_card' : 'list.archive_confirm')|trans({'%name%': restaurant.name}, 'partners')|json_encode }})">
                                        <input type="hidden" name="_token" value="{{ csrf_token('partners-restaurant-archive-' ~ restaurant.id) }}">
                                        <button type="submit" class="btn archive" {{ expired ? 'disabled' }}>{{ 'list.archive'|trans({}, 'partners') }}</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4" class="empty">{{ 'list.empty'|trans({}, 'partners') }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if archived is not empty %}
            <h2 class="section-title">{{ 'list.archived_title'|trans({}, 'partners') }}</h2>
            <div class="table-wrap">
                <table>
                    <tbody class="archived-list">
                        {% for restaurant in archived %}
                            {% set owner = owners[restaurant.id] ?? null %}
                            <tr>
                                <td>
                                    <div class="r-name">{{ restaurant.name }}</div>
                                    <div class="sub">{{ owner ? owner.email : 'list.no_owner'|trans({}, 'partners') }}</div>
                                </td>
                                <td>
                                    <div class="actions">
                                        <form method="post" action="{{ path('partners_restaurant_restore', {id: restaurant.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('partners-restaurant-restore-' ~ restaurant.id) }}">
                                            <button type="submit" class="btn restore" {{ expired ? 'disabled' }}>{{ 'list.restore'|trans({}, 'partners') }}</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
{% endblock %}

{% block after_main %}

    {# "+ Nuevo restaurante": admin's modal (desktop) + bottom sheet (mobile)
       pair, each with its own copy of the form. On a validation error the
       page comes back (422) with the dialog open, the message and the
       values typed (the password never). #}
    {% if not expired %}
        {% set values = dialog.values ?? {name: '', email: ''} %}
        {% for panel in [{id: 'new-modal', overlay: 'modal-overlay', box: 'modal'}, {id: 'new-sheet', overlay: 'sheet-overlay', box: 'sheet'}] %}
            <div class="{{ panel.overlay }}" id="{{ panel.id }}" onclick="if(event.target===this)NewRestaurantUI.close()">
                <div class="{{ panel.box }}" role="dialog" aria-modal="true" aria-labelledby="{{ panel.id }}-title">
                    {% if panel.box == 'sheet' %}<div class="sheet-handle"></div>{% endif %}
                    <div class="panel-header">
                        <div class="panel-title" id="{{ panel.id }}-title">{{ 'new.title'|trans({}, 'partners') }}</div>
                        <button type="button" class="panel-close" onclick="NewRestaurantUI.close()" aria-label="{{ 'new.close'|trans({}, 'partners') }}">
                            <i class="ti ti-x" aria-hidden="true"></i>
                        </button>
                    </div>
                    <form method="post" action="{{ path('partners_restaurant_create') }}" class="new-restaurant-form" style="display: contents">
                        <input type="hidden" name="_token" value="{{ csrf_token('partners-restaurant-create') }}">
                        <div class="panel-body">
                            {% if dialog.error is defined %}
                                <div class="form-error" role="alert">{{ dialog.error }}</div>
                            {% endif %}
                            <div class="field">
                                <label for="{{ panel.id }}-name">{{ 'new.name'|trans({}, 'partners') }}</label>
                                <input type="text" id="{{ panel.id }}-name" name="name" value="{{ values.name }}" required minlength="2" maxlength="100">
                            </div>
                            <div class="field">
                                <label for="{{ panel.id }}-email">{{ 'new.email'|trans({}, 'partners') }}</label>
                                <input type="email" id="{{ panel.id }}-email" name="email" value="{{ values.email }}" required autocomplete="off">
                            </div>
                            <div class="field">
                                <label for="{{ panel.id }}-password">{{ 'new.password'|trans({}, 'partners') }}</label>
                                <input type="password" id="{{ panel.id }}-password" name="password" required minlength="8" autocomplete="new-password">
                            </div>
                        </div>
                        <div class="panel-footer">
                            <button type="button" class="btn" onclick="NewRestaurantUI.close()">{{ 'new.cancel'|trans({}, 'partners') }}</button>
                            <button type="submit" class="btn btn-primary"><i class="ti ti-check" aria-hidden="true"></i> {{ 'new.submit'|trans({}, 'partners') }}</button>
                        </div>
                    </form>
                </div>
            </div>
        {% endfor %}

        {# "Registrar pago": /platform's dialog, admin's modal (desktop) +
           bottom sheet (mobile) pair; PaymentUI fills in the restaurant. #}
        {% for panel in [{id: 'payment-modal', overlay: 'modal-overlay', box: 'modal'}, {id: 'payment-sheet', overlay: 'sheet-overlay', box: 'sheet'}] %}
            <div class="{{ panel.overlay }}" id="{{ panel.id }}" onclick="if(event.target===this)PaymentUI.close()">
                <div class="{{ panel.box }}" role="dialog" aria-modal="true" aria-labelledby="{{ panel.id }}-title">
                    {% if panel.box == 'sheet' %}<div class="sheet-handle"></div>{% endif %}
                    <div class="panel-header">
                        <div class="panel-title" id="{{ panel.id }}-title" data-title></div>
                        <button type="button" class="panel-close" onclick="PaymentUI.close()" aria-label="{{ 'new.close'|trans({}, 'partners') }}">
                            <i class="ti ti-x" aria-hidden="true"></i>
                        </button>
                    </div>
                    <form method="post" class="payment-form" style="display: contents">
                        <input type="hidden" name="_token" value="">
                        <div class="panel-body">
                            <div class="plan-options">
                                {% for plan in ['monthly', 'yearly'] %}
                                    <label class="plan-option">
                                        <input type="radio" name="plan" value="{{ plan }}" {{ loop.first ? 'checked' }}>
                                        <span>{{ ('payment.' ~ plan)|trans({}, 'partners') }} <span data-until="{{ plan }}"></span></span>
                                    </label>
                                {% endfor %}
                            </div>
                        </div>
                        <div class="panel-footer">
                            <button type="button" class="btn" onclick="PaymentUI.close()">{{ 'new.cancel'|trans({}, 'partners') }}</button>
                            <button type="submit" class="btn btn-primary"><i class="ti ti-check" aria-hidden="true"></i> {{ 'payment.save'|trans({}, 'partners') }}</button>
                        </div>
                    </form>
                </div>
            </div>
        {% endfor %}

        <script>
            const PaymentUI = {
                panels: ['payment-modal', 'payment-sheet'].map(id => document.getElementById(id)),
                title: {{ 'payment.title'|trans({}, 'partners')|json_encode|raw }},
                open(button) {
                    const d = button.dataset;
                    this.panels.forEach(panel => {
                        panel.querySelector('[data-title]').textContent = this.title + ' · ' + d.name;
                        const form = panel.querySelector('.payment-form');
                        form.action = d.action;
                        form.elements._token.value = d.token;
                        form.querySelector('input[value="monthly"]').checked = true;
                        panel.querySelector('[data-until="monthly"]').textContent = d.untilMonthly;
                        panel.querySelector('[data-until="yearly"]').textContent = d.untilYearly;
                    });
                    // Same breakpoint as admin's window.isMobile().
                    (window.innerWidth < 768 ? this.panels[1] : this.panels[0]).classList.add('open');
                },
                close() {
                    this.panels.forEach(panel => panel.classList.remove('open'));
                },
            };
            document.addEventListener('keydown', e => { if (e.key === 'Escape') PaymentUI.close(); });

            const NewRestaurantUI = {
                panels: ['new-modal', 'new-sheet'].map(id => document.getElementById(id)),
                open() {
                    // Same breakpoint as admin's window.isMobile().
                    const panel = window.innerWidth < 768 ? this.panels[1] : this.panels[0];
                    panel.classList.add('open');
                    panel.querySelector('input[name="name"]').focus();
                },
                close() {
                    this.panels.forEach(panel => panel.classList.remove('open'));
                },
            };
            document.addEventListener('keydown', e => { if (e.key === 'Escape') NewRestaurantUI.close(); });
            {% if dialog.error is defined %}NewRestaurantUI.open();{% endif %}
        </script>
    {% endif %}

    {# "Editar" next to the company name (header, partners/_base.html.twig):
       same modal + bottom sheet pair; reopened with the error on a 422.
       Also while expired — that's when its restaurants need to reach it. #}
    {% for panel in [{id: 'company-modal', overlay: 'modal-overlay', box: 'modal'}, {id: 'company-sheet', overlay: 'sheet-overlay', box: 'sheet'}] %}
        <div class="{{ panel.overlay }}" id="{{ panel.id }}" onclick="if(event.target===this)CompanyUI.close()">
            <div class="{{ panel.box }}" role="dialog" aria-modal="true" aria-labelledby="{{ panel.id }}-title">
                {% if panel.box == 'sheet' %}<div class="sheet-handle"></div>{% endif %}
                <div class="panel-header">
                    <div class="panel-title" id="{{ panel.id }}-title">{{ 'company.title'|trans({}, 'partners') }}</div>
                    <button type="button" class="panel-close" onclick="CompanyUI.close()" aria-label="{{ 'new.close'|trans({}, 'partners') }}">
                        <i class="ti ti-x" aria-hidden="true"></i>
                    </button>
                </div>
                <form method="post" action="{{ path('partners_company') }}" class="company-form" style="display: contents">
                    <input type="hidden" name="_token" value="{{ csrf_token('partners-company') }}">
                    <div class="panel-body">
                        {% if company.error is defined %}
                            <div class="form-error" role="alert">{{ company.error }}</div>
                        {% endif %}
                        <div class="field">
                            <label for="{{ panel.id }}-name">{{ 'company.name'|trans({}, 'partners') }}</label>
                            <input type="text" id="{{ panel.id }}-name" name="name" value="{{ company.values.name }}" required minlength="2" maxlength="100">
                        </div>
                        <div class="field">
                            <label for="{{ panel.id }}-email">{{ 'company.email'|trans({}, 'partners') }}</label>
                            <input type="email" id="{{ panel.id }}-email" name="email" value="{{ company.values.email }}" maxlength="180" placeholder="{{ userEmail }}">
                            <div class="field-hint">{{ 'company.email_hint'|trans({}, 'partners') }}</div>
                        </div>
                    </div>
                    <div class="panel-footer">
                        <button type="button" class="btn" onclick="CompanyUI.close()">{{ 'new.cancel'|trans({}, 'partners') }}</button>
                        <button type="submit" class="btn btn-primary"><i class="ti ti-check" aria-hidden="true"></i> {{ 'company.save'|trans({}, 'partners') }}</button>
                    </div>
                </form>
            </div>
        </div>
    {% endfor %}
    <script>
        const CompanyUI = {
            panels: ['company-modal', 'company-sheet'].map(id => document.getElementById(id)),
            open() {
                // Same breakpoint as admin's window.isMobile().
                const panel = window.innerWidth < 768 ? this.panels[1] : this.panels[0];
                panel.classList.add('open');
                panel.querySelector('input[name="name"]').focus();
            },
            close() {
                this.panels.forEach(panel => panel.classList.remove('open'));
            },
        };
        document.addEventListener('keydown', e => { if (e.key === 'Escape') CompanyUI.close(); });
        {% if company.error is defined %}CompanyUI.open();{% endif %}
    </script>

    {# "Copiar enlace de pago", as on /platform. navigator.clipboard needs
       a secure context (https / localhost); plain http falls back to execCommand. #}
    <script>
        function copyPaymentLink(button) {
            const label = button.dataset.label ??= button.textContent;
            const done = () => {
                button.textContent = {{ 'list.copied'|trans({}, 'partners')|json_encode|raw }};
                clearTimeout(button.copyTimer);
                button.copyTimer = setTimeout(() => { button.textContent = label; }, 2000);
            };
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(button.dataset.url).then(done);
                return;
            }
            const area = document.createElement('textarea');
            area.value = button.dataset.url;
            area.style.position = 'fixed';
            area.style.opacity = '0';
            document.body.appendChild(area);
            area.select();
            if (document.execCommand('copy')) done();
            area.remove();
        }
    </script>

    {# Expired without a live subscription: the plan dialog (the reseller's
       prices); with one (a failed charge) the subscription screen instead. #}
    {% if expired and not reseller.hasLiveSubscription %}
        {% include 'partners/_plan_dialog.html.twig' %}
    {% endif %}
{% endblock %}

{# Status by the restaurant's own paid_until (the reseller's own state has
   the notice at the top): ⚪ pending (never paid: no free trial), 🔴
   expired, 🟢 active (an old trial, never paid yet) or paid. #}
{% macro status_cell(r) %}
    <td data-label="{{ 'list.status'|trans({}, 'partners') }}" class="status-cell">
        {% if r.awaitingFirstPayment %}
            <div class="status status-pending">⚪ {{ 'status.pending'|trans({}, 'partners') }}</div>
        {% elseif r.ownPeriodExpired %}
            <div class="status status-expired">🔴 {{ 'status.expired'|trans({}, 'partners') }}</div>
        {% elseif r.plan is null %}
            <div class="status status-active">🟢 {{ 'status.active'|trans({}, 'partners') }}</div>
        {% else %}
            <div class="status status-active">🟢 {{ 'status.paid'|trans({}, 'partners') }}</div>
        {% endif %}
        <div class="sub last-paid">{{ r.lastPaidAt ? 'list.last_paid'|trans({'%date%': r.lastPaidAt|date('d/m/Y')}, 'partners') : 'list.no_payments'|trans({}, 'partners') }}</div>
        {% if r.hasLiveSubscription %}
            <div class="sub auto-pay">{{ (r.stripeCancelPending ? 'list.auto_pay_cancelled' : 'list.auto_pay')|trans({}, 'partners') }}</div>
        {% endif %}
    </td>
{% endmacro %}

{# /platform's "Válida hasta": orange at 7 days or fewer, red once expired. #}
{% macro until_cell(r) %}
    {% if r.awaitingFirstPayment %}
        {# Never active: no date to show. #}
        <td data-label="{{ 'list.until'|trans({}, 'partners') }}" class="until"><div>—</div></td>
    {% else %}
    {% set days = r.daysLeft %}
    <td data-label="{{ 'list.until'|trans({}, 'partners') }}" class="until {{ days < 0 ? 'until-expired' : (days <= 7 ? 'until-soon' : '') }}">
        <div>{{ r.paidUntil|date('d/m/Y') }}</div>
        <div class="sub">
            {%- if days < 0 -%}
                {{ (days == -1 ? 'days.ago_one' : 'days.ago')|trans({'%count%': -days}, 'partners') }}
            {%- elseif days == 0 -%}
                {{ 'days.today'|trans({}, 'partners') }}
            {%- else -%}
                {{ (days == 1 ? 'days.left_one' : 'days.left')|trans({'%count%': days}, 'partners') }}
            {%- endif -%}
        </div>
    </td>
    {% endif %}
{% endmacro %}

{# "Cobro con tarjeta": the reseller's own Stripe account (PartnersConnectController):
   not connected → "Conectar Stripe"; onboarding unfinished → "Continuar alta";
   connected → its price for its restaurants (monthly, yearly optional). #}
{% macro connect_card(reseller, expired, currency) %}
    {% set dec = app.request.locale == 'en' ? '.' : ',' %}
    {% set symbol = currency == 'eur' ? '€' : currency|upper %}
    <section class="connect-card" id="connect">
        <div class="connect-head">
            <div class="connect-title"><i class="ti ti-credit-card" aria-hidden="true"></i> {{ 'connect.title'|trans({}, 'partners') }}</div>
            {% if reseller.connectReady %}
                <span class="connect-status connect-ready">✓ {{ 'connect.status.ready'|trans({}, 'partners') }}</span>
            {% elseif reseller.hasConnectAccount %}
                <span class="connect-status connect-pending">{{ 'connect.status.pending'|trans({}, 'partners') }}</span>
            {% endif %}
        </div>

        {% if not reseller.connectReady %}
            <p class="connect-text">{{ (reseller.hasConnectAccount ? 'connect.pending_text' : 'connect.intro')|trans({}, 'partners') }}</p>
            <form method="post" action="{{ path('partners_connect_start') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('partners-connect-start') }}">
                <button type="submit" class="btn btn-primary" id="connect-start" {{ expired ? 'disabled' }}>
                    {{ (reseller.hasConnectAccount ? 'connect.continue' : 'connect.start')|trans({}, 'partners') }}
                </button>
            </form>
        {% endif %}

        {% if reseller.hasConnectAccount %}
            <form method="post" action="{{ path('partners_connect_prices') }}" class="connect-prices" id="connect-prices">
                <input type="hidden" name="_token" value="{{ csrf_token('partners-connect-prices') }}">
                <div class="connect-fields">
                    <div class="field">
                        <label for="price-monthly">{{ 'connect.price.monthly'|trans({'%currency%': symbol}, 'partners') }}</label>
                        <input type="text" inputmode="decimal" id="price-monthly" name="monthly" required
                               value="{{ reseller.restaurantPriceMonthly is not null ? (reseller.restaurantPriceMonthly / 100)|number_format(2, dec, '') }}">
                    </div>
                    <div class="field">
                        <label for="price-yearly">{{ 'connect.price.yearly'|trans({'%currency%': symbol}, 'partners') }}</label>
                        <input type="text" inputmode="decimal" id="price-yearly" name="yearly"
                               placeholder="{{ 'connect.price.yearly_placeholder'|trans({}, 'partners') }}"
                               value="{{ reseller.restaurantPriceYearly is not null ? (reseller.restaurantPriceYearly / 100)|number_format(2, dec, '') }}">
                    </div>
                    <button type="submit" class="btn btn-primary" {{ expired ? 'disabled' }}>{{ 'connect.price.save'|trans({}, 'partners') }}</button>
                </div>
                <p class="connect-note">{{ 'connect.price.note'|trans({}, 'partners') }}</p>
            </form>
        {% endif %}
    </section>
{% endmacro %}
