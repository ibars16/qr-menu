<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    {# Login is a Turbo page: without a full reload, its inline styles
       (background glow, centered body) stay applied after the redirect here.
       See public/base.html.twig's turbo_meta block. #}
    <meta name="turbo-visit-control" content="reload">
    <title>Plataforma — QR Menu</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.31.0/dist/tabler-icons.min.css">
    <script>(function(){try{if(localStorage.getItem('admin-theme')==='light')document.documentElement.classList.add('light');}catch(e){}}());</script>
    <style>
        {% include 'admin/_styles_tokens.html.twig' %}
        {% include 'admin/_styles_controls.html.twig' %}
        {% include 'admin/_styles_modal.html.twig' %}

        /* Same bar as admin's .main-header. */
        .platform-header {
            padding: 14px 24px; border-bottom: 1px solid var(--bd-1);
            display: flex; align-items: center; justify-content: space-between; gap: 12px;
            background: var(--bg-nav); position: sticky; top: 0; z-index: 100;
        }
        .platform-title { font-size: var(--fs-lg); font-weight: 600; color: var(--tx-hi); letter-spacing: -0.3px; }
        .platform-body { padding: var(--sp-6); }

        /* Summary cards */
        .summary { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--sp-3); margin-bottom: var(--sp-5); }
        .summary-card {
            background: var(--bg-card); border: 1px solid var(--bd-1); border-radius: var(--r-lg);
            padding: var(--sp-4);
        }
        .summary-value { font-size: var(--fs-2xl); font-weight: 700; color: var(--tx-hi); line-height: 1.1; }
        .summary-label { margin-top: var(--sp-1); font-size: var(--fs-sm); color: var(--tx-muted); }

        /* List */
        .table-wrap {
            width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch;
            background: var(--bg-card); border: 1px solid var(--bd-1); border-radius: var(--r-lg);
        }
        table { width: 100%; border-collapse: collapse; font-size: var(--fs-base); }
        th, td { text-align: left; padding: var(--sp-3) var(--sp-4); border-bottom: 1px solid var(--bd-1); vertical-align: middle; }
        th { font-size: var(--fs-sm); font-weight: 600; color: var(--tx-3); white-space: nowrap; }
        td { color: var(--tx-1); }
        tbody tr:last-child td { border-bottom: none; }
        th.actions-col { text-align: right; }

        .r-name { font-weight: 600; color: var(--tx-hi); }
        .sub { margin-top: 2px; font-size: var(--fs-sm); color: var(--tx-muted); }
        .sub a { color: var(--tx-muted); }
        .sub a:hover { color: var(--tx-hi); }

        /* Same green as admin's .flash-success. */
        .status { font-weight: 600; white-space: nowrap; }
        .status-active  { color: #7aad40; }
        .status-trial   { color: var(--warn-fg); }
        .status-expired { color: var(--err-text); }

        .until { white-space: nowrap; }
        .until-soon, .until-soon .sub { color: var(--warn-fg); }
        .until-expired, .until-expired .sub { color: var(--err-text); }

        .actions { display: flex; justify-content: flex-end; align-items: center; gap: var(--sp-2); }
        .actions form { display: contents; }
        .btn:disabled { opacity: 0.5; cursor: default; }
        .empty { color: var(--tx-muted); }
        .section-title { margin: var(--sp-6) 0 var(--sp-3); font-size: var(--fs-md); font-weight: 600; color: var(--tx-hi); }

        /* Payment dialog options */
        .plan-options { display: flex; flex-direction: column; gap: var(--sp-2); }
        .plan-option {
            display: flex; align-items: center; gap: var(--sp-3);
            padding: var(--sp-3) 14px; border: 1px solid var(--bd-2); border-radius: 10px;
            background: var(--bg-input); cursor: pointer; font-size: var(--fs-md); color: var(--tx-1);
        }
        .plan-option:has(input:checked) { border-color: var(--brand); }
        .plan-option input { accent-color: var(--brand); }

        @media (max-width: 767px) {
            .platform-header { padding: 12px 16px; }
            .platform-title { font-size: 17px; }
            .platform-body { padding: 12px; }
            .summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }

        /* Mobile: one stacked card per restaurant. */
        @media (max-width: 639px) {
            .table-wrap { background: none; border: none; overflow: visible; }
            table, tbody, tr, td { display: block; }
            thead { display: none; }
            tbody { display: flex; flex-direction: column; gap: var(--sp-2); }
            tr { background: var(--bg-card); border: 1px solid var(--bd-1); border-radius: var(--r-lg); padding: var(--sp-1) 0; }
            td { border-bottom: none; padding: var(--sp-2) var(--sp-4); }
            tbody tr:last-child td { border-bottom: none; }
            td[data-label]::before {
                content: attr(data-label); display: block; margin-bottom: 2px;
                font-size: var(--fs-xs); font-weight: 600; color: var(--tx-5);
                text-transform: uppercase; letter-spacing: 0.07em;
            }
            .actions { padding-top: var(--sp-1); }
            .actions { flex-wrap: wrap; }
            .actions .btn { flex: 1; justify-content: center; }
        }
    </style>
</head>
<body>
    <header class="platform-header">
        <div class="platform-title">Plataforma</div>
        <a class="btn" href="{{ path('admin_logout') }}"><i class="ti ti-logout" aria-hidden="true"></i> Cerrar sesión</a>
    </header>

    <main class="platform-body">
        {% for message in app.flashes('success') %}
            <div class="flash flash-success">{{ message }}</div>
        {% endfor %}

        <div class="summary">
            <div class="summary-card"><div class="summary-value">{{ summary.active }}</div><div class="summary-label">Activas</div></div>
            <div class="summary-card"><div class="summary-value">{{ summary.trial }}</div><div class="summary-label">En prueba</div></div>
            <div class="summary-card"><div class="summary-value">{{ summary.expiringSoon }}</div><div class="summary-label">Vencen en 7 días</div></div>
            <div class="summary-card"><div class="summary-value">{{ summary.expired }}</div><div class="summary-label">Vencidas</div></div>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Restaurante</th>
                        <th>Suscripción</th>
                        <th>Válida hasta</th>
                        <th class="actions-col"></th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        {% set restaurant = row.restaurant %}
                        <tr>
                            <td>
                                <div class="r-name">{{ restaurant.name }}</div>
                                <div class="sub">
                                    {{ row.owner ? row.owner.email : 'Sin dueño' }}
                                    · <a href="{{ path('menu_show', {slug: restaurant.slug}) }}" target="_blank" rel="noopener">Ver carta</a>
                                </div>
                            </td>
                            {% if restaurant.billedByReseller %}
                                {# Billed through its reseller: no dates or actions of its own. #}
                                <td data-label="Suscripción">
                                    {% if restaurant.archived %}
                                        <div class="status">⚪ Archivado</div>
                                    {% elseif restaurant.expired %}
                                        <div class="status status-expired">🔴 Vencida</div>
                                    {% else %}
                                        <div class="status status-active">🟢 Activa</div>
                                    {% endif %}
                                    <div class="sub reseller-of">Revendedor · {{ restaurant.reseller.name }}</div>
                                </td>
                                <td data-label="Válida hasta" class="until"><div class="sub">Lo paga el revendedor</div></td>
                                <td></td>
                            {% else %}
                                {{ _self.status_cell(restaurant, 'Prueba gratis') }}
                                {{ _self.until_cell(restaurant) }}
                                <td>
                                    <div class="actions">
                                        {{ _self.payment_button(restaurant, 'platform_register_payment', 'platform-register-payment-') }}
                                        {% if not restaurant.hasLiveSubscription %}
                                            {% if row.owner %}
                                                <button type="button" class="btn copy-link" onclick="copyPaymentLink(this)"
                                                        data-url="{{ url('admin_billing_pay', {id: restaurant.id}) }}">Copiar enlace de pago</button>
                                            {% else %}
                                                <button type="button" class="btn copy-link" disabled>Sin dueño</button>
                                            {% endif %}
                                        {% endif %}
                                        {{ _self.deactivate_form(restaurant, 'platform_deactivate', 'platform-deactivate-', '¿Desactivar ' ~ restaurant.name ~ '? Su carta dejará de verse.') }}
                                    </div>
                                </td>
                            {% endif %}
                        </tr>
                    {% else %}
                        <tr><td colspan="4" class="empty">No hay restaurantes.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if resellerRows is not empty %}
            <h2 class="section-title">Revendedores</h2>
            <div class="table-wrap" id="resellers">
                <table>
                    <thead>
                        <tr>
                            <th>Revendedor</th>
                            <th>Restaurantes</th>
                            <th>Suscripción</th>
                            <th>Válida hasta</th>
                            <th class="actions-col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in resellerRows %}
                            {% set reseller = row.reseller %}
                            <tr>
                                <td>
                                    <div class="r-name">{{ reseller.name }}</div>
                                    <div class="sub">{{ row.user ? row.user.email : 'Sin usuario' }}</div>
                                </td>
                                <td data-label="Restaurantes" class="reseller-count">
                                    <div>{{ row.restaurants.active }} en uso</div>
                                    {% if row.restaurants.archived %}<div class="sub">{{ row.restaurants.archived }} {{ row.restaurants.archived == 1 ? 'archivado' : 'archivados' }}</div>{% endif %}
                                </td>
                                {{ _self.status_cell(reseller, 'Sin pagar') }}
                                {{ _self.until_cell(reseller) }}
                                <td>
                                    <div class="actions">
                                        {{ _self.payment_button(reseller, 'platform_reseller_register_payment', 'platform-reseller-register-payment-') }}
                                        {{ _self.deactivate_form(reseller, 'platform_reseller_deactivate', 'platform-reseller-deactivate-', '¿Desactivar ' ~ reseller.name ~ '? Se apagarán todos sus restaurantes.') }}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </main>

    {# Payment dialog: admin's modal (desktop) + bottom sheet (mobile) pair,
       each with its own copy of the form; PaymentUI fills in the restaurant. #}
    {% for panel in [{id: 'payment-modal', overlay: 'modal-overlay', box: 'modal'}, {id: 'payment-sheet', overlay: 'sheet-overlay', box: 'sheet'}] %}
        <div class="{{ panel.overlay }}" id="{{ panel.id }}" onclick="if(event.target===this)PaymentUI.close()">
            <div class="{{ panel.box }}" role="dialog" aria-modal="true" aria-labelledby="{{ panel.id }}-title">
                {% if panel.box == 'sheet' %}<div class="sheet-handle"></div>{% endif %}
                <div class="panel-header">
                    <div class="panel-title" id="{{ panel.id }}-title" data-title></div>
                    <button type="button" class="panel-close" onclick="PaymentUI.close()" aria-label="Cerrar">
                        <i class="ti ti-x" aria-hidden="true"></i>
                    </button>
                </div>
                <form method="post" class="payment-form" style="display: contents">
                    <input type="hidden" name="_token" value="">
                    <div class="panel-body">
                        <div class="plan-options">
                            <label class="plan-option">
                                <input type="radio" name="plan" value="monthly" checked>
                                <span>1 mes → activa hasta <span data-until="monthly"></span></span>
                            </label>
                            <label class="plan-option">
                                <input type="radio" name="plan" value="yearly">
                                <span>1 año → activa hasta <span data-until="yearly"></span></span>
                            </label>
                        </div>
                    </div>
                    <div class="panel-footer">
                        <button type="button" class="btn" onclick="PaymentUI.close()">Cancelar</button>
                        <button type="submit" class="btn btn-primary"><i class="ti ti-check" aria-hidden="true"></i> Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    {% endfor %}

    <script>
        const PaymentUI = {
            panels: ['payment-modal', 'payment-sheet'].map(id => document.getElementById(id)),
            open(button) {
                const d = button.dataset;
                this.panels.forEach(panel => {
                    panel.querySelector('[data-title]').textContent = 'Registrar pago · ' + d.name;
                    const form = panel.querySelector('.payment-form');
                    form.action = d.action;
                    form.elements._token.value = d.token;
                    form.querySelector('input[value="monthly"]').checked = true;
                    panel.querySelector('[data-until="monthly"]').textContent = d.untilMonthly;
                    panel.querySelector('[data-until="yearly"]').textContent = d.untilYearly;
                });
                // Same breakpoint as admin's window.isMobile().
                (window.innerWidth < 768 ? this.panels[1] : this.panels[0]).classList.add('open');
            },
            close() {
                this.panels.forEach(panel => panel.classList.remove('open'));
            },
        };
        document.addEventListener('keydown', e => { if (e.key === 'Escape') PaymentUI.close(); });

        // navigator.clipboard needs a secure context (https / localhost);
        // plain http on a LAN address falls back to execCommand.
        function copyPaymentLink(button) {
            const url = button.dataset.url;
            const done = () => {
                button.textContent = 'Copiado ✓';
                clearTimeout(button.copyTimer);
                button.copyTimer = setTimeout(() => { button.textContent = 'Copiar enlace de pago'; }, 2000);
            };
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(url).then(done);
                return;
            }
            const area = document.createElement('textarea');
            area.value = url;
            area.style.position = 'fixed';
            area.style.opacity = '0';
            document.body.appendChild(area);
            area.select();
            if (document.execCommand('copy')) done();
            area.remove();
        }
    </script>
</body>
</html>

{# Shared by the restaurant and reseller tables: c is a Restaurant (billed on
   its own) or a Reseller. #}
{% macro status_cell(c, unpaid_label) %}
    <td data-label="Suscripción">
        {% if c.expired %}
            <div class="status status-expired">🔴 Vencida</div>
        {% elseif c.plan is null %}
            <div class="status status-trial">🟡 {{ unpaid_label }}</div>
        {% else %}
            <div class="status status-active">🟢 Activa · {{ c.plan == 'yearly' ? 'Anual' : 'Mensual' }}</div>
        {% endif %}
        <div class="sub">{{ c.lastPaidAt ? 'Último cobro ' ~ c.lastPaidAt|date('d/m/Y') : 'Sin cobros' }}</div>
        {% if c.hasLiveSubscription %}
            <div class="sub auto-pay">{{ c.stripeCancelPending ? '💳 Cancelada · no renovará' : '💳 Pago automático' }}</div>
        {% endif %}
    </td>
{% endmacro %}

{% macro until_cell(c) %}
    {% set days = c.daysLeft %}
    <td data-label="Válida hasta" class="until {{ days < 0 ? 'until-expired' : (days <= 7 ? 'until-soon' : '') }}">
        <div>{{ c.paidUntil|date('d/m/Y') }}</div>
        <div class="sub">
            {%- if days < 0 -%}
                venció hace {{ -days }} {{ days == -1 ? 'día' : 'días' }}
            {%- elseif days == 0 -%}
                vence hoy
            {%- elseif days == 1 -%}
                queda 1 día
            {%- else -%}
                quedan {{ days }} días
            {%- endif -%}
        </div>
    </td>
{% endmacro %}

{# The payment dialog's opener; route/token prefix tell restaurants and resellers apart. #}
{% macro payment_button(c, route, token_prefix) %}
    <button type="button" class="btn btn-primary" onclick="PaymentUI.open(this)"
            data-name="{{ c.name }}"
            data-action="{{ path(route, {id: c.id}) }}"
            data-token="{{ csrf_token(token_prefix ~ c.id) }}"
            data-until-monthly="{{ c.paidUntilAfter('monthly')|date('d/m/Y') }}"
            data-until-yearly="{{ c.paidUntilAfter('yearly')|date('d/m/Y') }}">
        Registrar pago
    </button>
{% endmacro %}

{% macro deactivate_form(c, route, token_prefix, confirm_text) %}
    <form method="post" action="{{ path(route, {id: c.id}) }}"
          onsubmit="return confirm({{ confirm_text|json_encode }})">
        <input type="hidden" name="_token" value="{{ csrf_token(token_prefix ~ c.id) }}">
        <button type="submit" class="btn btn-danger">Desactivar</button>
    </form>
{% endmacro %}
