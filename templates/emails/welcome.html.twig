{% extends 'emails/_layout.html.twig' %}
{% block title %}{{ 'welcome.subject'|trans({'%app%': app}, 'emails', locale) }}{% endblock %}
{% block content %}
    <p style="margin:0 0 12px;font-size:17px;font-weight:600;">{{ 'welcome.hello'|trans({}, 'emails', locale) }}</p>
    <p style="margin:0;">{{ 'welcome.ready'|trans({}, 'emails', locale) }}</p>
    {# Self sign-up (AccountMailer): confirm first — the public menu waits for it. #}
    {% if confirmUrl is defined and confirmUrl %}
        <p style="margin:12px 0 0;">{{ 'welcome.confirm_intro'|trans({}, 'emails', locale) }}</p>
        {% include 'emails/_button.html.twig' with { url: confirmUrl, label: 'confirm.button'|trans({}, 'emails', locale) } only %}
        <p style="margin:0 0 12px;color:#595959;font-size:14px;">{{ 'confirm.expiry'|trans({}, 'emails', locale) }}</p>
        <p style="margin:0 0 12px;"><a href="{{ loginUrl }}" style="color:#A33A0C;font-weight:600;">{{ 'welcome.button'|trans({}, 'emails', locale) }}</a></p>
    {% else %}
        {% include 'emails/_button.html.twig' with { url: loginUrl, label: 'welcome.button'|trans({}, 'emails', locale) } only %}
    {% endif %}
    <p style="margin:0 0 12px;">{{ 'welcome.login_with'|trans({'%email%': accountEmail}, 'emails', locale) }}</p>
    <p style="margin:0;color:#595959;font-size:14px;">{{ 'welcome.forgot'|trans({}, 'emails', locale) }}</p>
{% endblock %}
