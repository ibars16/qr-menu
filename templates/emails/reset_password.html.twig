{% extends 'emails/_layout.html.twig' %}
{% block title %}{{ 'reset.subject'|trans({}, 'emails', locale) }}{% endblock %}
{% block content %}
    <p style="margin:0;">{{ 'reset.intro'|trans({}, 'emails', locale) }}</p>
    {% include 'emails/_button.html.twig' with { url: resetUrl, label: 'reset.button'|trans({}, 'emails', locale) } only %}
    <p style="margin:0 0 12px;">{{ 'reset.expiry'|trans({}, 'emails', locale) }}</p>
    <p style="margin:0;color:#595959;font-size:14px;">{{ 'reset.ignore'|trans({}, 'emails', locale) }}</p>
{% endblock %}
