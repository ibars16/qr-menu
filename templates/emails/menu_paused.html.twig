{% extends 'emails/_layout.html.twig' %}
{% block title %}{{ 'menu_paused.subject'|trans({'%app%': app}, 'emails', locale) }}{% endblock %}
{% block content %}
    <p style="margin:0 0 12px;font-size:17px;font-weight:600;">{{ 'menu_paused.subject'|trans({'%app%': app}, 'emails', locale) }}</p>
    <p style="margin:0;">{{ 'menu_paused.intro'|trans({'%restaurant%': restaurantName}, 'emails', locale) }}</p>
    {% include 'emails/_button.html.twig' with { url: billingUrl, label: 'menu_paused.button'|trans({}, 'emails', locale) } only %}
{% endblock %}
