{% extends 'emails/_layout.html.twig' %}
{% block title %}{{ 'confirm.subject'|trans({'%app%': app}, 'emails', locale) }}{% endblock %}
{% block content %}
    <p style="margin:0;">{{ 'confirm.intro'|trans({}, 'emails', locale) }}</p>
    {% include 'emails/_button.html.twig' with { url: confirmUrl, label: 'confirm.button'|trans({}, 'emails', locale) } only %}
    <p style="margin:0 0 12px;color:#595959;font-size:14px;">{{ 'confirm.expiry'|trans({}, 'emails', locale) }}</p>
    <p style="margin:0;color:#595959;font-size:14px;">{{ 'confirm.ignore'|trans({}, 'emails', locale) }}</p>
{% endblock %}
