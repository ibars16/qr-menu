{% extends 'base.html.twig' %}

{% block meta %}{% endblock %}

{# Each public page (and login/register) carries its own large inline
   <style> block instead of a shared external stylesheet. Turbo Drive only
   merges <head> elements it can track — an untracked inline <style> that
   differs between pages is left stale/duplicated across a Turbo visit,
   which is exactly what caused broken styles after using the browser back
   button between these pages. Forcing a full reload for any visit landing
   on one sidesteps that entirely. #}
{% block turbo_meta %}
    <meta name="turbo-visit-control" content="reload">
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.31.0/dist/tabler-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {# Same families as the public menu's shared structure
       (menu/layouts/standard/_fonts.html.twig): Fraunces for display,
       Inter for body — so the marketing site reads like the "Clásico claro"
       (maison) menu it sells. #}
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    {# Light (parchment) is the default now; only an explicit 'dark' choice
       drops the .light class. The key and the .light class keep their old
       meaning, so login/register (which read 'site-theme' === 'light')
       stay compatible. #}
    <script>(function(){try{if(localStorage.getItem('site-theme')!=='dark')document.documentElement.classList.add('light');}catch(e){document.documentElement.classList.add('light');}}());</script>
    <style>
        /* Palette mirrors menu/themes/maison/vars.html.twig (light) and a
           warm espresso counterpart for dark. Token names are kept from the
           old site so pages/*.html.twig keep working unchanged. */
        :root {
            --font-display: 'Fraunces', Georgia, serif;
            --font-body:    'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;

            --brand:       #8E2632;
            --brand-hover: #A33A46;
            --brand-2:     #8E2632;
            --brand-grad:  #8E2632;
            --on-brand:    #FBF8F1;
            --gold:        #C9A46A;
            --gold-text:   #D2B07A;
            --shadow-rgb:  0,0,0;

            --bg-page:     #17110E;
            --bg-nav:      rgba(23,17,14,0.88);
            --bg-card:     #201814;
            --bg-elevated: #261D18;
            --bg-subtle:   #1C1512;
            --bg-input:    #2B221C;
            --bd-1:        rgba(242,235,223,0.09);
            --bd-2:        rgba(242,235,223,0.17);
            --tx-hi:       #F4EDE2;
            --tx-1:        #E0D6C8;
            --tx-2:        #BFB19F;
            --tx-3:        #AD9F8D;
            --tx-4:        #918372;
            --accent-text: #E3A3AA;
            --hero-wash:   radial-gradient(120% 90% at 85% 0%, rgba(201,164,106,0.10), transparent 60%), linear-gradient(180deg, #1E1612, #17110E);
        }
        html.light {
            --brand:       #7A1E28;
            --brand-hover: #9A3742;
            --brand-2:     #7A1E28;
            --brand-grad:  #7A1E28;
            --on-brand:    #FFFFFF;
            --gold:        #B0894C;
            --gold-text:   #805E30;
            --shadow-rgb:  36,28,23;

            --bg-page:     #F2EBDF;
            --bg-nav:      rgba(242,235,223,0.92);
            --bg-card:     #FBF8F1;
            --bg-elevated: #FBF8F1;
            --bg-subtle:   #F7F1E6;
            --bg-input:    #E9DFCD;
            --bd-1:        rgba(36,28,23,0.09);
            --bd-2:        rgba(36,28,23,0.18);
            --tx-hi:       #241C17;
            --tx-1:        #3A2F27;
            --tx-2:        #5E4F42;
            --tx-3:        #6D5D4E;
            --tx-4:        #75655A;
            --accent-text: #7A1E28;
            --hero-wash:   radial-gradient(120% 90% at 85% 0%, rgba(176,137,76,0.16), transparent 60%), linear-gradient(180deg, #E9DFCD, #F2EBDF);
        }
        .theme-icon-light { display: none; }
        html.light .theme-icon-dark  { display: none; }
        html.light .theme-icon-light { display: inline-flex; }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; }
        body {
            font-family: var(--font-body); background: var(--bg-page); color: var(--tx-1);
            -webkit-font-smoothing: antialiased; transition: background-color 0.25s, color 0.25s;
        }
        ::selection { background: rgba(176,137,76,0.3); }

        .container { max-width: 1120px; margin: 0 auto; padding: 0 24px; }

        /* Nav */
        .nav {
            position: sticky; top: 0; z-index: 50;
            background: var(--bg-nav); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--bd-1);
        }
        .nav-inner { display: flex; align-items: center; justify-content: space-between; padding: 14px 24px; max-width: 1120px; margin: 0 auto; }
        .nav-brand { display: flex; align-items: center; gap: 11px; text-decoration: none; }
        .nav-logo-mark {
            width: 34px; height: 34px; border-radius: 50%; background: var(--brand);
            display: flex; align-items: center; justify-content: center; flex-shrink: 0;
            font-family: var(--font-display); font-style: italic; font-size: 17px; font-weight: 500; color: var(--on-brand);
            box-shadow: inset 0 0 0 2px rgba(255,255,255,0.12), 0 0 0 1px var(--gold);
        }
        .nav-brand-name { font-family: var(--font-display); font-size: 19px; font-weight: 500; color: var(--tx-hi); letter-spacing: -0.01em; }
        /* Controls, right-aligned (public/_nav.html.twig):
           Precios · Iniciar sesión │ [idioma ▾] [☾] [Prueba gratis]
           Text links, a hairline, the round icon controls, then the CTA —
           the only filled button. */
        .nav-links { display: flex; align-items: center; gap: 8px; }
        .nav-link {
            font-size: 13.5px; font-weight: 500; color: var(--tx-1); text-decoration: none; white-space: nowrap;
            padding: 8px 10px; border-radius: 8px; transition: color 0.15s;
        }
        .nav-link:hover { color: var(--accent-text); }
        .nav-sep { flex-shrink: 0; width: 1px; height: 20px; margin: 0 8px; background: var(--bd-2); }
        .nav-lang-dropdown { position: relative; }
        .nav-lang-current {
            display: flex; align-items: center; gap: 5px; list-style: none; cursor: pointer; white-space: nowrap;
            height: 34px; font-size: 12.5px; font-weight: 500; color: var(--tx-2);
            background: transparent; border: 1px solid var(--bd-2);
            padding: 0 11px; border-radius: 999px; user-select: none;
            transition: color 0.15s, border-color 0.15s;
        }
        .nav-lang-current::-webkit-details-marker { display: none; }
        .nav-lang-current:hover { color: var(--tx-hi); border-color: var(--gold); }
        .nav-lang-current i { font-size: 11px; transition: transform 0.15s; }
        .nav-lang-dropdown[open] .nav-lang-current i { transform: rotate(180deg); }
        .nav-lang-menu {
            position: absolute; top: calc(100% + 8px); right: 0; z-index: 60;
            min-width: 168px; background: var(--bg-card); border: 1px solid var(--bd-2);
            border-radius: 14px; padding: 6px; box-shadow: 0 18px 40px -16px rgba(var(--shadow-rgb),0.35);
        }
        .nav-lang-item {
            display: flex; align-items: center; gap: 9px; padding: 8px 10px;
            border-radius: 9px; font-size: 13px; font-weight: 500; color: var(--tx-2);
            text-decoration: none; white-space: nowrap; transition: background 0.12s, color 0.12s;
        }
        .nav-lang-item span { font-size: 15px; }
        .nav-lang-item:hover { background: var(--bg-input); color: var(--tx-hi); }
        .nav-lang-item.active { color: var(--tx-hi); }
        .nav-lang-item i { margin-left: auto; font-size: 13px; color: var(--brand); }
        .nav-theme-toggle {
            flex-shrink: 0; width: 34px; height: 34px; border-radius: 999px;
            border: 1px solid var(--bd-2); background: transparent;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; color: var(--tx-2); font-size: 15px;
            transition: color 0.15s, border-color 0.15s;
        }
        .nav-theme-toggle:hover { color: var(--tx-hi); border-color: var(--gold); }
        .nav-cta {
            flex-shrink: 0; margin-left: 4px; white-space: nowrap;
            font-size: 13px; font-weight: 500; color: var(--on-brand); background: var(--brand);
            padding: 9px 18px; border-radius: 999px; text-decoration: none;
            box-shadow: 0 4px 14px rgba(122,30,40,0.22);
            transition: background 0.15s, transform 0.15s;
        }
        .nav-cta:hover { background: var(--brand-hover); transform: translateY(-1px); }
        /* --accent-text, not --gold: the ring needs 3:1 on the nav in both themes. */
        .nav a:focus-visible, .nav button:focus-visible, .nav summary:focus-visible { outline: 2px solid var(--accent-text); outline-offset: 2px; }

        /* Mobile: [idioma ▾] [Prueba gratis] [☰]; Precios, login and the
           theme move into the ☰ panel (.nav-desktop-only hidden). */
        .nav-mobile-only, .nav-label-short { display: none; }
        .nav-mobile { position: relative; }
        .nav-mobile-toggle {
            display: flex; align-items: center; justify-content: center; list-style: none; cursor: pointer;
            width: 38px; height: 38px; border-radius: 999px;
            border: 1px solid var(--bd-2); background: transparent;
            color: var(--tx-2); font-size: 18px; transition: color 0.15s, border-color 0.15s;
        }
        .nav-mobile-toggle::-webkit-details-marker { display: none; }
        .nav-mobile[open] .nav-mobile-toggle { color: var(--tx-hi); border-color: var(--gold); }
        .nav-mobile-panel {
            position: absolute; top: calc(100% + 10px); right: 0; z-index: 70;
            width: 78vw; max-width: 280px;
            background: var(--bg-card); border: 1px solid var(--bd-2);
            border-radius: 18px; padding: 18px;
            box-shadow: 0 22px 44px -16px rgba(var(--shadow-rgb),0.4);
            display: flex; flex-direction: column; gap: 14px;
        }
        .nav-mobile-login {
            width: 100%; text-align: center;
            font-size: 13px; font-weight: 500; color: var(--tx-1); text-decoration: none;
            background: transparent; border: 1px solid var(--bd-2);
            padding: 10px 16px; border-radius: 999px; transition: border-color 0.15s, color 0.15s;
        }
        .nav-mobile-login:hover { color: var(--tx-hi); border-color: var(--gold); }
        .nav-mobile-theme { font-family: inherit; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; }
        .nav-mobile-theme i { font-size: 15px; }

        /* 760px, not 640px: the desktop row must fit in German
           ("Preise · Anmelden │ 🇩🇪 DE ▾ ☾ Kostenlos testen") with the brand. */
        @media (max-width: 760px) {
            .nav-inner { padding: 10px 16px; }
            .nav-brand-name { font-size: 17px; }
            .nav-desktop-only { display: none; }
            .nav-mobile-only { display: block; }
            .nav-label-long { display: none; }
            .nav-label-short { display: inline; }
            .nav-cta { margin-left: 0; font-size: 12.5px; padding: 8px 14px; box-shadow: none; }
            /* Mobile order: [Prueba gratis] [idioma ▾] [☰] */
            .nav-cta { order: 1; }
            .nav-lang-dropdown { order: 2; }
            .nav-mobile { order: 3; }
        }
        /* Narrow phones: logo mark alone, then the flag alone, so the CTA
           and the language keep their room ("Kostenlos testen" at 320px). */
        @media (max-width: 460px) {
            .nav-brand-name { display: none; }
        }
        @media (max-width: 380px) {
            .nav-links { gap: 6px; }
            .nav-lang-code { display: none; }
            .nav-lang-current { padding: 0 9px; }
        }

        /* Buttons — pills, like the menu's "Explora nuestra carta" / "Ver más" */
        .btn-primary {
            font-size: 15px; font-weight: 500; color: var(--on-brand); background: var(--brand);
            padding: 15px 28px; border-radius: 999px; text-decoration: none;
            display: inline-flex; align-items: center; gap: 8px;
            box-shadow: 0 10px 26px -10px rgba(122,30,40,0.55);
            transition: background 0.18s, transform 0.18s, box-shadow 0.18s;
        }
        .btn-primary:hover { background: var(--brand-hover); transform: translateY(-1px); box-shadow: 0 14px 30px -10px rgba(122,30,40,0.6); }
        .btn-secondary {
            font-size: 15px; font-weight: 500; color: var(--tx-hi); background: transparent;
            border: 1px solid var(--bd-2); padding: 14px 27px; border-radius: 999px;
            text-decoration: none; display: inline-flex; align-items: center; gap: 8px;
            transition: border-color 0.18s, background 0.18s, transform 0.18s;
        }
        .btn-secondary:hover { border-color: var(--gold); background: var(--bg-card); transform: translateY(-1px); }

        /* Footer */
        .footer { border-top: 1px solid var(--bd-1); padding: 44px 24px 28px; background: var(--bg-subtle); }
        .footer-inner { max-width: 1120px; margin: 0 auto; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px; }
        .footer-brand { display: flex; align-items: center; gap: 10px; font-family: var(--font-display); font-size: 18px; font-weight: 500; color: var(--tx-hi); }
        .footer-links { display: flex; flex-wrap: wrap; gap: 20px; }
        .footer-links a { font-size: 13px; color: var(--tx-3); text-decoration: none; transition: color 0.15s; }
        .footer-links a:hover { color: var(--accent-text); }
        .footer-copy { width: 100%; text-align: center; font-size: 12px; color: var(--tx-4); margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--bd-1); }

        /* Shared prose layout for About/Privacy/Terms/Cookies */
        .legal { max-width: 720px; margin: 0 auto; padding: 72px 24px 88px; }
        .legal h1 { font-family: var(--font-display); font-size: 40px; font-weight: 400; color: var(--tx-hi); letter-spacing: -0.02em; line-height: 1.1; margin-bottom: 10px; }
        .legal .legal-updated { font-size: 12px; color: var(--tx-4); margin-bottom: 36px; }
        .legal h2 { font-family: var(--font-display); font-size: 22px; font-weight: 500; color: var(--tx-hi); letter-spacing: -0.01em; margin: 36px 0 12px; }
        .legal p { font-size: 15px; color: var(--tx-2); line-height: 1.75; margin-bottom: 12px; }
        .legal ul { margin: 0 0 12px 20px; }
        .legal li { font-size: 15px; color: var(--tx-2); line-height: 1.75; margin-bottom: 6px; }
        .legal a { color: var(--accent-text); text-decoration: underline; text-decoration-color: var(--gold); text-underline-offset: 3px; }
        .legal a:hover { text-decoration-color: currentColor; }
        .legal-placeholder {
            background: rgba(176,137,76,0.10); border: 1px solid rgba(176,137,76,0.35);
            border-radius: 12px; padding: 14px 16px; font-size: 13px; color: var(--gold-text);
            margin: 20px 0;
        }

        {% block extra_stylesheets %}{% endblock %}
    </style>
{% endblock %}

{% block body %}
    {% include 'public/_nav.html.twig' %}
    {% block content %}{% endblock %}
    {% include 'public/_footer.html.twig' %}
{% endblock %}
